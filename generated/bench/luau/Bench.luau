-- ReadBenchMixed reads the type wire (SPEC §4.3, §6.1); false refuses without a latch
-- (a stream refusal rides stream:error(), named by the runtime's refusalName).
function _M.ReadBenchMixed(stream: any, value: any): boolean
  if not stream:serializeBits(BITS, 16) then
    return false
  end
  if BITS.value ~= 49374 then -- const(49374, 16): a read rejects any other value (SPEC §4.3)
    return false
  end
  if not stream:serializeBits(BITS, 16) then
    return false
  end
  value.Sequence = BITS.value
  if not stream:serializeInt(BITS, 0, 65535) then
    return false
  end
  value.AckSequence = BITS.value
  if not stream:serializeBits(BITS, 32) then
    return false
  end
  value.AckBits = BITS.value
  if not stream:serializeBits64(BIG, 64) then
    return false
  end
  value.SessionId = BIG.value
  if not stream:serializeBits(BITS, 32) then
    return false
  end
  value.ClientId = BITS.value
  if not stream:serializeBits64(BIG, 64) then
    return false
  end
  value.Nonce = BIG.value
  if not stream:serializeInt64(BIG, -1000000000000i, 1000000000000i) then
    return false
  end
  value.WorldTime = BIG.value
  if not stream:serializeBits64(BIG, 48) then
    return false
  end
  value.FrameTick = BIG.value
  if not stream:serializeFixed64(BIG, 24, 8, 0i, 65535i) then
    return false
  end
  value.ServerTime = integer.tonumber(BIG.value)
  if not stream:serializeInt(BITS, 1, 8) then -- the count guards the loop (SPEC §6.3)
    return false
  end
  value.EntitiesCount = BITS.value
  for i = 1, value.EntitiesCount do
    if not _M.ReadMixedEntity(stream, value.Entities[i]) then
      return false
    end
  end
  if not stream:serializeInt(BITS, 0, 80) then -- the count guards the loop (SPEC §6.3)
    return false
  end
  value.StatsCount = BITS.value
  for i = 1, value.StatsCount do
    if not _M.ReadMixedStat(stream, value.Stats[i]) then
      return false
    end
  end
  if not _M.ReadMixedEvent(stream, value.GameEvent) then
    return false
  end
  for i = 1, 4 do
    local item = 0
    if not stream:serializeBits(BITS, 8) then
      return false
    end
    item = BITS.value
    buffer.writeu8(value.Loadout, i - 1, item)
  end
  do -- length, align, bytes into the pre-allocated buffer (SPEC §4.7)
    if not stream:serializeInt(BITS, 0, 15) then -- the length guards the payload (§6.3)
      return false
    end
    local n = BITS.value
    local tmp = buffer.create(n)
    if not stream:serializeBytes(tmp) then
      return false
    end
    buffer.copy(value.PlayerName, 0, tmp, 0, n) -- nothing past the used length is written (§5's tail rule)
    value.PlayerNameLength = n
    if not utf8valid(value.PlayerName, n) then return false end -- malformed UTF-8 (SPEC §4.7)
    for k = 0, n - 1 do if buffer.readu8(value.PlayerName, k) == 0 then return false end end -- interior null (SPEC §4.7)
  end
  do -- length, align, bytes into the pre-allocated buffer (SPEC §4.7)
    if not stream:serializeInt(BITS, 0, 16) then -- the length guards the payload (§6.3)
      return false
    end
    local n = BITS.value
    local tmp = buffer.create(n)
    if not stream:serializeBytes(tmp) then
      return false
    end
    buffer.copy(value.Payload, 0, tmp, 0, n) -- nothing past the used length is written (§5's tail rule)
    value.PayloadLength = n
  end
  if not stream:serializeCompressedFloat(STR, -1.0, 1.0, 0.01) then
    return false
  end
  value.AimX = STR.value
  if not stream:serializeCompressedFloat(STR, -1.0, 1.0, 0.01) then
    return false
  end
  value.AimY = STR.value
  if not stream:serializeCompressedFloat(STR, -1.0, 1.0, 0.01) then
    return false
  end
  value.AimZ = STR.value
  if not stream:serializeFloat(STR) then
    return false
  end
  value.Recoil = STR.value
  if not stream:serializeDouble(STR) then
    return false
  end
  value.Drift = STR.value
  if not stream:serializeUint128(WIDE) then
    return false
  end
  value.WideKey = WIDE.value
  if not stream:serializeInt128(WIDE, _Rt.int128(0x0000000000000000i, 0xfffffff000000000i), _Rt.int128(0x0000000000000000i, 0x0000001000000000i)) then
    return false
  end
  value.Flux = WIDE.value
  if not stream:serializeFixed64(BIG, 8, 8, 0i, 250i) then
    return false
  end
  value.Ping = integer.tonumber(BIG.value)
  if not stream:serializeBits(BITS, 4) then
    return false
  end
  if BITS.value ~= 0 then -- reserved(4): a read rejects nonzero (SPEC §4.3)
    return false
  end
  if not stream:serializeAlign() then -- rejects nonzero padding (SPEC §4.3)
    return false
  end
  if not stream:serializeBits(BITS, 24) then
    return false
  end
  value.CrcHint = BITS.value
  if not stream:serializeBool(BOOL) then
    return false
  end
  value.HasExtra = BOOL.value
  if not stream:serializeInt(BITS, 0, 255) then
    return false
  end
  value.Extra = BITS.value
  if not stream:serializeInt(BITS, 0, 15) then
    return false
  end
  value.IdleTicks = BITS.value
  return true
end

