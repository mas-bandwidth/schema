        if not rok: return false
        rv = rv
        write_int8_le(value.Loadout, i, rv)
    rv, rok = stream.serialize_int(rv, 0, 15) // the used length guards the copy (SPEC §4.7, §6.3)
    if not rok: return false
    rs, rok = stream.serialize_bytes(value.PlayerName, rv) // aligns (padding zero), then the used bytes in place (SPEC §4.7)
    if not rok: return false
    value.PlayerNameLength = rv
    rt = schema_rt.text_refusal(value.PlayerName, rv)
    if rt != serialize_refusal_none: return stream.fail(rt) // an interior NUL or malformed UTF-8 is refused (SPEC §4.7)
    rv, rok = stream.serialize_int(rv, 0, 16) // the used length guards the copy (SPEC §4.7, §6.3)
    if not rok: return false
    rs, rok = stream.serialize_bytes(value.Payload, rv) // aligns (padding zero), then the used bytes in place (SPEC §4.7)
    if not rok: return false
    value.PayloadLength = rv
    rf, rok = stream.serialize_compressed_float_precomputed(rf, 200, 8, 2.0, -1.0) // a step past the top, or a non-finite decode, is refused (SPEC §4.3)
    if not rok: return false
    value.AimX = rf
    rf, rok = stream.serialize_compressed_float_precomputed(rf, 200, 8, 2.0, -1.0) // a step past the top, or a non-finite decode, is refused (SPEC §4.3)
    if not rok: return false
    value.AimY = rf
    rf, rok = stream.serialize_compressed_float_precomputed(rf, 200, 8, 2.0, -1.0) // a step past the top, or a non-finite decode, is refused (SPEC §4.3)
    if not rok: return false
    value.AimZ = rf
    rf, rok = stream.serialize_float(rf) // NaN and ±inf refuse as non_finite_float on the raw bits (SPEC §4.3)
    if not rok: return false
    value.Recoil = rf
    rf, rok = stream.serialize_double(rf) // NaN and ±inf refuse as non_finite_float on the raw bits (SPEC §4.3)
    if not rok: return false
    value.Drift = rf
    ru, rok = stream.serialize_uint128(ru) // uint128 raw (SPEC §4.3)
    if not rok: return false
    value.WideKey = schema_rt.Int128 { lo: ru.lo, hi: ru.hi }
    rw, rok = stream.serialize_int128(rw, serialize_int128 { lo: 0x0000000000000000, hi: 0xfffffff000000000 }, serialize_int128 { lo: 0x0000000000000000, hi: 0x0000001000000000 }) // the offset from min; past max is refused (SPEC §4.3)
    if not rok: return false
    value.Flux = schema_rt.Int128 { lo: rw.lo, hi: rw.hi }
    rv, rok = stream.serialize_fixed32(rv, 24, 8, 0, 250) // the Q format's raw offset (SPEC §4.3)
    if not rok: return false
    value.Ping = rv
    rv, rok = stream.serialize_bits(rv, 4)
    if not rok: return false
    if rv != 0: return stream.fail(serialize_refusal_value_out_of_range) // reserved(4): a set bit is refused (SPEC §4.3)
    if not stream.serialize_align(): return false // refuses nonzero padding (SPEC §4.3)
    rv, rok = stream.serialize_bits(rv, 24)
    if not rok: return false
    value.CrcHint = rv
    rb, rok = stream.serialize_bool(rb)
    if not rok: return false
    value.HasExtra = rb
    rv, rok = stream.serialize_int(rv, 0, 255) // the offset from min; past max is refused (SPEC §4.3)
    if not rok: return false
    value.Extra = rv
    rv, rok = stream.serialize_int(rv, 0, 15) // the offset from min; past max is refused (SPEC §4.3)
    if not rok: return false
    value.IdleTicks = rv
    return true

// WriteBenchPacket writes v in wire order (SPEC §6.1). Write misuse the runtime
// sees traps in every run; the schema's own contracts are asserts.
def WriteBenchPacket(s:serialize_write_stream, v:BenchPacket) -> bool:
    assert v.A >= -100 and v.A <= 100 // the value is in [min, max] (SPEC §4.3)
    s.serialize_bits(v.A - (-100), 8) // the offset from min (SPEC §4.3)
    assert v.B >= 0 and v.B <= 65535 // the value is in [min, max] (SPEC §4.3)
    s.serialize_bits(v.B, 16) // the offset from min (SPEC §4.3)
    assert v.C >= -1000000 and v.C <= 1000000 // the value is in [min, max] (SPEC §4.3)
    s.serialize_bits(v.C - (-1000000), 21) // the offset from min (SPEC §4.3)
    s.serialize_bits(v.Bits7, 7) // the declared bit width (SPEC §4.3)
    s.serialize_bits(v.Bits13, 13) // the declared bit width (SPEC §4.3)
    s.serialize_bits(v.Bits23, 23) // the declared bit width (SPEC §4.3)
    s.serialize_bool(v.Flag) // SPEC §4.3
    s.serialize_float(v.X) // finite only: NaN and ±inf trap (SPEC §4.3)
    s.serialize_float(v.Y) // finite only: NaN and ±inf trap (SPEC §4.3)
    s.serialize_float(v.Z) // finite only: NaN and ±inf trap (SPEC §4.3)
    s.serialize_bits64(v.Big, 64) // the storage width (SPEC §4.3)
    s.serialize_align() // align (SPEC §4.3)
    s.serialize_bytes(v.Blob, 17) // [N]uint8 at a byte-aligned position: one bulk copy, wire-identical to the per-byte loop (SPEC §4.7)
    return true

// WriteBenchInts writes v in wire order (SPEC §6.1). Write misuse the runtime
// sees traps in every run; the schema's own contracts are asserts.
def WriteBenchInts(s:serialize_write_stream, v:BenchInts) -> bool:
    assert v.F0 >= -100 and v.F0 <= 100 // the value is in [min, max] (SPEC §4.3)
    s.serialize_bits(v.F0 - (-100), 8) // the offset from min (SPEC §4.3)
    assert v.F1 >= 0 and v.F1 <= 65535 // the value is in [min, max] (SPEC §4.3)
    s.serialize_bits(v.F1, 16) // the offset from min (SPEC §4.3)
    assert v.F2 >= -1000000 and v.F2 <= 1000000 // the value is in [min, max] (SPEC §4.3)
    s.serialize_bits(v.F2 - (-1000000), 21) // the offset from min (SPEC §4.3)
    assert v.F3 >= 0 and v.F3 <= 3 // the value is in [min, max] (SPEC §4.3)
    s.serialize_bits(v.F3, 2) // the offset from min (SPEC §4.3)
    assert v.F4 >= -15 and v.F4 <= 15 // the value is in [min, max] (SPEC §4.3)
    s.serialize_bits(v.F4 - (-15), 5) // the offset from min (SPEC §4.3)
    assert v.F5 >= 0 and v.F5 <= 1000 // the value is in [min, max] (SPEC §4.3)
    s.serialize_bits(v.F5, 10) // the offset from min (SPEC §4.3)
    assert v.F6 >= -2048 and v.F6 <= 2047 // the value is in [min, max] (SPEC §4.3)
    s.serialize_bits(v.F6 - (-2048), 12) // the offset from min (SPEC §4.3)
    assert v.F7 >= 0 and v.F7 <= 255 // the value is in [min, max] (SPEC §4.3)
    s.serialize_bits(v.F7, 8) // the offset from min (SPEC §4.3)
    assert v.F8 >= -600000 and v.F8 <= 600000 // the value is in [min, max] (SPEC §4.3)
    s.serialize_bits(v.F8 - (-600000), 21) // the offset from min (SPEC §4.3)
    assert v.F9 >= 0 and v.F9 <= 100 // the value is in [min, max] (SPEC §4.3)
    s.serialize_bits(v.F9, 7) // the offset from min (SPEC §4.3)
    return true

// WriteBenchBits writes v in wire order (SPEC §6.1). Write misuse the runtime
// sees traps in every run; the schema's own contracts are asserts.
def WriteBenchBits(s:serialize_write_stream, v:BenchBits) -> bool:
    s.serialize_bits(v.B7, 7) // the declared bit width (SPEC §4.3)
    s.serialize_bits(v.B13, 13) // the declared bit width (SPEC §4.3)
    s.serialize_bits(v.B23, 23) // the declared bit width (SPEC §4.3)
    s.serialize_bits(v.B3, 3) // the declared bit width (SPEC §4.3)
    s.serialize_bits(v.B32, 32) // the declared bit width (SPEC §4.3)
    s.serialize_bits(v.B11, 11) // the declared bit width (SPEC §4.3)
    s.serialize_bits(v.B19, 19) // the declared bit width (SPEC §4.3)
    s.serialize_bits64(v.B48, 48) // the declared bit width (SPEC §4.3)
    return true

// WriteMixedEntity writes v in wire order (SPEC §6.1). Write misuse the runtime
// sees traps in every run; the schema's own contracts are asserts.
def WriteMixedEntity(s:serialize_write_stream, v:MixedEntity) -> bool:
    s.serialize_bits(v.EntityId, 12) // the declared bit width (SPEC §4.3)
    assert v.PosX >= -16383 and v.PosX <= 16383 // the value is in [min, max] (SPEC §4.3)
    s.serialize_bits(v.PosX - (-16383), 15) // the offset from min (SPEC §4.3)
    assert v.PosY >= -16383 and v.PosY <= 16383 // the value is in [min, max] (SPEC §4.3)
    s.serialize_bits(v.PosY - (-16383), 15) // the offset from min (SPEC §4.3)
    assert v.PosZ >= -16383 and v.PosZ <= 16383 // the value is in [min, max] (SPEC §4.3)
    s.serialize_bits(v.PosZ - (-16383), 15) // the offset from min (SPEC §4.3)
    s.serialize_bits(v.Yaw, 9) // the declared bit width (SPEC §4.3)
    s.serialize_bits(v.Pitch, 9) // the declared bit width (SPEC §4.3)
    assert v.VelX >= -2048 and v.VelX <= 2047 // the value is in [min, max] (SPEC §4.3)
    s.serialize_bits(v.VelX - (-2048), 12) // the offset from min (SPEC §4.3)
    assert v.VelY >= -2048 and v.VelY <= 2047 // the value is in [min, max] (SPEC §4.3)
    s.serialize_bits(v.VelY - (-2048), 12) // the offset from min (SPEC §4.3)
    assert v.VelZ >= -2048 and v.VelZ <= 2047 // the value is in [min, max] (SPEC §4.3)
    s.serialize_bits(v.VelZ - (-2048), 12) // the offset from min (SPEC §4.3)
    assert v.Health >= 0 and v.Health <= 1000 // the value is in [min, max] (SPEC §4.3)
    s.serialize_bits(v.Health, 10) // the offset from min (SPEC §4.3)
    assert v.Weapon >= 0 and v.Weapon <= 15 // the enum value (SPEC §4.2)
    s.serialize_bits(v.Weapon, 4) // the enum value (SPEC §4.2)
    assert v.Damage >= 0 and v.Damage < 0x100 // the mask fits 8 bits (SPEC §4.2)
    s.serialize_bits(v.Damage, 8) // the flags wire width (SPEC §4.2)
    s.serialize_bool(v.Moving) // SPEC §4.3
    s.serialize_bool(v.Firing) // SPEC §4.3
    return true

// WriteMixedStat writes v in wire order (SPEC §6.1). Write misuse the runtime
// sees traps in every run; the schema's own contracts are asserts.
def WriteMixedStat(s:serialize_write_stream, v:MixedStat) -> bool:
    s.serialize_bits(v.StatId, 8) // the declared bit width (SPEC §4.3)
    assert v.Delta >= -512 and v.Delta <= 511 // the value is in [min, max] (SPEC §4.3)
    s.serialize_bits(v.Delta - (-512), 10) // the offset from min (SPEC §4.3)
    return true

// WriteMixedHitEvent writes v in wire order (SPEC §6.1). Write misuse the runtime
// sees traps in every run; the schema's own contracts are asserts.
def WriteMixedHitEvent(s:serialize_write_stream, v:MixedHitEvent) -> bool:
    s.serialize_bits(v.TargetId, 12) // the declared bit width (SPEC §4.3)
    assert v.Damage >= 0 and v.Damage <= 4095 // the value is in [min, max] (SPEC §4.3)
    s.serialize_bits(v.Damage, 12) // the offset from min (SPEC §4.3)
    assert v.HitKind >= 0 and v.HitKind <= 7 // the value is in [min, max] (SPEC §4.3)
    s.serialize_bits(v.HitKind, 3) // the offset from min (SPEC §4.3)
    s.serialize_bool(v.Crit) // SPEC §4.3
    return true

// WriteMixedChatEvent writes v in wire order (SPEC §6.1). Write misuse the runtime
// sees traps in every run; the schema's own contracts are asserts.
def WriteMixedChatEvent(s:serialize_write_stream, v:MixedChatEvent) -> bool:
    assert v.Channel >= 0 and v.Channel <= 3 // the value is in [min, max] (SPEC §4.3)
    s.serialize_bits(v.Channel, 2) // the offset from min (SPEC §4.3)
    s.serialize_bits(v.Speaker, 12) // the declared bit width (SPEC §4.3)
    return true

// WriteMixedPickupEvent writes v in wire order (SPEC §6.1). Write misuse the runtime
// sees traps in every run; the schema's own contracts are asserts.
def WriteMixedPickupEvent(s:serialize_write_stream, v:MixedPickupEvent) -> bool:
    s.serialize_bits(v.ItemId, 10) // the declared bit width (SPEC §4.3)
    assert v.Amount >= 0 and v.Amount <= 255 // the value is in [min, max] (SPEC §4.3)
    s.serialize_bits(v.Amount, 8) // the offset from min (SPEC §4.3)
    return true

// WriteMixedEvent writes the tag, then the selected arm only (SPEC §4.8: None = 0,
// then each declared arm).
def WriteMixedEvent(s:serialize_write_stream, v:MixedEvent) -> bool:
    assert v.Type >= 0 and v.Type <= 3 // the tag is a write-side contract (SPEC §4.8)
    s.serialize_bits(v.Type, 2) // the union tag (SPEC §4.8)
    if v.Type == MixedEventTypeHit: // the selected arm only (SPEC §4.8)
        WriteMixedHitEvent(s, v.Hit)
    if v.Type == MixedEventTypeChat: // the selected arm only (SPEC §4.8)
        WriteMixedChatEvent(s, v.Chat)
    if v.Type == MixedEventTypePickup: // the selected arm only (SPEC §4.8)
        WriteMixedPickupEvent(s, v.Pickup)
    return true

// WriteBenchMixed writes v in wire order (SPEC §6.1). Write misuse the runtime
// sees traps in every run; the schema's own contracts are asserts.
def WriteBenchMixed(s:serialize_write_stream, v:BenchMixed) -> bool:
    s.serialize_bits(49374, 16) // const(49374, 16) (SPEC §4.3)
    s.serialize_bits(v.Sequence, 16) // the declared bit width (SPEC §4.3)
    assert v.AckSequence >= 0 and v.AckSequence <= 65535 // the value is in [min, max] (SPEC §4.3)
    s.serialize_bits(v.AckSequence, 16) // the offset from min (SPEC §4.3)
    s.serialize_bits(v.AckBits, 32) // the declared bit width (SPEC §4.3)
    s.serialize_bits64(v.SessionId, 64) // the storage width (SPEC §4.3)
    s.serialize_bits(v.ClientId, 32) // the storage width (SPEC §4.3)
    s.serialize_bits64(v.Nonce, 64) // the offset from min (SPEC §4.3)
    assert v.WorldTime >= -1000000000000 and v.WorldTime <= 1000000000000 // the value is in [min, max] (SPEC §4.3)
    s.serialize_bits64(v.WorldTime - (-1000000000000), 41) // the offset from min (SPEC §4.3)
    s.serialize_bits64(v.FrameTick, 48) // the declared bit width (SPEC §4.3)
    s.serialize_fixed32(v.ServerTime, 24, 8, 0, 65535) // the Q format's raw offset (SPEC §4.3)
    assert v.EntitiesCount >= 1 and v.EntitiesCount <= 8 // the count is in [1, 8] (SPEC §4.6)
    s.serialize_bits(v.EntitiesCount - (1), 3) // the count (SPEC §4.6)
    for(v.EntitiesCount) _i: // the count guards the loop (SPEC §6.3)
        WriteMixedEntity(s, v.Entities[_i])
    assert v.StatsCount >= 0 and v.StatsCount <= 80 // the count is in [0, 80] (SPEC §4.6)
    s.serialize_bits(v.StatsCount, 7) // the count (SPEC §4.6)
    for(v.StatsCount) _i: // the count guards the loop (SPEC §6.3)
        WriteMixedStat(s, v.Stats[_i])
    WriteMixedEvent(s, v.GameEvent)
    for(4) _i:
        s.serialize_bits(read_uint8_le(v.Loadout, _i), 8) // the storage width (SPEC §4.3)
    assert v.PlayerNameLength >= 0 and v.PlayerNameLength <= 15 // the used length is in [0, 15] (SPEC §4.7)
    assert schema_rt.text_refusal(v.PlayerName, v.PlayerNameLength) == serialize_refusal_none // no interior NUL, well-formed UTF-8 (SPEC §4.7)
    s.serialize_bits(v.PlayerNameLength, 4) // the used length (SPEC §4.7)
    s.serialize_bytes(v.PlayerName, v.PlayerNameLength) // aligns, then the used bytes (SPEC §4.7)
    assert v.PayloadLength >= 0 and v.PayloadLength <= 16 // the used length is in [0, 16] (SPEC §4.7)
    s.serialize_bits(v.PayloadLength, 5) // the used length (SPEC §4.7)
    s.serialize_bytes(v.Payload, v.PayloadLength) // aligns, then the used bytes (SPEC §4.7)
    s.serialize_compressed_float_precomputed(v.AimX, 200, 8, 2.0, -1.0) // the step index; a non-finite value traps (SPEC §4.3)
    s.serialize_compressed_float_precomputed(v.AimY, 200, 8, 2.0, -1.0) // the step index; a non-finite value traps (SPEC §4.3)
    s.serialize_compressed_float_precomputed(v.AimZ, 200, 8, 2.0, -1.0) // the step index; a non-finite value traps (SPEC §4.3)
    s.serialize_float(v.Recoil) // finite only: NaN and ±inf trap (SPEC §4.3)
    s.serialize_double(v.Drift) // finite only: NaN and ±inf trap (SPEC §4.3)
    s.serialize_uint128(serialize_uint128 { lo: v.WideKey.lo, hi: v.WideKey.hi }) // uint128 raw (SPEC §4.3)
    s.serialize_int128(serialize_int128 { lo: v.Flux.lo, hi: v.Flux.hi }, serialize_int128 { lo: 0x0000000000000000, hi: 0xfffffff000000000 }, serialize_int128 { lo: 0x0000000000000000, hi: 0x0000001000000000 }) // int128, offset from min (SPEC §4.3)
    s.serialize_fixed32(v.Ping, 24, 8, 0, 250) // the Q format's raw offset (SPEC §4.3)
    s.serialize_bits(0, 4) // reserved(4) (SPEC §4.3)
    s.serialize_align() // align (SPEC §4.3)
    s.serialize_bits(v.CrcHint, 24) // the declared bit width (SPEC §4.3)
    s.serialize_bool(v.HasExtra) // SPEC §4.3
    assert v.Extra >= 0 and v.Extra <= 255 // the value is in [min, max] (SPEC §4.3)
    s.serialize_bits(v.Extra, 8) // the offset from min (SPEC §4.3)
    assert v.IdleTicks >= 0 and v.IdleTicks <= 15 // the value is in [min, max] (SPEC §4.3)
    s.serialize_bits(v.IdleTicks, 4) // the offset from min (SPEC §4.3)
    return true
