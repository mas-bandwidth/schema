def BenchBitsFixedClampBody(v:BenchBits, report:schema_rt.TableReport):
    if schema_rt.ult(127, v.B7):
        v.B7 = 127
        report.clamped += 1
    if schema_rt.ult(8191, v.B13):
        v.B13 = 8191
        report.clamped += 1
    if schema_rt.ult(8388607, v.B23):
