    push(out, schema_rt.TableFixedEntry { src: src + 24, dst: dst + 24, size: 4, grd: schema_rt.tableFixedNoGuard, op: schema_rt.tableFixedCopy })
    push(out, schema_rt.TableFixedEntry { src: src + 28, dst: dst + 28, size: 4, grd: schema_rt.tableFixedNoGuard, op: schema_rt.tableFixedCopy })
    push(out, schema_rt.TableFixedEntry { src: src + 32, dst: dst + 32, size: 4, grd: schema_rt.tableFixedNoGuard, op: schema_rt.tableFixedCopy })
    push(out, schema_rt.TableFixedEntry { src: src + 36, dst: dst + 36, size: 4, grd: schema_rt.tableFixedNoGuard, op: schema_rt.tableFixedCopy })
    return length(out)

// BenchIntsFixedScatter reads one canonical flat body image at at into v in place.
def BenchIntsFixedScatter(data:string, at:int, v:BenchInts):
    v.F0 = read_int32_le(data, at + 0)
    v.F1 = read_int32_le(data, at + 4)
    v.F2 = read_int32_le(data, at + 8)
    v.F3 = read_int32_le(data, at + 12)
    v.F4 = read_int32_le(data, at + 16)
    v.F5 = read_int32_le(data, at + 20)
    v.F6 = read_int32_le(data, at + 24)
    v.F7 = read_int32_le(data, at + 28)
    v.F8 = read_int32_le(data, at + 32)
    v.F9 = read_int32_le(data, at + 36)

def BenchIntsFixedClampBody(v:BenchInts, report:schema_rt.TableReport):
    if v.F0 < -100:
        v.F0 = -100
        report.clamped += 1
    elif v.F0 > 100:
        v.F0 = 100
        report.clamped += 1
    if v.F1 < 0:
        v.F1 = 0
        report.clamped += 1
    elif v.F1 > 65535:
        v.F1 = 65535
        report.clamped += 1
    if v.F2 < -1000000:
        v.F2 = -1000000
        report.clamped += 1
    elif v.F2 > 1000000:
        v.F2 = 1000000
        report.clamped += 1
    if v.F3 < 0:
        v.F3 = 0
        report.clamped += 1
    elif v.F3 > 3:
        v.F3 = 3
        report.clamped += 1
    if v.F4 < -15:
        v.F4 = -15
        report.clamped += 1
    elif v.F4 > 15:
        v.F4 = 15
        report.clamped += 1
    if v.F5 < 0:
        v.F5 = 0
        report.clamped += 1
    elif v.F5 > 1000:
        v.F5 = 1000
        report.clamped += 1
    if v.F6 < -2048:
        v.F6 = -2048
        report.clamped += 1
    elif v.F6 > 2047:
        v.F6 = 2047
        report.clamped += 1
    if v.F7 < 0:
        v.F7 = 0
        report.clamped += 1
    elif v.F7 > 255:
        v.F7 = 255
        report.clamped += 1
    if v.F8 < -600000:
        v.F8 = -600000
        report.clamped += 1
    elif v.F8 > 600000:
        v.F8 = 600000
        report.clamped += 1
    if v.F9 < 0:
        v.F9 = 0
        report.clamped += 1
    elif v.F9 > 100:
        v.F9 = 100
        report.clamped += 1

def BenchIntsFixedCheckBody(v:BenchInts) -> bool:
    if (v.F0 < -100) or (v.F0 > 100):
        return false
    if (v.F1 < 0) or (v.F1 > 65535):
        return false
    if (v.F2 < -1000000) or (v.F2 > 1000000):
        return false
    if (v.F3 < 0) or (v.F3 > 3):
        return false
    if (v.F4 < -15) or (v.F4 > 15):
        return false
    if (v.F5 < 0) or (v.F5 > 1000):
        return false
    if (v.F6 < -2048) or (v.F6 > 2047):
        return false
    if (v.F7 < 0) or (v.F7 > 255):
        return false
    if (v.F8 < -600000) or (v.F8 > 600000):
        return false
    if (v.F9 < 0) or (v.F9 > 100):
        return false
    return true

def BenchIntsFixedClamp(v:BenchInts, report:schema_rt.TableReport):
    BenchIntsFixedClampBody(v, report)

