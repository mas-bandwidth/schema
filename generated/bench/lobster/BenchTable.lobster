def BenchBitsFixedScatter(data:string, at:int, v:BenchBits):
    v.B7 = read_uint32_le(data, at + 0)
    v.B13 = read_uint32_le(data, at + 4)
    v.B23 = read_uint32_le(data, at + 8)
