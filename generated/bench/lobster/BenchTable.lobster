// read and MixedStatFixedLoadTolerant the tolerant one (docs/SPEC-TABLES.md §6.5).
def MixedStatFixedDecode(data:string) -> [MixedStat]:
    let layout = MixedStatFixedLayoutBytes()
    assert read_uint8_le(data, 0) == 3
    assert read_uint64_le(data, 8) == MixedStatFixedHash
    assert read_uint32_le(data, 16) == length(layout)
    let start = 20 + length(layout)
    let stride = 8 + 8
    let out:[MixedStat] = []
    var at = start
    while at < length(data):
        assert read_uint64_le(data, at) == MixedStatFixedHash
        push(out, MixedStatFixedGet(data, at + 8))
        at += stride
    return out

