        report.clamped += 1
    if schema_rt.ult(2047, v.B11):
        v.B11 = 2047
        report.clamped += 1
    if schema_rt.ult(524287, v.B19):
        v.B19 = 524287
        report.clamped += 1
    if schema_rt.ult(281474976710655, v.B48):
        v.B48 = 281474976710655
        report.clamped += 1

def BenchBitsFixedCheckBody(v:BenchBits) -> bool:
    if (schema_rt.ult(127, v.B7)):
        return false
    if (schema_rt.ult(8191, v.B13)):
        return false
    if (schema_rt.ult(8388607, v.B23)):
        return false
    if (schema_rt.ult(7, v.B3)):
        return false
    if (schema_rt.ult(2047, v.B11)):
        return false
    if (schema_rt.ult(524287, v.B19)):
        return false
    if (schema_rt.ult(281474976710655, v.B48)):
        return false
    return true

