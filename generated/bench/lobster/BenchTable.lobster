// MixedEntityFixedHash is fnv1a64 over the layout above (docs/FIXED-FORM-ALGORITHM.md §1).
let MixedEntityFixedHash = 9048123448468158193
let MixedEntityFixedRecordBytes = 51

// MixedEntityFixedPut writes one record body at at, in declared order and at each
// field's declared storage width (docs/FIXED-FORM-ALGORITHM.md §3).
def MixedEntityFixedPut(b:string, at:int, v:MixedEntity) -> string:
    b = write_int32_le(b, at + 0, v.EntityId)
    b = write_int32_le(b, at + 4, v.PosX)
    b = write_int32_le(b, at + 8, v.PosY)
    b = write_int32_le(b, at + 12, v.PosZ)
    b = write_int32_le(b, at + 16, v.Yaw)
    b = write_int32_le(b, at + 20, v.Pitch)
    b = write_int32_le(b, at + 24, v.VelX)
    b = write_int32_le(b, at + 28, v.VelY)
    b = write_int32_le(b, at + 32, v.VelZ)
    b = write_int32_le(b, at + 36, v.Health)
    b = write_int8_le(b, at + 40, int(v.Weapon))
    b = write_int64_le(b, at + 41, v.Damage)
    b = write_int8_le(b, at + 49, if v.Moving: 1 else: 0)
    b = write_int8_le(b, at + 50, if v.Firing: 1 else: 0)
    return b

// MixedEntityFixedGet reads one record body at at (docs/FIXED-FORM-ALGORITHM.md §3).
def MixedEntityFixedGet(data:string, at:int) -> MixedEntity:
    let v = NewMixedEntity()
    v.EntityId = read_uint32_le(data, at + 0)
    v.PosX = read_int32_le(data, at + 4)
    v.PosY = read_int32_le(data, at + 8)
    v.PosZ = read_int32_le(data, at + 12)
    v.Yaw = read_uint32_le(data, at + 16)
    v.Pitch = read_uint32_le(data, at + 20)
    v.VelX = read_int32_le(data, at + 24)
    v.VelY = read_int32_le(data, at + 28)
    v.VelZ = read_int32_le(data, at + 32)
    v.Health = read_int32_le(data, at + 36)
    v.Weapon = MixedWeapon(read_uint8_le(data, at + 40))
    v.Damage = read_uint64_le(data, at + 41)
    v.Moving = read_uint8_le(data, at + 49) != 0
    v.Firing = read_uint8_le(data, at + 50) != 0
    return v

// MixedEntityFixedSave writes values as a form-3 file: the header (MixedEntity, §2) once,
// then one hash-and-body record per value. A NaN or an infinity in any
// float refuses the batch: the answer is "" (docs/SPEC-TABLES.md §3.3).
def MixedEntityFixedSave(values:[MixedEntity]) -> string:
    var body = ""
    for(values) v: body += schema_rt.fixed_record(MixedEntityFixedHash, MixedEntityFixedPut(schema_rt.zeros(51), 0, v))
    return schema_rt.fixed_file(MixedEntityFixedLayoutBytes(), MixedEntityFixedHash, body, length(values))

// MixedEntityFixedDecode reads a TRUSTED form-3 file of MixedEntity records written by this
// build's own layout (MixedEntity, §2), asserting the header and every record
// hash. It is not a read of untrusted data: MixedEntityFixedLoad is the strict
// read and MixedEntityFixedLoadTolerant the tolerant one (docs/SPEC-TABLES.md §6.5).
def MixedEntityFixedDecode(data:string) -> [MixedEntity]:
    let layout = MixedEntityFixedLayoutBytes()
    assert read_uint8_le(data, 0) == 3
    assert read_uint64_le(data, 8) == MixedEntityFixedHash
    assert read_uint32_le(data, 16) == length(layout)
    let start = 20 + length(layout)
    let stride = 8 + 51
    let out:[MixedEntity] = []
    var at = start
    while at < length(data):
        assert read_uint64_le(data, at) == MixedEntityFixedHash
        push(out, MixedEntityFixedGet(data, at + 8))
        at += stride
    return out

