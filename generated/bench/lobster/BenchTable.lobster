        return -1
    return n

def BenchBitsFixedLoadTolerant(values:[BenchBits], data_in:string, plan:[schema_rt.TableFixedEntry], report_in:schema_rt.TableReport?) -> int:
    let report = if report_in: report_in else: schema_rt.TableReport {}
    schema_rt.fixed_reset_report(report)
    let data = data_in
    if length(data) < 1:
        report.malformed = true
        report.reason = schema_rt.TableRefuseTruncated
        return -1
    let form = read_uint8_le(data, 0)
    if form != schema_rt.TableFixedForm:
        if form == 1:
            return schema_rt.fixed_refuse(report, schema_rt.TableRefusePreviousForm)
        if form == 2:
            return schema_rt.fixed_refuse(report, schema_rt.TableRefuseMessageFormAsFile)
        return schema_rt.fixed_refuse(report, schema_rt.TableRefuseNewerForm)
    if length(data) < schema_rt.TableFixedHeaderBytes + 4:
        report.malformed = true
        report.reason = schema_rt.TableRefuseTruncated
        return -1
    var r_idx = 1
    while r_idx < schema_rt.TableFixedHashAt:
        if read_uint8_le(data, r_idx) != 0:
            report.malformed = true
            report.reason = schema_rt.TableRefuseReservedNotZero
            return -1
        r_idx += 1
    let layout_bytes = read_uint32_le(data, schema_rt.TableFixedHeaderBytes)
    if layout_bytes < 0 or layout_bytes + schema_rt.TableFixedHeaderBytes + 4 > length(data):
        return schema_rt.fixed_refuse(report, schema_rt.TableRefuseLayoutMalformed)
    let hash = read_uint64_le(data, schema_rt.TableFixedHashAt)
    let pick = schema_rt.fixed_select(BenchBitsFixedKnown, hash)
    if pick < 0:
        return schema_rt.fixed_refuse_hash(report, schema_rt.TableRefuseLayoutUnknown, hash)
    if pick < BenchBitsFixedFloor:
        return schema_rt.fixed_refuse_hash(report, schema_rt.TableRefuseLayoutUnsupported, hash)
    let known = BenchBitsFixedKnown[pick]
    if layout_bytes != known.layout_bytes:
        return schema_rt.fixed_refuse(report, schema_rt.TableRefuseLayoutMalformed)
    for(layout_bytes) l_i:
        if read_uint8_le(data, schema_rt.TableFixedHeaderBytes + 4 + l_i) != read_uint8_le(known.layout, l_i):
            return schema_rt.fixed_refuse(report, schema_rt.TableRefuseLayoutMalformed)
    var entries = BenchBitsFixedPlan.entries
    var entry_count = BenchBitsFixedPlan.count
    var holes = BenchBitsFixedHoles
    let record_bytes = known.record
    var census_unknown = 0
    var census_kind = 0
    if hash != BenchBitsFixedHash:
        let lane = BenchBitsFixedLineagePlans[pick]
        if lane.why != "":
            return schema_rt.fixed_refuse(report, lane.why)
        entries = lane.entries
        entry_count = lane.count
        holes = BenchBitsFixedLineageHoles[pick]
        census_unknown = lane.unknown
        census_kind = lane.kind_mismatch
    if entry_count > length(plan):
        return schema_rt.fixed_refuse(report, schema_rt.TableRefusePlanTooLarge)
    let records_start = schema_rt.TableFixedHeaderBytes + 4 + layout_bytes
    let rest = length(data) - records_start
    if record_bytes <= 8 or (rest % record_bytes) != 0:
        report.malformed = true
        report.reason = schema_rt.TableRefuseTruncated
        return -1
    let n = rest / record_bytes
    if n > length(values):
        return schema_rt.fixed_refuse(report, schema_rt.TableRefuseBatchTooLarge)
    for(n) k:
        let rec_at = records_start + k * record_bytes
        if read_uint64_le(data, rec_at) != hash:
            return schema_rt.fixed_refuse(report, schema_rt.TableRefuseNoLayout)
        let why = schema_rt.fixed_text_refusal(entries, entry_count, data, rec_at + 8)
        if why != "":
            return schema_rt.fixed_refuse(report, why)
    for(n) k:
        let rec_at = records_start + k * record_bytes
        var img = schema_rt.fixed_prefill_holes(schema_rt.zeros(36), BenchBitsFixedResetImage, holes)
        let img2, why = schema_rt.fixed_run(entries, entry_count, data, rec_at + 8, img, report)
        if why != "":
            return schema_rt.fixed_refuse(report, why)
        img = img2
        BenchBitsFixedScatter(img, 0, values[k])
        schema_rt.fixed_forged_bounds(entries, entry_count, data, rec_at + 8, report)
        BenchBitsFixedClamp(values[k], report)
    report.unknown += census_unknown
    report.kind_mismatch += census_kind
    return n

// MixedEntityReset restores v to its declared defaults in place (docs/SPEC-TABLES.md §3.4).
def MixedEntityReset(v:MixedEntity):
    v.EntityId = 0
    v.PosX = 0
    v.PosY = 0
    v.PosZ = 0
    v.Yaw = 0
    v.Pitch = 0
    v.VelX = 0
    v.VelY = 0
    v.VelZ = 0
    v.Health = 0
    v.Weapon = MixedWeaponNone
    v.Damage = 0
    v.Moving = false
    v.Firing = false

def MixedEntityFixedLeaves(out:[schema_rt.TableFixedEntry], src:int, dst:int) -> int:
    push(out, schema_rt.TableFixedEntry { src: src + 0, dst: dst + 0, size: 4, grd: schema_rt.tableFixedNoGuard, op: schema_rt.tableFixedCopy })
    push(out, schema_rt.TableFixedEntry { src: src + 4, dst: dst + 4, size: 4, grd: schema_rt.tableFixedNoGuard, op: schema_rt.tableFixedCopy })
    push(out, schema_rt.TableFixedEntry { src: src + 8, dst: dst + 8, size: 4, grd: schema_rt.tableFixedNoGuard, op: schema_rt.tableFixedCopy })
    push(out, schema_rt.TableFixedEntry { src: src + 12, dst: dst + 12, size: 4, grd: schema_rt.tableFixedNoGuard, op: schema_rt.tableFixedCopy })
    push(out, schema_rt.TableFixedEntry { src: src + 16, dst: dst + 16, size: 4, grd: schema_rt.tableFixedNoGuard, op: schema_rt.tableFixedCopy })
    push(out, schema_rt.TableFixedEntry { src: src + 20, dst: dst + 20, size: 4, grd: schema_rt.tableFixedNoGuard, op: schema_rt.tableFixedCopy })
    push(out, schema_rt.TableFixedEntry { src: src + 24, dst: dst + 24, size: 4, grd: schema_rt.tableFixedNoGuard, op: schema_rt.tableFixedCopy })
    push(out, schema_rt.TableFixedEntry { src: src + 28, dst: dst + 28, size: 4, grd: schema_rt.tableFixedNoGuard, op: schema_rt.tableFixedCopy })
    push(out, schema_rt.TableFixedEntry { src: src + 32, dst: dst + 32, size: 4, grd: schema_rt.tableFixedNoGuard, op: schema_rt.tableFixedCopy })
    push(out, schema_rt.TableFixedEntry { src: src + 36, dst: dst + 36, size: 4, grd: schema_rt.tableFixedNoGuard, op: schema_rt.tableFixedCopy })
    push(out, schema_rt.TableFixedEntry { src: src + 40, dst: dst + 40, size: 1, grd: schema_rt.tableFixedNoGuard, op: schema_rt.tableFixedCopy })
    push(out, schema_rt.TableFixedEntry { src: src + 41, dst: dst + 41, size: 8, grd: schema_rt.tableFixedNoGuard, op: schema_rt.tableFixedCopy })
    push(out, schema_rt.TableFixedEntry { src: src + 49, dst: dst + 49, size: 1, grd: schema_rt.tableFixedNoGuard, op: schema_rt.tableFixedBool })
    push(out, schema_rt.TableFixedEntry { src: src + 50, dst: dst + 50, size: 1, grd: schema_rt.tableFixedNoGuard, op: schema_rt.tableFixedBool })
    return length(out)

// MixedEntityFixedScatter reads one canonical flat body image at at into v in place.
def MixedEntityFixedScatter(data:string, at:int, v:MixedEntity):
    v.EntityId = read_uint32_le(data, at + 0)
    v.PosX = read_int32_le(data, at + 4)
    v.PosY = read_int32_le(data, at + 8)
    v.PosZ = read_int32_le(data, at + 12)
    v.Yaw = read_uint32_le(data, at + 16)
    v.Pitch = read_uint32_le(data, at + 20)
    v.VelX = read_int32_le(data, at + 24)
    v.VelY = read_int32_le(data, at + 28)
    v.VelZ = read_int32_le(data, at + 32)
    v.Health = read_int32_le(data, at + 36)
    v.Weapon = MixedWeapon(read_uint8_le(data, at + 40))
    v.Damage = read_uint64_le(data, at + 41)
    v.Moving = read_uint8_le(data, at + 49) != 0
    v.Firing = read_uint8_le(data, at + 50) != 0

def MixedEntityFixedClampBody(v:MixedEntity, report:schema_rt.TableReport):
    if schema_rt.ult(4095, v.EntityId):
        v.EntityId = 4095
        report.clamped += 1
    if v.PosX < -16383:
        v.PosX = -16383
        report.clamped += 1
    elif v.PosX > 16383:
        v.PosX = 16383
        report.clamped += 1
    if v.PosY < -16383:
        v.PosY = -16383
        report.clamped += 1
    elif v.PosY > 16383:
        v.PosY = 16383
        report.clamped += 1
    if v.PosZ < -16383:
        v.PosZ = -16383
        report.clamped += 1
    elif v.PosZ > 16383:
        v.PosZ = 16383
        report.clamped += 1
    if schema_rt.ult(511, v.Yaw):
        v.Yaw = 511
        report.clamped += 1
    if schema_rt.ult(511, v.Pitch):
        v.Pitch = 511
        report.clamped += 1
    if v.VelX < -2048:
        v.VelX = -2048
        report.clamped += 1
    elif v.VelX > 2047:
        v.VelX = 2047
        report.clamped += 1
    if v.VelY < -2048:
        v.VelY = -2048
        report.clamped += 1
    elif v.VelY > 2047:
        v.VelY = 2047
        report.clamped += 1
    if v.VelZ < -2048:
        v.VelZ = -2048
        report.clamped += 1
    elif v.VelZ > 2047:
        v.VelZ = 2047
        report.clamped += 1
    if v.Health < 0:
        v.Health = 0
        report.clamped += 1
    elif v.Health > 1000:
        v.Health = 1000
        report.clamped += 1
    if schema_rt.ult(15, int(v.Weapon)):
        v.Weapon = MixedWeaponNone
        report.clamped += 1

def MixedEntityFixedCheckBody(v:MixedEntity) -> bool:
    if (schema_rt.ult(4095, v.EntityId)):
        return false
    if (v.PosX < -16383) or (v.PosX > 16383):
        return false
    if (v.PosY < -16383) or (v.PosY > 16383):
        return false
    if (v.PosZ < -16383) or (v.PosZ > 16383):
        return false
    if (schema_rt.ult(511, v.Yaw)):
        return false
    if (schema_rt.ult(511, v.Pitch)):
        return false
    if (v.VelX < -2048) or (v.VelX > 2047):
        return false
    if (v.VelY < -2048) or (v.VelY > 2047):
        return false
    if (v.VelZ < -2048) or (v.VelZ > 2047):
        return false
    if (v.Health < 0) or (v.Health > 1000):
        return false
    if schema_rt.ult(15, int(v.Weapon)):
        return false
    return true

def MixedEntityFixedClamp(v:MixedEntity, report:schema_rt.TableReport):
    MixedEntityFixedClampBody(v, report)

