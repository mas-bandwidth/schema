    b = write_int32_le(b, at + 24, v.B19)
    b = write_int64_le(b, at + 28, v.B48)
    return b

// BenchBitsFixedGet reads one record body at at (docs/FIXED-FORM-ALGORITHM.md §3).
def BenchBitsFixedGet(data:string, at:int) -> BenchBits:
