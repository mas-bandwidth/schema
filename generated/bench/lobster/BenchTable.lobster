    push(out, schema_rt.TableFixedEntry { src: src + 0, dst: dst + 0, size: 4, grd: schema_rt.tableFixedNoGuard, op: schema_rt.tableFixedCopy })
    push(out, schema_rt.TableFixedEntry { src: src + 4, dst: dst + 4, size: 4, grd: schema_rt.tableFixedNoGuard, op: schema_rt.tableFixedCopy })
    push(out, schema_rt.TableFixedEntry { src: src + 8, dst: dst + 8, size: 4, grd: schema_rt.tableFixedNoGuard, op: schema_rt.tableFixedCopy })
    push(out, schema_rt.TableFixedEntry { src: src + 12, dst: dst + 12, size: 4, grd: schema_rt.tableFixedNoGuard, op: schema_rt.tableFixedCopy })
    push(out, schema_rt.TableFixedEntry { src: src + 16, dst: dst + 16, size: 4, grd: schema_rt.tableFixedNoGuard, op: schema_rt.tableFixedCopy })
    push(out, schema_rt.TableFixedEntry { src: src + 20, dst: dst + 20, size: 4, grd: schema_rt.tableFixedNoGuard, op: schema_rt.tableFixedCopy })
    push(out, schema_rt.TableFixedEntry { src: src + 24, dst: dst + 24, size: 4, grd: schema_rt.tableFixedNoGuard, op: schema_rt.tableFixedCopy })
    push(out, schema_rt.TableFixedEntry { src: src + 28, dst: dst + 28, size: 8, grd: schema_rt.tableFixedNoGuard, op: schema_rt.tableFixedCopy })
    return length(out)

