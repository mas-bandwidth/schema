// BenchIntsFixedHash is fnv1a64 over the layout above (docs/FIXED-FORM-ALGORITHM.md §1).
let BenchIntsFixedHash = 3981736865207749091
let BenchIntsFixedRecordBytes = 40

// BenchIntsFixedPut writes one record body at at, in declared order and at each
// field's declared storage width (docs/FIXED-FORM-ALGORITHM.md §3).
def BenchIntsFixedPut(b:string, at:int, v:BenchInts) -> string:
    b = write_int32_le(b, at + 0, v.F0)
    b = write_int32_le(b, at + 4, v.F1)
    b = write_int32_le(b, at + 8, v.F2)
    b = write_int32_le(b, at + 12, v.F3)
    b = write_int32_le(b, at + 16, v.F4)
    b = write_int32_le(b, at + 20, v.F5)
    b = write_int32_le(b, at + 24, v.F6)
    b = write_int32_le(b, at + 28, v.F7)
    b = write_int32_le(b, at + 32, v.F8)
    b = write_int32_le(b, at + 36, v.F9)
    return b

// BenchIntsFixedGet reads one record body at at (docs/FIXED-FORM-ALGORITHM.md §3).
def BenchIntsFixedGet(data:string, at:int) -> BenchInts:
    let v = NewBenchInts()
    v.F0 = read_int32_le(data, at + 0)
    v.F1 = read_int32_le(data, at + 4)
    v.F2 = read_int32_le(data, at + 8)
    v.F3 = read_int32_le(data, at + 12)
    v.F4 = read_int32_le(data, at + 16)
    v.F5 = read_int32_le(data, at + 20)
    v.F6 = read_int32_le(data, at + 24)
    v.F7 = read_int32_le(data, at + 28)
    v.F8 = read_int32_le(data, at + 32)
    v.F9 = read_int32_le(data, at + 36)
    return v

// BenchIntsFixedSave writes values as a form-3 file: the header (BenchInts, §2) once,
// then one hash-and-body record per value. A NaN or an infinity in any
// float refuses the batch: the answer is "" (docs/SPEC-TABLES.md §3.3).
def BenchIntsFixedSave(values:[BenchInts]) -> string:
    var body = ""
    for(values) v: body += schema_rt.fixed_record(BenchIntsFixedHash, BenchIntsFixedPut(schema_rt.zeros(40), 0, v))
    return schema_rt.fixed_file(BenchIntsFixedLayoutBytes(), BenchIntsFixedHash, body, length(values))

// BenchIntsFixedDecode reads a TRUSTED form-3 file of BenchInts records written by this
// build's own layout (BenchInts, §2), asserting the header and every record
// hash. It is not a read of untrusted data: BenchIntsFixedLoad is the strict
// read and BenchIntsFixedLoadTolerant the tolerant one (docs/SPEC-TABLES.md §6.5).
def BenchIntsFixedDecode(data:string) -> [BenchInts]:
    let layout = BenchIntsFixedLayoutBytes()
    assert read_uint8_le(data, 0) == 3
    assert read_uint64_le(data, 8) == BenchIntsFixedHash
    assert read_uint32_le(data, 16) == length(layout)
    let start = 20 + length(layout)
    let stride = 8 + 40
    let out:[BenchInts] = []
    var at = start
    while at < length(data):
        assert read_uint64_le(data, at) == BenchIntsFixedHash
        push(out, BenchIntsFixedGet(data, at + 8))
        at += stride
    return out

