// TableEntityReset restores v to its declared defaults in place (docs/SPEC-TABLES.md §3.4).
def TableEntityReset(v:TableEntity):
    v.EntityId = 0
    v.PosX = 0
    v.PosY = 0
    v.PosZ = 0
    v.Yaw = 0
    v.Pitch = 0
    v.VelX = 0
    v.VelY = 0
    v.VelZ = 0
    v.Health = 0
    v.Weapon = TableWeaponNone
    v.Damage = 0
    v.Moving = false
    v.Firing = false

def TableEntityFixedLeaves(out:[schema_rt.TableFixedEntry], src:int, dst:int) -> int:
    push(out, schema_rt.TableFixedEntry { src: src + 0, dst: dst + 0, size: 4, grd: schema_rt.tableFixedNoGuard, op: schema_rt.tableFixedCopy })
    push(out, schema_rt.TableFixedEntry { src: src + 4, dst: dst + 4, size: 4, grd: schema_rt.tableFixedNoGuard, op: schema_rt.tableFixedCopy })
    push(out, schema_rt.TableFixedEntry { src: src + 8, dst: dst + 8, size: 4, grd: schema_rt.tableFixedNoGuard, op: schema_rt.tableFixedCopy })
    push(out, schema_rt.TableFixedEntry { src: src + 12, dst: dst + 12, size: 4, grd: schema_rt.tableFixedNoGuard, op: schema_rt.tableFixedCopy })
    push(out, schema_rt.TableFixedEntry { src: src + 16, dst: dst + 16, size: 4, grd: schema_rt.tableFixedNoGuard, op: schema_rt.tableFixedCopy })
    push(out, schema_rt.TableFixedEntry { src: src + 20, dst: dst + 20, size: 4, grd: schema_rt.tableFixedNoGuard, op: schema_rt.tableFixedCopy })
    push(out, schema_rt.TableFixedEntry { src: src + 24, dst: dst + 24, size: 4, grd: schema_rt.tableFixedNoGuard, op: schema_rt.tableFixedCopy })
    push(out, schema_rt.TableFixedEntry { src: src + 28, dst: dst + 28, size: 4, grd: schema_rt.tableFixedNoGuard, op: schema_rt.tableFixedCopy })
    push(out, schema_rt.TableFixedEntry { src: src + 32, dst: dst + 32, size: 4, grd: schema_rt.tableFixedNoGuard, op: schema_rt.tableFixedCopy })
    push(out, schema_rt.TableFixedEntry { src: src + 36, dst: dst + 36, size: 4, grd: schema_rt.tableFixedNoGuard, op: schema_rt.tableFixedCopy })
    push(out, schema_rt.TableFixedEntry { src: src + 40, dst: dst + 40, size: 1, grd: schema_rt.tableFixedNoGuard, op: schema_rt.tableFixedCopy })
    push(out, schema_rt.TableFixedEntry { src: src + 41, dst: dst + 41, size: 8, grd: schema_rt.tableFixedNoGuard, op: schema_rt.tableFixedCopy })
    push(out, schema_rt.TableFixedEntry { src: src + 49, dst: dst + 49, size: 1, grd: schema_rt.tableFixedNoGuard, op: schema_rt.tableFixedBool })
    push(out, schema_rt.TableFixedEntry { src: src + 50, dst: dst + 50, size: 1, grd: schema_rt.tableFixedNoGuard, op: schema_rt.tableFixedBool })
    return length(out)

// TableEntityFixedScatter reads one canonical flat body image at at into v in place.
def TableEntityFixedScatter(data:string, at:int, v:TableEntity):
    v.EntityId = read_uint32_le(data, at + 0)
    v.PosX = read_int32_le(data, at + 4)
    v.PosY = read_int32_le(data, at + 8)
    v.PosZ = read_int32_le(data, at + 12)
    v.Yaw = read_uint32_le(data, at + 16)
    v.Pitch = read_uint32_le(data, at + 20)
    v.VelX = read_int32_le(data, at + 24)
    v.VelY = read_int32_le(data, at + 28)
    v.VelZ = read_int32_le(data, at + 32)
    v.Health = read_int32_le(data, at + 36)
    v.Weapon = TableWeapon(read_uint8_le(data, at + 40))
    v.Damage = read_uint64_le(data, at + 41)
    v.Moving = read_uint8_le(data, at + 49) != 0
    v.Firing = read_uint8_le(data, at + 50) != 0

def TableEntityFixedClampBody(v:TableEntity, report:schema_rt.TableReport):
    if schema_rt.ult(4095, v.EntityId):
        v.EntityId = 4095
        report.clamped += 1
    if v.PosX < -16383:
        v.PosX = -16383
        report.clamped += 1
    elif v.PosX > 16383:
        v.PosX = 16383
        report.clamped += 1
    if v.PosY < -16383:
        v.PosY = -16383
        report.clamped += 1
    elif v.PosY > 16383:
        v.PosY = 16383
        report.clamped += 1
    if v.PosZ < -16383:
        v.PosZ = -16383
        report.clamped += 1
    elif v.PosZ > 16383:
        v.PosZ = 16383
        report.clamped += 1
    if schema_rt.ult(511, v.Yaw):
        v.Yaw = 511
        report.clamped += 1
    if schema_rt.ult(511, v.Pitch):
        v.Pitch = 511
        report.clamped += 1
    if v.VelX < -2048:
        v.VelX = -2048
        report.clamped += 1
    elif v.VelX > 2047:
        v.VelX = 2047
        report.clamped += 1
    if v.VelY < -2048:
        v.VelY = -2048
        report.clamped += 1
    elif v.VelY > 2047:
        v.VelY = 2047
        report.clamped += 1
    if v.VelZ < -2048:
        v.VelZ = -2048
        report.clamped += 1
    elif v.VelZ > 2047:
        v.VelZ = 2047
        report.clamped += 1
    if v.Health < 0:
        v.Health = 0
        report.clamped += 1
    elif v.Health > 1000:
        v.Health = 1000
        report.clamped += 1
    if schema_rt.ult(15, int(v.Weapon)):
        v.Weapon = TableWeaponNone
        report.clamped += 1

def TableEntityFixedCheckBody(v:TableEntity) -> bool:
    if (schema_rt.ult(4095, v.EntityId)):
        return false
    if (v.PosX < -16383) or (v.PosX > 16383):
        return false
    if (v.PosY < -16383) or (v.PosY > 16383):
        return false
    if (v.PosZ < -16383) or (v.PosZ > 16383):
        return false
    if (schema_rt.ult(511, v.Yaw)):
        return false
    if (schema_rt.ult(511, v.Pitch)):
        return false
    if (v.VelX < -2048) or (v.VelX > 2047):
        return false
    if (v.VelY < -2048) or (v.VelY > 2047):
        return false
    if (v.VelZ < -2048) or (v.VelZ > 2047):
        return false
    if (v.Health < 0) or (v.Health > 1000):
        return false
    if schema_rt.ult(15, int(v.Weapon)):
        return false
    return true

def TableEntityFixedClamp(v:TableEntity, report:schema_rt.TableReport):
    TableEntityFixedClampBody(v, report)

