// Package [[.Lang]] is the [[.Lang]] backend.
//
// SKELETON, laid down by `schema new-leg [[.Lang]]` (docs/CONTRIBUTING.md,
// "Adding a language"). It emits one [[.Ext]] file per schema file that names
// each declaration in a comment — enough for the leg to build, to test, and to
// be discovered by every registry. The port replaces the body of Generate
// with the real emitter and holds it to the pins in testdata/wire/, which C++
// writes and every other leg byte-compares against.
package [[.Lang]]

import (
	"bytes"
	"fmt"

	"github.com/mas-bandwidth/schema/v2/ir"
)

// Ext is the extension of every file this backend emits.
const Ext = "[[.Ext]]"

// comment opens a line comment in [[.Lang]].
const comment = "[[.Comment]]"

// Generate emits the unit: one file per schema file, keyed by output file
// name. The output is deterministic to the byte (SPEC §6.1) because it walks
// u.Files and each file's Decls, both in a fixed order.
func Generate(u *ir.Unit) (map[string][]byte, error) {
	files := make(map[string][]byte, len(u.Files))
	for _, f := range u.Files {
		var b bytes.Buffer
		fmt.Fprintf(&b, "%s Code generated by schema from %s.schema (the [[.Lang]] leg skeleton). DO NOT EDIT.\n", comment, f.Base)
		fmt.Fprintf(&b, "%s package %s, protocol id 0x%016x\n", comment, u.Package, u.ProtocolId)
		for _, d := range f.Decls {
			switch d := d.(type) {
			case *ir.Const:
				fmt.Fprintf(&b, "%s const %s\n", comment, d.Name)
			case *ir.Enum:
				fmt.Fprintf(&b, "%s enum %s\n", comment, d.Name)
			case *ir.Flags:
				fmt.Fprintf(&b, "%s flags %s\n", comment, d.Name)
			case *ir.Struct:
				fmt.Fprintf(&b, "%s type %s\n", comment, d.Name)
			case *ir.Union:
				fmt.Fprintf(&b, "%s union %s\n", comment, d.Name)
			default:
				return nil, fmt.Errorf("the [[.Lang]] backend does not know declaration %T yet", d)
			}
		}
		files[f.Base+Ext] = b.Bytes()
	}
	return files, nil
}
