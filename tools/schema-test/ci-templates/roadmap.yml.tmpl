# GENERATED by `go run ./tools/schema-test ci` from test/registry/registry.jsonl
# and tools/schema-test/ci-templates/roadmap.yml.tmpl. Do not edit: `schema-test
# ci --check` regenerates this file and fails on any difference.
#
# THE ROADMAP GATE. The tables in ROADMAP.md are generated (make roadmap);
# everything outside the nova-work markers is Glenn's, written by hand. This
# job holds both through the registry row [[.Key]]: the tables
# match docs/roadmap.sexp and its evidence, every block holds only a table
# and its source link, and no commit in the pushed range by anyone but Glenn
# Fiedler changes the page outside the markers. The range check reads each
# commit of the range, so this job checks out full history; that is why the
# row runs here and not in ci-fast.yml's shallow shards (the row's tier is
# nightly, so the pr group leaves it to this job and schema-nightly.yml runs
# it too). The negative control and the renderer suites need no history:
# they are pr-group rows, run by ci-fast.yml. The page equal to the render is
# the nightly row tooling.roadmap.page-is-the-render.
name: schema roadmap gate
on:
  push:
    branches: [ main ]
    paths: [ 'ROADMAP.md', 'docs/roadmap.sexp', 'docs/roadmap-evidence/**', 'tools/roadmap/**', '.github/workflows/roadmap.yml' ]
  pull_request:
    paths: [ 'ROADMAP.md', 'docs/roadmap.sexp', 'docs/roadmap-evidence/**', 'tools/roadmap/**', '.github/workflows/roadmap.yml' ]
  workflow_dispatch:
concurrency:
  group: ${{ github.workflow }}-${{ github.event.pull_request.number || format('{0}-{1}', github.event_name, github.ref) }}
  cancel-in-progress: ${{ github.event_name == 'pull_request' }}
permissions:
  contents: read
jobs:
  roadmap:
    if: (github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == github.repository)
    runs-on: [ self-hosted, Linux, X64, fleet, schema ]
    timeout-minutes: 2
    defaults:
      run:
        shell: go run ./tools/pgroup -- bash -e -o pipefail {0}
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0
      - uses: actions/setup-go@d8cbb8045d7f43706b9177cceb36c1f91a6644d5 # v7.1.0
        if: runner.environment == 'github-hosted'
        with:
          go-version: '1.26'
          cache: false
      # the range is the pull request's (from its base) or the push's (from
      # the commit before it); a dispatch checks the last commit
      - name: the data renders, blocks hold only tables, and the hand text is Glenn's
        env:
          ROADMAP_BASE: ${{ github.event.pull_request.base.sha || github.event.before || 'HEAD~1' }}
        run: go run ./tools/schema-test run [[.Row]]
