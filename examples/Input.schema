// Input.schema — client -> server input stream
// Shape: a header of raw-bit fields, then a bounded, self-counting array of
// composed input types. The most common realtime packet shape there is.

package example

const MaxInputsPerPacket = 16

type Input {
    stick_x  float32
    stick_y  float32
    throttle float32
    yaw      float32
    pitch    float32

    fire     bool
    alt_fire bool
    boost    bool
    brake    bool
    aim      bool
    lock_on  bool
    zoom     bool
    ping     bool
}

type InputPacket {
    synchronize_sequence bits(16)
    current_frame        bits(64)
    start_frame          bits(64)

    // wire: count in [0, MaxInputsPerPacket], then that many Input elements
    inputs Input[<= MaxInputsPerPacket]
}
