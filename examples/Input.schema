// Input.schema — client -> server input stream
// Shape: a header of raw-bit fields, then a bounded, self-counting array of
// composed input structs. The most common realtime packet shape there is.

package example

const MaxInputsPerPacket = 16

struct Input {
    stickX   float
    stickY   float
    throttle float
    yaw      float
    pitch    float

    fire     bool
    altFire  bool
    boost    bool
    brake    bool
    aim      bool
    lockOn   bool
    zoom     bool
    ping     bool
}

struct InputPacket {
    synchronizeSequence bits(16)
    currentFrame        bits(64)
    startFrame          bits(64)

    // wire: count in [0, MaxInputsPerPacket], then that many Input structs
    inputs Input[<= MaxInputsPerPacket]
}
