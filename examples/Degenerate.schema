// Degenerate.schema — the minimal shapes.
//
// Real protocols rarely declare a type that is one array and nothing else,
// or a struct whose only field is another struct, but small projects do, and
// a code generator has to get them right. Each type here is one such shape,
// stripped to the bone: a fixed array as the whole message, a unit of plain
// float pairs, and nested structs as the first, the only, or a far-offset
// field.
//
// Every type here is a whole number of bytes wide, and none needs a target's
// float-bits helpers. Keep both properties if you add a type: the reasons
// are in internal/goldens/regressions_test.go.

package example

// ---- a bare float unit --------------------------------------------------

// Two floats and nothing else: the Vec2/Vec3/Quat shape a project declares
// before it declares anything else.
type Vec2
{
    x float64
    y float64
}

// ---- fixed scalar arrays ------------------------------------------------

// A fixed scalar array as the whole message.
type SpanF64
{
    values [2]float64
}

// The same arrangement over the integer storages.
type SpanU64
{
    values [2]uint64
}

type SpanI64
{
    values [2]int64
}

// [1]T: a one-element fixed array.
type SpanOne
{
    values [1]uint64
}

// [N]T exactly 64 bits wide.
type SpanChunk
{
    values [4]uint16
}

// An array with a trailing field.
type SpanTail
{
    values [2]float64
    tail   uint32
}

// Two such arrays back to back.
type SpanTwice
{
    a [2]float64
    b [2]float64
}

// ---- nested structs at the edges ----------------------------------------

// A narrow struct: three raw-bit fields that sum to one 64-bit word.
type Trio
{
    a bits(20)
    b bits(20)
    c bits(24)
}

// A nested struct as the ONLY field.
type TrioSole
{
    inner Trio
}

// A struct from ANOTHER file as the only field: Types.schema's Vec3. Because
// it is used outside its declaring file, its cpp_native mapping applies here
// (SPEC §4.2, Native type mapping): generated C++ for this file includes
// vec_math.h and stores the field as ::VecMath.
type Vec3Sole
{
    v Vec3
}

// A nested struct as the FIRST field.
type TrioFirst
{
    inner   Trio
    trailer bits(16)
}

// A nested struct after 344 bits of other fields.
type TrioStraddle
{
    pad0  bits(64)
    pad1  bits(64)
    pad2  bits(64)
    pad3  bits(64)
    pad4  bits(64)
    pad5  bits(24)
    inner Trio
}
