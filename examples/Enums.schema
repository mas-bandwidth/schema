// Enums.schema — the enum family: both declaration forms (SPEC §4.2).
// Canonical form only — 0 = None implicit, variants dense from 1, never sparse,
// never explicit values. Variants are comma-separated (trailing comma allowed).
//
//   enum   with-None: None = 0 rides the wire, range [0, Max]
//   flags  one bit per variant from bit 0, up to 64; storage uint64 in every
//          target; wire = variant-count raw bits; no implicit None (the empty
//          mask is 0 and needs no name)
//
// Aspect-oriented layout (SPEC §2): one aspect per file.

package example

enum Team { Red, Blue }

enum ShipType { Fighter, Corvette, Bomber, Destroyer, Carrier }
enum MissileType { Heatseeker, Torpedo, Nuke }
enum PropType { Asteroid, Chunk, Fragment, Sphere, BlackHole, DysonPanel }

// An enum with NO variants: it holds only the implicit None = 0, so its wire
// range is the degenerate [0, 0] and it costs ZERO BITS. Useful for a kind
// that is declared before its variants are known — the schema compiles, the
// field round-trips as None, and nothing is spent on the wire until the first
// variant arrives.
enum Pending { }

// flags — named bits over a uint64, consumed as masks
flags ShipFlags { FiringLaser, Boosting, Braking, Aiming }
