// Render.schema — parallel scatter/gather. Generated types are trivially
// copyable and standard-layout, so N workers can build instances
// INDEPENDENTLY — into their own memory, or directly into disjoint sections
// of one shared blob — and the gather is concatenation or offset arithmetic,
// never a serial builder. Use this shape when many threads produce one
// buffer, such as per-worker render lists.
//
// Field order is largest-alignment-first: the natural C++ layout then has
// zero interior padding, and packed sequential mirrors in other languages
// match byte-for-byte.

package example

const RenderBlockMaxSprites = 64

type RenderSprite
{
    sort_key    uint64
    mesh_id     uint32
    material_id uint32
    layer       uint8
    team        Team
}

type RenderBlock
{
    worker_index      uint32
    sprite_count_hint uint32
    sprites           [..RenderBlockMaxSprites]RenderSprite
}
