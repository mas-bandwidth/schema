// Objects.schema — all object definitions for the unit.
// Aspect-oriented layout (SPEC §2): one aspect per file.
//
// THE WORKED EXAMPLE: one definition drives the generated family. From each
// object the compiler generates, per target:
//   ObjectType            (None = 0, then each object, deterministic order)
//   ShipState             (every field — the simulation struct)
//   ShipData_Deep         + serialize (every non-local field; deep = full state,
//                           sent to the client for client-side prediction)
//   ShipData_Shallow      + serialize (the [interpolate] fields, quantized —
//                           the wire-side implementation detail of interpolation)
//   ShipData_Interpolate  (the [interpolate] fields in continuous storage)
//   Quantize / Unquantize (the Interpolate <-> Shallow mapping pair)
//
// Field inventory is faithful to the real Ship.h (2026-08-05). View-encoding
// attribute syntax is PROPOSED (SPEC §4.8) — the deep/shallow semantics and the
// generated artifact list are DECIDED. Missile, DynamicProp and Turret follow
// once the Ship shape is approved.
//
// NOTE before this repo ever goes public: this file mirrors the real Space Game
// ship — review with Glenn first.

package example

object Ship {
    // ---- visual state, [interpolated]: sent for client interpolation, rides
    // the quantized shallow wire (an implementation detail) into Interpolate ----

    ship_type ShipType [interpolate]

    position        Vec3 [interpolate, quantize = UnitsPerMeter, max = MaxWorldMeters]
    rotation        Quat [interpolate, quantize = RotationUnits]
    linear_velocity Vec3 [interpolate, quantize = UnitsPerMeter, max = MaxSpeedMeters]

    flags uint64 [interpolate]
    team  Team   [interpolate]

    // float in deep, ranged-int projection on the shallow wire — the real
    // health/thrust pattern in ShipData_Shallow.
    health float32 [interpolate, min = 0, max = MaxHealth]
    thrust float32 [interpolate, min = 0, max = 100]

    // ---- full state: deep only (the default — no marker) ----

    angular_velocity Vec3

    laser_cooldown   float32
    missile_cooldown float32

    speed_current  float32
    speed_velocity float32

    stick_current  Vec3
    stick_velocity Vec3

    sensitivity_current  float32
    sensitivity_velocity float32

    roll_current  float32
    roll_velocity float32

    aim_current  float32
    aim_velocity float32

    laser_index   int8 [min = 0, max = ShipMaxLasers - 1]
    missile_index int8 [min = 0, max = ShipMaxMissiles - 1]

    target          Handle
    lock_start_time float64

    // ---- simulation-only: no wire at all ----

    invulnerable bool [local]
}
