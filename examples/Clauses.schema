// Clauses.schema — arrays and nested structs whose elements are not a whole
// number of bytes wide.
//
// Elements of 1, 13, 17, 26, 50 and 52 bits pack back to back with no
// padding, so most element boundaries fall mid-byte. Counted arrays carry
// their count in the fewest bits for [0, N] (SPEC §4.3). The arrangements
// behind each width are in internal/goldens/regressions_test.go.

package example

// 13-bit elements.
type W13
{
    items [..12]uint16 | min = 0, max = 8191
}

// 17-bit elements.
type W17
{
    items [..9]uint32 | min = 0, max = 131071
}

// 26-bit elements.
type W26
{
    items [..6]uint32 | min = 0, max = 67108863
}

// 1-bit elements: the narrowest a ranged element can be.
type W1
{
    items [..20]uint8 | min = 0, max = 1
}

// 52-bit and 50-bit elements: wide values stored in uint64.
type W52
{
    items [..3]uint64 | min = 0, max = 4503599627370495
}

type W50
{
    items [..3]uint64 | min = 0, max = 1125899906842623
}

// a FIXED array of 13-bit elements: no count bits, just seven elements.
type F13
{
    items [7]uint16 | min = 0, max = 8191
}

// ---- arrays of nested structs -------------------------------------------

// a 3-bit struct, packed ten to an array with no padding between elements.
type Tri3
{
    a bits(1)
    b bits(2)
}

type ArrTri3
{
    items [..10]Tri3
}

// an 11-bit struct, in a fixed array of nine.
type Eleven
{
    a bits(3)
    b bits(8)
}

type ArrEleven
{
    items [9]Eleven
}

// ---- the empty and the maximal ------------------------------------------

// a union whose arms are EMPTY types: the tag is the whole payload.
type EmptyA
{
}

type EmptyB
{
}

union EmptyUnion
{
    a EmptyA
    b EmptyB
}

type HoldsEmptyUnion
{
    lead bits(5)
    u    EmptyUnion
    tail bits(7)
}

// a string and a bytes field after a 5-bit lead: each aligns to the next
// byte before its payload (SPEC §4.7), so the padding here is real.
type Strs
{
    lead bits(5)
    s    string(8)
    b    bytes(8)
    tail bits(3)
}

// a counted array of nested structs between two odd-width fields.
type ArrNested
{
    lead  bits(5)
    items [..4]Eleven
    tail  bits(3)
}

// a single field and nothing else.
type Sole
{
    only bits(13)
}
