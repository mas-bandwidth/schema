// ObjectCreate.schema — object creation state
// Shape: the create-path pattern — quantized-integer vectors (the real float
// idiom: pre-quantize at a fixed scale, send ranged ints), constants composing
// into ranges, a bool-gated optional field, enums for kind and team.

package example

const UnitsPerMeter    = 1024
const MaxWorldMeters   = 8192
const MaxPositionUnits = MaxWorldMeters * UnitsPerMeter

const MaxSpeedMeters   = 2048
const MaxVelocityUnits = MaxSpeedMeters * UnitsPerMeter

const RotationUnits    = 1024

const MaxHealth = 1000

enum Team      { None Red Blue }
enum CraftKind { None Light Medium Heavy }

// A world position, quantized to 1/1024 meter.
type QuantizedPosition {
    x int32(-MaxPositionUnits, MaxPositionUnits)
    y int32(-MaxPositionUnits, MaxPositionUnits)
    z int32(-MaxPositionUnits, MaxPositionUnits)
}

// A velocity, quantized at the same scale with its own bound.
type QuantizedVelocity {
    x int32(-MaxVelocityUnits, MaxVelocityUnits)
    y int32(-MaxVelocityUnits, MaxVelocityUnits)
    z int32(-MaxVelocityUnits, MaxVelocityUnits)
}

// A unit quaternion, components quantized to [-1024, 1024].
type QuantizedRotation {
    x int16(-RotationUnits, RotationUnits)
    y int16(-RotationUnits, RotationUnits)
    z int16(-RotationUnits, RotationUnits)
    w int16(-RotationUnits, RotationUnits)
}

type CraftCreate {
    // Finding 1 in examples/README.md: the hand-written equivalent encodes
    // kind as [1, max] — None excluded from the wire. schema's enum wire is
    // [0, max], spending one unused value. Ranged enums are an open question.
    kind CraftKind

    position        QuantizedPosition
    rotation        QuantizedRotation
    linear_velocity QuantizedVelocity

    has_flags bool
    if has_flags {
        flags bits(64)
    }

    team   Team
    health int16(0, MaxHealth)
    thrust int8(0, 100)
}

// The explicit-switch pattern — for dispatch that is NOT a message set
// (object records inside a snapshot packet, the baseline/delta shape).
enum RecordKind { None Craft Debris }

type ObjectRecord {
    object_id   int32(0, 9999)
    record_kind RecordKind
    switch record_kind {
    case Craft:  craft CraftCreate
    case Debris: debris_seed uint32
    }
}
