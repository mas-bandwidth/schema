// Selecting a union arm constructs a fresh payload with its declared
// defaults, including the unused elements of a counted array.
package example

type DefaultArm
{
    entries [..2]ProbeConfig
    marker  uint8            | min = 0, max = 7
}

union DefaultChoice
{
    first  DefaultArm
    second DefaultArm
}

// A union held as a struct field: the same union wire, inside a struct.
type DefaultChoicePacket
{
    choice DefaultChoice
}

// The same arms with a bytes field beside the defaulted payload.
type DefaultBulkArm
{
    payload DefaultArm
    data    bytes(2)
}

union DefaultBulkChoice
{
    first  DefaultBulkArm
    second DefaultBulkArm
}
