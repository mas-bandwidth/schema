// Types.schema — the plain types of the example protocol.
// One aspect per file (SPEC §2): every `type` lives here, and the other files
// refer to them by name. The language predefines no composite types
// (SPEC §4.2), so the vectors and quaternions below are declared like any
// other type, sized to what this protocol needs.

package example

// A continuous vector with float64 components.
// cpp_native/cpp_include (SPEC §4.2, Native type mapping) let generated C++
// store Vec3 as your own math type, VecMath, which derives from the
// generated struct and adds operators without changing its layout. Headers
// generated from other files include vec_math.h and store VecMath (see
// Vec3Sole in Degenerate.schema); this file's own header keeps the generated
// struct, because VecMath derives from it. Other targets ignore the pair.
type Vec3 | cpp_native = VecMath, cpp_include = "vec_math.h"
{
    x float64
    y float64
    z float64
}

// Unit rotation quaternion — always unit length (rotations are). A plain
// 4-float type; the rotation actions (renormalize, shortest-arc) are the
// application's own, hand-written beside it.
type Quat
{
    x float64
    y float64
    z float64
    w float64
}

// A handle to another object: id + generation sequence.
// object_id 0 doubles as the null handle.
type Handle
{
    object_id       int32 | min = 0, max = MaxObjects - 1
    object_sequence uint8
}

// Hand-quantized vectors and rotation — the quantization idiom ShipCreate
// uses below: scaled integers with declared bounds, tuned per domain.
type QuantizedPosition
{
    x int32 | min = -MaxPositionUnits, max = MaxPositionUnits
    y int32 | min = -MaxPositionUnits, max = MaxPositionUnits
    z int32 | min = -MaxPositionUnits, max = MaxPositionUnits
}

type QuantizedVelocity
{
    x int32 | min = -MaxVelocityUnits, max = MaxVelocityUnits
    y int32 | min = -MaxVelocityUnits, max = MaxVelocityUnits
    z int32 | min = -MaxVelocityUnits, max = MaxVelocityUnits
}

type QuantizedRotation
{
    x int16 | min = -RotationUnits, max = RotationUnits
    y int16 | min = -RotationUnits, max = RotationUnits
    z int16 | min = -RotationUnits, max = RotationUnits
    w int16 | min = -RotationUnits, max = RotationUnits
}

// ---- a branch on an earlier field (SPEC §4.4, §4.5, §5) ----

// A rigid body whose velocities ride the wire only while it is moving. The
// `if` reads `at_rest`, a field already written above it, so the branch
// costs no wire bits beyond that bool (SPEC §4.5). When the body is at rest
// the velocity fields are not sent, and a read sets both to zero (SPEC §5),
// so a receiver never sees stale velocities on a resting body.
type RigidBody
{
    position    Vec3
    orientation Quat
    at_rest     bool
    if !at_rest
    {
        linear_velocity  Vec3
        angular_velocity Vec3
    }
}

// ---- input ----

type Input
{
    stick_x  float32
    stick_y  float32
    throttle float32
    yaw      float32
    pitch    float32

    fire     bool
    alt_fire bool
    boost    bool
    brake    bool
    aim      bool
    lock_on  bool
    zoom     bool
    ping     bool
}

type InputPacket
{
    synchronize_sequence uint16
    current_frame        uint64
    start_frame          uint64

    // wire: count in [0, MaxInputsPerPacket], then that many Input elements
    inputs [..MaxInputsPerPacket]Input
}

// ---- the create idiom ----

type ShipCreate
{
    // ship_type is a plain enum: its wire range is [0, ShipType.Max], and
    // None (0) is a legal value on the wire even though a create always
    // names a real ship type.
    ship_type ShipType

    position        QuantizedPosition
    rotation        QuantizedRotation
    linear_velocity QuantizedVelocity

    // the flags gate idiom: one bool saves the flag bits in the common all-zero case
    has_flags bool
    if has_flags
    {
        flags ShipFlags
    }

    team   Team
    health int16 | min = 0, max = MaxHealth
    thrust int8  | min = 0, max = 100

    // an empty enum: its wire range is [0, 0], so the field costs zero bits
    // until the enum gains its first variant.
    pending Pending
}

// ---- bounds written as expressions ----

// Bounds may be any constant expression, including parenthesized
// subexpressions and a doubled unary minus. Generated code writes these
// bounds as source text in each target language, keeping your parentheses
// and adding any a target needs (`--` is a decrement in C, not two minuses).
type ExpressionProbe
{
    hardpoint_index int32                 | min = 0, max = (ShipMaxLasers + ShipMaxMissiles) - 1
    spin_rate       int32 = RotationUnits | min = --RotationUnits, max = RotationUnits * 2
}

// ---- the 64-bit integer extremes ----

// The full int64 and uint64 ranges are usable everywhere a value is: as
// constants, as bounds and as defaults. INT64_MIN and UINT64_MAX are the two
// values a C-family compiler cannot read as a plain decimal literal, so
// generated code spells them safely in every target. doubled_floor folds to
// INT64_MIN through an intermediate that does not fit in 64 bits; the
// compiler evaluates constant expressions in arbitrary precision, so that
// is fine too.

const FloorLimit          = -9223372036854775808
const CeilingCount uint64 = 18446744073709551615

type ExtremeProbe
{
    floor_bound     int64                         | min = -9223372036854775808, max = 100
    doubled_floor   int64                         | min = --FloorLimit, max = 100
    ceiling_range   uint64 = 1                    | min = 1, max = 18446744073709551615
    floor_default   int64 = -9223372036854775808
    ceiling_default uint64 = 18446744073709551615
}

type ExtremeRow
{
    clamped_floor   int64                         | min = -9223372036854775808, max = 100
    clamped_ceiling uint64 = 1                    | min = 1, max = 18446744073709551614
    floor_def       int64 = -9223372036854775808
    ceiling_def     uint64 = 18446744073709551615
}
