// Types.schema — all plain types for the unit.
// Aspect-oriented layout (SPEC §2): one aspect per file.
// The language pre-defines NO composite types (SPEC §4.2, Type tags): these are
// ours, minimal for this protocol's needs. The [vec3]/[quat4] tags are inert in
// v1 — user-chosen labels the delta pass later CLAIMS to assign actions
// (interpolation, prediction, normalization). Types on one side; a layer that
// defines the needed actions for those types on the other.

package example

// Continuous vector — float64 components, the deep wire.
// cpp_native/cpp_include (SPEC §4.2, Native type mapping): generated C++
// declares Vec3 storage as ::VecMath — a hand math type deriving from the
// generated basis struct (same layout, plus operators) — and every header
// referencing it includes the mapped header. Other targets ignore the pair.
type Vec3 [vec3, cpp_native = VecMath, cpp_include = "vec_math.h"] {
    x float64
    y float64
    z float64
}

// Unit rotation quaternion — always unit length (rotations are). The tag is
// what the delta pass will claim for renormalize + shortest-arc actions; in v1
// this is a plain 4-float type and the hand-written rotation actions remain.
type Quat [quat4] {
    x float64
    y float64
    z float64
    w float64
}

// A handle to another object: id + generation sequence.
// object_id 0 doubles as the null sentinel (the surveyed NULL_OBJECT convention).
type Handle {
    object_id       int32 [min = 0, max = MaxObjects - 1]
    object_sequence uint8
}

// Hand-quantized vectors and rotation — the pre-object-views idiom ShipCreate uses below.
// (Object views express the same thing with [interpolate, quantize = ...]; both
// belong in the corpus while both idioms exist in real code.)
type QuantizedPosition {
    x int32 [min = -MaxPositionUnits, max = MaxPositionUnits]
    y int32 [min = -MaxPositionUnits, max = MaxPositionUnits]
    z int32 [min = -MaxPositionUnits, max = MaxPositionUnits]
}

type QuantizedVelocity {
    x int32 [min = -MaxVelocityUnits, max = MaxVelocityUnits]
    y int32 [min = -MaxVelocityUnits, max = MaxVelocityUnits]
    z int32 [min = -MaxVelocityUnits, max = MaxVelocityUnits]
}

type QuantizedRotation {
    x int16 [min = -RotationUnits, max = RotationUnits]
    y int16 [min = -RotationUnits, max = RotationUnits]
    z int16 [min = -RotationUnits, max = RotationUnits]
    w int16 [min = -RotationUnits, max = RotationUnits]
}

// ---- the back-reference worked example (SPEC §4.4, §4.5, §5) ----

// The serialize README's own RigidBody example, schema-specified — field for
// field, the generated serialize function IS that hand-written one. The group
// of velocity fields rides the wire only when !at_rest; when the at-rest side
// is taken, the hand-written version zeroes both velocities under
// `else if ( Stream::IsReading )` — here that is SPEC §5's
// zero-on-untaken-branch rule, the language's contract rather than a
// convention the caller remembers. The branch costs no wire bits beyond the
// bool already paid for (back-referencing, SPEC §4.5).
table RigidBody {
    position    Vec3
    orientation Quat
    at_rest     bool
    if !at_rest {
        linear_velocity  Vec3
        angular_velocity Vec3
    }
}

// ---- input ----

type Input {
    stick_x  float32
    stick_y  float32
    throttle float32
    yaw      float32
    pitch    float32

    fire     bool
    alt_fire bool
    boost    bool
    brake    bool
    aim      bool
    lock_on  bool
    zoom     bool
    ping     bool
}

type InputPacket {
    synchronize_sequence uint16
    current_frame        uint64
    start_frame          uint64

    // wire: count in [0, MaxInputsPerPacket], then that many Input elements
    inputs [<= MaxInputsPerPacket]Input
}

// ---- the create idiom (pre-object-views) ----

type ShipCreate {
    // ship_type is a plain enum: wire [0, ShipType.Max], None wire-legal. The
    // hand-written create path writes [1, MAX] — that index form (enum_index)
    // was designed and cut for now (SPEC §9 q11); one unused wire value is the
    // recorded v1 cost.
    ship_type ShipType

    position        QuantizedPosition
    rotation        QuantizedRotation
    linear_velocity QuantizedVelocity

    // the flags gate idiom: one bool saves the flag bits in the common all-zero case
    has_flags bool
    if has_flags {
        flags ShipFlags
    }

    team   Team
    health int16 [min = 0, max = MaxHealth]
    thrust int8  [min = 0, max = 100]

    // an empty enum: the degenerate [0, 0] wire range, ZERO BITS. It rides
    // here to keep the no-variant path in the cross-language corpus rather
    // than only in a unit test.
    pending Pending
}

// ---- the #22 parenthesization class, pinned end-to-end (issue #91) ----

// The two source spellings whose rendering regressions no golden caught
// before this type existed: an author-parenthesized bound, and a doubled
// unary minus (issue #22's class — "--" is a decrement in the C family and a
// parse error in Go and Rust, so the target form must parenthesize). Every
// symbolic backend renders these bounds as source text, so the golden trees
// themselves refuse a paren regression: dropping the author's parens or the
// doubled-minus parenthesization changes no wire bit and no folded value —
// only these goldens go red.
type ExpressionProbe {
    hardpoint_index int32 [min = 0, max = (ShipMaxLasers + ShipMaxMissiles) - 1]
    spin_rate       int32 [min = --RotationUnits, max = RotationUnits * 2]
}

// ---- issue #95: the integer extremes, pinned end-to-end ----

// The two values with no direct decimal spelling in the C family:
// INT64_MIN's literal half overflows long long before the unary minus
// applies, and a value past INT64_MAX has no signed rung of the decimal
// ladder to land on. Every fold of these must reach the compiler in a
// guarded spelling — ( -9223372036854775807LL - 1 ), the ULL suffix — so
// this type keeps them in every -Werror leg, bounds and constants and
// defaults and table clamps alike. The doubled-minus-AT-the-extreme
// interaction — an intermediate -(-9223372036854775808) that overflows the
// 64-bit carrier though the final value fits — rides here as doubled_floor:
// every symbolic backend must fold it (C and C# through carrierEval, Rust
// through renderArg's i64 gate) or evaluate it in arbitrary precision (Go's
// untyped constants, JS's BigInt), because a symbolic -(-FLOOR_LIMIT) is a
// compile error wherever the carrier is 64-bit.

const FloorLimit          = -9223372036854775808
const CeilingCount uint64 = 18446744073709551615

type ExtremeProbe {
    floor_bound     int64  [min = -9223372036854775808, max = 100]
    doubled_floor   int64  [min = --FloorLimit, max = 100]
    ceiling_range   uint64 [min = 1, max = 18446744073709551615]
    floor_default   int64  = -9223372036854775808
    ceiling_default uint64 = 18446744073709551615
}

table ExtremeRow {
    clamped_floor   int64  [min = -9223372036854775808, max = 100]
    clamped_ceiling uint64 [min = 1, max = 18446744073709551614]
    floor_def       int64  = -9223372036854775808
    ceiling_def     uint64 = 18446744073709551615
}
