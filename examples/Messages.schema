// Messages.schema — the reliable message set
// Shape: one enum-dispatched message union. The kind field is serialized once,
// the switch back-references it for free, and each case carries its own fields.
// An empty case is a legal, zero-bit message body.

package example

const MaxBlockSize = 2000

enum MessageKind { Heartbeat Test Block Synchronize Timescale }

type Message {
    kind MessageKind

    switch kind {
    case Heartbeat:
        // empty body — presence of the message is the payload

    case Test:
        test_a bits(16)
        test_b int(0, 1000)
        test_c int(0, 1000)
        test_d int(0, 1000)

    case Block:
        // wire: length in [0, MaxBlockSize], align, then the bytes
        block_data bytes(<= MaxBlockSize)

    case Synchronize:
        sync_frame    bits(64)
        sync_sequence bits(16)

    case Timescale:
        timescale double
        frame_a   bits(32)
        frame_b   bits(32)
    }
}
