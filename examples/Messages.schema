// Messages.schema — the reliable message set
// Each message is its own declaration. The compiler extracts the set into a
// symbol table and generates the rest (SPEC §4.8): the MessageType enum —
// None = 0, then each message SORTED BY NAME (so here: Block = 1, Chat = 2,
// Heartbeat = 3, Synchronize = 4, Test = 5, Timescale = 6 — independent of file
// layout and cut & paste) — the wire tag in minimal bits, and
// WriteMessage/ReadMessage dispatch in each language's own idiom. No
// hand-written enum, no switch.

package example

// MaxBlockSize lives in Constants.schema (the aspect home) and resolves
// cross-file, order-free (SPEC §4.2). A duplicate declaration here was a real
// §4.6 compile error — caught 2026-08-05 by the corpus standing check.

message Heartbeat {
    // empty body — presence of the message is the payload
}

message Test {
    test_a uint16
    test_b int16 [min = 0, max = 1000]
    test_c int16 [min = 0, max = 1000]
    test_d int16 [min = 0, max = 1000]
}

message Block {
    // wire: length in [0, MaxBlockSize], align, then the used bytes — same
    // shape as string(N); pre-allocated fixed buffer + used length (SPEC §4.7)
    block_data bytes(MaxBlockSize)
}

message Chat {
    // wire: length in [0, MaxChatLength], align, then the used bytes —
    // byte strings, no UTF-8 rule, interior 0x00 rejected; N is the max
    // length, and the bound exists to size the length prefix's bits (SPEC §4.7)
    text string(MaxChatLength)
}

message Synchronize {
    sync_frame    uint64
    sync_sequence uint16
}

message Timescale {
    timescale float64
    frame_a   uint32
    frame_b   uint32
}
