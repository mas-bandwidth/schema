// Joins.schema — branches, unions and arrays whose paths differ in width.
//
// After an `if`, a union or a counted array, the bit offset of the next
// field depends on which path the data took. These types put a field after
// each such point, with paths of equal and unequal width, so every
// arrangement of "same offset" and "different offset" is on the wire. The
// code-generator details each one covers are in
// internal/goldens/regressions_test.go.

package example

// two arms of the SAME width: tail lands at the same offset on either path.
type ArmsAgree
{
    lead bits(5)
    flag bool
    if flag
    {
        a bits(11)
    }
    else
    {
        b bits(11)
    }
    tail bits(7)
}

// two arms of DIFFERENT widths: tail's offset depends on the path.
type ArmsDisagree
{
    lead bits(5)
    flag bool
    if flag
    {
        a bits(11)
    }
    else
    {
        b bits(3)
    }
    tail bits(7)
}

// a branch with NO else arm -- one path writes nothing at all.
type ArmEmpty
{
    lead bits(5)
    flag bool
    if flag
    {
        a bits(19)
    }
    tail bits(7)
}

// nested branches, the inner one with arms of different widths.
type ArmsNested
{
    lead  bits(3)
    outer bool
    if outer
    {
        inner bool
        if inner
        {
            x bits(29)
        }
        else
        {
            y bits(5)
        }
    }
    else
    {
        z bits(13)
    }
    tail bits(6)
}

// a string in one arm: it aligns to a byte boundary, the other arm does not.
type ArmAlign
{
    lead bits(5)
    flag bool
    if flag
    {
        s string(4)
    }
    else
    {
        b bits(10)
    }
    tail bits(7)
}

// a counted array in one arm: its width depends on the count, the other
// arm's does not.
type ArmArray
{
    lead bits(5)
    flag bool
    if flag
    {
        items [..3]uint16 | min = 0, max = 8191
    }
    else
    {
        b bits(9)
    }
    tail bits(7)
}

// ---- unions of UNEQUAL arms ---------------------------------------------

type Narrow
{
    n bits(3)
}

type Wide
{
    w bits(37)
}

union Uneven
{
    narrow Narrow
    wide   Wide
}

// the union sits at a mid-byte offset, and a field follows it.
type HoldsUneven
{
    lead bits(5)
    u    Uneven
    tail bits(11)
}

// a counted array OF unions -- each element may take either arm.
type ArrUneven
{
    lead  bits(5)
    items [..3]Uneven
    tail  bits(3)
}

// a counted array, then a string that aligns to the next byte, then a long
// run of fixed-width fields.
type RegainAfterAlign
{
    lead  bits(5)
    items [..3]uint16 | min = 0, max = 8191
    s     string(4)
    p     bits(32)
    q     bits(29)
    r     bits(19)
    tail  bits(4)
}
