// Wire.schema — the wire constructs the other files don't need: typed
// constants, enum and flags headroom, storage-less wire items, every `bits`
// width class, compressed floats, defaults, unions, empty types and
// fixed-capacity strings. Each type is a small, realistic shape that uses
// one or two of them.

package example

// typed constants pin their exported type in every target (SPEC §4.2);
// a bare const with a float literal infers float64 — Go's rule: a decimal
// point or exponent in the literal makes it float
const ProbeId uint64   = 0xDEADBEEFCAFE
const HalfTurn float64 = 180.0
const TickRate float32 = 60.0
const SpinRate         = 1.5

// enum headroom: the wire range is [0, 15] whatever the variant count, and
// non-variant values are wire-legal (SPEC §4.2, §6.1)
enum Weapon | max = 15
{ Laser, Missile, Railgun }

// flags widening: 8 wire bits with three named so far (SPEC §4.2)
flags ProbeFlags | max = 8
{ Armed, Cloaked, Damaged }

// the storage-less wire constructs (SPEC §4.3): a magic byte the read
// REJECTS if wrong, reserved bits held at zero, and an alignment point
type ProbeHeader
{
    const(0xAB, 8)
    version     bits(3)
    reserved(5)
    align
    probe_id uint64
}

// raw bits at 9, 33 and 64 bits wide, and full-range uint32 and uint64
// fields, whose bounds span the whole storage type
type ProbeBits
{
    small    bits(9)
    boundary bits(33)
    wide     bits(64)
    sensor   uint32   | min = 0, max = 4294967295
    nonce    uint64   | min = 0, max = 18446744073709551615
}

// a compressed float (SPEC §4.3: min, max and resolution quantize it to the
// fewest bits that hold the range at that step), a specified default,
// if/else with a nested branch, bare int32/int64, and a range-counted array
// whose count can never be zero
type ProbeSample
{
    active      bool = true
    orientation float32     | min = -HalfTurn, max = HalfTurn, resolution = 0.01
    raw_delta   int32
    big_delta   int64
    if active
    {
        weapon     Weapon
        has_target bool
        if has_target
        {
            target_id uint16
        }
    }
    else
    {
        idle_ticks uint32
    }
    samples [1..8]uint16
}

// first-class one-of (SPEC §4.8): the tag rides in minimal bits for
// [0, variant count], then the selected arm only; None = 0 is the in-band
// empty union and a read rejects a tag above the count
type ProbeRing
{
    radius uint16
}

type ProbeSlab
{
    width  uint8 | min = 0, max = 100
    height uint8
}

union ProbeShape
{
    ring ProbeRing
    slab ProbeSlab
}

// a union as a field, an empty (None) union field, and a counted array of
// unions — every composition form the language admits
type ProbeCollider
{
    armor  uint8
    shape  ProbeShape
    backup ProbeShape
    extras [..2]ProbeShape
}

// specified defaults past bool (SPEC §4.2): a negative integer and an enum
// variant — zero init everywhere else
type ProbeConfig
{
    retries   int32 = -1
    preferred Weapon = Railgun
}

// defaults apply through composition: constructing a ProbeArray gives both
// array elements and the nested config their declared defaults, not zeros
type ProbeArray
{
    samples [2]ProbeSample
    config  ProbeConfig
}

// an empty body — presence is the payload, and it costs zero wire bits
type Heartbeat
{
}

// a nested report shape: composition through a named type, and the widened
// flags wire riding beside it
type Test
{
    test_a uint16
    test_b int16  | min = 0, max = 1000
    test_c int16  | min = 0, max = 1000
    test_d int16  | min = 0, max = 1000
}

// wire: length in [0, MaxBlockSize], align, then the used bytes — the
// bytes(N) form: pre-allocated fixed buffer + used length (SPEC §4.7)
type Block
{
    data bytes(MaxBlockSize)
}

// wire: length in [0, MaxChatLength], align, then the used bytes —
// well-formed UTF-8 by contract (writer-trusted, debug-asserted), interior
// 0x00 rejected on read; N is the max length behind a symbolic bound, and
// the bound sizes the length prefix's bits (SPEC §4.7)
type Chat
{
    text string(MaxChatLength)
}

type ProbeReport
{
    header ProbeHeader
    flags  ProbeFlags
    echo   Test
}

// A broad test object: ranged integers, raw bits, a bool, a counted array,
// plain and compressed floats, every integer width, a 17-byte block after an
// explicit align, and a string. If you are porting a hand-written serialize
// function, this shows the schema spelling of most of what it does.
type TestData
{
    a int32 | min = -100, max = 100
    b int32 | min = -100, max = 100
    c int32 | min = -100, max = 150

    d bits(8)
    e bits(8)
    f bits(8)

    g bool

    items [..16]int32 | min = 0, max = 255

    float_value            float32
    compressed_float_value float32 | min = 0, max = 10, resolution = 0.01
    double_value           float64

    int8_value  int8
    int16_value int16

    uint8_value  uint8
    uint16_value uint16
    uint32_value uint32
    uint64_value uint64

    int64_full  int64
    int64_range int64 | min = -1000000000000, max = 1000000000000

    align
    fixed_bytes [17]uint8

    text string(255)
}

// Compressed floats over a range starting at zero and over one with a
// negative minimum. Quantization is strict IEEE-754 float32 arithmetic with
// no fused multiply-add (SPEC §4.3, §7.2), so every target maps a given value
// to the same integer on the wire.
type CompressedProbe
{
    boundary float32 | min = 0, max = 10, resolution = 0.01
    offset   float32 | min = -5, max = 5, resolution = 0.001
}
