#!/usr/bin/env bash
# pre-push: in an agent clone, refuse a push that carries a commit whose author
# or committer is not rowan-claude. Wired in by 'make setup' (git config
# core.hooksPath .githooks); 'make deps' runs it.
#
# An agent clone is one whose 'git config user.email' is the rowan-claude noreply
# address. In every other clone this hook does nothing, so maintainers and outside
# contributors are unaffected; the CAA check on GitHub still covers them.
#
# Checked range, per pushed ref: the commits reachable from the local sha that no
# remote-tracking ref of the pushed remote has (git rev-list <sha> --not
# --remotes=<remote>). That covers a new branch, and a merge from main does not
# drag main's own GitHub-committed commits into the check. A deleted ref is skipped.
# Never push with --no-verify: if this hook refuses wrongly, fix the hook.
set -u
login=rowan-claude
email=305107455+rowan-claude@users.noreply.github.com

[ "$(git config user.email)" = "$email" ] || exit 0

ok() { # name, email
  [ "$1" = "Rowan Claude" ] && [ "$2" = "$email" ]
}

zero=0000000000000000000000000000000000000000
# Exclude what the pushed remote already has. Hook arg 1 is the remote's name (or
# its URL when pushed by URL: then every remote's refs are excluded).
remote=${1:-}
if git remote | grep -qxF -- "$remote"; then notrefs=--remotes="$remote"; else notrefs=--remotes; fi
bad=
while read -r lref lsha rref rsha; do
  [ -z "${lsha:-}" ] && continue
  [ "$lsha" = "$zero" ] && continue
  while IFS=$'\t' read -r sha an ae cn ce; do
    if ! ok "$an" "$ae" || ! ok "$cn" "$ce"; then
      bad+="  ${sha:0:12}  author $an <$ae>  committer $cn <$ce>"$'\n'
    fi
  done < <(git log --format='%H%x09%an%x09%ae%x09%cn%x09%ce' "$lsha" --not "$notrefs")
done

if [ -n "$bad" ]; then
  {
    echo "pre-push: refused. This is an agent clone ($login); these commits have another author or committer:"
    printf '%s' "$bad"
    echo "Fix: git rebase -r --exec 'git commit --amend --no-edit --reset-author' origin/main"
  } >&2
  exit 1
fi
exit 0
