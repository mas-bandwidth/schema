#!/bin/sh
# THE SQUIRREL CARD DRIVER (tables/cards/conformance/FORMAT.md).
#
# Every surface is handed to one script, tables/cards/squirrel/driver.nut,
# under the pinned interpreter ($SQ, which make exports; the dist/ pin
# otherwise), over the generated Card unit (CARDS_SQUIRREL_GENERATED, which
# `make cards-squirrel-generate` writes).
#
# sq EXITS 0 ON A RUNTIME ERROR (docs/PORT-SQUIRREL.md, THE HARNESS): it prints
# "AN ERROR HAS OCCURRED" to stderr, so a run that writes anything to stderr is
# a failure here whatever its exit status, and a crashed surface is never
# reported as answered.
#
# The working directory is the repository root, which is the contract: every
# path in the manifest is repo-relative, so this driver never resolves one.
#
# usage: driver <manifest> list
#        driver <manifest> <surface> <outdir>
sq="${SQ:-dist/squirrel-3.2/bin/sq}"
main=tables/cards/squirrel/driver.nut
# A SURFACE this leg does not answer is ABSENT: exit 2 (test/conformance/
# README.md, "Exit codes"). driver.nut's own `list` is the one place the
# answered surfaces are named.
if [ "$2" != list ]; then
	listed=$("$sq" "$main" "$1" list 2>/dev/null) || exit 1
	if ! printf '%s\n' "$listed" | grep -qx -- "$2"; then
		exit 2
	fi
fi
err=$(mktemp) || exit 1
"$sq" "$main" "$@" 2>"$err"
status=$?
if [ -s "$err" ]; then
	cat "$err" >&2
	rm -f "$err"
	[ "$status" -ne 0 ] && exit "$status"
	exit 1
fi
rm -f "$err"
exit "$status"
