<Project Sdk="Microsoft.NET.Sdk">

  <!-- THE CARD FACADE LIBRARY (tables/cards/conformance/FORMAT.md). It compiles
       the handwritten facade (Cards.cs) beside the generated card unit, the way
       test/conformance/cs compiles its generated sources: the Makefile's
       cards-cs-generate target writes the unit into
       build/tables-generated-cs/cards, and this project includes it from there.
       No test framework and no package dependency; TreatWarningsAsErrors is
       the refuser for the generated source. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>Cards</AssemblyName>
    <CardsGeneratedDir Condition="'$(CardsGeneratedDir)' == ''">../../../build/tables-generated-cs/cards</CardsGeneratedDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Cards.cs" />
    <Compile Include="$(CardsGeneratedDir)/*.cs" />
  </ItemGroup>

  <!-- The package-private seam, the C# spelling of Go's in-package tests and
       driver: the test program and the conformance driver are friend
       assemblies, so they reach the internal retention and hash seams the way
       tables/cards's own _test.go files reach package-private upgrade() and
       r.failEdit (tables/cards/upgrade.go, edit.go). -->
  <ItemGroup>
    <InternalsVisibleTo Include="CardsTests" />
    <InternalsVisibleTo Include="CardsDriver" />
  </ItemGroup>

</Project>
