package mapdemo

// The REPORT rows' roots (docs/SPEC-TABLES.md §2.8, §4): one map and one field
// AFTER it, so a body that stops the map can still be seen to let the parent
// read on. Two roots that differ only in the KEY'S KIND are the changed-key
// evolution case, read one against the other.

table Row
{
    entries map[string(8)]Item
    after   int32
}

table WideRow
{
    entries map[uint32]Item
    after   int32
}

// The reader's OWN edges, past what the two roots above reach (§2.8, §16.2): a
// key bound ABOVE the text walker's key buffer, where a key it cannot hold
// whole must not become a shorter key of its own making, and a uint64 key,
// whose domain the number rule has to establish before any cast — the one key
// kind whose magnitudes fill the high half of a signed 64-bit lane.

table EdgeRow
{
    names map[string(300)]Item
    ids   map[uint64]Item
    after int32
}
