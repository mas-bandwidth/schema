schema-tables-baseline 6
package messagedemo

table Cursor
    field line id=0x01fc kind=8
    field column id=0x27df kind=8

table Edit
    field revision id=0xb98e kind=8
    field body id=0xa2df kind=15 union=EditBody

table InsertText
    field at id=0x42ad kind=13 type=Cursor
    field text id=0xf3d8 kind=12 size=32
    field origin id=0x4330 kind=15 union=Origin
    field origins id=0x53ab kind=14 elem=15 union=Origin array=bounded bound=2
    field modes id=0xab38 kind=14 elem=7 enum=Mode optional=true array=bounded bound=2

table OpenDocument
    field path id=0xc9b1 kind=12 size=64
    field mode id=0x0c7c kind=7 enum=Mode default=Read
    field cursor id=0xd139 kind=13 type=Cursor

table Ping
    field nonce id=0x80f0 kind=8

table RemoveText
    field span id=0xabc0 kind=13 type=Selection

table SaveDocument
    field path id=0xc9b1 kind=12 size=64
    field force id=0xf12d kind=1

table Script
    field path id=0xc9b1 kind=12 size=64
    field line id=0x01fc kind=8

table Selection
    field start id=0x61f4 kind=13 type=Cursor
    field end id=0x1f24 kind=13 type=Cursor

table ToolMessage
    field sequence id=0xd32b kind=8
    field body id=0xa2df kind=15 union=ToolBody
    field history id=0xcbae kind=14 elem=15 union=ToolBody array=bounded bound=2
    field trace id=0xf493 kind=14 elem=13 type=Script optional=true array=bounded bound=3
    field marks id=0xe15f kind=14 elem=7 enum=Mode optional=true array=fixed bound=2

table Transaction
    field reason id=0xa6ba kind=12 size=16
    field edits id=0x3d33 kind=14 elem=13 type=Edit array=bounded bound=3
    field pending id=0xe683 kind=14 elem=15 union=EditBody array=fixed bound=2
    field checkpoints id=0x990b kind=14 elem=8 optional=true array=fixed bound=2
    field snapshots id=0x7daf kind=14 elem=13 type=Selection optional=true array=fixed bound=2

table User
    field name id=0x30df kind=12 size=16

enum Mode
    variant Read id=0xa0ee
    variant Write id=0x1fa0

flags Capabilities
    variant Trace bit=0
    variant Verbose bit=1

union EditBody
    arm insert id=0x508b payload=InsertText
    arm remove id=0xce6f payload=RemoveText
    arm count id=0xe445 kind=4 min=0 max=100
    arm marks id=0xe15f kind=14 elem=7 array=bounded bound=3
    arm blob id=0xd316 kind=14 elem=6 size=4
    arm mode id=0x0c7c kind=7 enum=Mode

union Origin
    arm user id=0x3e8a payload=User
    arm script id=0x4f94 payload=Script
    arm pid id=0x9462 kind=8 min=0 max=1000
    arm note id=0x9da7 kind=12 size=24

union ToolBody
    arm open id=0x1797 payload=OpenDocument
    arm save id=0xb2b7 payload=SaveDocument
    arm transact id=0x968c payload=Transaction
    arm ping id=0xe6d4 payload=Ping
    arm caps id=0xacfb kind=9 flags=Capabilities
    arm spans id=0x8156 kind=14 elem=4 array=fixed bound=2
    arm origin id=0x4330 kind=15 union=Origin
    arm ack id=0x6048 kind=none

## history
### 2026-09-04 — the first baseline over the message corpus, where a union arm of every shape rides (docs/SPEC-TABLES.md §2.6)
- baseline created over 12 tables — data written BEFORE this point is not covered by it
