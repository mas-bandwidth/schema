// Stream.schema — a union whose arm is a VARIABLE-LENGTH table
// (docs/SPEC-TABLES.md §2.2, §2.6): the mode runs through arms, so Feed is
// variable-length because Frame's chunk arm is, and the set arm is a by-value
// edge every pointer walk descends — the numbering, the pack and the cook.
// Frame also carries a POINTER ARM (§2.6): `link` is the pointer edge itself,
// and the node it names is shared with the arrays of pointers beside it — one
// node reached from an arm and from a slot, written once. A scalar arm rides
// beside it, so the union holds a body arm, a pointer arm and a value arm.
//
// Feed also holds the two ARRAY OF POINTERS spellings (§2.1): a counted one and
// a fixed one, whose slots share nodes with each other and with the chain.
package streamdemo

table Header
{
    name string(16)
}

table Chunk
{
    data  bytes(8)
    next  *Chunk
    links [..2]*Chunk // an array of pointers inside a NODE, and inside the union arm that holds a Chunk by value
}

union Frame
{
    header Header
    chunk  Chunk
    link   *Chunk
    tag    uint32
}

table Feed
{
    id    uint32
    frame Frame
    parts [..4]*Chunk
    pair  [2]*Chunk
}
