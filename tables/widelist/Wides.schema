package widelistdemo

// THE EXTENT'S ALIGNMENT IS ITS ARRAYS' (docs/SPEC-TABLES.md §2.8, §2.9,
// §6.2): a 128-bit element is sixteen bytes at sixteen, and both records here
// are aligned eight. `Wide`'s own storage is forty bytes, eight modulo
// sixteen, so its extent begins at forty-eight and not at forty; an odd count
// of `tags` ends the root's extent at eight modulo sixteen, so `WideTail`,
// which follows it, lands there too unless its node aligns to sixteen.
table WideTail
{
    wides []uint128
}

table Wide
{
    tail  *WideTail
    wides []uint128
    tags  []uint64
}
