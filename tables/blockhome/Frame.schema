// Frame.schema — the block home: the first file that declares a table with a
// block form. The unit's shared C# block runtime and every blittable record
// land in its Block.cs (§19.2).

package blockhome

table PartRow
{
    armor ArmorConfig
    // a `type` holding two bounded arrays, nested by value in a ROW: both stay
    // INLINE, at every depth (SPEC-TABLES.md §2.7, depth one bounded only)
    gunner  GunnerSettings
    part_id uint32
    slot    uint8
}

table PartFrame
{
    version uint64
    parts   [..MaxParts]PartRow
}
