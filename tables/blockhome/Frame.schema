// Frame.schema — the first file that declares a table with a block form, which
// is what the C# block home USED to be. The unit's shared runtime does not land
// here: it lands in <Package>Block.cs, named by the package and independent of
// file order (§19.2). What FrameBlock.cs carries is what belongs to a
// declaration — each table's projection record and its block handle.

package blockhome

table PartRow
{
    armor ArmorConfig
    // a `type` holding two bounded arrays, nested by value in a ROW: both stay
    // INLINE, at every depth (docs/SPEC-TABLES.md §2.7, depth one bounded only)
    gunner  GunnerSettings
    part_id uint32
    slot    uint8
}

table PartFrame
{
    version uint64
    parts   [..MaxParts]PartRow
}
