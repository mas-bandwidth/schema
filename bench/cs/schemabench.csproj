<Project Sdk="Microsoft.NET.Sdk">

  <!-- The C# bench runner project: compiles the generated C# beside the
       serialize.cs runtime (sibling checkout, same relative-path convention
       as test/cs/schematest.csproj) and runs src/Program.cs — the C# port of
       bench/cpp/bench_main.cpp. Same property choices as the test project;
       see that file for the Nullable=annotations reasoning. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>annotations</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>schemabench</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- §3.5: the serialize.cs runtime root this leg compiles against.
         bench/run.sh overrides it (-property:SerializeCsRoot=<abs>) when
         SERIALIZE_CS points away from the sibling default, and verifies the
         evaluated Compile items land under the recorded path before any
         preamble is emitted (bench/tools/runtime-paths.sh) — hardcoding the
         path here while the preamble recorded the env var is exactly the
         2026-08-15 provenance defect. -->
    <SerializeCsRoot Condition="'$(SerializeCsRoot)' == ''">../../../serialize.cs</SerializeCsRoot>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../generated/cs/*.cs" />
    <!-- the bench-corpus realworld unit (namespace Realworld — its own
         per-unit TableRuntime, so no basename/type collision with the
         Example unit above): RealPacket, the §1.7 realistic snapshot the
         real_packet rows measure -->
    <Compile Include="../../generated/bench/cs/realworld/*.cs" />
    <Compile Include="$(SerializeCsRoot)/src/Serialize.cs" />
    <!-- the emulated 128-bit pair (Int128Value/UInt128Value) lives beside
         Serialize.cs and Serialize.cs references it on every TFM — the same
         include test/cs/schematest.csproj carries -->
    <Compile Include="$(SerializeCsRoot)/src/Int128Pair.cs" />
  </ItemGroup>

</Project>
