<Project Sdk="Microsoft.NET.Sdk">

  <!-- The C# bench runner project: compiles the generated C# beside the
       serialize.cs runtime (sibling checkout, same relative-path convention
       as test/cs/schematest.csproj) and runs src/Program.cs — the C# port of
       bench/cpp/bench_main.cpp. Same property choices as the test project;
       see that file for the Nullable=annotations reasoning. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>annotations</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>schemabench</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../generated/cs/*.cs" />
    <Compile Include="../../../serialize.cs/src/Serialize.cs" />
    <!-- the emulated 128-bit pair (Int128Value/UInt128Value) lives beside
         Serialize.cs and Serialize.cs references it on every TFM — the same
         include test/cs/schematest.csproj carries -->
    <Compile Include="../../../serialize.cs/src/Int128Pair.cs" />
  </ItemGroup>

</Project>
