#!/bin/sh
# Corrupt the staged variant zero; the real runner must refuse before timing.
set -eu
dir=$(mktemp -d)
trap 'rm -rf "$dir"' EXIT HUP INT TERM
cp bench/corpus/variants/bench_mixed.variants.bin "$dir/bench_mixed.variants.bin"
printf '\377' | dd of="$dir/bench_mixed.variants.bin" bs=1 seek=0 conv=notrunc 2>/dev/null
if bench/python/run --csv --variant-dir "$dir" > "$dir/out" 2> "$dir/err"; then
    echo 'bench-python-negative-control: corrupt variant was accepted' >&2; exit 1
fi
if ! grep -q 'variant 0 differs from the C++ pin' "$dir/err"; then
    cat "$dir/err" >&2; echo 'bench-python-negative-control: failed for the wrong reason' >&2; exit 1
fi
if [ -s "$dir/out" ]; then echo 'bench-python-negative-control: emitted rows on failure' >&2; exit 1; fi
echo 'bench-python-negative-control: corrupt variant refused before timing'
