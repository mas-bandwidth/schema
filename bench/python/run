#!/bin/sh
set -eu
ROOT=$(pwd -P)
PYTHON=${PYTHON:-$ROOT/dist/python-3.15.2/bin/python3.15}
if [ ! -x "$PYTHON" ]; then echo "missing pinned Python: run make dist-python" >&2; exit 2; fi
if [ ! -f generated/bench/python/bench/Bench.py ]; then echo "missing generated benchmark: run make generated/bench/python/.stamp" >&2; exit 2; fi
exec "$PYTHON" -W error -I -B bench/python/main.py "$@"
