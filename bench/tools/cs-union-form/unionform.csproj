<Project Sdk="Microsoft.NET.Sdk">

  <!-- The C# union-form decision probe (schema#262). NOT a bench-standard leg:
       it emits no CSV row, it is not wired into bench/run.sh, and it measures
       no corpus shape — it measures two candidate C# spellings of a table
       union against each other, which is a language question, not a wire one.
       See README.md beside this file. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>annotations</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>csunionform</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>

</Project>
