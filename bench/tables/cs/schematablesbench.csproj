<Project Sdk="Microsoft.NET.Sdk">

  <!-- The C# TABLES bench runner: bench/tables/cs/src/Program.cs, the port of
       bench/tables/cpp/table_main.cpp.

       Sources come from generated/bench/tables/cs, produced by the Makefile
       from bench/corpus/BenchTable.schema. The Block and Cook files are
       excluded: this leg measures the tolerant WIRE (issue #330's scope —
       block and cook numbers stay C++/C# in the game, on real render data).
       TreatWarningsAsErrors is the refuser for the generated source.

       WHY serialize.cs IS HERE, since the table codec does not use it. The
       generated <Base>Table.cs names no runtime — `make tables-cs-standalone`
       gates exactly that, and NO LINE OF THE MEASURED PATH crosses into the
       serialize assembly. What needs it is the UNIT's packet file: the
       closure's `type` declarations (the union's three arms) also get
       ordinary type-wire codecs, and those are the runtime's callers. It is
       the same include for the same reason test/conformance/cs carries it,
       and the C++ leg does not need its twin only because C++ splits the
       type codecs into their own header this runner never includes. The row
       records linkage `asm` on that packaging fact. -->

  <PropertyGroup>
    <SerializeCsRoot Condition="'$(SerializeCsRoot)' == ''">../../../../serialize.cs</SerializeCsRoot>
  </PropertyGroup>
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>annotations</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>schematablesbench</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src/*.cs" />
    <Compile Include="../../../generated/bench/tables/cs/*.cs"
             Exclude="../../../generated/bench/tables/cs/*Block.cs;../../../generated/bench/tables/cs/*Cook.cs" />
    <Compile Include="$(SerializeCsRoot)/src/Serialize.cs" />
    <Compile Include="$(SerializeCsRoot)/src/Int128Pair.cs" />
  </ItemGroup>

</Project>
