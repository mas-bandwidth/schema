;;;; json.lisp -- the text form (SPEC-TABLES.md §16): read and canonical write.
;;;;
;;;; The read is two passes: the dialect's grammar (§16.2: RFC 8259 plus
;;;; comments, trailing commas and a leading BOM) into a tree, then the
;;;; placement walk over the reflection of the root declaration. The write is
;;;; §16.14's W0-W14, step by step.

(in-package :spec-port)

(defconstant +json-max-depth+ 128)
(defconstant +schema-name-cap+ 255)

(defun malformed (fmt &rest args) (apply #'refuse (concatenate 'string "malformed: " fmt) args))

;;; ------------------------------------------------------------------
;;; Pass 1: the grammar. A JSON value is
;;;   (:obj . ((key-octets . value) ...))  (:arr . values)  (:str . octets)
;;;   (:num . token-string)  :true  :false  :null

(defvar *j*)
(defvar *jp*)

(defun jpeek () (if (< *jp* (length *j*)) (aref *j* *jp*) nil))

(defun check-comment-bytes (s e)
  ;; §16.2: a comment's bytes are well-formed UTF-8 and hold no NUL
  (unless (utf8-well-formed-p *j* :start s :end e) (malformed "comment is not text")))

(defun skip-ws ()
  (loop
    (let ((c (jpeek)))
      (cond ((null c) (return))
            ((member c '(#x20 #x09 #x0A #x0D)) (incf *jp*))
            ((= c #x2F)
             (let ((c2 (and (< (1+ *jp*) (length *j*)) (aref *j* (1+ *jp*)))))
               (cond ((eql c2 #x2F)
                      ;; runs to a LINE FEED or the end of input; a lone CR does not end it
                      (let* ((s (+ *jp* 2)) (e (or (position #x0A *j* :start s) (length *j*))))
                        (check-comment-bytes s e)
                        (setf *jp* e)))
                     ((eql c2 #x2A)
                      (let* ((s (+ *jp* 2)) (e (search #(#x2A #x2F) *j* :start2 s)))
                        (unless e (malformed "unclosed block comment"))
                        (check-comment-bytes s e)
                        (setf *jp* (+ e 2))))
                     (t (malformed "stray /")))))
            (t (return))))))

(defun parse-text (bytes)
  "The whole text: one root value, then only whitespace (§16.1)."
  (let ((*j* bytes) (*jp* 0))
    (when (and (>= (length bytes) 3) (= (aref bytes 0) #xEF) (= (aref bytes 1) #xBB) (= (aref bytes 2) #xBF))
      (setf *jp* 3))
    (skip-ws)
    (let ((v (parse-jvalue 0)))
      (skip-ws)
      (when (< *jp* (length *j*)) (malformed "data after the root value"))
      v)))

(defun expect-byte (b)
  (unless (eql (jpeek) b) (malformed "expected ~a at ~a" (code-char b) *jp*))
  (incf *jp*))

(defun match-literal (lit value)
  (let ((n (length lit)))
    (unless (and (<= (+ *jp* n) (length *j*))
                 (loop for i below n always (= (aref *j* (+ *jp* i)) (char-code (char lit i)))))
      (malformed "bad literal"))
    (incf *jp* n)
    value))

(defun parse-jvalue (depth)
  (skip-ws)
  (let ((c (jpeek)))
    (cond
      ((null c) (malformed "end of input"))
      ((= c #x7B) (parse-jobject depth))
      ((= c #x5B) (parse-jarray depth))
      ((= c #x22) (cons :str (parse-jstring)))
      ((or (= c #x2D) (<= #x30 c #x39)) (cons :num (parse-jnumber)))
      ((= c #x74) (match-literal "true" :true))
      ((= c #x66) (match-literal "false" :false))
      ((= c #x6E) (match-literal "null" :null))
      (t (malformed "unexpected byte ~a" c)))))

(defun check-container-depth (depth)
  ;; SPEC-GAP 9: see SPEC-GAPS.md; the root is depth 0 and depth 128 is read.
  (when (> depth +json-max-depth+) (malformed "nesting past ~a" +json-max-depth+)))

(defun parse-jobject (depth)
  (check-container-depth depth)
  (incf *jp*)
  (let ((members '()))
    (skip-ws)
    (if (eql (jpeek) #x7D)
        (incf *jp*)
        (loop
          (skip-ws)
          (unless (eql (jpeek) #x22) (malformed "object key expected"))
          (let ((k (parse-jstring)))
            (skip-ws)
            (expect-byte #x3A)
            (let ((v (parse-jvalue (1+ depth))))
              (when (find k members :key #'car :test #'equalp) (malformed "repeated key"))
              (push (cons k v) members)))
          (skip-ws)
          (let ((c (jpeek)))
            (cond ((eql c #x2C) (incf *jp*) (skip-ws)
                   (when (eql (jpeek) #x7D) (incf *jp*) (return)))     ; trailing comma
                  ((eql c #x7D) (incf *jp*) (return))
                  (t (malformed "object: , or } expected"))))))
    (cons :obj (nreverse members))))

(defun parse-jarray (depth)
  (check-container-depth depth)
  (incf *jp*)
  (let ((elems '()))
    (skip-ws)
    (if (eql (jpeek) #x5D)
        (incf *jp*)
        (loop
          (push (parse-jvalue (1+ depth)) elems)
          (skip-ws)
          (let ((c (jpeek)))
            (cond ((eql c #x2C) (incf *jp*) (skip-ws)
                   (when (eql (jpeek) #x5D) (incf *jp*) (return)))
                  ((eql c #x5D) (incf *jp*) (return))
                  (t (malformed "array: , or ] expected"))))))
    (cons :arr (nreverse elems))))

(defun hex-digit (b)
  (cond ((<= #x30 b #x39) (- b #x30))
        ((<= #x41 b #x46) (- b #x37))
        ((<= #x61 b #x66) (- b #x57))
        (t (malformed "bad \\u escape"))))

(defun read-u4 ()
  (unless (<= (+ *jp* 4) (length *j*)) (malformed "short \\u escape"))
  (let ((v 0)) (dotimes (i 4) (setf v (+ (* v 16) (hex-digit (aref *j* (+ *jp* i)))))) (incf *jp* 4) v))

(defun push-utf8 (out c)
  (loop for b across (string-to-octets (string (code-char c))) do (vector-push-extend b out)))

(defun parse-jstring ()
  "The decoded octets. Ill-formed UTF-8 and lone surrogates refuse
(§16.3); so does any string decoding to U+0000, placed or skipped."
  (incf *jp*)
  (let ((out (make-array 16 :element-type '(unsigned-byte 8) :adjustable t :fill-pointer 0)))
    (loop
      (let ((c (jpeek)))
        (cond
          ((null c) (malformed "unclosed string"))
          ((= c #x22) (incf *jp*) (return))
          ((< c #x20) (malformed "raw control byte in a string"))
          ((= c #x5C)
           (incf *jp*)
           (let ((e (jpeek)))
             (incf *jp*)
             (case e
               (#x22 (vector-push-extend #x22 out)) (#x5C (vector-push-extend #x5C out))
               (#x2F (vector-push-extend #x2F out)) (#x62 (vector-push-extend #x08 out))
               (#x66 (vector-push-extend #x0C out)) (#x6E (vector-push-extend #x0A out))
               (#x72 (vector-push-extend #x0D out)) (#x74 (vector-push-extend #x09 out))
               (#x75
                (let ((u (read-u4)))
                  (cond
                    ((<= #xD800 u #xDBFF)
                     (unless (and (< (1+ *jp*) (length *j*)) (= (aref *j* *jp*) #x5C) (= (aref *j* (1+ *jp*)) #x75))
                       (refuse "malformed: string_lone_surrogate"))
                     (incf *jp* 2)
                     (let ((lo (read-u4)))
                       (unless (<= #xDC00 lo #xDFFF) (refuse "malformed: string_lone_surrogate"))
                       (push-utf8 out (+ #x10000 (ash (- u #xD800) 10) (- lo #xDC00)))))
                    ((<= #xDC00 u #xDFFF) (refuse "malformed: string_lone_surrogate"))
                    (t (push-utf8 out u)))))
               (t (malformed "bad escape")))))
          (t (vector-push-extend c out) (incf *jp*)))))
    (let ((v (coerce out 'octets)))
      (unless (utf8-well-formed-p v :allow-zero t) (refuse "malformed: string_not_utf8"))
      (when (find 0 v) (refuse "text_holds_zero"))
      v)))

(defun parse-jnumber ()
  "RFC 8259's number grammar; the token's text."
  (let ((s *jp*))
    (flet ((digit-p () (let ((c (jpeek))) (and c (<= #x30 c #x39))))
           (digits () (unless (let ((c (jpeek))) (and c (<= #x30 c #x39))) (malformed "number"))
                     (loop while (let ((c (jpeek))) (and c (<= #x30 c #x39))) do (incf *jp*))))
      (when (eql (jpeek) #x2D) (incf *jp*))
      (cond ((eql (jpeek) #x30) (incf *jp*))
            ((digit-p) (digits))
            (t (malformed "number")))
      (when (eql (jpeek) #x2E) (incf *jp*) (digits))
      (when (member (jpeek) '(#x65 #x45))
        (incf *jp*)
        (when (member (jpeek) '(#x2B #x2D)) (incf *jp*))
        (digits)))
    (map 'string #'code-char (subseq *j* s *jp*))))

(defun number-token-p (s)
  "True when S is exactly one RFC 8259 number."
  (let ((*j* (string-to-octets s)) (*jp* 0))
    (and (plusp (length s))
         (handler-case (progn (parse-jnumber) (= *jp* (length *j*)))
           (refusal () nil)))))

(defun integer-token-p (s)
  "§16.2 Numbers: digits with an optional minus; no fraction, no exponent, not -0."
  (and (number-token-p s)
       (not (find #\. s)) (not (find #\e s)) (not (find #\E s))
       (string/= s "-0")))

(defun token-parts (s)
  "(values negative digits-integer exponent10) of a number token."
  (let* ((neg (char= (char s 0) #\-))
         (body (if neg (subseq s 1) s))
         (epos (position-if (lambda (c) (member c '(#\e #\E))) body))
         (mant (subseq body 0 epos))
         (ex (if epos (parse-integer body :start (1+ epos)) 0))
         (dot (position #\. mant))
         (ip (subseq mant 0 dot))
         (fp (if dot (subseq mant (1+ dot)) "")))
    (values neg (parse-integer (concatenate 'string ip fp)) (- ex (length fp)))))

(defun token-value (s &key (limit 400))
  "The exact value of a number token, or :HUGE / :TINY when its magnitude
is past 10^LIMIT either way (no exact arithmetic is spent on those)."
  (multiple-value-bind (neg d e10) (token-parts s)
    (cond ((zerop d) (values 0 neg))
          (t (let ((order (+ (length (format nil "~d" d)) e10)))
               (cond ((> order limit) (values :huge neg))
                     ((< order (- limit)) (values :tiny neg))
                     (t (let ((r (* d (expt 10 e10)))) (values (if neg (- r) r) neg)))))))))

;;; ------------------------------------------------------------------
;;; Pass 2: placement (§16.2, §16.7)

(defvar *labels*)        ; label -> :open | :skipped | tval
(defvar *json-unknown*)

(defun key-string (k)
  (when (> (length k) +schema-name-cap+) (malformed "schema name past 255 bytes"))
  (octets-to-string k))

(defun amp-key-p (k) (and (plusp (length k)) (= (aref k 0) #x26)))

(defun parse-label (jv)
  "§16.7: a positive integer spelled as one, within a u64."
  (unless (and (consp jv) (eq (car jv) :num)) (malformed "label"))
  (let ((s (cdr jv)))
    (unless (and (every #'digit-char-p s) (char/= (char s 0) #\0)) (malformed "label ~a" s))
    (let ((n (parse-integer s)))
      (when (>= n (expt 2 64)) (malformed "label past u64"))
      n)))

(defun skip-jvalue (jv)
  "A value no field places: held to the label rules and the name cap (§16.7)."
  (when (consp jv)
    (case (car jv)
      (:arr (mapc #'skip-jvalue (cdr jv)))
      (:obj
       (let ((members (cdr jv)))
         (loop for (k . v) in members for i from 0
               do (key-string k)
                  (when (amp-key-p k)
                    (unless (and (zerop i) (equalp k (string-to-octets "&node"))) (malformed "& key"))))
         (if (and members (equalp (car (first members)) (string-to-octets "&node")))
             (let ((label (parse-label (cdr (first members)))))
               (if (null (rest members))
                   (let ((s (gethash label *labels*)))
                     (when (or (null s) (eq s :open)) (malformed "reference to an undefined label")))
                   (progn
                     (when (gethash label *labels*) (malformed "label defined twice"))
                     (setf (gethash label *labels*) :open)
                     (loop for (nil . v) in (rest members) do (skip-jvalue v))
                     (setf (gethash label *labels*) :skipped))))
             (loop for (nil . v) in members do (skip-jvalue v))))))))

(defun jtype-p (jv tag) (and (consp jv) (eq (car jv) tag)))

(defun need (jv tag where)
  (unless (jtype-p jv tag) (kind-mismatch "~a: wrong JSON type" where))
  (cdr jv))

(defun json-read-value (decl bytes)
  "§16.1's FromJson: a fresh value of DECL from the text BYTES."
  (let ((*labels* (make-hash-table)) (*json-unknown* 0))
    (let ((jv (parse-text bytes)))
      (if (sdecl-json-array decl)
          (progn (unless (jtype-p jv :arr) (refuse "json_root_not_array: ~a" (sdecl-name decl)))
                 (read-struct-value decl jv (sdecl-name decl)))
          (progn (unless (jtype-p jv :obj) (kind-mismatch "root is not an object"))
                 (read-struct decl (cdr jv)))))))

(defun read-struct-value (decl jv where)
  "A by-value table or type: an object, or the array of a json=\"array\" table."
  (if (sdecl-json-array decl)
      (let ((tv (make-default-tval decl)) (f (aref (struct-fields decl) 0)))
        (unless (jtype-p jv :arr) (kind-mismatch "~a: wrong JSON type" where))
        (setf (aref (tval-slots tv) 0) (read-value (field-type f) jv (field-default f) where))
        tv)
      (read-struct decl (need jv :obj where))))

(defun read-struct (decl members &optional (tv (make-default-tval decl)))
  (let ((present (make-hash-table)))
    (dolist (m members)
      (let ((k (car m)) (v (cdr m)))
        (when (amp-key-p k) (malformed "& key where a field is placed"))
        (let ((fd (gethash (key-string k) (sdecl-by-key decl))))
          (if (null fd)
              (progn (incf *json-unknown*) (skip-jvalue v))
              (let ((where (format nil "~a.~a" (sdecl-name decl) (field-name fd))))
                (setf (gethash (field-index fd) present) t)
                (setf (aref (tval-slots tv) (field-index fd))
                      (read-value (field-type fd) v (field-default fd) where)))))))
    (loop for fd across (struct-fields decl)
          do (when (and (field-required fd) (not (gethash (field-index fd) present)) (guard-true-p tv fd))
               (refuse "missing_required: ~a.~a" (sdecl-name decl) (field-name fd)))
             (when (field-total fd)
               (let ((sum (loop for e across (aref (tval-slots tv) (field-index fd)) sum (if e (length e) 0))))
                 (when (> sum (field-total fd)) (refuse "length_over_bound: total ~a" (field-name fd))))))
    tv))

(defun out-of-range (where) (refuse "out_of_range: ~a" where))

(defun read-integer (jv wide where)
  "An integer token (a number, or a string of digits for a wide kind)."
  (let ((s (if wide (octets-to-string (need jv :str where)) (need jv :num where))))
    (unless (integer-token-p s) (kind-mismatch "~a: not an integer token" where))
    (parse-integer s)))

(defun int-wide-p (td)
  (ecase (first td)
    (:int (> (third td) 32))
    (:bits (> (second td) 32))
    ((:i128 :u128) t)
    (:fixed (> (+ (third td) (fourth td)) 32))))

(defun read-float (td jv where)
  (let* ((s (need jv :num where)) (w (second td)))
    (multiple-value-bind (r neg) (token-value s)
      (let ((bits (cond ((eq r :huge) :inf)
                        ((eq r :tiny) (rational-to-float-bits 0 w :negative-zero neg))
                        (t (rational-to-float-bits r w :negative-zero neg)))))
        (when (eq bits :inf) (kind-mismatch "~a: past the float's range" where))
        (if (compressed-p td)
            (destructuring-bind (mn mx res) (third td)
              (declare (ignore res))
              ;; SPEC-GAP 6, as the wire read holds it
              (let ((v (float-bits-rational bits w))
                    (lo (float-bits-rational (rational-to-float-bits (rational mn) w) w))
                    (hi (float-bits-rational (rational-to-float-bits (rational mx) w) w)))
                (unless (<= lo v hi) (out-of-range where))
                (if (zerop v) 0 bits)))
            bits)))))

(defun read-fixed (td jv where)
  (destructuring-bind (signed ii ff rawmin rawmax) (rest td)
    (declare (ignore signed ii))
    (let ((s (if (int-wide-p td) (octets-to-string (need jv :str where)) (need jv :num where))))
      (unless (number-token-p s) (kind-mismatch "~a: not a number" where))
      (multiple-value-bind (r) (token-value s :limit 200)
        (cond ((eq r :huge) (out-of-range where))
              ((eq r :tiny) (kind-mismatch "~a: finer than the fraction" where)))
        (let ((raw (* r (expt 2 ff))))
          (unless (integerp raw) (kind-mismatch "~a: finer than the fraction" where))
          (unless (<= rawmin raw rawmax) (out-of-range where))
          raw)))))

(defun days-in-month (y m)
  (if (= m 2)
      (if (and (zerop (mod y 4)) (or (plusp (mod y 100)) (zerop (mod y 400)))) 29 28)
      (nth (1- m) '(31 28 31 30 31 30 31 31 30 31 30 31))))

(defun days-from-civil (y m d)
  (let* ((y (if (<= m 2) (1- y) y))
         (era (floor y 400))
         (yoe (- y (* era 400)))
         (doy (+ (floor (+ (* 153 (+ m (if (> m 2) -3 9))) 2) 5) (1- d)))
         (doe (+ (* yoe 365) (floor yoe 4) (- (floor yoe 100)) doy)))
    (+ (* era 146097) doe -719468)))

(defun civil-from-days (z)
  (let* ((z (+ z 719468))
         (era (floor z 146097))
         (doe (- z (* era 146097)))
         (yoe (floor (- doe (floor doe 1460) (- (floor doe 36524)) (floor doe 146096)) 365))
         (y (+ yoe (* era 400)))
         (doy (- doe (- (+ (* 365 yoe) (floor yoe 4)) (floor yoe 100))))
         (mp (floor (+ (* 5 doy) 2) 153))
         (d (1+ (- doy (floor (+ (* 153 mp) 2) 5))))
         (m (if (< mp 10) (+ mp 3) (- mp 9))))
    (values (if (<= m 2) (1+ y) y) m d)))

(defun parse-rfc3339 (s where)
  "§16.2's timestamp row: exactly RFC 3339 §5.6 date-time, to UTC nanoseconds."
  (flet ((bad () (refuse "timestamp_not_rfc3339: ~a" where)))
    (let ((n (length s)) (p 0))
      (labels ((dig (k) (unless (<= (+ p k) n) (bad))
                 (let ((v 0)) (dotimes (i k) (let ((c (char s (+ p i)))) (unless (digit-char-p c) (bad))
                                                (setf v (+ (* v 10) (digit-char-p c)))))
                   (incf p k) v))
               (ch (cs) (unless (and (< p n) (find (char s p) cs)) (bad)) (prog1 (char s p) (incf p))))
        (let* ((y (dig 4)) (mo (progn (ch "-") (dig 2))) (d (progn (ch "-") (dig 2)))
               (h (progn (ch "Tt") (dig 2))) (mi (progn (ch ":") (dig 2))) (se (progn (ch ":") (dig 2)))
               (nanos 0) (off 0))
          (unless (and (<= 1 mo 12) (<= 1 d (days-in-month y mo)) (<= h 23) (<= mi 59) (<= se 59)) (bad))
          (when (and (< p n) (char= (char s p) #\.))
            (incf p)
            (let ((st p))
              (loop while (and (< p n) (digit-char-p (char s p))) do (incf p))
              (when (= st p) (bad))
              (let ((frac (subseq s st (min p (+ st 9)))))
                (setf nanos (* (parse-integer frac) (expt 10 (- 9 (length frac))))))))
          (let ((z (ch "Zz+-")))
            (unless (member z '(#\Z #\z))
              (let ((oh (dig 2)) (om (progn (ch ":") (dig 2))))
                (unless (and (<= oh 23) (<= om 59)) (bad))
                (setf off (* (if (char= z #\+) 1 -1) (+ (* oh 3600) (* om 60)))))))
          (unless (= p n) (bad))
          (let ((ns (+ (* (- (+ (* (days-from-civil y mo d) 86400) (* h 3600) (* mi 60) se) off) 1000000000) nanos)))
            (unless (<= (- (expt 2 63)) ns (1- (expt 2 63))) (bad))
            ns))))))

(defparameter +b64+ "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/")

(defun base64-encode (v)
  (with-output-to-string (o)
    (loop for i from 0 below (length v) by 3
          do (let* ((n (- (min (length v) (+ i 3)) i))
                    (w (logior (ash (aref v i) 16)
                               (if (> n 1) (ash (aref v (+ i 1)) 8) 0)
                               (if (> n 2) (aref v (+ i 2)) 0))))
               (write-char (char +b64+ (ldb (byte 6 18) w)) o)
               (write-char (char +b64+ (ldb (byte 6 12) w)) o)
               (write-char (if (> n 1) (char +b64+ (ldb (byte 6 6) w)) #\=) o)
               (write-char (if (> n 2) (char +b64+ (ldb (byte 6 0) w)) #\=) o)))))

(defun base64-decode (s where)
  "§16.8's canonical base64: anything but the writer's own spelling refuses."
  (let ((n (length s)))
    (unless (zerop (mod n 4)) (kind-mismatch "~a: not base64" where))
    (let ((out (make-array 0 :element-type '(unsigned-byte 8) :adjustable t :fill-pointer 0)))
      (loop for i from 0 below n by 4
            do (let ((vals (loop for k below 4
                                 for c = (char s (+ i k))
                                 collect (cond ((position c +b64+))
                                               ((and (char= c #\=) (>= (+ i k) (- n 2))) nil)
                                               (t (kind-mismatch "~a: not base64" where))))))
                 (let ((pads (count nil vals)))
                   (when (or (null (first vals)) (null (second vals))
                             (and (null (third vals)) (fourth vals))
                             (and (plusp pads) (< (+ i 4) n)))
                     (kind-mismatch "~a: not base64" where))
                   (let ((w (loop for v in vals for sh from 18 downto 0 by 6 sum (ash (or v 0) sh))))
                     (vector-push-extend (ldb (byte 8 16) w) out)
                     (when (< pads 2) (vector-push-extend (ldb (byte 8 8) w) out))
                     (when (< pads 1) (vector-push-extend (ldb (byte 8 0) w) out))))))
      (let ((v (coerce out 'octets)))
        (unless (string= (base64-encode v) s) (refuse "base64_not_canonical: ~a" where))
        v))))

(defun read-enum (e jv dflt where)
  (let* ((s (key-string (need jv :str where))))
    (if (string= s "None")
        0
        (let ((v (find s (edecl-variants e) :key #'variant-name :test #'string=)))
          (cond ((null v) (incf *json-unknown*) 0)
                ((variant-deprecated v) dflt)      ; §2.15: reads as the declared default
                (t (variant-ordinal v)))))))

(defun read-flags (fd jv where)
  (let ((mask 0) (names (fdecl-variants fd)))
    (dolist (e (need jv :arr where) mask)
      (let* ((s (key-string (need e :str where))) (bit (position s names :test #'string=)))
        (cond ((null bit) (incf *json-unknown*))
              ((logbitp bit mask) (malformed "~a: flag named twice" where))
              (t (setf mask (logior mask (ash 1 bit)))))))))

(defun read-union (u jv where)
  (let ((members (need jv :obj where)))
    (cond
      ((null members) nil)
      ((rest members) (malformed "~a: union with two keys" where))
      (t (destructuring-bind (k . v) (first members)
           (when (amp-key-p k) (malformed "& key at a union"))
           (let* ((name (key-string k))
                  (arm (and (string/= name "None") (find name (union-arms u) :key #'arm-name :test #'string=))))
             (cond
               ((null arm) (incf *json-unknown*) (skip-jvalue v) nil)
               ((null (arm-type arm))
                (unless (eq v :null) (kind-mismatch "~a: payload-free arm holds a value" where))
                (cons (arm-tag arm) nil))
               (t (cons (arm-tag arm) (read-value (arm-type arm) v (type-default (arm-type arm)) where))))))))))

(defun read-pointer (decl jv where)
  "§16.7: a pointee in place, a label definition, or a reference."
  (cond
    ((eq jv :null) nil)
    (t
     (let* ((members (need jv :obj where))
            (amp (string-to-octets "&node")))
       (if (and members (equalp (car (first members)) amp))
           (let ((label (parse-label (cdr (first members)))))
             (if (null (rest members))
                 (let ((s (gethash label *labels*)))
                   (cond ((or (null s) (eq s :open)) (malformed "reference to an undefined label"))
                         ((eq s :skipped) nil)
                         ((not (eq (tval-decl s) decl)) (kind-mismatch "~a: label names another table" where))
                         (t s)))
                 (progn
                   (when (gethash label *labels*) (malformed "label defined twice"))
                   (setf (gethash label *labels*) :open)
                   (let ((tv (read-struct decl (rest members))))
                     (setf (gethash label *labels*) tv)
                     tv))))
           (read-struct decl members))))))

(defun read-map-key (ktd k where)
  (ecase (first ktd)
    (:string (when (and (second ktd) (> (length k) (second ktd))) (refuse "length_over_bound: ~a key" where))
     k)
    ((:int :bits)
     (let ((s (octets-to-string k)))
       (unless (number-token-p s) (malformed "~a: map key" where))
       (unless (integer-token-p s) (kind-mismatch "~a: map key" where))
       (let ((v (parse-integer s)))
         (if (eq (first ktd) :int)
             (unless (<= (fourth ktd) v (fifth ktd)) (out-of-range where))
             (unless (<= 0 v (1- (expt 2 (second ktd)))) (out-of-range where)))
         v)))))

(defun read-map (td jv where)
  (destructuring-bind (ktd vtd) (rest td)
    (let ((entries
            (loop for (k . v) in (need jv :obj where)
                  collect (cons (read-map-key ktd k where)
                                (if (eq (first vtd) :optional)
                                    (if (eq v :null) :absent (read-value (second vtd) v (type-default (second vtd)) where))
                                    (read-value vtd v (type-default vtd) where))))))
      (stable-sort entries (lambda (a b) (key-less-p ktd (car a) (car b)))))))

(defun read-element (elem jv where)
  (if (eq (first elem) :optional)
      (if (eq jv :null) nil (read-value (second elem) jv (type-default (second elem)) where))
      (read-value elem jv (type-default elem) where)))

(defun read-array (td jv where)
  (destructuring-bind (mode lo hi elem) (rest td)
    (if (eq mode :keyed)
        (let ((out (type-default td)))
          (loop for (k . v) in (need jv :obj where)
                do (when (amp-key-p k) (malformed "& key at an enum-keyed array"))
                   (let* ((name (key-string k))
                          (var (and (string/= name "None") (find name (edecl-variants hi) :key #'variant-name :test #'string=))))
                     (if (null var)
                         (progn (incf *json-unknown*) (skip-jvalue v))
                         (setf (aref out (1- (variant-ordinal var))) (read-element elem v where)))))
          out)
        (let* ((elems (need jv :arr where)) (n (length elems)))
          (when (and hi (> n hi)) (refuse "count_over_bound: ~a" where))
          (let ((vals (mapcar (lambda (e) (read-element elem e where)) elems)))
            (ecase mode
              (:fixed (let ((out (type-default td)))
                        (loop for v in vals for i from 0 do (setf (aref out i) v))
                        out))
              (:counted (when (< n lo) (refuse "count_under_bound: ~a" where))   ; SPEC-GAP 7
               (coerce vals 'vector))
              (:unbounded (coerce vals 'vector))))))))

(defun read-value (td jv dflt where)
  "One JSON value into type TD by §16.2's row for it."
  (when (and (eq jv :null) (not (member (first td) '(:optional :ptr))))
    (kind-mismatch "~a: null" where))
  (ecase (first td)
    (:optional (if (eq jv :null) :absent (read-value (second td) jv dflt where)))
    (:int (let ((v (read-integer jv (int-wide-p td) where)))
            (unless (<= (fourth td) v (fifth td)) (out-of-range where))
            v))
    (:bits (let ((v (read-integer jv (int-wide-p td) where)))
             (unless (<= 0 v (1- (expt 2 (second td)))) (out-of-range where))
             v))
    (:i128 (let ((v (read-integer jv t where)))
             (unless (<= (second td) v (third td)) (out-of-range where))
             v))
    (:u128 (let ((v (read-integer jv t where)))
             (unless (<= 0 v (1- (expt 2 128))) (out-of-range where))
             v))
    (:bool (cond ((eq jv :true) t) ((eq jv :false) nil) (t (kind-mismatch "~a: not a bool" where))))
    (:float (read-float td jv where))
    (:fixed (read-fixed td jv where))
    (:timestamp (parse-rfc3339 (octets-to-string (need jv :str where)) where))
    (:string (let ((v (need jv :str where)))
               (when (and (second td) (> (length v) (second td))) (refuse "length_over_bound: ~a" where))
               v))
    (:bytes (let ((v (base64-decode (octets-to-string (need jv :str where)) where)))
              (when (and (second td) (> (length v) (second td))) (refuse "length_over_bound: ~a" where))
              v))
    (:enum (read-enum (second td) jv dflt where))
    (:flags (read-flags (second td) jv where))
    (:struct (read-struct-value (second td) jv where))
    (:union (read-union (second td) jv where))
    (:map (read-map td jv where))
    (:array (read-array td jv where))
    (:ptr (let ((target (second td)))
            (cond ((eq jv :null) nil)
                  ((eq target :bytes) (make-blob :kind :bytes :data (base64-decode (octets-to-string (need jv :str where)) where)))
                  ((eq target :string) (make-blob :kind :string :data (need jv :str where)))
                  (t (read-pointer target jv where)))))))

;;; ------------------------------------------------------------------
;;; The canonical writer (§16.14)

(defvar *out*)
(defvar *namings*)     ; node -> count of slots naming it (W1)
(defvar *jlabels*)     ; node -> label once defined
(defvar *next-label*)

(defun out (s) (loop for ch across s do (vector-push-extend (char-code ch) *out*)))
(defun out-bytes (v) (loop for b across v do (vector-push-extend b *out*)))
(defun nl (d) (vector-push-extend 10 *out*) (dotimes (i (* 2 d)) (vector-push-extend 32 *out*)))

(defun present-fields (tv)
  "W3 steps 1-2: declaration order, minus false guards and absent optionals."
  (loop for f across (struct-fields (tval-decl tv))
        for v = (aref (tval-slots tv) (field-index f))
        when (and (guard-true-p tv f) (not (and (eq (first (field-type f)) :optional) (eq v :absent))))
          collect f))

;;; W1: the graph pass

(defun graph-walk (tv open)
  (dolist (f (present-fields tv))
    (graph-value (field-type f) (aref (tval-slots tv) (field-index f)) open)))

(defun graph-value (td v open)
  (case (first td)
    (:optional (unless (eq v :absent) (graph-value (second td) v open)))
    (:struct (graph-walk v open))
    (:union (when (and v (cdr v))
              (let ((arm (aref (union-arms (second td)) (1- (car v)))))
                (when (arm-type arm) (graph-value (arm-type arm) (cdr v) open)))))
    (:array (let ((elem (fifth td)))
              (loop for e across v do (graph-value (if (eq (first elem) :optional) '(:bool) elem) e open))))
    (:map (dolist (e v) (graph-value (third td) (cdr e) open)))
    (:ptr
     (when v
       (let ((c (gethash v *namings* 0)))
         (cond
           ((blob-p v) (when (plusp c) (invalid "blob_shared")) (setf (gethash v *namings*) 1))
           ((gethash v open) (invalid "data_cycle"))
           ((plusp c) (setf (gethash v *namings*) (1+ c)))
           (t (setf (gethash v *namings*) 1)
              (setf (gethash v open) t)
              (graph-walk v open)
              (remhash v open))))))))

;;; W8-W13: leaves

(defun write-jstring (v where)
  (unless (utf8-well-formed-p v) (invalid "~a is not text" where))
  (vector-push-extend #x22 *out*)
  (loop for b across v
        do (case b
             (#x22 (out "\\\"")) (#x5C (out "\\\\"))
             (#x08 (out "\\b")) (#x0C (out "\\f")) (#x0A (out "\\n")) (#x0D (out "\\r")) (#x09 (out "\\t"))
             (t (if (< b #x20) (out (format nil "\\u00~(~2,'0x~)" b)) (vector-push-extend b *out*)))))
  (vector-push-extend #x22 *out*))

(defun write-ascii-string (s) (out "\"") (out s) (out "\""))

(defun floor-log10 (r)
  (let ((x (floor (* (- (integer-length (numerator r)) (integer-length (denominator r))) 0.30103d0))))
    (loop while (> (expt 10 x) r) do (decf x))
    (loop while (<= (expt 10 (1+ x)) r) do (incf x))
    x))

(defun g-format (r p)
  "W12's G for a positive exact R at P digits: (values text decimal-value)."
  (let* ((x (floor-log10 r))
         (n (round (/ r (expt 10 (- x p -1))))))
    (when (>= n (expt 10 p))
      (incf x)
      (setf n (round (/ r (expt 10 (- x p -1))))))
    (let* ((value (* n (expt 10 (- x p -1))))
           (digits (string-right-trim "0" (format nil "~d" n)))
           (digits (if (string= digits "") "0" digits)))
      (values
       (if (or (< x -4) (>= x p))
           (format nil "~a~:[.~a~;~*~]e~a~2,'0d" (char digits 0) (= (length digits) 1) (subseq digits 1)
                   (if (minusp x) "-" "+") (abs x))
           (if (>= x 0)
               (let* ((padded (if (< (length digits) (1+ x))
                                  (concatenate 'string digits (make-string (- (1+ x) (length digits)) :initial-element #\0))
                                  digits))
                      (ip (subseq padded 0 (1+ x))) (fp (subseq padded (1+ x))))
                 (if (string= fp "") ip (concatenate 'string ip "." fp)))
               (concatenate 'string "0." (make-string (- (- x) 1) :initial-element #\0) digits)))
       value))))

(defun float-text (bits w)
  (let* ((neg (float-negative-p bits w)) (r (abs (float-bits-rational bits w))))
    (concatenate 'string (if neg "-" "")
                 (if (zerop r)
                     "0"
                     (multiple-value-bind (lo hi) (if (= w 32) (values 6 9) (values 15 17))
                       (loop for p from lo to hi
                             do (multiple-value-bind (text value) (g-format r p)
                                  (when (or (= p hi) (eql (rational-to-float-bits value w) (rational-to-float-bits r w)))
                                    (return text)))))))))

(defun fixed-text (raw ff)
  (let* ((a (abs raw)) (whole (ash a (- ff))) (frac (ldb (byte ff 0) a)) (den (expt 2 ff)))
    (with-output-to-string (o)
      (when (minusp raw) (write-char #\- o))
      (format o "~d." whole)
      (if (zerop frac)
          (write-char #\0 o)
          (loop until (zerop frac)
                do (multiple-value-bind (dgt rest) (floor (* frac 10) den)
                     (write-char (digit-char dgt) o)
                     (setf frac rest)))))))

(defun timestamp-text (ns)
  (multiple-value-bind (secs nanos) (floor ns 1000000000)
    (multiple-value-bind (days sod) (floor secs 86400)
      (multiple-value-bind (y m d) (civil-from-days days)
        (format nil "~4,'0d-~2,'0d-~2,'0dT~2,'0d:~2,'0d:~2,'0d~aZ" y m d
                (floor sod 3600) (floor (mod sod 3600) 60) (mod sod 60)
                (if (zerop nanos) "" (concatenate 'string "." (string-right-trim "0" (format nil "~9,'0d" nanos)))))))))

;;; W2-W7: values

(defun write-int (v wide)
  (if wide (write-ascii-string (format nil "~d" v)) (out (format nil "~d" v))))

(defun write-jvalue (td v d where)
  (ecase (first td)
    (:optional (write-jvalue (second td) v d where))
    (:int (unless (<= (fourth td) v (fifth td)) (invalid "~a" where)) (write-int v (int-wide-p td)))
    (:bits (unless (<= 0 v (1- (expt 2 (second td)))) (invalid "~a" where)) (write-int v (int-wide-p td)))
    (:i128 (unless (<= (second td) v (third td)) (invalid "~a" where)) (write-int v t))
    (:u128 (write-int v t))
    (:bool (out (if v "true" "false")))
    (:float (let ((w (second td)))
              (unless (if (= w 32) (f32-finite-p v) (f64-finite-p v)) (invalid "non-finite float ~a" where))
              (when (compressed-p td)
                (destructuring-bind (mn mx res) (third td)
                  (declare (ignore res))
                  (let ((x (float-bits-rational v w)))
                    (unless (<= (float-bits-rational (rational-to-float-bits (rational mn) w) w) x
                                (float-bits-rational (rational-to-float-bits (rational mx) w) w))
                      (invalid "~a off its range" where)))))
              (out (float-text v w))))
    (:fixed (unless (<= (fifth td) v (sixth td)) (invalid "~a" where))
     (let ((s (fixed-text v (fourth td))))
       (if (int-wide-p td) (write-ascii-string s) (out s))))
    (:timestamp (write-ascii-string (timestamp-text v)))
    (:string (when (and (second td) (> (length v) (second td))) (invalid "~a past its bound" where))
     (write-jstring v where))
    (:bytes (when (and (second td) (> (length v) (second td))) (invalid "~a past its bound" where))
     (write-ascii-string (base64-encode v)))
    (:enum (let ((e (second td)))
             (cond ((zerop v) (write-ascii-string "None"))
                   ((or (< v 0) (> v (edecl-max e))) (invalid "~a: enum value no variant names" where))
                   (t (let ((var (aref (edecl-variants e) (1- v))))
                        (when (variant-deprecated var) (invalid "~a: deprecated variant" where))
                        (write-jstring (string-to-octets (variant-name var)) where))))))
    (:flags (let ((names (fdecl-variants (second td))))
              (when (>= v (ash 1 (length names))) (invalid "~a: flags bit no variant names" where))
              (write-jarray (loop for n in names for i from 0 when (logbitp i v) collect n) d
                            (lambda (n dd) (declare (ignore dd)) (write-jstring (string-to-octets n) where)))))
    (:struct (write-table (second td) v d where))
    (:union (write-union (second td) v d where))
    (:map (write-map td v d where))
    (:array (write-array td v d where))
    (:ptr (cond ((null v) (out "null"))
                ((blob-p v) (if (eq (blob-kind v) :bytes)
                                (write-ascii-string (base64-encode (blob-data v)))
                                (write-jstring (blob-data v) where)))
                (t (write-node v d where))))))

(defun write-jarray (items d writer)
  "W4's layout over ITEMS."
  (if (null items)
      (out "[]")
      (progn (out "[")
             (loop for x in items for first = t then nil
                   do (unless first (out ",")) (nl (1+ d)) (funcall writer x (1+ d)))
             (nl d) (out "]"))))

(defun write-jobject (members d)
  "W3's layout over MEMBERS: (key-writer . value-writer) pairs."
  (if (null members)
      (out "{}")
      (progn (out "{")
             (loop for (kw . vw) in members for first = t then nil
                   do (unless first (out ",")) (nl (1+ d)) (funcall kw) (out ": ") (funcall vw (1+ d)))
             (nl d) (out "}"))))

(defun field-members (tv where)
  (mapcar (lambda (f)
            (cons (lambda () (write-jstring (string-to-octets (field-key f)) where))
                  (lambda (dd) (write-jvalue (field-type f) (aref (tval-slots tv) (field-index f)) dd
                                             (format nil "~a.~a" where (field-name f))))))
          (present-fields tv)))

(defun write-table (decl tv d where)
  "W3 (and W14 for a json=\"array\" table)."
  (when (> d +json-max-depth+) (invalid "~a: past the depth cap" where))
  (if (sdecl-json-array decl)
      (let ((f (aref (struct-fields decl) 0)))
        (write-jvalue (field-type f) (aref (tval-slots tv) 0) d where))
      (write-jobject (field-members tv (sdecl-name decl)) d)))

(defun write-node (tv d where)
  (when (> d +json-max-depth+) (invalid "~a: past the depth cap" where))
  (let ((label (gethash tv *jlabels*)))
    (cond
      (label                                   ; a later occurrence: a reference
       (write-jobject (list (cons (lambda () (out "\"&node\"")) (lambda (dd) (declare (ignore dd)) (out (format nil "~d" label))))) d))
      ((> (gethash tv *namings* 0) 1)          ; a shared node's first occurrence: its definition
       (let ((members (field-members tv (sdecl-name (tval-decl tv)))))
         (when (null members) (invalid "~a: a definition holding no field" where))
         (let ((label (incf *next-label*)))
           (setf (gethash tv *jlabels*) label)
           (write-jobject (cons (cons (lambda () (out "\"&node\"")) (lambda (dd) (declare (ignore dd)) (out (format nil "~d" label))))
                                members)
                          d))))
      (t (write-table (tval-decl tv) tv d where)))))

(defun write-union (u v d where)
  (if (null v)
      (out "{}")
      (let ((arms (union-arms u)))
        (when (or (< (car v) 1) (> (car v) (length arms))) (invalid "~a: union tag" where))
        (let ((arm (aref arms (1- (car v)))))
          (write-jobject (list (cons (lambda () (write-jstring (string-to-octets (arm-name arm)) where))
                                     (lambda (dd) (if (null (arm-type arm))
                                                      (out "null")
                                                      (write-jvalue (arm-type arm) (cdr v) dd where)))))
                         d)))))

(defun write-map (td v d where)
  (destructuring-bind (ktd vtd) (rest td)
    (let ((entries (stable-sort (copy-list v) (lambda (a b) (key-less-p ktd (car a) (car b))))))
      (write-jobject
       (mapcar (lambda (e)
                 (cons (lambda () (if (eq (first ktd) :string)
                                      (write-jstring (car e) where)
                                      (write-ascii-string (format nil "~d" (car e)))))
                       (lambda (dd) (if (and (eq (first vtd) :optional) (eq (cdr e) :absent))
                                        (out "null")
                                        (write-jvalue vtd (cdr e) dd where)))))
               entries)
       d))))

(defun write-array (td v d where)
  (destructuring-bind (mode lo hi elem) (rest td)
    (ecase mode
      (:keyed
       (write-jobject
        (loop for var across (edecl-variants hi) for i from 0
              collect (let ((i i) (var var))
                        (cons (lambda () (write-jstring (string-to-octets (variant-name var)) where))
                              (lambda (dd) (write-jvalue elem (aref v i) dd where)))))
        d))
      ((:fixed :counted :unbounded)
       (when (and hi (> (length v) hi)) (invalid "~a: count past its bound" where))
       (when (< (length v) lo) (invalid "~a: count below its bound" where))
       (write-jarray (coerce v 'list) d
                     (lambda (e dd)
                       (if (eq (first elem) :optional)
                           (if (null e) (out "null") (write-jvalue (second elem) e dd where))
                           (write-jvalue elem e dd where))))))))

(defun json-write-value (tv)
  "§16.1's ToJson: the canonical text of a root value, or a refusal (W0)."
  (let ((*out* (make-array 256 :element-type '(unsigned-byte 8) :adjustable t :fill-pointer 0))
        (*namings* (make-hash-table :test 'eq))
        (*jlabels* (make-hash-table :test 'eq))
        (*next-label* 0))
    (let ((open (make-hash-table :test 'eq)))
      (setf (gethash tv open) t)
      (graph-walk tv open))
    (write-table (tval-decl tv) tv 0 (sdecl-name (tval-decl tv)))
    (vector-push-extend 10 *out*)
    (coerce *out* 'octets)))
