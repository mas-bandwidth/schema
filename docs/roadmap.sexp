  ; The variable-tables roadmap: one task per cell; a done task names its tests, an open one says what exists and what is missing.
  (:id "variable-tables" :type :roadmap :title "Variable tables" :text ("Variable tables are the table wire's variable class: pointers and the flat node table, maps, unbounded arrays, blobs, union arms of any field type, retain-unknown, the text, block, cook and message forms, and the reflection that walks them. C++ is the reference; C, C# and Go carry the whole class." "Rust, Java, JavaScript, Dart and Elixir carry the card constructs (the subset the sprint's card record uses) and refuse the rest by name. A cell is ✅ only when the whole row is carried and its tests pass on this branch, so a card-constructs-only port stays ❌ until the rest of the row lands; each ❌ cell's source data says what exists and what is missing." "A leg that is red at the branch head holds its cells ❌ even where the row's tests exist: the source data names the one task that holds them, so one fix card turns them green together.") :rows (("fixed-class" "fixed class on the table wire") ("optional-fields" "optional fields ?T") ("enum-keyed-arrays" "enum-keyed arrays [E]T") ("text-form" "text form: JSON in and out of a table") ("reflection" "reflection descriptors") ("block-read" "block form, read side") ("cook-open" "cook open") ("build-version" "build version") ("variable-class" "variable class (pointers, the flat node table)") ("text-form-variable" "text form, variable class") ("block-build" "block form, build side") ("cook-write" "cook write in the runtime") ("wide-scalars" "fixed-point and 128-bit scalars on the table wire") ("union-table-arms" "unions whose arms are tables") ("pointer-arrays" "arrays of pointers") ("union-arrays" "arrays of unions") ("optional-arrays" "optional arrays") ("blobs" "blobs (*bytes, *string)") ("string-identity" "a caller's equal strings in two blob slots save by value") ("wire-fuzzer" "the wire fuzzer gate") ("maps" "maps") ("union-arms-any" "union arms of any field type") ("defaults-and-table-rename" "string, bytes and flags defaults, and renaming a table") ("renames" "renaming variants, arms and type fields") ("id-table-wire" "the 64-bit id-table wire, enum and escape kinds") ("wstring" "wstring(N) on the table wire (#522)") ("unbounded-arrays" "unbounded arrays") ("message-form" "the message form (form byte 2, a bitpacked body)") ("retain-unknown" "retain-unknown") ("doc-tags" "doc comments and tags in the descriptors") ("unit-registry" "the unit registry, UnitView") ("widening" "widening on read, and the refusal reasons") ("cards" "cards: the sprint's card record as a variable table (tables/cards)")) :columns (("cpp" "cpp") ("c" "c") ("cs" "cs") ("go" "go") ("rust" "rust") ("java" "java") ("js" "js") ("dart" "dart") ("elixir" "elixir") ("goose" "goose") ("luau" "luau") ("lua" "lua") ("squirrel" "squirrel") ("moo" "moo") ("lobster" "lobster")) :cells (("fixed-class" "cpp" "vt/fixed-class/cpp") ("fixed-class" "c" "vt/fixed-class/c/cell") ("fixed-class" "cs" "vt/fixed-class/cs/cell") ("fixed-class" "go" "vt/fixed-class/go") ("fixed-class" "rust" "vt/fixed-class/rust") ("fixed-class" "java" "vt/fixed-class/java") ("fixed-class" "js" "vt/fixed-class/js") ("fixed-class" "dart" "vt/fixed-class/dart") ("fixed-class" "elixir" "vt/fixed-class/elixir") ("optional-fields" "cpp" "vt/optional-fields/cpp") ("optional-fields" "c" "vt/optional-fields/c/cell") ("optional-fields" "cs" "vt/optional-fields/cs/cell") ("optional-fields" "go" "vt/optional-fields/go") ("optional-fields" "rust" "vt/optional-fields/rust") ("optional-fields" "java" "vt/optional-fields/java") ("optional-fields" "js" "vt/optional-fields/js") ("optional-fields" "dart" "vt/optional-fields/dart") ("optional-fields" "elixir" "vt/optional-fields/elixir") ("enum-keyed-arrays" "cpp" "vt/enum-keyed-arrays/cpp") ("enum-keyed-arrays" "c" "vt/enum-keyed-arrays/c/cell") ("enum-keyed-arrays" "cs" "vt/enum-keyed-arrays/cs/cell") ("enum-keyed-arrays" "go" "vt/enum-keyed-arrays/go") ("enum-keyed-arrays" "rust" "vt/enum-keyed-arrays/rust") ("enum-keyed-arrays" "java" "vt/enum-key