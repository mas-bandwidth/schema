  ; The packet-wire roadmap: one task per language and gate, the evidence the legs' make targets.
  (:id "packet-wire" :type :roadmap :title "Packet wire" :text ("Constants, enums, flags and types: bit-packed structs exchanged between client and server with exactly the same protocol version." "A cell is ✅ when the language's packet leg passes on this branch: the examples generated and run against the shared wire vectors the C++ reference writes (make test-<lang>), with the packet-text (#519), packet-wide (#188) and packet-defaults (#396) gates and their negative controls.") :rows (("constants" "constants and compile-time expressions") ("enums" "enums") ("flags" "flags") ("types" "types, bitpacked structs") ("composition" "composition of types by value") ("unions" "tagged unions of type payloads") ("payload-free-arms" "named payload-free union arms") ("bool" "bool") ("full-width-integers" "full-width integers, 8 to 64 bits") ("ranged-integers" "ranged integers") ("bits" "bits(N)") ("int128" "raw uint128 and ranged int128") ("floats" "raw float32 and float64") ("compressed-float" "compressed float32") ("fixed-point" "fixed(I, F) and ufixed(I, F)") ("bytes" "bytes(N)") ("string" "string(N)") ("string-utf8-refusal" "string(N) refuses malformed UTF-8 on read (#519)") ("wstring" "wstring(N) (#188)") ("fixed-arrays" "fixed arrays [N]T") ("counted-arrays" "counted arrays [A..B]T") ("if-else" "if / else") ("const" "on-wire const(Value, Bits)") ("reserved" "reserved(Bits)") ("align" "align") ("scalar-defaults" "defaults for scalar, enum and fixed fields") ("text-defaults" "string, bytes and flags defaults (#396)") ("protocol-id" "the protocol id")) :columns (("cpp" "cpp") ("c" "c") ("cs" "cs") ("go" "go") ("rust" "rust") ("java" "java") ("js" "js") ("dart" "dart") ("elixir" "elixir") ("goose" "goose") ("luau" "luau") ("lua" "lua") ("squirrel" "squirrel") ("moo" "moo") ("lobster" "lobster")) :cells (("constants" "cpp" "packet/cpp/leg") ("constants" "c" "packet/c/leg") ("constants" "cs" "packet/cs/leg") ("constants" "go" "packet/go/leg") ("constants" "rust" "packet/rust/leg