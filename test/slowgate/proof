#!/bin/sh
# THE NAMED-PASS RUN-PROOF (schema#988, G5).
#
# A test that does not run makes `go test` exit 0 just as one that passed: a
# target that runs a bare `go test` can go green having run nothing. So a
# target that names the tests it proves calls its `go test` THROUGH HERE, and
# this script does two things no exit code can do on its own:
#
#   1. it REFUSES ANY SKIP: one `--- SKIP:` line in the log is a failure, even
#      at exit 0. No test may skip (a test that is not to run is left out at
#      the root, the one driver's query in tools/schema-test, never inside it),
#   2. it REQUIRES A NAMED `--- PASS` PER TEST, because a test that does not
#      exist never prints one, and Go prints `--- PASS` for the PARENT of a
#      subtest that did not pass, so the parent's PASS proves nothing about
#      `TestCppVariableWideAlignment/direct`. The names are matched with their
#      trailing ` (` so a prefix (TestRetain) cannot stand in for the whole
#      (TestRetainUnknownNodeRecord).
#
# usage: sh test/slowgate/proof <label> '<required --- PASS names>' <go test args...>
#
# The log is build/slowgate/<label>.log (SLOWGATE_LOG_DIR moves it). Output is
# bounded by design (one line on success, the log only on failure): a target's
# receipt is a count, not a transcript.
set -e

label="${1-}"
if [ $# -gt 0 ]; then shift; fi
required="${1-}"
if [ $# -gt 0 ]; then shift; fi

if [ -z "$label" ] || [ $# -eq 0 ]; then
	echo "test/slowgate/proof: usage: proof <label> '<required PASS names>' <go test args...>" >&2
	exit 2
fi
if [ -z "$required" ]; then
	echo "test/slowgate/proof: $label names no required test. A target that cannot name one test it proves does not belong here." >&2
	exit 2
fi

logdir="${SLOWGATE_LOG_DIR:-build/slowgate}"
mkdir -p "$logdir"
log="$logdir/$label.log"

rc=0
go test -v "$@" > "$log" 2>&1 || rc=$?

if [ "$rc" -ne 0 ]; then
	cat "$log"
	echo "PROOF $label: go test exited $rc: the tests ran and are RED. Fix the red; do not loosen the check."
	exit "$rc"
fi

if grep -q -e '--- SKIP:' "$log"; then
	echo "PROOF $label FAILED: a test skipped, and a skip is a failure (no test may decide not to run; leave a test out at the root, tools/schema-test):"
	grep -n -e '--- SKIP:' "$log"
	exit 1
fi

missing=""
for want in $required; do
	if ! grep -F -q -- "--- PASS: $want (" "$log"; then
		missing="$missing $want"
	fi
done
if [ -n "$missing" ]; then
	echo "PROOF $label FAILED: no \`--- PASS\` for the test(s) this target names, so the target proved nothing about them (a test that does not exist fails):$missing"
	echo "(a parent's --- PASS is printed even when a named subtest did not pass, which is why the name is required verbatim)"
	cat "$log"
	exit 1
fi

count=$(printf '%s\n' $required | wc -l | tr -d ' ')
echo "PROOF $label: $count named test(s) ran and PASS ($log)"
