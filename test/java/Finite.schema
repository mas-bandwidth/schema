// The finite-float shapes the Java packet harness refuses NaN and both
// infinities on (SPEC §4.3): a bare float32 and float64 as fields, each as an
// array element (a fixed array and a counted one), and a compressed float32.
// test/java/FiniteMain.java writes and reads them; make/java.mk builds it.
package packetfinite

type Scalars
{
    f32 float32
    f64 float64
}

type Elements
{
    a32 [2]float32
    a64 [..2]float64
}

type Quantized
{
    q float32 | min = -1, max = 1, resolution = 0.01
}
