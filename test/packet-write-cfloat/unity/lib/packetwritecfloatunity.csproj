<Project Sdk="Microsoft.NET.Sdk">

  <!-- The generated PacketCFloat unit this driver exercises, in the Unity
       dialect (test/unity/UnityDialect.props). -->
  <Import Project="../../../unity/UnityDialect.props" />

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>packetwritecfloatunity</AssemblyName>
    <CFloatDir Condition="'$(CFloatDir)' == ''">$(MSBuildThisFileDirectory)../../../../build/packet-write-cfloat/unity</CFloatDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(CFloatDir)/*.cs" />
  </ItemGroup>

</Project>
