<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Unity twin of the packet compressed-float write driver: the
       generated PacketCFloat unit, compiled in the Unity dialect by lib/,
       driven from a .NET host in a Debug build, where the write asserts are
       live. -->
  <Import Project="../../unity/HostDialect.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>packet-write-cfloat-unity</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <ProjectReference Include="lib/packetwritecfloatunity.csproj" />
  </ItemGroup>

</Project>
