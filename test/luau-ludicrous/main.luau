--!strict
-- The Luau cross-language wire test for the fixed-point and 128-bit unit
-- (examples128/), the twin of test/js-ludicrous/main.mjs and
-- test/ludicrous_main.cpp block for block: the generated module writes the
-- SAME pinned instances and byte-compares against the C++-pinned
-- testdata/wire goldens, reads them back, zeroes an untaken 128-bit field,
-- installs the specified 128-bit defaults, and rejects (never clamps) hostile
-- offsets and truncation. pins.luau carries the goldens in as source (the
-- interpreter has no io library). Prints OK, or the failures and an error.
local serialize = require("./serialize")
local lud = require("./Ludicrous")
local pins: { [string]: string } = require("./pins") :: any

local failed = false
local function check(ok: boolean, what: string)
	if not ok then
		print("FAILED: " .. what)
		failed = true
	end
end

local function hex(b: buffer): string
	local parts = table.create(buffer.len(b))
	for i = 0, buffer.len(b) - 1 do
		parts[i + 1] = string.format("%02x", buffer.readu8(b, i))
	end
	return table.concat(parts)
end

local function copy(b: buffer): buffer
	local out = buffer.create(buffer.len(b))
	buffer.copy(out, 0, b, 0, buffer.len(b))
	return out
end

local function i128(lo: integer, hi: integer): any
	return { lo = lo, hi = hi }
end

local function eq128(a: any, b: any): boolean
	return a.lo == b.lo and a.hi == b.hi
end

-- deepEqual compares two values field by field, buffers by content.
local function deepEqual(a: any, b: any): boolean
	if type(a) ~= type(b) then
		return false
	end
	if type(a) == "buffer" then
		return buffer.tostring(a) == buffer.tostring(b)
	end
	if type(a) ~= "table" then
		return a == b
	end
	for k, x in a do
		if not deepEqual(x, b[k]) then
			return false
		end
	end
	for k in b do
		if a[k] == nil then
			return false
		end
	end
	return true
end

-- goldenWire byte-compares written wire against the C++-pinned golden.
local function goldenWire(name: string, data: buffer)
	check(pins[name] ~= nil, "the golden " .. name .. " is carried in")
	check(hex(data) == pins[name], "wire golden " .. name .. ": Luau bytes " .. hex(data) .. " must equal the C++-pinned bytes")
end

-- setBits forces bits [pos, pos + n) of a wire image to 1: the hostile
-- reader's tool, smuggling an offset into a range's bit headroom, which a
-- read must REJECT, never clamp (STANDARD.md).
local function setBits(data: buffer, pos: number, n: number)
	for i = pos, pos + n - 1 do
		local byte = i // 8
		buffer.writeu8(data, byte, bit32.bor(buffer.readu8(data, byte), bit32.lshift(1, i % 8)))
	end
end

local function write(fn: (any, any) -> boolean, v: any, what: string): buffer
	local ws = serialize.WriteStream.new(buffer.create(256))
	check(fn(ws, v), "write " .. what)
	ws:flush()
	return ws:data()
end

-- makeState is test/ludicrous_main.cpp's make_state: the values stay mirrored.
local function makeState(): any
	local inp: any = lud.NewLudicrousState()
	inp.Mode = lud.DriveMode.Ludicrous
	inp.Probe.Angle = 2981888 -- +45.5 * 2^16
	inp.Probe.Position = -809119744i -- -12346.1875 * 2^16
	inp.Probe.Reach = i128(65535999999i, 0i) -- raw_max - 1
	inp.Probe.Ticks = 777777
	inp.Probe.Samples[1] = -524288 -- raw_min
	inp.Probe.Samples[2] = 524288 -- raw_max
	inp.Wide.EntityId = i128(0xfedcba9876543210i, 0x0123456789abcdefi)
	inp.Wide.Energy = i128(4999999999i, 0i)
	inp.Wide.Flux = i128(7i, 0x0000000800000000i) -- 2^99 + 7
	-- Wide.Bias and Wide.Seed stay at their SPECIFIED DEFAULTS (-250 and 2^65)
	inp.KeysCount = 2
	inp.Keys[1] = i128(1i, 0i)
	inp.Keys[2] = i128(0i, 0x8000000000000000i) -- 2^127
	inp.HasTarget = true
	inp.TargetId = i128(42i, 0i)
	return inp
end

-- worst-case bounds, hand-derived (SPEC §6.1 item 4): the numbers
-- test/ludicrous_main.cpp static_asserts
check(lud.FixedProbeMaxBits == 156, "FixedProbe worst case")
check(lud.WideProbeMaxBits == 403, "WideProbe worst case")
check(lud.LudicrousStateMaxBits == 1205, "LudicrousState worst case")
check(lud.ProtocolId ~= 0i, "the unit has a protocol id")

-- construction installs the specified defaults (SPEC §4.2), one of which no
-- 64-bit literal can spell; Zero is the §5 zero form
do
	local zero: any = lud.NewLudicrousState()
	check(zero.Mode == lud.DriveMode.None, "a fresh state starts at DriveMode None")
	check(eq128(zero.Probe.Reach, i128(0i, 0i)), "reach starts zero")
	check(eq128(zero.Wide.EntityId, i128(0i, 0i)), "entity_id starts zero")
	check(eq128(zero.Wide.Bias, i128(-250i, -1i)), "bias defaults -250")
	check(eq128(zero.Wide.Seed, i128(0i, 2i)), "seed defaults 2^65")
	check(zero.KeysCount == 0, "keys start empty")
	check(eq128(zero.TargetId, i128(0i, 0i)), "target_id starts zero")
	lud.ZeroLudicrousState(zero)
	check(eq128(zero.Wide.Bias, i128(0i, 0i)), "the §5 zero form stays zero")
end

-- the taken-branch wire: generated bytes == the C++-pinned golden
local takenWire: buffer
do
	local inp = makeState()
	takenWire = write(lud.WriteLudicrousState, inp, "LudicrousState")
	goldenWire("ludicrous_state", takenWire)
	local out: any = lud.NewLudicrousState()
	check(lud.ReadLudicrousState(serialize.ReadStream.new(takenWire), out), "read LudicrousState")
	check(out.Mode == lud.DriveMode.Ludicrous, "mode round-trips")
	check(deepEqual(out.Probe, inp.Probe), "the fixed probe round-trips")
	check(deepEqual(out.Wide, inp.Wide), "the wide probe round-trips, the defaults riding the wire")
	check(out.KeysCount == 2 and eq128(out.Keys[1], inp.Keys[1]) and eq128(out.Keys[2], inp.Keys[2]), "keys round-trip")
	check(out.HasTarget and eq128(out.TargetId, i128(42i, 0i)), "the taken branch round-trips")
end

-- the untaken branch: the 128-bit field under it reads back ZERO into a
-- dirty object (SPEC §5)
do
	local inp = makeState()
	inp.HasTarget = false
	local data = write(lud.WriteLudicrousState, inp, "LudicrousState untargeted")
	goldenWire("ludicrous_state_untargeted", data)
	local out: any = lud.NewLudicrousState()
	out.TargetId = i128(0xdeadi, 0i)
	check(lud.ReadLudicrousState(serialize.ReadStream.new(data), out), "read LudicrousState untargeted")
	check(not out.HasTarget, "has_target reads false")
	check(eq128(out.TargetId, i128(0i, 0i)), "the untaken 128-bit field reads as zero (SPEC §5)")
end

-- hostile reads REJECT, never clamp (STANDARD.md, SPEC §5)
do
	-- fixed: angle's 25 offset bits start at bit 2; all ones is above the raw range
	local hostile = copy(takenWire)
	setBits(hostile, 2, 25)
	check(not lud.ReadLudicrousState(serialize.ReadStream.new(hostile), lud.NewLudicrousState()), "a smuggled fixed offset is REJECTED")
	-- int128: energy's 34 offset bits start at bit 286; all ones is above 10^10
	hostile = copy(takenWire)
	setBits(hostile, 286, 34)
	check(not lud.ReadLudicrousState(serialize.ReadStream.new(hostile), lud.NewLudicrousState()), "a smuggled int128 offset is REJECTED")
	-- truncation: running out of input mid-read is a read failure (SPEC §5)
	local short = buffer.create(4)
	buffer.copy(short, 0, takenWire, 0, 4)
	check(not lud.ReadLudicrousState(serialize.ReadStream.new(short), lud.NewLudicrousState()), "a truncated stream is a read failure")
end

-- DegenerateProbe: min == max costs ZERO bits (SPEC §4.6); the whole wire
-- is the tail byte
do
	check(lud.DegenerateProbeMaxBits == 8, "three degenerate fields cost zero bits")
	local inp: any = lud.NewDegenerateProbe()
	inp.LockedFixed = -196608 -- -3 * 2^16, the ONE legal raw
	inp.LockedInt = 7
	inp.LockedWide = i128(-12345678901234i, -1i)
	inp.Tail = 0xa5
	local data = write(lud.WriteDegenerateProbe, inp, "DegenerateProbe")
	goldenWire("degenerate_probe", data)
	local out: any = lud.NewDegenerateProbe()
	check(lud.ReadDegenerateProbe(serialize.ReadStream.new(data), out), "read DegenerateProbe")
	check(deepEqual(out, inp), "DegenerateProbe round-trips: every value materialized from its range")
end

-- UnsignedProbe: ufixed(I, F) (SPEC §4.3); span's raw value fills uint64's
-- HIGH HALF, carried as the integer's unsigned bit pattern
do
	check(lud.UnsignedProbeMaxBits == 196, "UnsignedProbe worst case")
	local inp: any = lud.NewUnsignedProbe()
	inp.Angle = 2981888
	inp.Span = 0xffffffffffff0000i -- raw_max, the uint64 high half
	inp.Reach = i128(131071999999i, 0i) -- raw_max - 1
	inp.Ticks = 777777
	inp.Samples[1] = 0
	inp.Samples[2] = 1048576
	inp.Locked = 196608 -- 3 * 2^16, the ONE legal raw
	inp.Tail = 0xa5
	local uWire = write(lud.WriteUnsignedProbe, inp, "UnsignedProbe")
	goldenWire("unsigned_probe", uWire)
	local out: any = lud.NewUnsignedProbe()
	check(lud.ReadUnsignedProbe(serialize.ReadStream.new(uWire), out), "read UnsignedProbe")
	check(deepEqual(out, inp), "UnsignedProbe round-trips, the uint64 high half bit-exact")
	-- the write-side degenerate refusal: any raw but 3 * 2^16 is refused
	inp.Locked = 196609
	check(not lud.WriteUnsignedProbe(serialize.WriteStream.new(buffer.create(256)), inp), "a wrong degenerate ufixed raw is REFUSED on write")
	-- hostile: span's 64 offset bits from bit 25, all ones, above the raw
	-- range in the UNSIGNED domain
	local hostile = copy(uWire)
	setBits(hostile, 25, 64)
	check(not lud.ReadUnsignedProbe(serialize.ReadStream.new(hostile), lud.NewUnsignedProbe()), "a smuggled ufixed high-half offset is REJECTED")
end

if failed then
	error("luau ludicrous: FAILED")
end
print("OK")
