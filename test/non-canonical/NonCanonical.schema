// The non-canonical spelling corpus (docs/SPEC-TABLES.md §3, §3.1, §3.3, §4;
// docs/rulings.json reads-refuse-non-canonical). `Root` carries the variable
// form's cases: two scalars, one at a nonzero declared default, a pointer to
// `Node`, a one-arm union, and a second node type `Other`. `Batch` is the
// fixed table the message form announces.
package noncanonical

table Root
{
    a    uint32 = 7
    b    uint32
    next *Node
    pick Pick
}

union Pick
{
    plain int32
}

table Node
{
    value uint32
}

table Other
{
    x uint32
}

fixed table Batch
{
    mode  uint8 = 7
    count uint8
    note  uint8
    pick  Pick
}
