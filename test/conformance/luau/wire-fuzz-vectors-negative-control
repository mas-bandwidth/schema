#!/bin/sh
# THE LUAU VECTORS' CONTROL (make/luau-fuzz.mk, tables-luau-wire-fuzz-vectors):
# each pinned vector's strict verdict is broken in a scratch copy of the
# artifact the vector covers, and that vector's replay must diverge from the
# Go engine (docs/SPEC-TABLES.md §4.2, the engine is the oracle). A plant whose
# anchor is not found once per target fails the control rather than passing it
# vacuously.
#
# The strict cut removed the tolerant read (docs/plans/strict-only.md), so a
# vector that once pinned a tolerant counter now pins the STRICT VERDICT: the
# whole load refuses. The plant therefore restores the tolerant read -- damage
# no longer discards the load, and the report counters no longer refuse -- or,
# for a fixed root's form-1 wire, restores the pre-strict fixed-form dispatch
# that let the variable read answer. The region vector's strict verdict is
# acceptance, and its plant makes the driver's LoadMeasure refuse a root whose
# extent alignment raises the region above the default. In every case the leg
# and the oracle disagree on the read verdict, and the harness names the
# vector it stopped on.
set -eu

out=build/luau-wire-fuzz-vectors-nc
host=${LUAUFUZZHOST:-build/luaufuzzhost/luaufuzzhost}
for need in build/conformance-harness "$host" build/conformance-luau build/luau-driver/units.luau; do
	if [ ! -e "$need" ]; then
		echo "NEGATIVE CONTROL FAILED: $need is missing (make tables-luau-wire-fuzz-vectors-negative-control builds it)" >&2
		exit 1
	fi
done

# THE TOLERANT READ, AS THE STRICT CUT REMOVED IT: wire damage no longer
# discards the value, and the refusing counters no longer refuse it.
tol='s/\t\tlocal damaged = wireDamage\(b, top, fr\.ids, rep\)/\t\tlocal damaged = false/; s/\tfor _, k in REFUSING do/\tfor _, k in ({}) do/'
# A header whose spelling crosses its L is framed by the whole body rather than
# its own L, and the body's trailing bytes are no longer damage.
frame='s/\tif fr == nil or \(top ~= nil and top\.term \+ 1 ~= fr\.e\) then/\tif fr == nil then/'
# A damaged walk returns its partial value: the malformed flag stops
# discarding the load.
loadfix='s/\tif report\.malformed then return nil end\n\treturn v/\tif false then return nil end\n\treturn v/; s/\tif rep\.duplicate > 0 then rep\.duplicateField = witness\(root, b, "duplicate"\) end\n\treturn v/\tif rep.duplicate > 0 then rep.duplicateField = witness(root, b, "duplicate") end\n\trep.malformed = false\n\treturn v/'
# A fixed root again answers a form-1 wire through the variable read.
fixed='s/\tif d ~= nil and d\.fixed then/\tif false then/g'

# plant <vector> <perl substitution> [driver]: the strict verdict broken, the
# run red on <vector>. The substitution lands in every generated
# schema_load.luau, or in the copied wire-fuzz driver when the third word is
# `driver`.
plant() {
	name=$1 subst=$2 where=${3:-units}
	rm -rf "$out"
	mkdir -p "$out/test/conformance/luau" "$out/build/luau-driver"
	cp test/conformance/luau/wirefuzz.luau "$out/test/conformance/luau/"
	cp build/luau-driver/units.luau "$out/build/luau-driver/"
	cp -R build/conformance-luau "$out/build/conformance-luau"
	planted=0
	targets="$out"/build/conformance-luau/*/schema_load.luau
	[ "$where" = driver ] && targets="$out/test/conformance/luau/wirefuzz.luau"
	for f in $targets; do
		before=$(cksum < "$f")
		perl -0pi -e "$subst" "$f"
		if [ "$(cksum < "$f")" = "$before" ]; then
			echo "NEGATIVE CONTROL FAILED: the $name plant matched nothing in $f" >&2
			exit 1
		fi
		planted=$((planted + 1))
	done
	if [ "$planted" -lt 1 ]; then
		echo "NEGATIVE CONTROL FAILED: no generated schema_load.luau to plant in" >&2
		exit 1
	fi
	line=$(grep -v '^#' test/conformance/luau/wire-fuzz-vectors.txt | awk -v n="$name" '$1 == n')
	if [ -z "$line" ]; then
		echo "NEGATIVE CONTROL FAILED: $name is not in test/conformance/luau/wire-fuzz-vectors.txt" >&2
		exit 1
	fi
	set -- $line
	if build/conformance-harness wire-fuzz --driver "$host $out/test/conformance/luau/wirefuzz.luau" \
		--replay "$4" --unit "$2" --root "$3" --failed "$out/failed.bin" > "$out/log" 2>&1; then
		cat "$out/log"
		echo "NEGATIVE CONTROL FAILED: the $name flaw left its vector green" >&2
		exit 1
	fi
	# THE VERDICT, NOT A REASON: the planted artifact must accept what the
	# Go engine refuses (or, for the region vector, refuse what it accepts).
	if ! grep -qE '^harness: FAILED after 0 mutants: read acceptance differs: the leg says (true, the oracle says false|false, the oracle says true)' "$out/log"; then
		cat "$out/log"
		echo "NEGATIVE CONTROL FAILED: the $name flaw went red, but not as a read-verdict divergence" >&2
		exit 1
	fi
	# THE VECTOR, NOT A NEIGHBOUR: the harness must stop on this vector.
	if ! grep -q "corpus seed ${name}.bin (" "$out/log"; then
		cat "$out/log"
		echo "NEGATIVE CONTROL FAILED: the $name flaw went red on another vector" >&2
		exit 1
	fi
	echo "luau vectors negative control: the $name flaw turns the $name vector red"
}

plant map_header_count_past_length "$tol"
plant keyed_header_count_past_length "$fixed; $tol; $frame; $loadfix"
plant text_ill_formed_repeat_reads_default "$fixed; $tol; $frame; $loadfix"
plant list_count_cross_length "$tol; $frame; $loadfix"
plant map_repeated_key_widen "$tol"
plant region_align_extent_uint128 \
	's/\tif desc\.variable ~= true then return -1 end\n/\tif desc.variable ~= true then return -1 end\n\tif align > 8 then return nil end\n/' driver
