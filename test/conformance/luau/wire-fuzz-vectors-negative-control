#!/bin/sh
# THE LUAU VECTORS' CONTROL (make/luau-fuzz.mk, tables-luau-wire-fuzz-vectors):
# each pinned vector's fix is reverted in a scratch copy of the emitted units,
# and that vector's replay must diverge. A plant whose anchor is not found once per generated
# schema_load.luau fails the control rather than passing it vacuously.
set -eu

out=build/luau-wire-fuzz-vectors-nc
host=${LUAUFUZZHOST:-build/luaufuzzhost/luaufuzzhost}
for need in build/conformance-harness "$host" build/conformance-luau build/luau-driver/units.luau; do
	if [ ! -e "$need" ]; then
		echo "NEGATIVE CONTROL FAILED: $need is missing (make tables-luau-wire-fuzz-vectors-negative-control builds it)" >&2
		exit 1
	fi
done

# plant <vector> <perl substitution> [driver]: the fix reverted, the run red
# on <vector>. The substitution lands in every generated schema_load.luau, or
# in the copied wire-fuzz driver when the third word is `driver`.
plant() {
	name=$1 subst=$2 where=${3:-units}
	rm -rf "$out"
	mkdir -p "$out/test/conformance/luau" "$out/build/luau-driver"
	cp test/conformance/luau/wirefuzz.luau "$out/test/conformance/luau/"
	cp build/luau-driver/units.luau "$out/build/luau-driver/"
	cp -R build/conformance-luau "$out/build/conformance-luau"
	planted=0
	targets="$out"/build/conformance-luau/*/schema_load.luau
	[ "$where" = driver ] && targets="$out/test/conformance/luau/wirefuzz.luau"
	for f in $targets; do
		before=$(cksum < "$f")
		perl -0pi -e "$subst" "$f"
		if [ "$(cksum < "$f")" = "$before" ]; then
			echo "NEGATIVE CONTROL FAILED: the $name plant matched nothing in $f" >&2
			exit 1
		fi
		planted=$((planted + 1))
	done
	if [ "$planted" -lt 1 ]; then
		echo "NEGATIVE CONTROL FAILED: no generated schema_load.luau to plant in" >&2
		exit 1
	fi
	line=$(grep -v '^#' test/conformance/luau/wire-fuzz-vectors.txt | awk -v n="$name" '$1 == n')
	if [ -z "$line" ]; then
		echo "NEGATIVE CONTROL FAILED: $name is not in test/conformance/luau/wire-fuzz-vectors.txt" >&2
		exit 1
	fi
	set -- $line
	if build/conformance-harness wire-fuzz --driver "$host $out/test/conformance/luau/wirefuzz.luau" \
		--replay "$4" --unit "$2" --root "$3" --failed "$out/failed.bin" > "$out/log" 2>&1; then
		cat "$out/log"
		echo "NEGATIVE CONTROL FAILED: the $name fix reverted left its vector green" >&2
		exit 1
	fi
	if ! grep -q '^harness: FAILED after 0 mutants: ' "$out/log"; then
		cat "$out/log"
		echo "NEGATIVE CONTROL FAILED: the $name fix reverted went red, but not as a divergence on its replay" >&2
		exit 1
	fi
	echo "luau vectors negative control: the $name fix reverted turns the $name vector red"
}

# UNDER THE STRICT READ the fuzzer compares the verdict and the written-back
# bytes only (docs/rulings.json strict-only-read, refusal-verdict-only), so a
# plant that only trades one refusal for another (kind_mismatch for framing
# damage, a cap refusal for damage) or only moves a counter is invisible on its
# old vector: both readers refuse it either way. Each such control is re-aimed
# at the rule that took the old one's place, on the code it planted in, and at
# a vector that rule alone refuses: the plant turns REFUSED into READ.
#
# the map header's element kind is judged and a foreign kind refuses
plant map_header_foreign_element_kind \
	's/if ek ~= 13 then report\.kindMismatch = report\.kindMismatch \+ 1; r\.at = endpos; return true end/if ek ~= 13 then r.at = endpos; return true end/'
# the keyed body's element kind, the same rule on kind 16
plant keyed_header_foreign_element_kind \
	's/if not widens\(ek, fd\.ek\) then report\.kindMismatch = report\.kindMismatch \+ 1; r\.at = endpos; return true end/if not widens(ek, fd.ek) then r.at = endpos; return true end/'
# kind 12's content rule: ill-formed text refuses the load
plant text_ill_formed_refuses \
	's/(local function utf8_ok\(b: buffer, at: number, n: number\): boolean\n)/$1\tif true then return true end -- PLANTED: the kind 12 content rule is gone\n/'
# the key scan's foreign key kind refuses (the later-widening reset it once
# guarded is a repeated key under the strict read, refused either way)
plant map_key_foreign_kind \
	's/report\.kindMismatch = report\.kindMismatch \+ 1\n(\t+)landed = \{\}/landed = {}/'
