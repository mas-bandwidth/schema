#!/bin/sh
# Prove the restored Go gates detect a changed wire, a changed message batch,
# a missing text event, a noncanonical integer accepted by the generated
# wire reader, an absent case that writes no `.absent` answer, the 4096
# id-table entry cap (docs/LAYERS/1-framing.md) taken out of the generated
# reader (frame-cap), a text writer that emits map keys out of order
# (key-order), and a text writer that writes storage that is not text
# (text-refusal).
set -eu

mode=$1
out=build/go-table-control-$mode
mkdir -p "$out"
case "$mode" in
wire)
    source=test/conformance/go/main.go
    sed '/if err := spill(out, f\[1\], scratch);/i\
        if f[1] == "root_full" { scratch[0] ^= 1 }
    ' "$source" > "$out/source.gotext"
    ;;
message)
    source=test/conformance/go/messages.go
    sed '/if err := spill(out, f\[1\], answer);/i\
        if f[1] == "login_full" { answer[len(answer)-1] ^= 1 }
    ' "$source" > "$out/source.gotext"
    ;;
cycle)
    # a load's refusal of a pointer naming an open node (docs/SPEC-TABLES.md
    # §3.1, §4) taken out of the generated graphdemo reader
    source=$(grep -l '^func tableCycleCheck(' build/tables-generated-go/pointers/*.go)
    sed 's/if visited != vertices {/if false { \/\/ SABOTAGED: a cycle reads clean/' "$source" > "$out/source.gotext"
    ;;
key-order)
    # the generated mapdemo text writer walks each map's entries in DESCENDING
    # key order (docs/SPEC-TABLES.md §16.14, W6): the stored order is untouched,
    # so only the text moves
    source=$(grep -l '^func tableJSONWriteMap(' build/tables-generated-go/maps/*TableJson.go)
    sed 's/at := unsafe.Add(base, int64(i)\*int64(f.ElemSize))/at := unsafe.Add(base, int64(count-1-i)*int64(f.ElemSize)) \/\/ SABOTAGED: descending keys/' "$source" > "$out/source.gotext"
    ;;
text-refusal)
    # the generated text writer WRITES storage that is not text instead of
    # refusing it (docs/SPEC-TABLES.md §16.14, W0): the raw byte in tabledemo's
    # narrow writer, U+FFFD in widedemo's wide one
    source=$(grep -l 'out.invalid = true // not text: the write refuses' build/tables-generated-go/examples/*TableJson.go)
    sed 's|out.invalid = true // not text: the write refuses|out.put(c) // SABOTAGED: written, not refused|' "$source" > "$out/source.gotext"
    ;;
write-refusal)
    # the variable and fixed writers' ranged-scalar check removed from a copy
    # of the generated Go: the write-refusal and write-refusal-fixed rows must
    # go red while the message form (a different writer) stays green
    source=$(grep -l 'if value.Penetration < 0 || value.Penetration > 10 {' build/tables-generated-go/examples/*Table.go)
    perl -0pe 's/if value\.Penetration < 0 \|\| value\.Penetration > 10 \{\n(\s*)return false/if false { \/\/ SABOTAGED: write range check removed\n$1return false/g' "$source" > "$out/source.gotext"
    if cmp -s "$source" "$out/source.gotext"; then
        echo "negative control patched nothing: $mode ($source)" >&2
        exit 1
    fi
    ;;
walk)
    source=$(grep -l 'func (in \*tableJSONIn) scanString' build/tables-generated-go/examples/*TableJson.go)
    sed 's/if clamped {/if false \&\& clamped {/g' "$source" > "$out/source.gotext"
    ;;
leb|leb-driver)
    source=$(grep -l 'if i > 0 && b == 0' build/tables-generated-go/examples/*Table.go)
    sed 's/if i > 0 \&\& b == 0/if false/' "$source" > "$out/source.gotext"
    ;;
frame-cap)
    source=$(grep -l 'if n > 4096 {' build/tables-generated-go/r1/*Table.go)
    sed 's/if n > 4096 {/if false { \/\/ SABOTAGED: no entry cap/' "$source" > "$out/source.gotext"
    ;;
absent)
    # Model two explicit missing cases before suppressing their markers.
    # Neither control may depend on a naturally unsupported feature surviving
    # as this backend gains coverage. First prove these markers are accepted.
    source=test/conformance/go/main.go
    sed '/^func surfaceWire(/,/^}/ {
        /c := findCodec(f\[2\], f\[3\])/a\
        if f[1] == "root_full" { if err := spillAbsentReason(out, f[1], "negative-control missing case"); err != nil { return err }; continue }
    }
    /^func surfaceFraming(/,/^}/ {
        /c := findCodec(f\[2\], f\[3\])/a\
        if f[1] == "frame_empty_table" { c = nil }
    }' "$source" > "$out/present.gotext"
    grep -Fq 'negative-control missing case' "$out/present.gotext"
    grep -Fq 'if f[1] == "frame_empty_table" { c = nil }' "$out/present.gotext"
    sed 's|return os.WriteFile(filepath.Join(dir, name+".absent"), nil, 0o644)|return nil // SABOTAGED: an absent case writes nothing|' "$out/present.gotext" > "$out/source.gotext"
    source2=test/conformance/go/messages.go
    sed 's|return os.WriteFile(filepath.Join(dir, name+".absent"), \[\]byte(reason), 0o644)|_ = filepath.Join; return nil // SABOTAGED: an absent case writes nothing|' "$source2" > "$out/source2.gotext"
    if cmp -s "$source2" "$out/source2.gotext"; then
        echo "negative control patched nothing: $mode ($source2)" >&2
        exit 1
    fi
    ;;
*) echo "unknown control: $mode" >&2; exit 1 ;;
esac
if cmp -s "$source" "$out/source.gotext"; then
    echo "negative control patched nothing: $mode" >&2
    exit 1
fi
root=$(pwd)
if [ -n "${source2:-}" ]; then
    printf '{"Replace":{"%s/%s":"%s/%s/source.gotext","%s/%s":"%s/%s/source2.gotext"}}\n' "$root" "$source" "$root" "$out" "$root" "$source2" "$root" "$out" > "$out/overlay.json"
else
    printf '{"Replace":{"%s/%s":"%s/%s/source.gotext"}}\n' "$root" "$source" "$root" "$out" > "$out/overlay.json"
fi
if [ "$mode" = absent ]; then
    printf '{"Replace":{"%s/%s":"%s/%s/present.gotext"}}\n' "$root" "$source" "$root" "$out" > "$out/present-overlay.json"
    (cd test/conformance/go && go build -overlay "$root/$out/present-overlay.json" -o "$root/$out/present-driver" .)
    printf 'go %s/present-driver\n' "$out" > "$out/present-drivers.txt"
    if ! build/conformance-harness run --drivers "$out/present-drivers.txt" --work "$out/present-work" > "$out/present-log" 2>&1; then
        echo "negative control baseline failed: explicit absence markers must be accepted" >&2
        cat "$out/present-log" >&2
        exit 1
    fi
fi
(cd test/conformance/go && go build -overlay "$root/$out/overlay.json" -o "$root/$out/driver-bin" .)

if [ "$mode" = leb-driver ]; then
    # the sabotaged driver alone, for a gate that drives it itself
    # (tables-go-release-negative-control)
    echo "Go table negative control: $mode built $out/driver-bin"
    exit 0
elif [ "$mode" = leb ]; then
    if build/conformance-harness wire-fuzz --driver "$out/driver-bin wire-fuzz" --n 0 --failed "$out/failed.bin" > "$out/log" 2>&1; then
        echo 'negative control failed: noncanonical integers were accepted unnoticed' >&2
        exit 1
    fi
    grep -q 'harness: FAILED after' "$out/log"
else
    printf '#!/bin/sh\nexec %s/driver-bin "$@"\n' "$out" > "$out/driver"
    chmod +x "$out/driver"
    printf 'go %s/driver\n' "$out" > "$out/drivers.txt"
    if build/conformance-harness run --drivers "$out/drivers.txt" --work "$out/work" > "$out/log" 2>&1; then
        echo "negative control failed: $mode left conformance green" >&2
        exit 1
    fi
    if [ "$mode" = wire ]; then
        grep -q 'go / wire: root_full' "$out/log"
        grep -q 'json-read     pass' "$out/log"
    elif [ "$mode" = cycle ]; then
        grep -q 'go / framing: node_cycle_self: damaged input owes the refusal' "$out/log"
        grep -q 'go / framing: node_cycle_to_root: damaged input owes the refusal' "$out/log"
        grep -q 'wire          pass' "$out/log"
    elif [ "$mode" = message ]; then
        grep -q 'go / message: login_full' "$out/log"
        grep -q 'wire          pass' "$out/log"
    elif [ "$mode" = text-refusal ]; then
        grep -q 'go / json-write: text_refuse_illformed.json' "$out/log"
        grep -q 'go / json-write: text_refuse_unpaired.json' "$out/log"
        grep -q 'wire          pass' "$out/log"
        grep -q 'json-read     pass' "$out/log"
    elif [ "$mode" = key-order ]; then
        grep -q 'go / json-write: map_key_order.json' "$out/log"
        grep -q 'go / json-write: map_text_order.json' "$out/log"
        grep -q 'wire          pass' "$out/log"
        grep -q 'json-read     pass' "$out/log"
    elif [ "$mode" = frame-cap ]; then
        grep -q 'go / framing: frame_entries_4097: damaged input owes the refusal' "$out/log"
        grep -q 'wire          pass' "$out/log"
    elif [ "$mode" = absent ]; then
        grep -q 'go / wire: root_full: .*driver wrote nothing' "$out/log"
        grep -q 'go / framing: frame_empty_table: the driver wrote nothing' "$out/log"
        grep -q 'json-read     pass' "$out/log"
    elif [ "$mode" = write-refusal ]; then
        grep -q 'go / write-refusal: wref_range_high' "$out/log"
        grep -q 'go / write-refusal-fixed: fref_range_high' "$out/log"
        grep -q 'message       pass' "$out/log"
    else
        grep -q 'go / json-hostile:' "$out/log"
        grep -q 'wire          pass' "$out/log"
    fi
fi
echo "Go table negative control: $mode detected by its gate"
