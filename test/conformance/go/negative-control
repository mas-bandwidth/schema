#!/bin/sh
# Prove the restored Go gates detect a changed wire, a changed message batch,
# a missing text event, a noncanonical integer accepted by the generated
# wire reader, an absent case that writes no `.absent` answer, and two
# framing rules (docs/LAYERS/1-framing.md) taken out of the generated reader:
# the 4096 id-table entry cap (frame-cap) and the refusal of a pointer naming
# an open node (frame-cycle).
set -eu

mode=$1
out=build/go-table-control-$mode
mkdir -p "$out"
case "$mode" in
wire)
    source=test/conformance/go/main.go
    sed '/if err := spill(out, f\[1\], scratch);/i\
        if f[1] == "root_full" { scratch[0] ^= 1 }
    ' "$source" > "$out/source.gotext"
    ;;
message)
    source=test/conformance/go/messages.go
    sed '/if err := spill(out, f\[1\], answer);/i\
        if f[1] == "login_full" { answer[len(answer)-1] ^= 1 }
    ' "$source" > "$out/source.gotext"
    ;;
walk)
    source=$(grep -l 'func (in \*tableJSONIn) scanString' build/tables-generated-go/examples/*TableJson.go)
    sed 's/in.report.Clamped++/in.report.Clamped += 0/g' "$source" > "$out/source.gotext"
    ;;
leb|leb-driver)
    source=$(grep -l 'if i > 0 && b == 0' build/tables-generated-go/examples/*Table.go)
    sed 's/if i > 0 \&\& b == 0/if false/' "$source" > "$out/source.gotext"
    ;;
frame-cap)
    source=$(grep -l 'if n > 4096 {' build/tables-generated-go/r1/*Table.go)
    sed 's/if n > 4096 {/if false { \/\/ SABOTAGED: no entry cap/' "$source" > "$out/source.gotext"
    ;;
frame-cycle)
    source=$(grep -l 'return n.reason == TableRefuseDataCycle' build/tables-generated-go/pointers/*.go)
    sed 's/return n.reason == TableRefuseDataCycle/return false \/\/ SABOTAGED: a cycle reads clean/' "$source" > "$out/source.gotext"
    ;;
absent)
    # both writers of the marker: the bare one and the one carrying a reason
    source=test/conformance/go/main.go
    sed 's|return os.WriteFile(filepath.Join(dir, name+".absent"), nil, 0o644)|return nil // SABOTAGED: an absent case writes nothing|' "$source" > "$out/source.gotext"
    source2=test/conformance/go/messages.go
    sed 's|return os.WriteFile(filepath.Join(dir, name+".absent"), \[\]byte(reason), 0o644)|_ = filepath.Join; return nil // SABOTAGED: an absent case writes nothing|' "$source2" > "$out/source2.gotext"
    if cmp -s "$source2" "$out/source2.gotext"; then
        echo "negative control patched nothing: $mode ($source2)" >&2
        exit 1
    fi
    ;;
*) echo "unknown control: $mode" >&2; exit 1 ;;
esac
if cmp -s "$source" "$out/source.gotext"; then
    echo "negative control patched nothing: $mode" >&2
    exit 1
fi
root=$(pwd)
if [ -n "${source2:-}" ]; then
    printf '{"Replace":{"%s/%s":"%s/%s/source.gotext","%s/%s":"%s/%s/source2.gotext"}}\n' "$root" "$source" "$root" "$out" "$root" "$source2" "$root" "$out" > "$out/overlay.json"
else
    printf '{"Replace":{"%s/%s":"%s/%s/source.gotext"}}\n' "$root" "$source" "$root" "$out" > "$out/overlay.json"
fi
(cd test/conformance/go && go build -overlay "$root/$out/overlay.json" -o "$root/$out/driver-bin" .)

if [ "$mode" = leb-driver ]; then
    # the sabotaged driver alone, for a gate that drives it itself
    # (tables-go-release-negative-control)
    echo "Go table negative control: $mode built $out/driver-bin"
    exit 0
elif [ "$mode" = leb ]; then
    if build/conformance-harness wire-fuzz --driver "$out/driver-bin wire-fuzz" --n 0 --failed "$out/failed.bin" > "$out/log" 2>&1; then
        echo 'negative control failed: noncanonical integers were accepted unnoticed' >&2
        exit 1
    fi
    grep -q 'harness: FAILED after' "$out/log"
else
    printf '#!/bin/sh\nexec %s/driver-bin "$@"\n' "$out" > "$out/driver"
    chmod +x "$out/driver"
    printf 'go %s/driver\n' "$out" > "$out/drivers.txt"
    if build/conformance-harness run --drivers "$out/drivers.txt" --work "$out/work" > "$out/log" 2>&1; then
        echo "negative control failed: $mode left conformance green" >&2
        exit 1
    fi
    if [ "$mode" = wire ]; then
        grep -q 'go / wire: root_full' "$out/log"
        grep -q 'json-read     pass' "$out/log"
    elif [ "$mode" = message ]; then
        grep -q 'go / message: login_full' "$out/log"
        grep -q 'wire          pass' "$out/log"
    elif [ "$mode" = frame-cap ]; then
        grep -q 'go / framing: frame_entries_4097: damaged input owes the refusal' "$out/log"
        grep -q 'wire          pass' "$out/log"
    elif [ "$mode" = frame-cycle ]; then
        grep -q 'go / framing: node_cycle_self: damaged input owes the refusal' "$out/log"
        grep -q 'wire          pass' "$out/log"
    elif [ "$mode" = absent ]; then
        grep -q 'go / wire: blob_shared: .*driver wrote nothing' "$out/log"
        grep -q 'go / framing: .*: the driver wrote nothing' "$out/log"
        grep -q 'json-read     pass' "$out/log"
    else
        grep -q 'go / json-hostile:' "$out/log"
        grep -q 'wire          pass' "$out/log"
    fi
fi
echo "Go table negative control: $mode detected by its gate"
