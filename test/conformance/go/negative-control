#!/bin/sh
# Prove the restored Go gates detect a changed wire, a changed message batch,
# a missing text event, a noncanonical integer accepted by the generated
# wire reader, an absent case that writes no `.absent` answer, the 4096
# id-table entry cap (docs/LAYERS/1-framing.md) taken out of the generated
# reader (frame-cap), a text writer that emits map keys out of order
# (key-order), a text writer that writes storage that is not text
# (text-refusal), the generated variable and fixed writers' ranged-int
# refusal (write-refusal), the generated FixedSave's ranged-int refusal
# (write-refusal-fixed), the generated SaveMessages's ranged-int refusal
# (write-refusal-message), and the three §22.7 write-order breaks: a loaded
# map walked descending (write-order-descending), a builder map written in
# insertion order (write-order-insertion) and the numbering walk taking a
# body's fields in reverse (write-order-numbering).
set -eu

mode=$1
out=build/go-table-control-$mode
mkdir -p "$out"
case "$mode" in
wire)
    source=test/conformance/go/main.go
    sed '/if err := spill(out, f\[1\], scratch);/i\
        if f[1] == "root_full" { scratch[0] ^= 1 }
    ' "$source" > "$out/source.gotext"
    ;;
message)
    source=test/conformance/go/messages.go
    sed '/if err := spill(out, f\[1\], answer);/i\
        if f[1] == "login_full" { answer[len(answer)-1] ^= 1 }
    ' "$source" > "$out/source.gotext"
    ;;
cycle)
    # a load's refusal of a pointer naming an open node (docs/SPEC-TABLES.md
    # §3.1, §4) taken out of the generated graphdemo reader
    source=$(grep -l '^func tableCycleCheck' build/tables-generated-go/pointers/*.go | head -n 1)
    sed 's/if visited != vertices {/if false { \/\/ SABOTAGED: a cycle reads clean/' "$source" > "$out/source.gotext"
    ;;
key-order)
    # the generated mapdemo text writer walks each map's entries in DESCENDING
    # key order (docs/SPEC-TABLES.md §16.14, W6): the stored order is untouched,
    # so only the text moves
    source=$(grep -l '^func tableJSONWriteMap(' build/tables-generated-go/maps/*TableJson.go)
    sed 's/at := unsafe.Add(base, int64(i)\*int64(f.ElemSize))/at := unsafe.Add(base, int64(count-1-i)*int64(f.ElemSize)) \/\/ SABOTAGED: descending keys/' "$source" > "$out/source.gotext"
    ;;
text-refusal)
    # the generated text writer WRITES storage that is not text instead of
    # refusing it (docs/SPEC-TABLES.md §16.14, W0): the raw byte in tabledemo's
    # narrow writer, U+FFFD in widedemo's wide one
    source=$(grep -l 'out.invalid = true // not text: the write refuses' build/tables-generated-go/examples/*TableJson.go)
    sed 's|out.invalid = true // not text: the write refuses|out.put(c) // SABOTAGED: written, not refused|' "$source" > "$out/source.gotext"
    ;;
write-refusal)
    # the variable and fixed writers' ranged-scalar check removed from a copy
    # of the generated Go: the write-refusal and write-refusal-fixed rows must
    # go red while the message form (a different writer) stays green
    source=$(grep -l 'if value.Penetration < 0 || value.Penetration > 10 {' build/tables-generated-go/examples/*Table.go)
    perl -0pe 's/if value\.Penetration < 0 \|\| value\.Penetration > 10 \{\n(\s*)return false/if false { \/\/ SABOTAGED: write range check removed\n$1return false/g' "$source" > "$out/source.gotext"
    if cmp -s "$source" "$out/source.gotext"; then
        echo "negative control patched nothing: $mode ($source)" >&2
        exit 1
    fi
    ;;
write-refusal-fixed)
    # the fixed writer's ranged-scalar check removed from a copy of the
    # generated Go: the write-refusal-fixed rows and the write-refusal rows
    # written through a fixed root's own form must go red while the message
    # form and the wire surface stay green
    source=$(grep -l '^func WeaponConfigFixedCheckBody(' build/tables-generated-go/examples/*.go)
    sed '/^func WeaponConfigFixedCheckBody(/,/^}/ s/if value.Penetration < 0 || value.Penetration > 10 {/if false { \/\/ SABOTAGED: fixed range check removed/' "$source" > "$out/source.gotext"
    ;;
write-refusal-message)
    # the message writer's ranged-int refusal taken out of the generated
    # backenddemo StorePurchase message body. The scalar's low argument is
    # floored in the copy because the Quantity shape's base (Base[0] = 1)
    # still refuses quantity 0 with its own underflow, which would hide the
    # removed range check and leave mref_range_low green. The floor does not
    # touch the value, so the measured and saved lengths agree and the lawful
    # message rows stay green.
    source=$(grep -l '^func StorePurchaseSaveMessageBody(' build/tables-generated-go/backend/*.go)
    sed -e '/^func StorePurchaseSaveMessageBody(/,/^}/ s/if value.Quantity < 1 || value.Quantity > 99 {/if false { \/\/ SABOTAGED: a ranged int writes unchecked/' \
        -e '/^func StorePurchaseSaveMessageBody(/,/^}/ s/uint64(value.Quantity), uint64(0)/uint64(max(value.Quantity, 1)), uint64(0)/' \
        "$source" > "$out/source.gotext"
    ;;
walk)
    source=$(grep -l 'func (in \*tableJSONIn) scanString' build/tables-generated-go/examples/*TableJson.go)
    sed 's/if clamped {/if false \&\& clamped {/g' "$source" > "$out/source.gotext"
    ;;
leb|leb-driver)
    source=$(grep -l 'if i > 0 && b == 0' build/tables-generated-go/pointers/*Table.go)
    sed 's/if i > 0 \&\& b == 0/if false/' "$source" > "$out/source.gotext"
    ;;
frame-cap)
    # the framing battery's fixed root reads through R1's variable-class twin
    # (make/go.mk, test/conformance/go/fixed.go), so the cap is taken out there
    source=$(grep -l 'if n > 4096 {' build/tables-generated-go-framing/r1variable/*Table.go | head -n 1)
    sed -e 's/if n > 4096 {/if false { \/\/ SABOTAGED: no entry cap/' \
        -e 's/var ids \[4096\]uint64/var ids [8192]uint64/' "$source" > "$out/source.gotext"
    ;;
absent)
    # Model two explicit missing cases before suppressing their markers.
    # Neither control may depend on a naturally unsupported feature surviving
    # as this backend gains coverage. First prove these markers are accepted.
    source=test/conformance/go/main.go
    sed '/^func surfaceWire(/,/^}/ {
        /c := findCodec(f\[2\], f\[3\])/a\
        if f[1] == "root_full" { if err := spillAbsentReason(out, f[1], "negative-control missing case"); err != nil { return err }; continue }
    }
    /^func surfaceFraming(/,/^}/ {
        /c := findCodec(f\[2\], f\[3\])/a\
        if f[1] == "frame_empty_table" { c = nil }
    }' "$source" > "$out/present.gotext"
    grep -Fq 'negative-control missing case' "$out/present.gotext"
    grep -Fq 'if f[1] == "frame_empty_table" { c = nil }' "$out/present.gotext"
    sed 's|return os.WriteFile(filepath.Join(dir, name+".absent"), nil, 0o644)|return nil // SABOTAGED: an absent case writes nothing|' "$out/present.gotext" > "$out/source.gotext"
    source2=test/conformance/go/messages.go
    sed 's|return os.WriteFile(filepath.Join(dir, name+".absent"), \[\]byte(reason), 0o644)|_ = filepath.Join; return nil // SABOTAGED: an absent case writes nothing|' "$source2" > "$out/source2.gotext"
    if cmp -s "$source2" "$out/source2.gotext"; then
        echo "negative control patched nothing: $mode ($source2)" >&2
        exit 1
    fi
    ;;
write-order-descending)
    # THE WRITE ORDER's first break (docs/SPEC-TABLES.md §22.7): the cursor
    # the wire writer walks a LOADED region's map with starts at the last
    # entry and steps backward, so the entries are written in DESCENDING key
    # order. The stored region is untouched and a builder's map walks its own
    # sorted order, so json-read (text in, wire out) stays green.
    source=$(grep -l '^func tableMapCursor(' build/tables-generated-go/maps/*Table.go)
    perl -0pe 's/(\t\t\tprev = k\n\t\t\}\n)\t\treturn c\n/$1\t\tc.p, c.size = unsafe.Add(base, int64(h.Count-1)*int64(f.ElemSize)), -c.size \/\/ SABOTAGED: a loaded map walks descending\n\t\treturn c\n/' "$source" > "$out/source.gotext"
    ;;
write-order-insertion)
    # THE WRITE ORDER's second break (§22.7): a builder's map is written in
    # INSERTION ORDER, its sort and the sort's check taken out. A text whose
    # keys arrive unsorted (edge_map_keys_unsorted) packs out of order, so
    # json-read goes red there; a loaded region's map never meets the
    # builder's walk, so wire stays green.
    source=$(grep -l '^func tableMapCursor(' build/tables-generated-go/maps/*Table.go)
    perl -0pe 's/\tslices\.SortFunc\(order, func\(x, y int64\) int \{\n[^\n]*\n\t\}\)\n/\t_ = slices.SortFunc[[]int64, int64] \/\/ SABOTAGED: a builder map writes in insertion order\n/; s/ \|\| i > 0 && tableMapKeyOrder\(tableMapStoredKey\(a\.At\(order\[i-1\]\), key\), k, key\) >= 0 \{/ || i < 0 { \/\/ SABOTAGED: the order check goes with the sort/' "$source" > "$out/source.gotext"
    grep -q 'SABOTAGED: a builder map writes in insertion order' "$out/source.gotext" && grep -q 'SABOTAGED: the order check goes with the sort' "$out/source.gotext" || {
        echo "negative control patched only part of the sort: $mode ($source)" >&2
        exit 1
    }
    ;;
write-order-numbering)
    # THE WRITE ORDER's third break (§22.7): the numbering walk takes a body's
    # fields in REVERSE. Only the walk that numbers the nodes is sabotaged (a
    # reversed copy of tableRegionEdges that the numbering's visit calls), so
    # the writer still writes each body in declaration order and names nodes
    # by numbers the canonical depth-first walk does not give them.
    source=$(grep -l '^func tableRegionEdges(' build/tables-generated-go/pointers/*Table.go)
    perl -0pe 's{(^func tableRegionEdges\(.*?^\}\n)}{my $f = $1; (my $r = $f) =~ s/^func tableRegionEdges\(/func tableRegionEdgesReversed(/; $r =~ s/f := &info\.Fields\[i\]/f := &info.Fields[len(info.Fields)-1-i] \/\/ SABOTAGED: the numbering walk takes a body\x27s fields in reverse/; $f . $r}mse; s/if t != nil && !tableRegionEdges\(p, t, func\(/if t != nil && !tableRegionEdgesReversed(p, t, func(/' "$source" > "$out/source.gotext"
    grep -q 'SABOTAGED: the numbering walk' "$out/source.gotext" && grep -q '!tableRegionEdgesReversed(p, t, func(' "$out/source.gotext" || {
        echo "negative control patched only part of the walk: $mode ($source)" >&2
        exit 1
    }
    ;;
*) echo "unknown control: $mode" >&2; exit 1 ;;
esac
if cmp -s "$source" "$out/source.gotext"; then
    echo "negative control patched nothing: $mode" >&2
    exit 1
fi
root=$(pwd)
if [ -n "${source2:-}" ]; then
    printf '{"Replace":{"%s/%s":"%s/%s/source.gotext","%s/%s":"%s/%s/source2.gotext"}}\n' "$root" "$source" "$root" "$out" "$root" "$source2" "$root" "$out" > "$out/overlay.json"
else
    printf '{"Replace":{"%s/%s":"%s/%s/source.gotext"}}\n' "$root" "$source" "$root" "$out" > "$out/overlay.json"
fi
if [ "$mode" = absent ]; then
    printf '{"Replace":{"%s/%s":"%s/%s/present.gotext"}}\n' "$root" "$source" "$root" "$out" > "$out/present-overlay.json"
    (cd test/conformance/go && go build -overlay "$root/$out/present-overlay.json" -o "$root/$out/present-driver" .)
    printf 'go %s/present-driver\n' "$out" > "$out/present-drivers.txt"
    if ! build/conformance-harness run --drivers "$out/present-drivers.txt" --work "$out/present-work" > "$out/present-log" 2>&1; then
        echo "negative control baseline failed: explicit absence markers must be accepted" >&2
        cat "$out/present-log" >&2
        exit 1
    fi
fi
(cd test/conformance/go && go build -overlay "$root/$out/overlay.json" -o "$root/$out/driver-bin" .)

if [ "$mode" = leb-driver ]; then
    # the sabotaged driver alone, for a gate that drives it itself
    # (tables-go-release-negative-control)
    echo "Go table negative control: $mode built $out/driver-bin"
    exit 0
elif [ "$mode" = leb ]; then
    if build/conformance-harness wire-fuzz --driver "$out/driver-bin wire-fuzz" --n 0 --failed "$out/failed.bin" > "$out/log" 2>&1; then
        echo 'negative control failed: noncanonical integers were accepted unnoticed' >&2
        exit 1
    fi
    grep -q 'harness: FAILED after' "$out/log"
else
    printf '#!/bin/sh\nexec %s/driver-bin "$@"\n' "$out" > "$out/driver"
    chmod +x "$out/driver"
    printf 'go %s/driver\n' "$out" > "$out/drivers.txt"
    if build/conformance-harness run --drivers "$out/drivers.txt" --work "$out/work" > "$out/log" 2>&1; then
        echo "negative control failed: $mode left conformance green" >&2
        exit 1
    fi
    if [ "$mode" = wire ]; then
        grep -q 'go / wire: root_full' "$out/log"
        grep -q 'json-read     pass' "$out/log"
    elif [ "$mode" = cycle ]; then
        grep -Eq '(go / framing: node_cycle_self:|driver: framing: node_cycle_self:)' "$out/log"
        grep -q 'wire          pass' "$out/log"
    elif [ "$mode" = message ]; then
        grep -q 'go / message: login_full' "$out/log"
        grep -q 'wire          pass' "$out/log"
    elif [ "$mode" = text-refusal ]; then
        grep -q 'go / json-write: text_refuse_illformed.json' "$out/log"
        grep -q 'go / write-refusal-json: jref_utf8_surrogate' "$out/log"
        grep -q 'wire          pass' "$out/log"
        grep -q 'json-read     pass' "$out/log"
    elif [ "$mode" = key-order ]; then
        grep -q 'go / json-write: map_key_order.json' "$out/log"
        grep -q 'go / json-write: map_text_order.json' "$out/log"
        grep -q 'wire          pass' "$out/log"
        grep -q 'json-read     pass' "$out/log"
    elif [ "$mode" = frame-cap ]; then
        grep -q 'go / framing: frame_entries_4097: read outcome differs: got read, want refused' "$out/log"
        grep -q 'wire          pass' "$out/log"
    elif [ "$mode" = absent ]; then
        grep -q 'go / wire: root_full: .*driver wrote nothing' "$out/log"
        grep -q 'go / framing: frame_empty_table: the driver wrote nothing' "$out/log"
        grep -q 'json-read     pass' "$out/log"
    elif [ "$mode" = write-refusal ]; then
        grep -q 'go / write-refusal: wref_range_high' "$out/log"
        grep -q 'go / write-refusal-fixed: fref_range_high' "$out/log"
        grep -q 'message       pass' "$out/log"
    elif [ "$mode" = write-refusal-fixed ]; then
        grep -q 'go / write-refusal-fixed: fref_range_high' "$out/log"
        grep -q '^write-refusal FAIL' "$out/log"
        grep -q 'wire          pass' "$out/log"
    elif [ "$mode" = write-refusal-message ]; then
        grep -q 'go / write-refusal-message: mref_range_high' "$out/log"
        grep -q 'go / write-refusal-message: mref_range_low' "$out/log"
        grep -q '^message       pass' "$out/log"
        grep -q 'wire          pass' "$out/log"
    elif [ "$mode" = write-order-descending ]; then
        # §22.7's edge vectors run through the wire surface on the derived
        # rewrite manifest and print under rewrite. The text writer walks the
        # stored order itself, and no pointer graph holds a map.
        grep -q 'go / rewrite: edge_map_keys:' "$out/log"
        grep -q '^json-write    pass' "$out/log"
        if grep -q 'go / [a-z-]*: graph_' "$out/log"; then echo "negative control reddened what its break cannot reach: graph_ rows" >&2; exit 1; fi
        if grep -q 'go / rewrite: edge_graph_diamond:' "$out/log"; then echo "negative control reddened what its break cannot reach: edge_graph_diamond" >&2; exit 1; fi
    elif [ "$mode" = write-order-insertion ]; then
        # the unsorted text either packs to other bytes or is refused when the
        # leg reads its own out-of-order write back; both name the row
        grep -Eq 'go / json-read: (edge_map_keys_unsorted:|.*unanswered: .*edge_map_keys_unsorted)' "$out/log"
        grep -q '^wire          pass' "$out/log"
        grep -q '^json-write    pass' "$out/log"
    elif [ "$mode" = write-order-numbering ]; then
        grep -q 'go / rewrite: edge_graph_diamond:' "$out/log"
        # node_diamond_chain is also a framing row that reads, and the
        # framing surface writes it back through the same numbering walk
        grep -q 'go / rewrite: node_diamond_chain:' "$out/log"
        grep -q 'go / framing: node_diamond_chain.wire:' "$out/log"
        grep -q '^json-write    pass' "$out/log"
        if grep -q 'go / [a-z-]*: map_' "$out/log"; then echo "negative control reddened what its break cannot reach: map_ rows" >&2; exit 1; fi
        if grep -q 'go / rewrite: edge_map_keys:' "$out/log"; then echo "negative control reddened what its break cannot reach: edge_map_keys" >&2; exit 1; fi
    else
        grep -q 'go / json-hostile:' "$out/log"
        grep -q 'wire          pass' "$out/log"
    fi
fi
echo "Go table negative control: $mode detected by its gate"
