#!/bin/sh
# THE GO LEG's driver, cross-built for a BIG-ENDIAN target and run under the
# pinned emulator (test/conformance/README.md, docs/SPEC-TABLES.md §19.1, §7).
#
# The TABLE WIRE is byte-order-neutral by construction: every field id, every
# length and every scalar rides little-endian whatever the host is. So the wire,
# the read report and both directions of the text form — the hostile battery
# included — have expectations a big-endian reader owes exactly as a
# little-endian one does, and this leg meets them against the same goldens.
#
# The two ACCELERATORS' own surfaces do not, and the leg says so by not listing
# them rather than by failing them: a block and a cook are produced in the byte
# order of the build that wrote them (§19.1, §7), and the corpus's fixtures are
# this host's. A big-endian reader is CORRECT to refuse them, so there is no
# byte-order-neutral verdict for it to give on `cook`, `block`, `block-dump` or
# either forgery battery.
#
# BUT THE REFUSAL ITSELF IS NEUTRAL, and this leg reports it GREEN rather than
# absent. `cook-foreign` and `block-foreign` hand the reader a file whose MAGIC
# word is reversed — foreign to WHOEVER READS IT, whatever the host's own order
# — so the expected verdict is `refuse` on every leg on every machine, and this
# leg answering it is the reader being PRESENT and correct rather than missing.
# That distinction is what the ABSENT rows could not make on their own.
#
# usage: driver <manifest> list
#        driver <manifest> <surface> <outdir>
set -e

if [ "$2" = "list" ]; then
    # the WIRE-CARRYING surfaces are ABSENT while the Go port writes the
    # wire's previous form (docs/SPEC-TABLES.md §3, schema#511)
    echo cook-foreign
    echo block-foreign
    exit 0
fi

exec ${BE_RUN:-qemu-s390x} build/conformance-go-be "$@"
