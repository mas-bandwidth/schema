#!/bin/sh
# A compiling altered runtime must fail the named ownership or retention check.
set -eu
mode=$1
out=build/go-ownership-control-$mode
mkdir -p "$out"
test=TestAllocatorOwnershipAndStandaloneWriters
case "$mode" in
arm-framing) source=read.go; sabotage=go-arm-reference-framing; test=TestPointerArmLengthBeforeResolution; expected="arm framing must precede resolution" ;;
message-reserved) source=message.go; sabotage=go-message-measure-reserved; test=TestMessageMeasureReservedFraming; expected="reserved framing extent 192 want 960" ;;
counted-tail) source=read.go; sabotage=go-counted-tail-reset; test=TestRepeatedArrayTailDefaults; expected="counted tail not reset" ;;
measure-cycle) source=regions.go; sabotage=go-measure-cycle-reason; test=TestMeasureRefusalReasons; expected="wire cycle:" ;;
measure-count) source=lists.go; sabotage=go-measure-count-reason; test=TestMeasureRefusalReasons; expected="count 2147483648: size -1 reason count_over_length" ;;
unknown-node) source=retain.go; sabotage=go-retain-unknown-node; test=TestRetainUnknownNodeRecord; expected="unplaceable node retention" ;;
builder-union) source=read.go; sabotage=go-builder-union-refusal; test=TestBuilderRefusalThroughUnion; expected="union count refusal became damage or continued" ;;
original-slice) source=allocator.go; sabotage=go-allocator-original-slice; expected='Free must receive original slice' ;;
pair) source=regions.go; sabotage=go-allocator-pair; expected='standalone pair not used or leaked' ;;
frame) source=regions.go; sabotage=go-allocator-frame; expected='Go allocations outside caller-backed scratch' ;;
file-count-floor) source=retain.go; sabotage=go-retain-file-count-floor; test=TestRetainFileCapacityBeforeExpansion; expected='count expanded past available resolved capacity' ;;
message-depth) source=retainmessage.go; sabotage=go-retain-message-depth; test=TestRetainMessage; expected='depth 65' ;;
runtime)
    if SCHEMA_GO_ALLOC_ANY_GO=0 GOTOOLCHAIN=go1.27.1 go test ./internal/codegen/gotable -run "^$test\$" -count=1 > "$out/log" 2>&1; then
        echo 'allocation certification accepted a different runtime' >&2; exit 1
    fi
    grep -Fq 'allocation certification requires go1.26.0, running go1.27.1' "$out/log"
    echo 'Go allocation certification refuses Go 1.27.1'; exit 0 ;;
*) echo "unknown ownership control: $mode" >&2; exit 1 ;;
esac
source=internal/codegen/gotable/$source
go run ./tools/sabotage -name "$sabotage" -out "$out/source.gotext" "$source"
root=$(pwd)
printf '{"Replace":{"%s/%s":"%s/%s/source.gotext"}}\n' "$root" "$source" "$root" "$out" > "$out/overlay.json"
if GOTOOLCHAIN=go1.26.0 go test -overlay "$out/overlay.json" ./internal/codegen/gotable -run "$test" -count=1 > "$out/log" 2>&1; then
    echo "ownership control stayed green: $mode" >&2; exit 1
fi
if grep -q '\[build failed\]' "$out/log"; then cat "$out/log"; exit 1; fi
grep -Fq "$expected" "$out/log" || { cat "$out/log"; exit 1; }
echo "Go ownership control: $mode detected by $test"
