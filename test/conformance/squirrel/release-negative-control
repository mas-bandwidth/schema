#!/bin/sh
# THE SQUIRREL RELEASE TIER's negative control (docs/PORTING.md J3;
# make/squirrel-fuzz.mk, tables-squirrel-release).
#
# The release tier scales the leg's wire fuzzer over both of its arms. This
# control overlays the emitted load runtime so a body that stops early is read
# as finished: an array field's frame length past its body is clamped to the
# body instead of counted malformed (docs/SPEC-TABLES.md §3, §4), with the
# wire-alone check that holds the same frame rule taken out too (the plant
# TestSquirrelWireFuzzNegativeControl uses). It regenerates the corpus into
# build/ and runs the release tier's builder-arm fuzz against it through
# $SCHEMA_SQUIRREL_CONFORMANCE, which must go red on the read's verdict. Under
# the strict read the verdict is the contract (docs/plans/strict-only.md): a
# stopped root body is damage and refuses, so the builder's `stopped` flag no
# longer moves anything the harness compares, and the plant goes where the
# verdict is decided. No tracked file is written to.
#
# usage: release-negative-control <harness flags...>
# The working directory is the repository root; $SQ is the pinned interpreter.
set -eu
out=build/squirrel-release-negative-control
rm -rf "$out"
mkdir -p "$out"
runtime=load.nut
source=internal/codegen/squirreltable/runtime/$runtime
perl -0pe 's/(readFieldArray = function\(fd, r, T, table, v, report, st, selection = null\) \{\n  local L = leb\(r\);\n)  if \(r\.bad \|\| r\.at \+ L > r\.end\) \{ report\.bodyDamaged = true; return false; \}\n/$1  if (r.bad) { report.bodyDamaged = true; return false; }\n  if (r.at + L > r.end) L = r.end - r.at;\n/; s/wireCheck\(bytes, 1, end, table, false\)/{ fail = null, nonFinite = false }/' "$source" > "$out/$runtime"
if [ "$(grep -c 'if (r.at + L > r.end) L = r.end - r.at;' "$out/$runtime")" != 1 ] ||
	grep -q 'wireCheck(bytes, 1, end, table, false)' "$out/$runtime"; then
	echo "NEGATIVE CONTROL FAILED (release): the sabotage did not patch both anchors" >&2
	exit 1
fi
root=$(pwd)
printf '{"Replace":{"%s/%s":"%s/%s/%s"}}\n' "$root" "$source" "$root" "$out" "$runtime" > "$out/overlay.json"
"${GO:-go}" build -overlay "$root/$out/overlay.json" -o "$out/schema" ./cmd/schema
mkdir -p "$out/conformance-squirrel"
: > "$out/conformance-squirrel/REFUSED.txt"
grep '^unit ' testdata/conformance/tables/MANIFEST.txt | while read -r _ key paths; do
	# shellcheck disable=SC2086 # a unit's paths are words
	if ! "$out/schema" generate --lang squirrel --out "$out/conformance-squirrel/$key" $paths > "$out/$key.log" 2>&1; then
		printf '%s %s\n' "$key" "$(tr '\n' ' ' < "$out/$key.log")" >> "$out/conformance-squirrel/REFUSED.txt"
	fi
	rm -f "$out/$key.log"
done
if SCHEMA_SQUIRREL_CONFORMANCE="$root/$out/conformance-squirrel" ./build/conformance-harness wire-fuzz \
	--driver "$SQ test/conformance/squirrel/wirefuzz.nut builder" --builder "$@" --failed "$out/failed.bin" > "$out/log" 2>&1; then
	echo "NEGATIVE CONTROL FAILED (release): the sabotage left the builder arm green" >&2
	cat "$out/log" >&2
	exit 1
fi
if ! grep -q "read acceptance differs: the leg says true, the oracle says false" "$out/log"; then
	echo "NEGATIVE CONTROL FAILED (release): the builder arm went red for another reason" >&2
	cat "$out/log" >&2
	exit 1
fi
echo "Squirrel release negative control: a body that stops early read as finished turns the release tier's builder arm red"
