#!/bin/sh
# THE DART LEG's EMITTER-SIDE conformance negative controls (docs/PORTING.md I11).
#
# walk: the bool arm of the generated text reader (internal/codegen/darttable/
# textform.go) is sabotaged IN THE EMITTER (tools/sabotage
# table-dart-text-walk-bool: the read stores the negation), a schema compiler is
# built against it through a Go overlay, and every table unit the driver reads
# is generated afresh from it into a tree of its own under build/. The driver
# source is copied beside that tree, so its repo-relative imports
# (../../../build/tables-generated-dart*) resolve to the sabotaged copy, and is
# AOT-compiled there. Nothing tracked and no normal build output is written to.
#
# The matrix must go red on `dart / json-read` and on no other surface:
# json-write and wire never run the reader, so they stay green, which is what
# says the harness found a defect in GENERATED code and localized it. A build
# failure never counts as detection.
#
# zero: the ZERO RULE (docs/SPEC-TABLES.md §16.3, text_holds_zero) is taken
# out of _jsonText, the one helper every text-storage read goes through
# (tools/sabotage table-dart-text-zero), the same way. The matrix must go red on
# `dart / json-hostile` and on exactly the two carried rows,
# str-zero-escape-value and str-zero-escape-map-key; the skipped unknown-key
# zero, json-read and every other surface stay green.
#
# wire: the counted list's `widened` count is taken out of the WIRE emitter
# (internal/codegen/darttable/wireform.go, tools/sabotage table-dart-wire-widen)
# and the tolerant wire's differential fuzzer (docs/PORTING.md I15, harness
# wire-fuzz) is run over a driver built from the regenerated units. It must go
# red on the report, naming the mutant; it does not run the matrix.
#
# share: the shared-node label (docs/SPEC-TABLES.md §16.7, docs/PORTING.md M14)
# is taken out of _writePtr (tools/sabotage table-dart-text-share), so a node two
# slots name is written in full twice. The matrix must go red on
# `dart / json-write` alone, on the shared-node rows (graph_shared,
# list_shared).
#
# framing: the id table's 4096-entry maximum (docs/LAYERS/1-framing.md F6) is
# taken out of the reader's open() (tools/sabotage table-dart-id-table-cap), so a
# table of 4097 entries reads as clean. The matrix must go red on
# `dart / framing` alone, on frame_entries_4097.
#
# block: the block Open's pitch check (internal/codegen/darttable/block.go,
# tools/sabotage table-dart-block-pitch) is taken out, so the forged image
# block_pitch opens where it must refuse. The matrix must go red on
# `dart / forgery` and `dart / block-reason` on that row alone; `block` and `block-dump` read the two
# valid images, which carry this build's pitch, and stay green.
#
# usage: negative-control <walk|zero|share|wire|block|absent> [dart]     (run from the repository root)
set -eu

mode=${1:-walk}
dart=${2:-dart}
case "$mode" in
    walk) sabotage=table-dart-text-walk-bool; marker='SABOTAGED: the read stores the negation' ;;
    zero) sabotage=table-dart-text-zero; marker='SABOTAGED: text_holds_zero removed' ;;
    share) sabotage=table-dart-text-share; marker='SABOTAGED: every node written in place' ;;
    wire) sabotage=table-dart-wire-widen; marker='SABOTAGED: the widened count is gone' ;;
    mapheader) sabotage=table-dart-map-header-bounded; marker='SABOTAGED: the map header is bounded by L' ;;
    block) sabotage=table-dart-block-pitch; marker='SABOTAGED: the pitch check is gone' ;;
    framing) sabotage=table-dart-id-table-cap; marker='SABOTAGED: the 4096-entry id-table maximum is gone' ;;
    absent) ;;
    *) echo "unknown control: $mode" >&2; exit 1 ;;
esac
out=build/conformance-dart-negative-$mode
root=$(pwd)

if [ "$mode" = absent ]; then
    # PER-CASE ABSENT (docs/PORTING.md I4): the driver's every `<case>.absent`
    # write is renamed out of the harness's sight, over the tree `make
    # build/conformance-dart` generated, so each row the leg cannot carry is a
    # row it wrote nothing for. The matrix must go red on exactly those rows,
    # each as "wrote nothing", and every answered row must stay green.
    rm -rf "$out"
    mkdir -p "$out/build" "$out/test/conformance/dart"
    ln -s "$root/build/tables-generated-dart" "$out/build/tables-generated-dart"
    ln -s "$root/build/tables-generated-dart-scalars" "$out/build/tables-generated-dart-scalars"
    for d in "$root"/build/*; do
        [ -e "$out/build/$(basename "$d")" ] || ln -s "$d" "$out/build/$(basename "$d")"
    done
    sed "s/\.absent')/.absent.gone')/g" test/conformance/dart/main.dart > "$out/test/conformance/dart/main.dart"
    n=$(grep -c "\.absent\.gone')" "$out/test/conformance/dart/main.dart")
    [ "$n" -ge 3 ] || { echo "negative control: the absent writes matched $n sites, want at least 3 — the driver moved" >&2; exit 1; }
    "$dart" compile exe -o "$out/conformance-dart" "$out/test/conformance/dart/main.dart" >/dev/null
    printf 'dart %s/%s/conformance-dart\n' "$root" "$out" > "$out/drivers.txt"
    if build/conformance-harness run --drivers "$out/drivers.txt" --work "$out/work" > "$out/log" 2>&1; then
        cat "$out/log"
        echo "NEGATIVE CONTROL FAILED: absent (the .absent writes renamed) left dart conformance green" >&2
        exit 1
    fi
    if grep '^  dart / ' "$out/log" | grep -Ev 'wrote nothing' >/dev/null; then
        cat "$out/log"; echo "absent control turned a row red for another reason" >&2; exit 1
    fi
    grep -q '^  dart / ' "$out/log" || { cat "$out/log"; exit 1; }
    for surface in report json-read json-write json-hostile cook cook-write block forgery; do
        grep -Eq "^$surface +pass " "$out/log" || { cat "$out/log"; echo "surface $surface did not stay green" >&2; exit 1; }
    done
    grep '^  dart / ' "$out/log" | head -3
    echo "Dart absent negative control: with the .absent writes gone, exactly the rows the leg cannot carry go red as wrote nothing"
    exit 0
fi

rm -rf "$out"
mkdir -p "$out/build" "$out/test/conformance/dart"

emitter=textform.go
[ "$mode" = wire ] && emitter=wireform.go
[ "$mode" = mapheader ] && emitter=wireunion.go
[ "$mode" = block ] && emitter=block.go
[ "$mode" = framing ] && emitter=wireform.go
go run ./tools/sabotage -name "$sabotage" -out "$out/emitter.gotext" "internal/codegen/darttable/$emitter"
printf '{"Replace":{"%s/internal/codegen/darttable/%s":"%s/%s/emitter.gotext"}}\n' "$root" "$emitter" "$root" "$out" > "$out/overlay.json"
go build -overlay="$out/overlay.json" -o "$out/schema" ./cmd/schema

for pair in \
    examples:tables/examples pointers:tables/pointers blobs:tables/blobs \
    lists:tables/lists maps:tables/maps messages:tables/messages \
    backend:tables/backend stream:tables/stream vocab:tables/vocab \
    vocab9:tables/vocab9 cards:tables/cards block:tables/block \
    v1:test/tables/V1.schema v2:test/tables/V2.schema \
    w1:test/tables/W1.schema w2:test/tables/W2.schema \
    r1:test/tables/R1.schema r2:test/tables/R2.schema \
    p1:test/tables/P1.schema p2:test/tables/P2.schema p3:test/tables/P3.schema \
    g1:test/tables/G1.schema m1:test/tables/M1.schema m2:test/tables/M2.schema \
    k1:test/tables/K1.schema k2:test/tables/K2.schema a2:test/tables/A2.schema \
    rt1:test/tables/RT1.schema; do
    unit=${pair%%:*}
    input=${pair#*:}
    "$out/schema" generate --lang dart --out "$out/build/tables-generated-dart/$unit" "$input" >/dev/null
done
for pair in scalars:tables/scalars scalars2:test/tables/Scalars2.schema; do
    unit=${pair%%:*}
    input=${pair#*:}
    "$out/schema" generate --lang dart --out "$out/build/tables-generated-dart-scalars/$unit" "$input" >/dev/null
done

# the sabotage must have reached generated code, or the control is vacuous
if ! grep -rqF "$marker" "$out/build/tables-generated-dart"; then
    echo "negative control patched no generated reader" >&2
    exit 1
fi

cp test/conformance/dart/main.dart "$out/test/conformance/dart/main.dart"
"$dart" compile exe -o "$out/conformance-dart" "$out/test/conformance/dart/main.dart" >/dev/null
printf 'dart %s/%s/conformance-dart\n' "$root" "$out" > "$out/drivers.txt"

# mapheader builds the sabotaged driver only: make/wire-fuzz-release.mk runs the
# release gate's own runs over it (tables-wire-fuzz-release-negative-control)
[ "$mode" = mapheader ] && exit 0

if [ "$mode" = wire ]; then
    # the differential, not the matrix: seed 1, no random pass, the enumerated
    # mutants alone, which are the same at every seed
    if build/conformance-harness wire-fuzz --finite-owed tables-finite/dart --driver "$out/conformance-dart wire-fuzz" --seed 1 --n 0 --failed "$out/failed.bin" > "$out/log" 2>&1; then
        cat "$out/log"
        echo "NEGATIVE CONTROL FAILED: $mode ($sabotage) left the dart wire fuzzer green" >&2
        exit 1
    fi
    grep -Fq 'harness: FAILED' "$out/log" && grep -Fq 'the report differs' "$out/log" || { cat "$out/log"; echo "the wire fuzzer went red for some other reason" >&2; exit 1; }
    if grep -Eq 'leg died|did not answer' "$out/log"; then cat "$out/log"; exit 1; fi
    grep -F 'the report differs' "$out/log" | head -1
    echo "Dart wire negative control: the emitter sabotage ($sabotage) is detected by the wire fuzzer's report comparison"
    exit 0
fi

if build/conformance-harness run --drivers "$out/drivers.txt" --work "$out/work" > "$out/log" 2>&1; then
    cat "$out/log"
    echo "NEGATIVE CONTROL FAILED: $mode ($sabotage) left dart conformance green" >&2
    exit 1
fi
if grep -Eq 'driver exited|driver wrote nothing' "$out/log"; then
    cat "$out/log"; exit 1
fi
case "$mode" in
    walk) red=json-read ;;
    zero) red=json-hostile ;;
    share) red=json-write ;;
    block) red=forgery ;;
    framing) red=framing ;;
esac
grep -Eq "^$red +FAIL " "$out/log" || { cat "$out/log"; exit 1; }
for surface in wire message report framing json-read json-write json-hostile cook cook-write cook-foreign block block-foreign block-dump forgery cook-forgery cook-reason block-reason; do
    [ "$surface" = "$red" ] && continue
    # the refusal's NAME is a row of the same rule: block-reason holds the
    # reason block_pitch must give, so it goes red beside the forgery battery
    [ "$mode" = block ] && [ "$surface" = block-reason ] && continue
    grep -Eq "^$surface +pass " "$out/log" || { cat "$out/log"; echo "surface $surface did not stay green" >&2; exit 1; }
done
# every failing row is a row of the broken rule, and each is a wrong answer
allowed="^  dart / $red[:/ ]"
[ "$mode" = block ] && allowed='^  dart / (forgery|block-reason): block_pitch: '
if grep '^  dart / ' "$out/log" | grep -Ev "$allowed" >/dev/null; then
    cat "$out/log"; exit 1
fi
if [ "$mode" = share ]; then
    grep -q '^  dart / json-write.*graph_shared' "$out/log" || { cat "$out/log"; echo "share control did not turn graph_shared red" >&2; exit 1; }
fi
if [ "$mode" = framing ]; then
    rows=$(grep '^  dart / framing' "$out/log" | grep -Eo 'frame_[a-z0-9_]+' | sort -u | tr '\n' ' ')
    [ "$rows" = "frame_entries_4097 " ] || { cat "$out/log"; echo "framing control turned red on '$rows', want frame_entries_4097" >&2; exit 1; }
fi
if [ "$mode" = zero ]; then
    rows=$(grep '^  dart / json-hostile' "$out/log" | grep -Eo 'str-zero-escape-[a-z-]+' | sort -u | tr '\n' ' ')
    if [ "$rows" != "str-zero-escape-map-key str-zero-escape-value " ]; then
        cat "$out/log"; echo "zero control turned red: '$rows', want exactly the two carried zero rows" >&2; exit 1
    fi
fi
if [ "$mode" = block ]; then
    rows=$(grep '^  dart / forgery' "$out/log" | grep -Eo 'block_pitch' | sort -u | tr '\n' ' ')
    [ "$rows" = "block_pitch " ] || { cat "$out/log"; echo "block control turned red on '$rows', want the block_pitch row" >&2; exit 1; }
fi
grep "^$red " "$out/log"
echo "Dart $mode negative control: the emitter sabotage ($sabotage) is detected by dart / $red alone"
