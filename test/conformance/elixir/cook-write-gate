#!/bin/sh
# THE ELIXIR COOK-WRITE GATE (docs/SPEC-TABLES.md §7.2, §7.6): reads one
# `conformance-harness run --only elixir` log and its work directory, and
# passes only when the leg's cook-write line reads `pass N/N` with the same N,
# no absence suffix, and no relaxed case. The run's other surfaces are not
# this gate's verdict.
#
# usage: cook-write-gate <log> <work>
log=$1
work=$2

line=$(grep -E '^cook-write +' "$log")
if [ -z "$line" ]; then
	echo "elixir cook-write gate: $log has no cook-write line"
	exit 1
fi
set -- $line
verdict=$2
count=$3
suffix=${4:-}
case "$count" in
  *[!0-9/]* | */*/* | 0/* | /* | */ | "") echo "elixir cook-write gate: invalid count $count"; exit 1 ;;
esac
if [ "$verdict" != pass ] || [ "${count%/*}" = "$count" ] || [ "${count%/*}" != "${count#*/}" ]; then
	echo "elixir cook-write gate: the cook-write line reads '$line', want pass N/N"
	exit 1
fi

if [ ! -d "$work/out/elixir/cook-write" ]; then
  echo "elixir cook-write gate: missing output directory"
  exit 1
fi
if [ -n "$suffix" ] || find "$work/out/elixir/cook-write" -name '*.absent' -print -quit | grep -q .; then
	echo "elixir cook-write gate: '$line' has absent cases"
	exit 1
fi

if grep -qE 'RELAXED.* elixir / cook-write' "$log"; then
	grep -E 'RELAXED.* elixir / cook-write' "$log"
	echo "elixir cook-write gate: a cook-write case is relaxed"
	exit 1
fi

echo "elixir cook-write gate: $line, every case gated"
