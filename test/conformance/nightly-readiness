            return
        amended = amended.replace(before, after)
    makefile = runner.out / "Makefile.uncapped"
    makefile.write_text(amended)
    runner.out.joinpath("Makefile.uncapped.json").write_text(json.dumps({
        "source_sha256": hashlib.sha256(original.encode()).hexdigest(),
        "execution_sha256": hashlib.sha256(amended.encode()).hexdigest(),
