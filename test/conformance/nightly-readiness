def pass_events(text):
    passed = set()
    for line in text.splitlines():
        try:
            event = json.loads(line)
        except ValueError:
            continue
        if event.get("Action") == "pass" and event.get("Test"):
            package = event.get("Package", "").removeprefix("github.com/mas-bandwidth/schema/v2/")
            passed.add((package, event["Test"]))
    return passed


def native_retirement_errors(text, lang, passed):
    errors = []
    for line in text.splitlines():
        # Native stdout may be nested in a Go test log's file:line prefix.
        line = re.sub(r"^\s*(?:[^:\s]+:\d+:\s*)?", "", line).rstrip()
        if not re.match(r"(?:SKIP(?:PED)?|RETIRED)(?:[: ]|$)", line):
            continue
        needs = RETIRED_NATIVE.get(lang, {}).get(line)
        if not needs:
            errors.append("unclassified native-program skip: " + line)
        elif missing := sorted(set(needs) - passed):
            errors.append("retirement replacement did not pass: " + line + ": " + repr(missing))
        else:
            print("EXPLICIT RETIRED NATIVE TEST: " + line, flush=True)
    return errors


def native_result(text, listed, package, prior_passes=frozenset()):
    """Require actual terminal events for every discovered test and no live skip."""
    errors, terminal, passes, reasons = [], {}, 0, {}
    package_pass = 0
    expected_package = "github.com/mas-bandwidth/schema/v2/" + package_path(package)
    passed = set(prior_passes) | pass_events(text)
    native_output = []
    for line in text.splitlines():
        try:
            event = json.loads(line)
        except (ValueError, TypeError):
            errors.append("non-JSON native output: " + line[:160])
            continue
        name, action = event.get("Test", ""), event.get("Action")
        native_output.append(event.get("Output", ""))
        if action in ("build-output", "build-fail"):
            if action == "build-fail":
                errors.append("native build failure")
            continue
        if event.get("Package") != expected_package:
            errors.append("native event names the wrong/missing package: " + str(event.get("Package")))
            continue
        if name:
            reasons[name] = reasons.get(name, "") + event.get("Output", "")
            if action in ("pass", "fail", "skip"):
                if name in terminal:
                    errors.append("duplicate native terminal event: " + name)
                terminal[name] = action
                if action == "pass":
                    passes += 1
                elif action == "fail":
                    errors.append("failed native test: " + name)
        elif action == "pass":
            package_pass += 1
        elif action in ("skip", "fail"):
            errors.append("native package " + action)
    for name, action in terminal.items():
        if action != "skip":
            continue
        retired = RETIRED.get(name) if package == "gotable" else None
        reason_lines = [re.sub(r"^\s*(?:[^:\s]+:\d+:\s*)?", "", line).rstrip()
                        for line in reasons.get(name, "").splitlines()]
        if retired and retired[0] in reason_lines:
            missing = sorted(set(retired[1]) - passed)
            if missing:
                errors.append("retirement replacement did not pass: " + name + ": " + repr(missing))
            else:
                print("EXPLICIT RETIRED TEST: " + name + ": " + retired[0], flush=True)
        else:
            errors.append("live/unclassified native skip: " + name + ": " +
                          reasons.get(name, "").strip()[-600:])
    for name in listed:
        if name not in terminal:
            errors.append("listed native test did not finish: " + name)
    if not listed or not passes or package_pass != 1:
        errors.append("empty or incomplete native test package")
    lang = next((lang for lang, packages in PACKAGES.items() if package in packages), "")
    errors.extend(native_retirement_errors("".join(native_output), lang, passed))
    return errors


def implementation_result(text, lang):
    rows = re.findall(r"^IMPLEMENTATION_PREREQUISITES_PASS language=([^ ]+) "
                      r"constructs=(\d+) witnesses=(\d+)$", text, re.MULTILINE)
    if len(rows) != 1 or rows[0][0] != lang:
        return ["missing, duplicate or wrong-language implementation prerequisite result"]
    if min(int(rows[0][1]), int(rows[0][2])) <= 0:
        return ["empty implementation construct/witness coverage"]
    return []


def fuzz_result(text, arm, seed, lang="", builder=False):
    """The harness's old exit-0 permits absent roots; readiness does not."""
    errors = []
    if re.search(r"seeds absent|non-finite mutants not compared|finite-owed", text):
        errors.append("wire roster or finite-value exemption was reported")
    if arm != "retain" and not builder and "seeds outside the arm" in text:
        errors.append("plain wire-fuzz unexpectedly excluded seeds")
    prefix = "wire-fuzz" + ("-builder" if builder else "-mixed-builder" if lang in MIXED_BUILDER else "") + (" retain" if arm == "retain" else "")
    pattern = (r"^" + re.escape(prefix) + r": seed (\d+), (\d+) seeds over (\d+) roots"
               r"(?:, \d+ seeds outside the arm)?, (\d+) enumerated \+ (\d+) random = "
               r"(\d+) mutants, 0 divergences, [0-9.]+ s, [0-9.]+ mutants/s$")
    rows = [re.fullmatch(pattern, line) for line in text.splitlines()]
    rows = [row for row in rows if row is not None]
    if len(rows) != 1:
        errors.append("missing, duplicate or incomplete strict wire-fuzz summary")
    else:
        got_seed, seeds, roots, enumerated, random, total = map(int, rows[0].groups())
        if (got_seed != seed or min(seeds, roots, enumerated) <= 0 or
                random != RANDOM_MUTANTS or total != enumerated + random):
            errors.append("wire-fuzz seed/count/roster accounting is incomplete")
    return errors


class Runner:
    def __init__(self, root, lang):
        self.root = root
        self.out = root / "build" / "nightly-readiness" / lang
        self.out.mkdir(parents=True, exist_ok=True)
        self.results = []
        self.native_passes = set()
        self.lang = lang
        self.env = dict(os.environ, SCHEMA_SLOW="1", SCHEMA_REQUIRE_CORPUS="1")
        # Never update a reference pin or accept cache/no-test overrides here.
        for key in tuple(self.env):
            if key in ("MAKEFLAGS", "MFLAGS", "GNUMAKEFLAGS", "MAKEOVERRIDES", "MAKEFILES", "SCHEMA_SKIP_LEGS") or key.startswith("SCHEMA_UPDATE_"):
                self.env.pop(key)
        self.env["GOFLAGS"] = "-p=2"
        self.env["GOMAXPROCS"] = "2"
        self.env["CARGO_BUILD_JOBS"] = "2"
        self.env["ELIXIR_TABLES_EBIN"] = str(root / "build/elixir-tables-ebin")
        self.env["SCHEMA_C_COLLECTIONS_DRIVER"] = str(root / "build/c-collections-fuzz")
        self.env["SCHEMA_CPP_COLLECTIONS_DRIVER"] = str(root / "build/cpp-collections-fuzz")
        if lang == "cpp":
            # The shared harness includes the native Dart roster probes, and
            # the compiler package includes the explicit 2 GiB certification.
            self.env["SCHEMA_DART_ROSTER_DRIVER"] = str(root / "build/conformance-dart")
            self.env["SCHEMA_CERTIFY_INT32_MAX"] = "1"

    def run(self, name, argv, cwd=None, validate=None, expected=0):
        cwd = Path(cwd or self.root).resolve()
        # Go accepts an inherited logical PWD when it names the same inode,
        # but make CURDIR uses the physical path. Keep source overlay keys
        # and Go package paths identical, including packet subdirectories.
        env = dict(self.env, PWD=str(cwd))
        print("\n=== " + name + " ===\n" + shlex.join(argv), flush=True)
        stem = self.out / name
        (stem.with_suffix(".command.json")).write_text(
            json.dumps({"argv": argv, "cwd": str(cwd), "PWD": env["PWD"],
                        "SCHEMA_SLOW": "1", "SCHEMA_REQUIRE_CORPUS": "1",
                        "GOFLAGS": "-p=2", "GOMAXPROCS": "2"}, indent=2) + "\n")
        start = time.monotonic()
        try:
            with stem.with_suffix(".log").open("w") as log:
                proc = subprocess.Popen(argv, cwd=cwd, env=env, stdout=subprocess.PIPE,
                                        stderr=subprocess.STDOUT, text=True, errors="replace")
                for line in proc.stdout:
                    print(line, end="", flush=True)
                    log.write(line)
                proc.stdout.close()
                status = proc.wait()  # Deliberately no elapsed-time cutoff.
            text = stem.with_suffix(".log").read_text()
        except OSError as error:
            text, status = str(error), 127
            stem.with_suffix(".log").write_text(text + "\n")
            print(text, flush=True)
        errors = []
        if status != expected:
            errors.append("exit " + str(status) + ", expected " + str(expected))
        if validate:
            errors.extend(validate(text))
        self.results.append({"phase": name, "exit": status, "seconds": time.monotonic() - start,
                             "errors": errors})
        for error in errors:
            print("INCOMPLETE: " + name + ": " + error, flush=True)
        return text, status

    def missing(self, name, reason):
        print("INCOMPLETE: " + name + ": " + reason, flush=True)
        self.results.append({"phase": name, "errors": [reason]})

    def make(self, name, targets, makefile=None):
        # No caller-supplied target list or release-count overrides.
        argv = ["make", "--no-print-directory", "-j2"]
        if makefile:
            argv += ["-f", str(makefile)]
        return self.run(name, argv + targets.split(),
                        validate=lambda text: native_retirement_errors(text, self.lang, self.native_passes))

    def finish(self, lang):
        phases = [row["phase"] for row in self.results]
        missing = sorted(required_phases(lang) - set(phases))
        duplicates = sorted(phase for phase, count in Counter(phases).items() if count > 1)
        if missing:
            self.missing("phase-contract", "missing required phases: " + ", ".join(missing))
        if duplicates:
            self.missing("phase-contract-duplicates", "duplicate phases: " + ", ".join(duplicates))
        self.out.joinpath("results.json").write_text(json.dumps(self.results, indent=2) + "\n")
        failed = [row["phase"] for row in self.results if row["errors"]]
        print("\nOriginal-nine readiness " + lang + ": " +
              ("INCOMPLETE: " + ", ".join(failed) if failed else "PASS"), flush=True)
        if not failed:
            print("NIGHTLY_READINESS_PASS language=" + lang + " phases=" + str(len(self.results)), flush=True)
        return 1 if failed else 0


def run_native(runner, lang):
    packages = ["lockfile", *PACKAGES[lang]]
    if lang == "cpp":
        packages.extend(SHARED_PACKAGES)
    for package in packages:
        path = "./" + package_path(package)
        listed_text, status = runner.run("native-list-" + package,
                                        ["go", "test", "-timeout=0", "-list", "^(Test|Example|Fuzz)", path])
        listed = [line for line in listed_text.splitlines() if re.fullmatch(r"(?:Test|Example|Fuzz)\w+", line)]
        if status or not listed or len(listed) != len(set(listed)):
            runner.missing("native-list-" + package, "missing, empty or duplicate native test inventory")
        text, status = runner.run("native-" + package,
                   ["go", "test", "-json", "-timeout=0", "-count=1", "-parallel=2", path],
                   validate=lambda text, names=listed, pkg=package:
                       native_result(text, names, pkg, runner.native_passes))
        runner.native_passes.update(pass_events(text))


def go_packet_makefile(runner):
    # Preserve the existing packet-wide-go recipe/dependencies, changing its
    # one outer suite cap only. This override is private to this make process.
    original = (runner.root / "make/go.mk").read_text()
    match = re.search(r"^packet-wide-go:[^\n]*\n((?:\t[^\n]*\n)+)", original, re.MULTILINE)
    before = "go test -count=1 ."
    after = "go test -timeout=0 -count=1 -v ."
    if not match or match[1].count(before) != 1:
        runner.missing("packet-features", "the reviewed packet-wide-go outer test invocation changed")
        return None
    recipe = match[1].replace(before, after)
    text = "include Makefile\npacket-wide-go:\n" + recipe
    makefile = runner.out / "Makefile.go-packet-uncapped"
    makefile.write_text(text)
    runner.out.joinpath("Makefile.go-packet-uncapped.json").write_text(json.dumps({
        "source_sha256": hashlib.sha256(original.encode()).hexdigest(),
        "execution_sha256": hashlib.sha256(text.encode()).hexdigest(),
        "replacement": {before: after},
    }, indent=2) + "\n")
    return makefile


def packet_result(text, random=False, compilation=False):
    if compilation:
        return [] if re.search(r"^Generated: .+", text, re.MULTILINE) else [
            "packet compiler emitted no executable completion marker"]
    pattern = r"^OK \([1-9][0-9]* iterations, seed [0-9]+\)$" if random else r"^OK$"
    return [] if len(re.findall(pattern, text, re.MULTILINE)) == 1 else [
        "packet program emitted no unique successful execution marker"]


