def required_phases(lang):
    """Independent completion contract: omitting a runner call cannot turn green."""
    required = {"prerequisites", "implementation", "external-table-gates",
                "wire-driver-build", "wire-retain-controls", "packet-build", "packet-features"}
    for package in ("lockfile", *PACKAGES[lang], *(SHARED_PACKAGES if lang == "cpp" else ())):
        required |= {"native-list-" + package, "native-" + package}
    if lang == "moo":
        # MOO's packet programs are its package's probes (run_moo_packets):
        # one interpreter, one mode per shape.
        required |= {"packet-normal-0", "packet-ludicrous-0"}
        required |= {"retain-moo-" + name for name in MOO_RETENTION_CONTROLS}
    elif lang == "cpp":
        required.add("readiness-contracts")
        required |= {"packet-" + name for name in
                     ("schema_test", "schema_test_guard", "schema_test_wide",
                      "schema_test_random", "schema_test_ludicrous")}
    elif lang == "c":
        required |= {"packet-" + name for name in
                     ("schema_test_c", "schema_test_c_asan", "schema_test_c_ludicrous",
                      "schema_test_bench_c")}
    else:
        modes = {"cs": 2, "go": 1, "rust": 2, "java": 2, "js": 2, "dart": 3, "elixir": 1, "goose": 2}[lang]
        required |= {"packet-" + shape + "-" + str(mode)
                     for shape in ("normal", "ludicrous") for mode in range(modes)}
    required |= {"wire-" + arm + "-" + str(seed)
                 for arm in ("plain", "retain") for seed in (1, 2, 3)}
    if lang == "cs":
        required |= {"wire-builder-" + str(seed) for seed in (1, 2, 3)}
    if lang == "c":
        required |= {"retain-c-plant", "retain-c"}
    elif lang == "go":
        required |= {"retain-go-" + mode + tail
                     for mode in ("file-count-floor", "unknown-node") for tail in ("-plant", "")}
    elif lang == "rust":
        required.add("retain-rust")
    elif lang == "goose":
        required |= {"retain-goose-" + name for name in GOOSE_RETENTION_CONTROLS}
    return required


