def overlay_control(runner, name, source, test, package, expected, sabotage=None,
                    replacement=None, toolchain=None):
    """The existing C/Go/Rust control recipes, with only their suite cap removed."""
    out = runner.out / name
    out.mkdir(exist_ok=True)
    changed = out / "source.gotext"
    if sabotage:
        _, status = runner.run(name + "-plant", ["go", "run", "./tools/sabotage",
                               "-name", sabotage, "-out", str(changed), source])
        if status:
            return
    else:
        original = (runner.root / source).read_text()
        before, after = replacement
        if before not in original:
            runner.missing(name, "existing retention sabotage no longer matches")
            return
        changed.write_text(original.replace(before, after))
    if not changed.exists() or changed.read_bytes() == (runner.root / source).read_bytes():
        runner.missing(name, "retention sabotage changed no source")
        return
    overlay = out / "overlay.json"
    overlay.write_text(json.dumps({"Replace": {str(runner.root / source): str(changed)}}) + "\n")
    args = ["go", "test", "-json", "-timeout=0", "-count=1", "-parallel=2",
            "-overlay=" + str(overlay), "-run", "^" + test + "$", package]
    if toolchain:
        args = ["env", "GOTOOLCHAIN=" + toolchain] + args

    def validate(text):
        events = []
        for line in text.splitlines():
            try:
                events.append(json.loads(line))
            except ValueError:
                return ["control did not emit native test events"]
        if not any(e.get("Test") == test and e.get("Action") == "fail" for e in events):
            return ["the exact retention test did not fail"]
        if any(e.get("Action") == "skip" for e in events) or "[build failed]" in text:
            return ["control skipped or failed to compile"]
        if expected not in text:
            return ["control failed without the intended retention assertion"]
        return []

    runner.run(name, args, validate=validate, expected=1)


