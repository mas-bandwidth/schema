def moo_uncapped_makefile(runner, targets):
    """The MOO gates' make recipes, with only Go's default suite cap removed.

    Each recipe that runs go test is copied from make/moo*.mk with -timeout=0
    added, and the copy overrides the recipe in a private makefile that
    includes the real one. A recipe that already names a cap fails closed.
    """
    sources = {path: path.read_text() for path in sorted((runner.root / "make").glob("moo*.mk"))}
    text, replaced = "include Makefile\n", {}
    for target in targets.split():
        found = [(path, match) for path, source in sources.items()
                 for match in re.finditer(r"^" + re.escape(target) + r":[^\n]*\n((?:\t[^\n]*\n)+)",
                                          source, re.MULTILINE)]
        if len(found) != 1:
            runner.missing("external-table-gates", "the reviewed MOO recipe is not unique: " + target)
            return None
        recipe = found[0][1][1]
        if "go test " not in recipe:
            continue
        if re.search(r"-timeout[= ]", recipe):
            runner.missing("external-table-gates", "the reviewed MOO recipe carries a suite cap: " + target)
            return None
        amended = recipe.replace("go test ", "go test -timeout=0 ")
        text += target + ":\n" + amended
        replaced[target] = {"source": str(found[0][0].relative_to(runner.root)),
                            "source_sha256": hashlib.sha256(recipe.encode()).hexdigest(),
                            "execution_sha256": hashlib.sha256(amended.encode()).hexdigest()}
    makefile = runner.out / "Makefile.moo-uncapped"
    makefile.write_text(text)
    runner.out.joinpath("Makefile.moo-uncapped.json").write_text(json.dumps(replaced, indent=2) + "\n")
    return makefile


def goose_uncapped_makefile(runner, targets):
    """The Goose gates' make recipes, with only their outer go test suite cap removed.

    Each recipe that runs go test is copied from make/goose*.mk with its
    `-timeout 600s` (or Go's default cap) replaced by -timeout=0, and the copy
    overrides the recipe in a private makefile that includes the real one.
    Prerequisites, sabotages and assertions stay the reviewed source's.
    """
    sources = {path: path.read_text() for path in sorted((runner.root / "make").glob("goose*.mk"))}
    text, replaced = "include Makefile\n", {}
    for target in targets.split():
        found = [(path, match) for path, source in sources.items()
                 for match in re.finditer(r"^" + re.escape(target) + r":[^\n]*\n((?:\t[^\n]*\n)+)",
                                          source, re.MULTILINE)]
        if len(found) != 1:
            if any(re.search(r"^" + re.escape(target) + r":", source, re.MULTILINE) for source in sources.values()) \
                    and not found:
                continue  # a rule without its own recipe here, e.g. a static pattern rule
            runner.missing("external-table-gates", "the reviewed Goose recipe is not unique: " + target)
            return None
        recipe = found[0][1][1]
        if "go test " not in recipe:
            continue
        amended = recipe.replace(" -timeout 600s", "").replace("go test ", "go test -timeout=0 ")
        if re.search(r"-timeout[= ](?!0 )", amended):
            runner.missing("external-table-gates", "the reviewed Goose recipe carries another suite cap: " + target)
            return None
        text += target + ":\n" + amended
        replaced[target] = {"source": str(found[0][0].relative_to(runner.root)),
                            "source_sha256": hashlib.sha256(recipe.encode()).hexdigest(),
                            "execution_sha256": hashlib.sha256(amended.encode()).hexdigest()}
    makefile = runner.out / "Makefile.goose-uncapped"
    makefile.write_text(text)
    runner.out.joinpath("Makefile.goose-uncapped.json").write_text(json.dumps(replaced, indent=2) + "\n")
    return makefile


