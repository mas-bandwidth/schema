def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv
    if len(argv) != 1 or argv[0] not in LANGUAGES:
        print("usage: test/conformance/nightly-readiness <cpp|c|cs|go|rust|java|js|dart|elixir|goose|moo>",
              file=sys.stderr)
        return 2
    lang = argv[0]
    root = Path(__file__).resolve().parents[2]
    runner = Runner(root, lang)
    if lang == "cpp":
        runner.run("readiness-contracts", [sys.executable, "test/conformance/nightly_readiness_test.py"],
                   validate=lambda text: [] if re.search(r"^Ran [1-9][0-9]* tests? in ", text, re.MULTILINE)
                   and re.search(r"^OK$", text, re.MULTILINE) else ["readiness contract tests did not execute"])
    # SCHEMA_REQUIRE_CORPUS makes every port's native tests read the C++
    # reference's byte oracle, so a clean bench builds it here.
    prerequisites = "bin/schema build/conformance-harness build/fixedform-corpus/.stamp"
    if lang == "cpp":
        prerequisites += " build/c-collections-fuzz build/cpp-collections-fuzz build/conformance-dart"
    if lang == "dart":
        # Native cook-write tests import this corpus directly, before the
        # later AOT driver phase. A clean bench must not depend on that race.
        prerequisites += " build/tables-generated-dart/.stamp cards-dart-generate"
    if lang == "elixir":
        # Native message conformance invokes the compiled driver, before the
        # later fuzz phase. Prepare it on a clean checkout as well.
        prerequisites += " " + DRIVER_BUILD[lang]
    harness = "./build/conformance-harness"
    if lang == "goose":
        # The pinned compiler, and a harness built with the target's tag,
        # where compiler.Carried("goose") has its registrations.
        prerequisites += " goose-toolchain-ready build/conformance-harness-goose"
        harness = "./build/conformance-harness-goose"
    if lang == "moo":
        # The pinned interpreter and analyzer, and a harness built with the
        # target's tag, where compiler.Carried("moo") has its registrations.
        prerequisites += " moo-toolchain-ready build/conformance-harness-moo"
        harness = "./build/conformance-harness-moo"
    runner.make("prerequisites", prerequisites)
    runner.run("implementation", [harness, "implementation", "--lang", lang],
               validate=lambda text: implementation_result(text, lang))
    run_native(runner, lang)
    run_packets(runner, lang)
    run_external(runner, lang)
    run_fuzz(runner, lang)
    run_controls(runner, lang)
    return runner.finish(lang)


if __name__ == "__main__":
    sys.exit(main())
