#!/bin/sh
# THE ALL-ROOTS WIRE-FUZZ DRIVER'S BUILD (make/rust.mk, tables-rust-wire-fuzz-all).
#
# Generates every unit test/conformance/rust/src/wire_fuzz_all.rs dispatches,
# lays each unit's variable-wire modules out as one module directory with a
# mod.rs, and compiles the driver with rustc beside them — the way
# build/conformance-rust-card is built from the card's three modules. The
# working directory is the repository root.
#
# usage: wire-fuzz-all-build <out binary> [generator command]
#
# The generator command defaults to ./bin/schema; the retention negative
# control passes a `go run -overlay=...` command so the driver is built from a
# sabotaged generator without editing a tracked file.
set -e
out=$1
shift
gen=${*:-./bin/schema}
dir=$out.d
rm -rf "$dir"
mkdir -p "$dir/src"
for unit in backenddemo:tables/backend \
	blobdemo:tables/blobs \
	graphdemo:tables/pointers \
	listdemo:tables/lists \
	mapdemo:tables/maps \
	messagedemo:tables/messages \
	scalars:tables/scalars \
	streamdemo:tables/stream \
	tabledemo:tables/examples \
	tbla2:test/tables/A2.schema \
	tblg1:test/tables/G1.schema \
	tblk1:test/tables/K1.schema \
	tblk2:test/tables/K2.schema \
	tblm1:test/tables/M1.schema \
	tblm2:test/tables/M2.schema \
	tblp1:test/tables/P1.schema \
	tblp2:test/tables/P2.schema \
	tblp3:test/tables/P3.schema \
	tblr1:test/tables/R1.schema \
	tblr2:test/tables/R2.schema \
	tblscalars2:test/tables/Scalars2.schema \
	tblv1:test/tables/V1.schema \
	tblv2:test/tables/V2.schema \
	tblw1:test/tables/W1.schema \
	tblw2:test/tables/W2.schema \
	vocab9demo:tables/vocab9 \
	vocabdemo:tables/vocab \
	widedemo:examples-wide; do
	name=${unit%%:*}
	path=${unit#*:}
	$gen generate --lang rust --out "$dir/gen/$name" "$path" 2>"$dir/gen-$name.log" || {
		cat "$dir/gen-$name.log"
		exit 1
	}
	mkdir -p "$dir/src/$name"
	: >"$dir/src/$name/mod.rs"
	for f in "$dir/gen/$name/build_version.rs" "$dir/gen/$name/variable_runtime.rs" \
		"$dir/gen/$name/table_enums.rs" "$dir/gen/$name/fixed_runtime.rs" "$dir/gen/$name/message_runtime.rs" \
		"$dir/gen/$name"/*_records.rs "$dir/gen/$name"/*_fixed.rs \
		"$dir/gen/$name"/*_table.rs "$dir/gen/$name"/*_variable.rs \
		"$dir/gen/$name"/*_message.rs; do
		[ -f "$f" ] || continue
		m=$(basename "$f" .rs)
		# Generated message and fixed modules normally live at crate root.
		# In this multi-unit driver each unit is its own parent module.
		sed 's/^use crate::\*;/use super::*;/' "$f" > "$dir/src/$name/$(basename "$f")"
		printf '#[allow(dead_code, unused_imports)]\npub mod %s;\n#[allow(unused_imports)]\npub use %s::*;\n' "$m" "$m" >>"$dir/src/$name/mod.rs"
	done
done
cp test/conformance/rust/src/wire_fuzz_all.rs "$dir/src/main.rs"
rustc --edition 2024 -O -A warnings -o "$out" "$dir/src/main.rs"
