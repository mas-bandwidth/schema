#!/bin/sh
# THE JAVASCRIPT LEG's WALK negative control (docs/PORTING.md I11).
#
# One statement of the GENERATED text reader is changed in a COPY of the
# generated tree: the bool arm of the from-text walk stores false where the
# text said true. The driver (test/conformance/js/main.mjs) imports from
# SCHEMA_JS_GENERATED, so it is aimed at the copy and nothing tracked is
# written to. The matrix must go red on `js / json-read` and on no other
# surface: json-write and wire do not run the reader, so they stay green, which
# is what says the harness found a defect in generated code and localized it.
#
# The write-refusal mode drops the variable writer's ranged-integer refusal
# (TableVariableScalarHolds's min/max test) in the same kind of copy: the
# matrix must go red on `js / write-refusal` at wref_range_high and
# wref_range_low while `wire` stays green. The write-refusal-fixed mode drops
# WeaponConfig's ranged-integer refusal from the fixed writer's check body
# (`js / write-refusal-fixed` red at fref_range_high and fref_range_low), and
# the write-refusal-message mode drops StorePurchase's from the message
# writer's body (`js / write-refusal-message` red at mref_range_high and
# mref_range_low, `message` green); `wire` stays green in both.
set -eu

mode=${1:-walk}
src=build/tables-generated-js
out=build/js-conformance-negative-$mode
file=examples/TabledemoVariable.js
case "$mode" in
walk)
    anchor='        holder\[key\] = true;'
    replacement='        holder[key] = false;'
    ;;
write-refusal)
    anchor='  if (d.lo !== null \&\& (v < d.lo || v > d.hi)) { return false; }'
    replacement='  \/\/ SABOTAGED: a ranged integer writes unchecked'
    ;;
write-refusal-fixed)
    file=examples/TabledemoTable.js
    anchor='  if (!Number.isInteger(value.penetration) || value.penetration < 0 || value.penetration > 10) { return false; }'
    replacement='  \/\/ SABOTAGED: a ranged integer writes unchecked'
    ;;
write-refusal-message)
    file=backend/BackenddemoTable.js
    anchor='    if (!Number.isInteger(value.quantity) || value.quantity < 1 || value.quantity > 99) { return w.Refuse(); }'
    replacement='    \/\/ SABOTAGED: a ranged integer writes unchecked'
    ;;
*) echo "unknown control: $mode" >&2; exit 1 ;;
esac

rm -rf "$out"
mkdir -p "$out"
cp -R "$src" "$out/generated"

n=$(grep -c "^$anchor\$" "$src/$file")
if [ "$n" != 1 ]; then
    echo "negative control anchor matched $n times in $src/$file, want exactly 1" >&2
    exit 1
fi
sed "s/^$anchor\$/$replacement/" "$src/$file" > "$out/generated/$file"
if cmp -s "$src/$file" "$out/generated/$file"; then
    echo "negative control patched nothing: $mode" >&2
    exit 1
fi

root=$(pwd)
printf '#!/bin/sh\nSCHEMA_JS_GENERATED=%s/%s/generated exec %s/test/conformance/js/driver "$@"\n' "$root" "$out" "$root" > "$out/driver"
chmod +x "$out/driver"
printf 'js %s/%s/driver\n' "$root" "$out" > "$out/drivers.txt"

if build/conformance-harness run --drivers "$out/drivers.txt" --work "$out/work" > "$out/log" 2>&1; then
    echo "negative control failed: $mode left conformance green" >&2
    exit 1
fi
cat "$out/log"
if [ "$mode" = write-refusal ]; then
    grep -q 'js / write-refusal: wref_range_high' "$out/log"
    grep -q 'js / write-refusal: wref_range_low' "$out/log"
    grep -q 'write-refusal FAIL' "$out/log"
    grep -Eq '^ *wire +pass' "$out/log"
    echo "JavaScript write-refusal negative control: detected by js / write-refusal"
    exit 0
fi
if [ "$mode" = write-refusal-fixed ]; then
    grep -q 'js / write-refusal-fixed: fref_range_high' "$out/log"
    grep -q 'js / write-refusal-fixed: fref_range_low' "$out/log"
    grep -q 'write-refusal-fixedFAIL' "$out/log"
    grep -Eq '^ *wire +pass' "$out/log"
    echo "JavaScript write-refusal-fixed negative control: detected by js / write-refusal-fixed"
    exit 0
fi
if [ "$mode" = write-refusal-message ]; then
    grep -q 'js / write-refusal-message: mref_range_high' "$out/log"
    grep -q 'js / write-refusal-message: mref_range_low' "$out/log"
    grep -q 'write-refusal-messageFAIL' "$out/log"
    grep -Eq '^ *message +pass' "$out/log"
    grep -Eq '^ *wire +pass' "$out/log"
    echo "JavaScript write-refusal-message negative control: detected by js / write-refusal-message"
    exit 0
fi
grep -q 'js / json-read' "$out/log"
grep -q 'json-read     FAIL' "$out/log"
grep -Eq '^ *json-write +pass' "$out/log"
grep -Eq '^ *wire +pass' "$out/log"
echo "JavaScript walk negative control: $mode detected by js / json-read"
