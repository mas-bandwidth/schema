#!/bin/sh
# Prove byte decoding cannot replace invalid UTF-8 before FromJson sees it.
# Only the adapter is changed; generated readers and all input pins stay intact.
set -eu
mode=${1:-positive}
case "$mode" in positive|replacement) ;; *) echo "unknown mode: $mode" >&2; exit 2 ;; esac
root=$(pwd)
out=build/js-text-boundary/$mode
source=test/conformance/js/main.mjs
rm -rf "$out"
mkdir -p "$out"
# a driver copy imports the fixed-root bridge, the write-refusal surfaces and
# the message-load verdict (messageverdict.mjs) from beside it
cp test/conformance/js/fixed.mjs "$out/fixed.mjs"
cp test/conformance/js/writerefusal.mjs "$out/writerefusal.mjs"
cp test/conformance/js/messageverdict.mjs "$out/messageverdict.mjs"
cp test/conformance/js/surfaces1122.mjs "$out/surfaces1122.mjs"
main="$root/$source"
if [ "$mode" = replacement ]; then
    anchor='const jsonUTF8 = new TextDecoder("utf-8", { fatal: true, ignoreBOM: true });'
    matches=$(grep -Fxc "$anchor" "$source" || true)
    [ "$matches" = 1 ] || { echo "negative control anchor matched $matches times, want 1" >&2; exit 1; }
    sed 's/fatal: true, ignoreBOM: true/fatal: false, ignoreBOM: true/' "$source" > "$out/main.mjs"
    if cmp -s "$source" "$out/main.mjs"; then echo 'negative control changed nothing' >&2; exit 1; fi
    main="$root/$out/main.mjs"
fi
cat > "$out/driver" <<WRAP
#!/bin/sh
if [ "\$2" = list ]; then
    # the three text surfaces, and every unit the leg opts into: a unit left
    # out is filtered from the manifest and its claimed rows score ABSENT
    listed=\$("\${NODE:-node}" "$main" "\$1" list) || exit 1
    printf '%s\n' json-read json-write json-hostile
    printf '%s\n' "\$listed" | sed -n '/^unit /p'
    exit 0
fi
exec "\${NODE:-node}" "$main" "\$@"
WRAP
chmod +x "$out/driver"
printf 'js %s/%s/driver\n' "$root" "$out" > "$out/drivers"
rc=0
build/conformance-harness run --claims --surfaces json-read,json-write,json-hostile --drivers "$out/drivers" --work "$out/work" --results "$out/results.json" > "$out/log" 2>&1 || rc=$?
if [ "$mode" = positive ]; then
    rows=$(grep -c '^json-hostile ' testdata/conformance/tables/MANIFEST.txt)
    if [ "$rc" -ne 0 ] || ! grep -Eq "^json-hostile +pass $rows/$rows *\$" "$out/log"; then
        cat "$out/log"; echo 'JavaScript text boundary gate failed' >&2; exit 1
    fi
    grep -E '^json-(read|write|hostile) ' "$out/log"
    # The reader accepts exactly one leading BOM. Preserve the byte boundary:
    # stripping one here would let the reader incorrectly accept a double BOM.
    mkdir -p "$out/bom/single" "$out/bom/double" "$out/bom/strict" "$out/bom/buffer" "$out/bom/stripped"
    cp test/conformance/js/fixed.mjs "$out/bom/fixed.mjs"
    cp test/conformance/js/writerefusal.mjs "$out/bom/writerefusal.mjs"
    cp test/conformance/js/messageverdict.mjs "$out/bom/messageverdict.mjs"
    cp test/conformance/js/surfaces1122.mjs "$out/bom/surfaces1122.mjs"
    printf '\357\273\277{}\n' > "$out/bom/single/RootConfig.json"
    printf '\357\273\277\357\273\277{}\n' > "$out/bom/double/RootConfig.json"
    printf 'json-hostile bom-single tabledemo RootConfig %s/bom/single 0,0,0,0,0,false,read\njson-hostile bom-double tabledemo RootConfig %s/bom/double refused\n' "$out" "$out" > "$out/bom/manifest"
    "${NODE:-node}" "$source" "$out/bom/manifest" json-hostile "$out/bom/strict"
    sed 's/return jsonUTF8.decode(bytes);/return bytes.toString("utf8");/' "$source" > "$out/bom/buffer-main.mjs"
    if cmp -s "$source" "$out/bom/buffer-main.mjs"; then echo "BOM control did not restore the Buffer decoder" >&2; exit 1; fi
    sed 's/ignoreBOM: true/ignoreBOM: false/' "$source" > "$out/bom/stripped-main.mjs"
    "${NODE:-node}" "$out/bom/buffer-main.mjs" "$out/bom/manifest" json-hostile "$out/bom/buffer"
    "${NODE:-node}" "$out/bom/stripped-main.mjs" "$out/bom/manifest" json-hostile "$out/bom/stripped"
    cmp "$out/bom/strict/bom-single" "$out/bom/buffer/bom-single"
    cmp "$out/bom/strict/bom-double" "$out/bom/buffer/bom-double"
    [ "$(head -n 1 "$out/bom/strict/bom-single")" = read ]
    grep -qx 'refused' "$out/bom/strict/bom-double"
    [ "$(head -n 1 "$out/bom/stripped/bom-double")" = read ]
    echo 'JavaScript UTF-8 BOM: exactly one leading BOM reads; stripping at the adapter would incorrectly accept a double BOM'
    echo 'JavaScript strict UTF-8 boundary: all text claims pass'
    exit 0
fi
# Under the one strict read the corpus row str-illformed-at-bound is refused
# with or without replacement (U+FFFD is three bytes, which carries the string
# past its bound), so the row the replacement owns is one whose 0xFF sits well
# inside the bound: a strict boundary refuses it, a replacing one reads it.
mkdir -p "$out/inbound/text" "$out/inbound/strict" "$out/inbound/replaced"
printf '{ "version_note": "a\377b" }\n' > "$out/inbound/text/RootConfig.json"
printf 'json-hostile illformed-in-bound tabledemo RootConfig %s/inbound/text refused\n' "$out" > "$out/inbound/manifest"
"${NODE:-node}" "$source" "$out/inbound/manifest" json-hostile "$out/inbound/strict"
"${NODE:-node}" "$main" "$out/inbound/manifest" json-hostile "$out/inbound/replaced"
[ "$(head -n 1 "$out/inbound/strict/illformed-in-bound")" = refused ] || { echo 'the strict boundary read an ill-formed byte' >&2; exit 1; }
[ "$(head -n 1 "$out/inbound/replaced/illformed-in-bound")" = read ] || { echo 'negative control left replacement decoding refusing the in-bound row' >&2; exit 1; }
# The rows replacement decoding may move are the corpus's ill-formed UTF-8
# inputs, which only this byte boundary sees: str-illformed-at-bound (refused
# either way, above) and the two regression rows whose ill-formed bytes sit in
# a comment (0xFF; ED A0 80, a surrogate spelled in UTF-8). A replacing
# boundary hands the reader U+FFFD there, which a comment skips, so each of
# those two MUST go red here; any other row is unrelated.
if grep '^  js / ' "$out/log" | grep -Ev 'js / json-hostile: (str-illformed-at-bound|rr-comment-illformed-utf8|rr-comment-lone-surrogate):'; then
    cat "$out/log"; echo 'replacement decoding changed an unrelated row' >&2; exit 1
fi
for row in rr-comment-illformed-utf8 rr-comment-lone-surrogate; do
    grep -q "js / json-hostile: $row: read outcome differs: got read, want refused" "$out/log" ||
        { cat "$out/log"; echo "NEGATIVE CONTROL FAILED: replacement decoding left $row refused" >&2; exit 1; }
done
grep -Eq '^json-read +pass ' "$out/log"
grep -Eq '^json-write +pass ' "$out/log"
echo 'JavaScript text boundary negative control: replacement decoding reads an ill-formed byte the strict boundary refuses; text read/write remain green'
