#!/bin/sh
# THE MOO LEG's cook-write gate and its negative control (make/moo-cook-write.mk;
# docs/SPEC-TABLES.md §7.2, docs/rulings.json fixed-dead-bytes-are-zero).
#
#   run      the harness over the moo leg (build/conformance-moo), its output
#            in build/conformance-moo-cook-write/log. The leg's other surfaces
#            belong to other gates, so the run's own exit status is not this
#            gate's verdict: it passes only when the log's cook-write line reads
#            `pass N/N` with the same N twice and no `+Ka` absence suffix, and
#            the log carries no RELAXED line for `moo / cook-write`.
#   control  the same check over the harness run on units generated by a
#            private compiler whose embedded table_cookwrite.moo writes an
#            absent optional's payload and a counted array's dead slots again
#            (a sed over a copy, `go build -overlay`; no tracked file is
#            written): the check must go red, on the cook-write line.
#
# usage: test/conformance/moo/cook-write <run|control>
set -eu

mode=$1
root=$(pwd)

# check <log>: the cook-write verdict of one harness log
check() {
    log=$1
    line=$(grep -E '^cook-write +' "$log" || true)
    if [ -z "$line" ]; then
        echo "moo cook-write: the log carries no cook-write line" >&2
        return 1
    fi
    if grep -q 'RELAXED.* moo / cook-write' "$log"; then
        echo "moo cook-write: the log relaxes a cook-write row:" >&2
        grep 'RELAXED.* moo / cook-write' "$log" >&2
        return 1
    fi
    set -- $line
    if [ "$#" -ne 3 ] || [ "$2" != pass ]; then
        echo "moo cook-write: the cook-write line is not a plain pass: $line" >&2
        grep 'moo / cook-write' "$log" >&2 || true
        return 1
    fi
    got=${3%/*}
    of=${3#*/}
    case "$got$of" in
    *[!0-9]*|'') echo "moo cook-write: the cook-write count is not N/N: $line" >&2; return 1 ;;
    esac
    if [ "$got" != "$of" ] || [ "$of" -eq 0 ]; then
        echo "moo cook-write: $line" >&2
        return 1
    fi
    echo "moo cook-write: pass $got/$of, no row relaxed"
}

case "$mode" in
run)
    out=build/conformance-moo-cook-write
    rm -rf "$out"
    mkdir -p "$out"
    build/conformance-harness run --only moo > "$out/log" 2>&1 || true
    check "$out/log"
    ;;
control)
    out=build/conformance-moo-cook-write-negative-control
    rm -rf "$out"
    mkdir -p "$out"
    source=internal/codegen/mootable/runtime/table_cookwrite.moo
    perl -pe 's/^(\t\t)if not present then$/$1if false then/; s/^\t\t\tn = count\n//' "$source" > "$out/runtime.moo"
    if [ "$(diff "$source" "$out/runtime.moo" | grep -c '^<')" -ne 2 ]; then
        echo "NEGATIVE CONTROL: the sabotage did not patch both zeroing lines of $source" >&2
        exit 1
    fi
    printf '{"Replace":{"%s/%s":"%s/%s/runtime.moo"}}\n' "$root" "$source" "$root" "$out" > "$out/overlay.json"
    go build -tags schema_leg_moo -overlay "$root/$out/overlay.json" -o "$out/schema-moo" ./cmd/schema
    # the units exactly as make/moo-conformance.mk's build/conformance-moo generates them
    mkdir -p "$out/generated"
    grep '^unit[[:space:]]' testdata/conformance/tables/MANIFEST.txt |
    while read -r _ key paths; do
        # shellcheck disable=SC2086
        if ! "$out/schema-moo" generate --lang moo --out "$out/generated/$key" $paths > "$out/generated/$key.log" 2>&1; then
            rm -rf "$out/generated/$key"
            mv "$out/generated/$key.log" "$out/generated/$key.refused"
        else
            rm -f "$out/generated/$key.log"
        fi
    done
    moo="${MOO:-$root/dist/moo/moo}"
    printf '#!/bin/sh\nexec env SCHEMA_MOO_GENERATED=%s/generated MOO_DRIVER_STAGE=%s/stage MOO=%s %s/test/conformance/moo/driver "$@"\n' \
        "$out" "$out" "$moo" "$root" > "$out/driver"
    chmod +x "$out/driver"
    printf 'moo %s/driver\n' "$out" > "$out/drivers.txt"
    build/conformance-harness run --drivers "$out/drivers.txt" --work "$out/work" > "$out/log" 2>&1 || true
    if check "$out/log" > "$out/check" 2>&1; then
        echo "NEGATIVE CONTROL FAILED: the cook-write gate is green with the cook writer's zeroing removed" >&2
        cat "$out/check" >&2
        exit 1
    fi
    if ! grep -qE '^cook-write +FAIL' "$out/log"; then
        echo "NEGATIVE CONTROL FAILED: the gate went red, but not on a failing cook-write line" >&2
        cat "$out/check" >&2
        exit 1
    fi
    grep -E '^cook-write +' "$out/log"
    echo "negative control: the moo cook writer with its zeroing removed turns the cook-write gate red"
    ;;
*) echo "unknown mode: $mode" >&2; exit 1 ;;
esac
