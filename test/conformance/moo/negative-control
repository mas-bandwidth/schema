#!/bin/sh
# THE MOO LEG's conformance negative controls (test/conformance/README.md;
# docs/PORTING.md I2 and I11). Each one sabotages the EMITTER, never a
# generated file and never the driver: a sed over a copy of one runtime file
# the table emitter embeds (internal/codegen/mootable/runtime/*.moo, the
# //go:embed glob), checked to have matched, `go build -overlay` into a private
# compiler, the conformance units regenerated from it, and the harness required
# red on the named surfaces with their neighbours green. No tracked file is
# written, so an interrupt leaves no sabotaged tree.
#
#   report  table_load.moo damages the load at every unknown field it meets,
#           so a wire a newer writer wrote is refused whole: the surfaces that
#           read such wires answer `refused` where the oracle reads (`moo /
#           framing`, `moo / retain` and `moo / retain-save`)
#           and nothing else; `wire`, `json-read` and `cook-write` green (no
#           instance wire carries an unknown field). Local counters are not an
#           oracle, so a sabotage that moved only a counter would be harmless.
#           Since the single-read corpus migration no `report` row reaches
#           the variable walk's unknown-field skip (measured: under this
#           sabotage `report` stays 128/128), so `report` is not on this
#           control's list.
#   framing table_load.moo drops the id table's 4096-entry bound
#           (docs/LAYERS/1-framing.md F6): `moo / framing` red on
#           frame_entries_4097 and nothing else; `wire` and `report` green.
#   walk    json.moo's field-key index never holds the first declared field:
#           the text READER's surfaces red (`moo / json-read`, `moo /
#           json-hostile`, which reads through the same index, and `moo /
#           cook-write`, whose recipes read their input as text) and nothing
#           else; `json-write` and `wire` green, so the break is the text
#           reader's and the matrix localizes it (I11).
#
#   write-refusal  table_save.moo's variable writer stops refusing a NaN or an
#           infinity (docs/SPEC.md §5.1; SPEC-TABLES.md §3.3: the finite check
#           and the range check, which also holds finiteness, are both taken out): the write-refusal
#           battery's variable-class float rows (cooktorture's slice and map
#           floats) are written instead of refused, so `moo / write-refusal`
#           and nothing else goes red; `wire`, `message`, write-refusal-fixed
#           and write-refusal-message stay green.
#   write-refusal-fixed  table_fixed.moo's fixed writer stops refusing a NaN or
#           an infinity: a fixed root is written through that one checked
#           writer for both batteries, so `moo / write-refusal-fixed` goes red
#           with `moo / write-refusal` beside it, and `wire`, `message` and
#           write-refusal-message stay green.
#   write-refusal-message  table_message.moo's SaveMessages stops refusing
#           ill-formed UTF-8 in a text: `moo / write-refusal-message` red alone;
#           `wire`, `message`, write-refusal and write-refusal-fixed green.
#
# usage: test/conformance/moo/negative-control <report|walk|framing|write-refusal|write-refusal-fixed|write-refusal-message>
set -eu

mode=$1
root=$(pwd)
out=build/moo-table-control-$mode
rm -rf "$out"
mkdir -p "$out"
case "$mode" in
report)
    source=internal/codegen/mootable/runtime/table_load.moo
    perl -pe 's/^(\s*)(_?report)\.unknown \+= 1$/$1$2.unknown += 1; $2.bodyDamaged = true/' "$source" > "$out/runtime.moo"
    ;;
framing)
    source=internal/codegen/mootable/runtime/table_load.moo
    sed 's/ or lo > ID_TABLE_BOUND or / or /' "$source" > "$out/runtime.moo"
    ;;
walk)
    source=internal/codegen/mootable/runtime/json.moo
    sed 's/^\([[:space:]]*\)k\[fd\.json\] = i$/\1if i ~= 1 then k[fd.json] = i end/' "$source" > "$out/runtime.moo"
    ;;
write-refusal)
    source=internal/codegen/mootable/runtime/table_save.moo
    sed -e 's/if not V\.finite32(val) then/if false and not V.finite32(val) then/' \
        -e 's/if not V\.finite64(val\[1\], val\[2\]) then/if false and not V.finite64(val[1], val[2]) then/' \
        -e 's/if not V\.floatInRange(e, val) then/if false and not V.floatInRange(e, val) then/' "$source" > "$out/runtime.moo"
    ;;
write-refusal-fixed)
    source=internal/codegen/mootable/runtime/table_fixed.moo
    sed -e 's/^\t\t\tif not V\.finite32(v) then$/\t\t\tif false and not V.finite32(v) then/' \
        -e 's/^\t\t\tif not V\.finite64(v\[1\], v\[2\]) then$/\t\t\tif false and not V.finite64(v[1], v[2]) then/' \
        -e 's/if not V\.floatInRange(f, v) then/if false and not V.floatInRange(f, v) then/' "$source" > "$out/runtime.moo"
    ;;
write-refusal-message)
    source=internal/codegen/mootable/runtime/table_message.moo
    sed 's/if type(s) ~= "string" or #s > fd\.bound or not V\.utf8String(s) then/if type(s) ~= "string" or #s > fd.bound then/' "$source" > "$out/runtime.moo"
    ;;
*) echo "unknown control: $mode" >&2; exit 1 ;;
esac
if cmp -s "$source" "$out/runtime.moo"; then
    echo "NEGATIVE CONTROL: the $mode sabotage patched nothing in $source" >&2
    exit 1
fi
printf '{"Replace":{"%s/%s":"%s/%s/runtime.moo"}}\n' "$root" "$source" "$root" "$out" > "$out/overlay.json"
go build -overlay "$root/$out/overlay.json" -o "$out/schema-moo" ./cmd/schema

# the units exactly as make/moo-conformance.mk's build/conformance-moo generates them
mkdir -p "$out/generated"
grep '^unit[[:space:]]' testdata/conformance/tables/MANIFEST.txt |
while read -r _ key paths; do
    # shellcheck disable=SC2086
    if ! "$out/schema-moo" generate --lang moo --out "$out/generated/$key" $paths > "$out/generated/$key.log" 2>&1; then
        rm -rf "$out/generated/$key"
        mv "$out/generated/$key.log" "$out/generated/$key.refused"
    else
        rm -f "$out/generated/$key.log"
    fi
done

moo="${MOO:-$root/dist/moo/moo}"
printf '#!/bin/sh\nexec env SCHEMA_MOO_GENERATED=%s/generated MOO_DRIVER_STAGE=%s/stage MOO=%s %s/test/conformance/moo/driver "$@"\n' \
    "$out" "$out" "$moo" "$root" > "$out/driver"
chmod +x "$out/driver"
printf 'moo %s/driver\n' "$out" > "$out/drivers.txt"
if build/conformance-harness run --drivers "$out/drivers.txt" --work "$out/work" > "$out/log" 2>&1; then
    echo "NEGATIVE CONTROL FAILED: the moo $mode sabotage left conformance green" >&2
    exit 1
fi
# the driver staged this control's surfaces under its own directory, never
# under the plain run's build/conformance-moo-driver
if [ ! -f "$out/stage/list/manifest.moo" ]; then
    echo "NEGATIVE CONTROL: the driver staged nothing under $out/stage" >&2
    exit 1
fi
red=$(grep -oE '^ *moo / [a-z-]+' "$out/log" | sed 's/^ *moo \/ //' | sort -u | tr '\n' ' ')
case "$mode" in
report) want="framing report retain retain-save " ; green="wire json-read cook-write" ;;
framing) want="framing " ; green="wire report" ;;
walk)   want="cook-write json-hostile json-read " ; green="wire json-write" ;;
write-refusal) want="write-refusal " ; green="wire message write-refusal-fixed write-refusal-message" ;;
write-refusal-fixed) want="write-refusal write-refusal-fixed " ; green="wire message write-refusal-message" ;;
write-refusal-message) want="write-refusal-message " ; green="wire message write-refusal write-refusal-fixed" ;;
esac
if [ "$red" != "$want" ]; then
    echo "NEGATIVE CONTROL FAILED: the moo $mode sabotage turned [${red}] red; it must turn exactly [${want}] red" >&2
    cat "$out/log" >&2
    exit 1
fi
for surface in $green; do
    if ! grep -qE "^$surface +pass" "$out/log"; then
        echo "NEGATIVE CONTROL FAILED: the moo $mode sabotage did not leave $surface green" >&2
        cat "$out/log" >&2
        exit 1
    fi
done
echo "Moo table negative control: the $mode sabotage of the emitter turns exactly [${want% }] red and leaves $green green"
