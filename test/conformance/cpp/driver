#!/bin/sh
# THE C++ LEG's driver (test/conformance/README.md).
#
# A driver is a COMMAND, not a binary, exactly so a leg can be assembled from
# what a backend already has. This one answers the table surfaces out of
# build/conformance-cpp and hands the cook's node dump to the binary that
# already produces it — test/tables/cook_main.cpp — rather than compiling a
# second copy of a walk that is already gated.
#
# usage: driver <manifest> list
#        driver <manifest> <surface> <outdir>
set -e

manifest=$1
surface=$2
out=$3

case "$surface" in
list)
    build/conformance-cpp "$manifest" list
    echo cook
    echo cook-forgery
    ;;
cook)
    # one line per cook, from the derived manifest:
    #   cook <case> <unit> <root> <file>
    grep '^cook ' "$manifest" | while read -r _ cookcase _ root file; do
        ./build/schema_test_cook dump "$root" "$file" > "$out/$cookcase"
    done
    ;;
cook-forgery)
    # the whole 111-row battery in ONE process, over the derived manifest
    ./build/schema_test_cook conformance "$manifest" "$out"
    ;;
*)
    exec build/conformance-cpp "$manifest" "$surface" "$out"
    ;;
esac
