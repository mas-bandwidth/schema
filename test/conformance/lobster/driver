#!/bin/sh
# THE LOBSTER LEG's driver (test/conformance/README.md; docs/PORT-LOBSTER.md,
# THE HARNESS).
#
# Every surface is answered by ONE Lobster program,
# test/conformance/lobster/main.lobster, under the pinned toolchain (its
# default JIT through TinyCC). Lobster resolves its imports when it compiles a
# program, so the program is run once per generated UNIT: this script writes
# it into build/conformance-lobster/<unit>/ as conformance_main.lobster, after
# one `import .<Base>Table` line per table module there, and runs the units of
# a surface in parallel. A unit the target refused has
# no directory (make/lobster.mk records its refusal as <unit>.refused), and its
# cases are answered `absent` here without running anything.
#
# The program reads its inputs by absolute path and writes its answers on
# stdout, one or more lines per case — the case name, a space, the answer's
# bytes as lowercase hex (continued on further lines under the same name), or
# the word `absent` — which this script writes as one file per case into
# <outdir> (`absent` as <case>.absent). Any other line on stdout is refused.
#
# `list` is the program's own surface list; a surface not on it exits 2 and
# the matrix prints ABSENT.
#
# The working directory is the repository root.
#
# usage: driver <manifest> list
#        driver <manifest> <surface> <outdir>
main=test/conformance/lobster/main.lobster
lobster=${LOBSTER:-dist/lobster-v2026.8/bin/lobster}
units=${LOBSTER_CONFORMANCE_UNITS:-build/conformance-lobster}
dir=$units/driver
root=$(pwd)
case "$1" in
/*) manifest=$1 ;;
*) manifest=$root/$1 ;;
esac
if [ ! -f "$main" ]; then
	case "$2" in
	list) exit 0 ;;
	*) exit 2 ;;
	esac
fi
mkdir -p "$dir" || exit 1

# stage writes the program into one unit's directory as
# conformance_main.lobster: one `import .<Base>Table` per table module the unit
# has, then main.lobster itself
stage() {
	{
		echo "// GENERATED by test/conformance/lobster/driver from main.lobster: the unit's table modules, then the program"
		for m in "$units/$1"/*Table.lobster; do
			[ -f "$m" ] || continue
			b=${m##*/}
			echo "import .${b%.lobster}"
		done
		cat "$main"
	} >"$units/$1/conformance_main.lobster"
}

# run answers one surface over one unit's cases, into $dir/<surface>.<unit>.out
run() {
	stage "$2" || return 1
	"$lobster" "$units/$2/conformance_main.lobster" -- "$root" "$manifest" "$1" "$2" >"$dir/$1.$2.out"
}

# the surface list, from the program; any generated unit compiles it
surfaces() {
	first=
	for d in "$units"/*/; do
		[ -f "$d/schema_tables.lobster" ] || continue
		first=${d%/}
		first=${first##*/}
		break
	done
	[ -n "$first" ] || { echo "driver: no generated unit under $units; run make $units" >&2; return 1; }
	stage "$first" || return 1
	"$lobster" "$units/$first/conformance_main.lobster" -- "$root" "$manifest" list "$first"
}

if [ "$2" = list ]; then
	surfaces
	exit
fi
surfaces >"$dir/list" || exit 1
grep -qx -- "$2" "$dir/list" || exit 2

# pairs prints `<unit> <case>` for every case a surface answers, joined
# through the manifest the way the program joins it (test/conformance/README.md,
# The surfaces): a message through its connection, a cook-write through its
# instance, a forgery through its subject's block or cook line, a refusal
# through its forgery. A refused unit's cases are answered absent from it.
pairs() {
	awk -v s="$1" '
	NR == FNR {
		if ($1 == "connection") conn[$2] = $3
		if ($1 == "instance") inst[$2] = $3
		if ($1 == "block") blk[$2] = $3
		if ($1 == "cook") ck[$4] = $3
		if ($1 == "forgery") fs[$2] = $4
		next
	}
	function subj(k, x) { return k == "block" ? blk[x] : ck[x] }
	(s == "wire" || s == "json-read") && $1 == "instance" { if (s == "wire" || $6 != "no-text") print $3, $2 }
	s == "json-write" && $1 == "instance" && $6 != "no-text" { print $3, $2 ".json" }
	s == "report" && $1 == "report" { print $3, $2 }
	s == "json-hostile" && $1 == "json-hostile" { print $3, $2 }
	(s == "block" || s == "block-foreign" || s == "block-dump") && $1 == "block" { print $3, $2 }
	(s == "cook" || s == "cook-foreign") && $1 == "cook" { print $3, $2 }
	s == "message" && $1 == "message" { print conn[$3], $2 }
	(s == "retain" || s == "retain-save") && $1 == "retain" { print $3, $2 }
	(s == "retain" || s == "retain-save") && $1 == "retain-message" { print $4, $2 }
	s == "cook-write" && $1 == "cook-write" { print inst[$2], $2; print inst[$2], $2 "-be" }
	s == "forgery" && $1 == "forgery" && $3 == "block" { print subj("block", $4), $2 }
	s == "cook-forgery" && $1 == "forgery" && $3 == "cook" { print subj("cook", $4), $2 }
	s == "block-reason" && $1 == "refusal" && $3 == "block" { print subj("block", fs[$2]), $2 }
	s == "cook-reason" && $1 == "refusal" && $3 == "cook" { print subj("cook", fs[$2]), $2 }
	' "$manifest" "$manifest"
}

mkdir -p "$3" || exit 1
rm -f "$dir/$2".*.out
pids=
pairs "$2" >"$dir/$2.pairs" || exit 1
for u in $(awk '{ print $1 }' "$dir/$2.pairs" | sort -u); do
	if [ -f "$units/$u/schema_tables.lobster" ]; then
		run "$2" "$u" &
		pids="$pids $!"
	elif [ -f "$units/$u.refused" ]; then
		awk -v u="$u" '$1 == u { print $2 " absent" }' "$dir/$2.pairs" >"$dir/$2.$u.out"
	else
		echo "driver: unit $u is neither generated nor refused under $units" >&2
		exit 1
	fi
done
status=0
for p in $pids; do
	wait "$p" || status=1
done
[ "$status" -eq 0 ] || exit 1
cat "$dir/$2".*.out 2>/dev/null | LOBSTER_OUTDIR=$3 perl -ne '
	chomp;
	if (/^(\S+) absent(?: (.+))?$/) {
		# an absence, with its reason when the program names one
		open(my $f, ">", "$ENV{LOBSTER_OUTDIR}/$1.absent") or die "$1: $!";
		print $f $2 if defined $2;
		close $f;
		next;
	}
	my ($c, $h) = /^(\S+) ([0-9a-f]*)$/ or die "driver: not an answer line: $_\n";
	my $mode = $seen{$c}++ ? ">>:raw" : ">:raw";
	open(my $f, $mode, "$ENV{LOBSTER_OUTDIR}/$c") or die "$c: $!";
	print $f pack("H*", $h);
	close $f;
'
