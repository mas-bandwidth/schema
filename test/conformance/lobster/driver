#!/bin/sh
# THE LOBSTER LEG's driver (test/conformance/README.md; docs/PORT-LOBSTER.md,
# THE HARNESS).
#
# Every surface is answered by ONE Lobster program,
# test/conformance/lobster/main.lobster, under the pinned toolchain (its
# default JIT through TinyCC). Lobster resolves its imports when it compiles a
# program, so the program is run once per generated UNIT: this script copies
# it into build/conformance-lobster/<unit>/ as conformance_main.lobster, beside
# conformance_unit.lobster (one `import .<Base>Table` per table module there),
# and runs the units of a surface in parallel. A unit the target refused has
# no directory (make/lobster.mk records its refusal as <unit>.refused), and its
# cases are answered `absent` here without running anything.
#
# The program reads its inputs by absolute path and writes its answers on
# stdout, one or more lines per case — the case name, a space, the answer's
# bytes as lowercase hex (continued on further lines under the same name), or
# the word `absent` — which this script writes as one file per case into
# <outdir> (`absent` as <case>.absent). Any other line on stdout is refused.
#
# `list` is the program's own surface list; a surface not on it exits 2 and
# the matrix prints ABSENT.
#
# The working directory is the repository root.
#
# usage: driver <manifest> list
#        driver <manifest> <surface> <outdir>
main=test/conformance/lobster/main.lobster
lobster=${LOBSTER:-dist/lobster-v2026.8/bin/lobster}
units=build/conformance-lobster
dir=$units/driver
root=$(pwd)
case "$1" in
/*) manifest=$1 ;;
*) manifest=$root/$1 ;;
esac
if [ ! -f "$main" ]; then
	case "$2" in
	list) exit 0 ;;
	*) exit 2 ;;
	esac
fi
mkdir -p "$dir" || exit 1

# stage copies the program into one unit's directory and writes the module
# that imports the unit's table modules
stage() {
	cp "$main" "$units/$1/conformance_main.lobster" || return 1
	{
		echo "// GENERATED by test/conformance/lobster/driver: the unit's table modules"
		for m in "$units/$1"/*Table.lobster; do
			[ -f "$m" ] || continue
			b=${m##*/}
			echo "import .${b%.lobster}"
		done
	} >"$units/$1/conformance_unit.lobster"
}

# run answers one surface over one unit's cases, into $dir/<surface>.<unit>.out
run() {
	stage "$2" || return 1
	"$lobster" "$units/$2/conformance_main.lobster" -- "$root" "$manifest" "$1" "$2" >"$dir/$1.$2.out"
}

# the surface list, from the program; any generated unit compiles it
surfaces() {
	first=
	for d in "$units"/*/; do
		[ -f "$d/schema_tables.lobster" ] || continue
		first=${d%/}
		first=${first##*/}
		break
	done
	[ -n "$first" ] || { echo "driver: no generated unit under $units; run make $units" >&2; return 1; }
	stage "$first" || return 1
	"$lobster" "$units/$first/conformance_main.lobster" -- "$root" "$manifest" list "$first"
}

if [ "$2" = list ]; then
	surfaces
	exit
fi
surfaces >"$dir/list" || exit 1
grep -qx -- "$2" "$dir/list" || exit 2

# the manifest kind a surface reads (test/conformance/README.md, The surfaces)
case "$2" in
wire) kind=instance ;;
report) kind=report ;;
block | block-foreign | block-dump) kind=block ;;
*)
	echo "driver: $2 is listed but names no manifest kind here" >&2
	exit 1
	;;
esac

mkdir -p "$3" || exit 1
rm -f "$dir/$2".*.out
pids=
for u in $(awk -v k="$kind" '$1 == k { print $3 }' "$manifest" | sort -u); do
	if [ -f "$units/$u/schema_tables.lobster" ]; then
		run "$2" "$u" &
		pids="$pids $!"
	elif [ -f "$units/$u.refused" ]; then
		awk -v k="$kind" -v u="$u" '$1 == k && $3 == u { print $2 " absent" }' "$manifest" >"$dir/$2.$u.out"
	else
		echo "driver: unit $u is neither generated nor refused under $units" >&2
		exit 1
	fi
done
status=0
for p in $pids; do
	wait "$p" || status=1
done
[ "$status" -eq 0 ] || exit 1
cat "$dir/$2".*.out 2>/dev/null | LOBSTER_OUTDIR=$3 perl -ne '
	chomp;
	my ($c, $h) = /^(\S+) (absent|[0-9a-f]*)$/ or die "driver: not an answer line: $_\n";
	if ($h eq "absent") { open(my $f, ">", "$ENV{LOBSTER_OUTDIR}/$c.absent") or die "$c: $!"; close $f; next }
	my $mode = $seen{$c}++ ? ">>:raw" : ">:raw";
	open(my $f, $mode, "$ENV{LOBSTER_OUTDIR}/$c") or die "$c: $!";
	print $f pack("H*", $h);
	close $f;
'
