#!/bin/sh
# THE GOOSE LEG's driver (test/conformance/README.md; docs/PORT-GOOSE.md, THE
# HARNESS).
#
# Every call is handed to ONE Goose program, test/conformance/goose/main.goose,
# under the pinned compiler (`goose run`, the in-process TinyCC). The program's
# arguments follow `--`, without which `goose run` takes them as more input
# files. A surface runs ONCE PER UNIT: every generated unit
# (build/conformance-goose/<unit>, make/goose.mk) carries its own copy of the
# runtime, so two units cannot be one Goose program. For each unit this script
# copies main.goose into the unit's directory beside a glue module,
# conformance_unit.goose, that imports the unit's modules and names its
# registry (`<package>::TableUnit`), and runs it there.
#
# The program writes one line per case on stdout — the case name, a space, the
# answer's bytes as lowercase hex, or `absent` and an optional reason — which
# this script writes as one file per case into <outdir> (`<case>.absent`
# holding the reason). A case of a unit the target refused (a `.refused` file
# beside the units) is an absence. The program's exit status is the
# compiler's: 2 on a surface is ABSENT, and this script passes it through. The
# compiler's own progress lines go to stderr, kept under
# build/conformance-goose/driver.
#
# The working directory is the repository root.
#
# usage: driver <manifest> list
#        driver <manifest> <surface> <outdir>
#        driver <manifest> block-lead
main=test/conformance/goose/main.goose
goose=${GOOSE:-dist/goose-v2026.2-linux-x64/goose}
units=${SCHEMA_GOOSE_GENERATED:-build/conformance-goose}
dir=build/conformance-goose-driver
mkdir -p "$dir" || exit 1
# glue <unit dir>: the root and its glue module beside the unit's modules
glue() {
	ns=$(sed -n 's/^namespace \(.*\);$/\1/p' "$1"/*Table.goose | head -1)
	{
		echo "// generated by test/conformance/goose/driver: the unit under test"
		for f in "$1"/*.goose; do
			b=$(basename "$f" .goose)
			case "$b" in main|conformance_unit) continue ;; esac
			echo "import .$b;"
		done
		echo "fn conformance_unit() -> schema_rt::LoadUnit { return $ns::TableUnit; }"
	} >"$1/conformance_unit.goose"
	cp "$main" "$1/main.goose"
}
# THE ACCELERATORS (docs/SPEC-TABLES.md §7, §19): the block form's and the
# cook's surfaces run accel.goose in place of main.goose, beside a second glue
# module, conformance_accel.goose, that names the unit's block tables and cook
# roots (every generated <T>BlockOpenReason, <T>CookOpenReason and
# <T>CookMeasure, the fixed roots' typed writers) and its records as data. `block-lead` is the block lead
# gate (docs/PORTING.md I5): `driver <manifest> block-lead` prints its verdict
# and exits non-zero on any wrong lead.
accel=test/conformance/goose/accel.goose
accel_surfaces=" cook cook-write cook-foreign block block-foreign block-dump forgery cook-forgery cook-reason block-reason block-lead "
# accel_prep <unit dir> <unit>: the accelerator program runs in its OWN copy of
# the unit's directory, so main.goose's glue, which imports every module
# beside it, never meets accel.goose; it prints the copy's path
accel_prep() {
	a="$dir/accel/$2"
	rm -rf "$a" && mkdir -p "$a" || exit 1
	glue "$1"
	cp "$1"/*.goose "$a"/ || exit 1
	rm -f "$a/main.goose"
	accel_glue "$a"
	echo "$a"
}
# accel_glue <dir>
accel_glue() {
	ns=$(sed -n 's/^namespace \(.*\);$/\1/p' "$1"/*Table.goose | head -1)
	blocks=$(cat "$1"/*Block.goose 2>/dev/null | sed -n 's/^fn \([A-Za-z0-9_]*\)BlockOpenReason(.*/\1/p')
	cooks=$(cat "$1"/*Cook.goose 2>/dev/null | sed -n 's/^fn \([A-Za-z0-9_]*\)CookOpenReason(.*/\1/p')
	writers=$(cat "$1"/*Cook.goose 2>/dev/null | sed -n 's/^fn \([A-Za-z0-9_]*\)CookMeasure() .*/\1/p')
	{
		echo "// generated by test/conformance/goose/driver: the unit's accelerators"
		for f in "$1"/*Block.goose "$1"/*Cook.goose "$1"/*_block.goose "$1"/*_cook.goose; do
			[ -f "$f" ] && echo "import .$(basename "$f" .goose);"
		done
		echo "import .block_form;"
		echo "import .wire_load;"
		echo "let _accel_none: schema_rt::AccelRecord[1] = [schema_rt::AccelRecord { .. }];"
		echo "fn accel_block_reason(table: const u8[:], b: const u8[:], lead: i64) -> i64 {"
		for t in $blocks; do echo "    if table == \"$t\" { return $ns::${t}BlockOpenReason(b, lead); }"; done
		echo "    return -1;"
		echo "}"
		echo "fn accel_block_record(table: const u8[:]) -> i64 {"
		for t in $blocks; do echo "    if table == \"$t\" { return $ns::${t}BlockRecord; }"; done
		echo "    return -1;"
		echo "}"
		if grep -q '^let BlockRecords:' "$1"/*_block.goose 2>/dev/null; then
			echo "fn accel_block_records() -> const schema_rt::AccelRecord[:] { return $ns::BlockRecords; }"
		else
			echo "fn accel_block_records() -> const schema_rt::AccelRecord[:] { return _accel_none[0..0]; }"
		fi
		echo "fn accel_cook_reason(root: const u8[:], b: const u8[:], lead: i64) -> i64 {"
		for t in $cooks; do echo "    if root == \"$t\" { return $ns::${t}CookOpenReason(b, lead); }"; done
		echo "    return -1;"
		echo "}"
		echo "fn accel_cook_record(root: const u8[:]) -> i64 {"
		for t in $cooks; do echo "    if root == \"$t\" { return $ns::${t}CookRecord; }"; done
		echo "    return -1;"
		echo "}"
		if grep -q '^let CookRecords:' "$1"/*_cook.goose 2>/dev/null; then
			echo "fn accel_cook_records() -> const schema_rt::AccelRecord[:] { return $ns::CookRecords; }"
		else
			echo "fn accel_cook_records() -> const schema_rt::AccelRecord[:] { return _accel_none[0..0]; }"
		fi
		echo "fn accel_cook_measure(root: const u8[:]) -> i64 {"
		for t in $writers; do echo "    if root == \"$t\" { return $ns::${t}CookMeasure(); }"; done
		echo "    return -1;"
		echo "}"
		echo "fn accel_cook_write(root: const u8[:], data: const u8[:], vals: const schema_rt::LoadVal[:], at: i64, out: u8[:], big: bool) -> bool {"
		for t in $writers; do
			echo "    if root == \"$t\" {"
			echo "        var v = $ns::$t { .. };"
			echo "        $ns::${t}CookFromLoaded(v, data, vals, at);"
			echo "        return $ns::${t}Cook(v, out, big);"
			echo "    }"
		done
		echo "    return false;"
		echo "}"
	} >"$1/conformance_accel.goose"
	cp "$accel" "$1/accel.goose"
}
# accel_units <manifest> <surface>: the units a surface's lines name
accel_units() {
	case "$2" in
	block | block-foreign | block-dump | forgery | block-reason | block-lead) awk '$1 == "block" { print $3 }' "$1" ;;
	cook | cook-foreign | cook-forgery | cook-reason) awk '$1 == "cook" { print $3 }' "$1" ;;
	cook-write) awk 'NR == FNR { if ($1 == "cook-write") w[$2] = 1; next } $1 == "instance" && ($2 in w) { print $3 }' "$1" "$1" ;;
	esac | sort -u
}
if [ "$2" = block-lead ]; then
	status=0
	for key in $(accel_units "$1" block-lead); do
		[ -d "$units/$key" ] || { echo "driver: $units/$key is missing (make build/conformance-goose)" >&2; exit 1; }
		a=$(accel_prep "$units/$key" "$key") || exit 1
		"$goose" run "$a/accel.goose" -- block-lead "$1" "$key" 2>"$dir/block-lead.$key.err" || {
			status=1
			cat "$dir/block-lead.$key.err" >&2
		}
	done
	exit "$status"
fi
case "$2" in
list)
	# the program is the same in every unit: run it in the first one generated
	for key in $(awk '$1 == "unit" { print $2 }' "$1"); do
		[ -d "$units/$key" ] || continue
		glue "$units/$key"
		"$goose" run "$units/$key/main.goose" -- list "$1" 2>"$dir/list.err"
		status=$?
		[ "$status" -eq 0 ] || { cat "$dir/list.err" >&2; exit "$status"; }
		a=$(accel_prep "$units/$key" "$key") || exit 1
		"$goose" run "$a/accel.goose" -- list "$1" 2>"$dir/list.err"
		status=$?
		[ "$status" -eq 0 ] || cat "$dir/list.err" >&2
		exit "$status"
	done
	echo "driver: no unit generated under $units (make build/conformance-goose)" >&2
	exit 1
	;;
esac
mkdir -p "$3" || exit 1
out="$dir/$2.out"
: >"$out"
prog=main
case "$accel_surfaces" in *" $2 "*) prog=accel ;; esac
for key in $(awk '$1 == "unit" { print $2 }' "$1"); do
	u="$units/$key"
	if [ "$prog" = accel ]; then
		accel_units "$1" "$2" | grep -qx "$key" || continue
		if [ ! -d "$u" ]; then
			# a refused unit answers none of its cases
			awk -v k="$key" '
				NR == FNR { if ($1 == "cook-write") w[$2] = 1; next }
				$1 == "instance" && $3 == k && ($2 in w) { print $2 " absent"; print $2 "-be absent" }' "$1" "$1" >>"$out"
			continue
		fi
		a=$(accel_prep "$u" "$key") || exit 1
		"$goose" run "$a/accel.goose" -- "$2" "$1" "$key" >>"$out" 2>"$dir/$2.$key.err"
		status=$?
		if [ "$status" -ne 0 ]; then
			[ "$status" -eq 2 ] || cat "$dir/$2.$key.err" >&2
			exit "$status"
		fi
		continue
	fi
	if [ ! -d "$u" ]; then
		# a refused unit answers none of its cases
		awk -v k="$key" -v s="$2" '
			(s == "wire" && $1 == "instance" && $3 == k) ||
			(s == "report" && $1 == "report" && $3 == k) ||
			((s == "retain" || s == "retain-save") && $1 == "retain" && $3 == k) ||
			((s == "retain" || s == "retain-save") && $1 == "retain-message" && $4 == k) { print $2 " absent" }' "$1" >>"$out"
		continue
	fi
	glue "$u"
	"$goose" run "$u/main.goose" -- "$2" "$1" "$key" >>"$out" 2>"$dir/$2.$key.err"
	status=$?
	if [ "$status" -ne 0 ]; then
		[ "$status" -eq 2 ] || cat "$dir/$2.$key.err" >&2
		exit "$status"
	fi
done
GOOSE_OUTDIR=$3 perl -ne 'chomp; my ($c, $h) = split / /, $_, 2; next unless defined $c && $c ne ""; if (defined $h && $h =~ /^absent(?: (.*))?$/) { open(my $f, ">", "$ENV{GOOSE_OUTDIR}/$c.absent") or die; print $f (defined $1 ? $1 : ""); close $f; next } open(my $f, ">:raw", "$ENV{GOOSE_OUTDIR}/$c") or die "$c: $!"; print $f pack("H*", defined $h ? $h : ""); close $f;' <"$out"
