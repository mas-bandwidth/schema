#!/bin/sh
# THE GOOSE LEG's driver (test/conformance/README.md; docs/PORT-GOOSE.md, THE
# HARNESS).
#
# Every surface is handed to ONE Goose program, test/conformance/goose/main.goose,
# under the pinned compiler (`goose run`, the in-process TinyCC). A Goose
# program reads files and writes stdout through the standard library's os
# module, so the manifest goes IN as its path (the program's first argument
# after the surface) and the answers come OUT on stdout, one line per case —
# the case name, a space, the answer's bytes as lowercase hex — which this
# script writes as one file per case into <outdir> (a case the leg cannot
# answer is the line "<case> absent", written as <case>.absent).
#
# While main.goose is absent the leg answers ABSENT: `list` prints nothing and
# every surface exits 2. The conformance-leg card adds main.goose and the list
# grows with the surfaces (docs/PORT-GOOSE.md, THE CARD MAP).
#
# The working directory is the repository root.
#
# usage: driver <manifest> list
#        driver <manifest> <surface> <outdir>
main=test/conformance/goose/main.goose
goose=${GOOSE:-dist/goose-v2026.2-linux-x64/goose}
if [ ! -f "$main" ]; then
	case "$2" in
	list) exit 0 ;;
	*) exit 2 ;;
	esac
fi
dir=build/conformance-goose/driver
mkdir -p "$dir" || exit 1
case "$2" in
list)
	exec "$goose" run "$main" list "$1" 2>"$dir/list.err"
	;;
*)
	mkdir -p "$3" || exit 1
	"$goose" run "$main" "$2" "$1" >"$dir/$2.out" 2>"$dir/$2.err"
	status=$?
	[ "$status" -eq 0 ] || exit "$status"
	GOOSE_OUTDIR=$3 perl -ne 'chomp; my ($c, $h) = split / /, $_, 2; next unless defined $c && $c ne ""; if (defined $h && $h eq "absent") { open(my $f, ">", "$ENV{GOOSE_OUTDIR}/$c.absent") or die; close $f; next } open(my $f, ">:raw", "$ENV{GOOSE_OUTDIR}/$c") or die "$c: $!"; print $f pack("H*", defined $h ? $h : ""); close $f;' <"$dir/$2.out"
	;;
esac
