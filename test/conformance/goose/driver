#!/bin/sh
# THE GOOSE LEG's driver (test/conformance/README.md; docs/PORT-GOOSE.md, THE
# HARNESS).
#
# Every call is handed to ONE Goose program, test/conformance/goose/main.goose,
# under the pinned compiler (`goose run`, the in-process TinyCC). The program's
# arguments follow `--`, without which `goose run` takes them as more input
# files. A surface runs ONCE PER UNIT: every generated unit
# (build/conformance-goose/<unit>, make/goose.mk) carries its own copy of the
# runtime, so two units cannot be one Goose program. For each unit this script
# copies main.goose into the unit's directory beside a glue module,
# conformance_unit.goose, that imports the unit's modules and names its
# registry (`<package>::TableUnit`), and runs it there. The unit's text glue,
# units/<unit>.goose (the roots that answer the JSON surfaces, and through
# which generated calls), goes beside them as unit.goose; a unit without one
# gets the empty unit.goose beside main.goose, and its text rows are ABSENT.
#
# The program writes one line per case on stdout — the case name, a space, the
# answer's bytes as lowercase hex, or `absent` and an optional reason — which
# this script writes as one file per case into <outdir> (`<case>.absent`
# holding the reason; `refused` and a reason, a read the program ran and
# refused on the message-prior surface, as `<case>.refused`). A case of a unit the target refused (a `.refused` file
# beside the units) is an absence. The program's exit status is the
# compiler's: 2 on a surface is ABSENT, and this script passes it through. The
# compiler's own progress lines go to stderr, kept under
# the work directory below.
#
# The working directory is the repository root.
#
# usage: driver <manifest> list
#        driver <manifest> <surface> <outdir>
#        driver <manifest> block-lead
#        driver <manifest> block-fuzz <seed> <n>
#        driver <manifest> cook-fuzz <seed> <n> <fixtures dir>
main=test/conformance/goose/main.goose
goose=${GOOSE:-dist/goose-v2026.2-linux-x64/goose}
units=${SCHEMA_GOOSE_GENERATED:-build/conformance-goose}
# THE WORK DIRECTORY is one per units tree and per surface, so calls that run
# at once under make -j (the forgery fuzzer, the block lead, the controls over
# their own copies of the units) never share a file:
# build/conformance-goose-driver/<surface> for the generated units, and
# <units>.driver/<surface> for a copy named by SCHEMA_GOOSE_GENERATED.
base=build/conformance-goose-driver
[ -n "${SCHEMA_GOOSE_GENERATED:-}" ] && base=$units.driver
dir=$base/$2
mkdir -p "$dir" || exit 1
# announce_write_glue <namespace>: conformance_announce_write for a unit with
# a message form, on stdout: the unit's announcement as the generator writes
# it ($ns::MessageAnnouncement). main.goose's glue and the announcement-only
# batch (announce_prep) both take it from here.
announce_write_glue() {
	echo "fn conformance_announce_write(out: u8[>..]&) -> i64 {"
	echo "    if $1::MessageAnnouncement.len == 0 { out.append(\"refused\"); out.push(10); return 0; }"
	echo "    out.append($1::MessageAnnouncement);"
	echo "    return 0;"
	echo "}"
}
# glue <unit dir>: the root and its glue module beside the unit's modules
glue() {
	text=test/conformance/goose/units/$(basename "$1").goose
	[ -f "$text" ] || text=test/conformance/goose/unit.goose
	# Compare the copies to their sources, including a switch to the fallback.
	if [ -f "$1/conformance_unit.goose" ] && [ -f "$1/conformance_accel.goose" ] &&
		cmp -s "$main" "$1/main.goose" && cmp -s "$text" "$1/unit.goose" &&
		cmp -s "$accel_lib" "$1/accel_lib.goose"; then
		_fresh=1
		for _f in "$1"/*.goose test/conformance/goose/driver; do
			case "${_f##*/}" in main.goose|conformance_unit.goose|unit.goose|accel_lib.goose|conformance_accel.goose) continue ;; esac
			if [ "$_f" -nt "$1/conformance_unit.goose" ]; then _fresh=0; break; fi
		done
		[ "$_fresh" -eq 1 ] && return 0
	fi
	ns=$(sed -n 's/^namespace \(.*\);$/\1/p' "$1"/*Table.goose | head -1)
	{
		echo "// generated by test/conformance/goose/driver: the unit under test"
		for f in "$1"/*.goose; do
			b=$(basename "$f" .goose)
			# the accelerator module imports this one, never the reverse
			case "$b" in main|conformance_unit|unit|accel_lib|conformance_accel|accel) continue ;; esac
			echo "import .$b;"
		done
		echo "fn conformance_unit() -> schema_rt::LoadUnit { return $ns::TableUnit; }"
		echo "fn conformance_wire(root: const u8[:], data: const u8[:], out: u8[>..<]&) -> i64 {"
		for r in $(sed -n 's/^fn \([A-Za-z0-9_]*\)FixedLoad(.*/\1/p' "$1"/*Table.goose); do
			echo "    if root == \"$r\" {"
			echo "        var values: $ns::$r[256] = [$ns::$r { .. }; 256];"
			if grep -q "^fn ${r}FixedEvolveLoad(" "$1"/*Table.goose; then
				echo "        var rep = schema_rt::FixedEvolveReport { .. };"
				echo "        let n = $ns::${r}FixedEvolveLoad(values[0..256], data, rep);"
				echo "        if n < 0 || rep.damaged || rep.reason != 0 || rep.oor != 0 { return -3; }"
			else
				echo "        var rep = schema_rt::FixedReport { .. };"
				echo "        let n = $ns::${r}FixedLoad(values[0..256], data, rep);"
				echo "        if n < 0 || rep.damaged || rep.reason != 0 || rep.oor != 0 { return -3; }"
			fi
			echo "        var saved: u8[>..] = [];"
			echo "        if $ns::${r}FixedSave(values[0..n], saved) < 0 { return -4; }"
			echo "        out.append(saved);"
			echo "        return 0;"
			echo "    }"
		done
		echo "    return -1;"
		echo "}"
		# THE MESSAGE FORM's round trip, one arm per root the unit carries it
		# for (a fixed root's <Root>LoadMessages): AnnounceRead the peer's
		# announcement, LoadMessages the batch against it, SaveMessages what
		# landed. -1 is a root the leg carries no message form for.
		echo "fn conformance_message(root: const u8[:], announce: const u8[:], wire: const u8[:], out: u8[>..]&) -> i64 {"
		for r in $(sed -n 's/^fn \([A-Za-z0-9_]*\)LoadMessages(.*/\1/p' "$1"/*Table.goose); do
			echo "    if root == \"$r\" {"
			echo "        var voc = schema_rt::MsgVocabulary { .. };"
			echo "        var rep = schema_rt::MsgReport { .. };"
			echo "        if !schema_rt::announce_read(voc, announce, rep) { return -2; }"
			echo "        var values: $ns::$r[>..] = []; values.resize(256, $ns::$r { .. });"
			echo "        let n = $ns::${r}LoadMessages(values[0..256], voc, wire, rep);"
			echo "        if n < 1 || rep.damaged || rep.reason != 0 { return -3; }"
			echo "        return $ns::${r}SaveMessages(values[0..n], out, rep);"
			echo "    }"
		done
		echo "    return -1;"
		echo "}"
		# conformance_message_count answers a message-batch row: the count
		# <Root>LoadMessages returned into storage for 256 bodies (§3.3).
		# -1 is a root the leg carries no message form for, -2 a refused
		# announcement; a load's own answer is never below 0.
		echo "fn conformance_message_count(root: const u8[:], announce: const u8[:], wire: const u8[:]) -> i64 {"
		for r in $(sed -n 's/^fn \([A-Za-z0-9_]*\)LoadMessages(.*/\1/p' "$1"/*Table.goose); do
			echo "    if root == \"$r\" {"
			echo "        var voc = schema_rt::MsgVocabulary { .. };"
			echo "        var rep = schema_rt::MsgReport { .. };"
			echo "        if !schema_rt::announce_read(voc, announce, rep) { return -2; }"
			echo "        var values: $ns::$r[>..] = []; values.resize(256, $ns::$r { .. });"
			echo "        return $ns::${r}LoadMessages(values[0..256], voc, wire, rep);"
			echo "    }"
		done
		echo "    return -1;"
		echo "}"
		# THE 2026-11-22 SURFACES (test/conformance/README.md). The cook
		# writer over a loaded value, for write-refusal-cook: <Root>CookMeasure
		# then <Root>Cook into a buffer of that size, little-endian; 0 is
		# written, 1 refused, -1 a root with no region cook writer.
		echo "fn conformance_cook_var(root: const u8[:], data: const u8[:], vals: const schema_rt::LoadVal[:], nodes: const schema_rt::LoadNode[:], at: i64) -> i64 {"
		for cf in "$1"/*Cook.goose; do
			[ -f "$cf" ] || continue
			for r in $(sed -n 's/^fn \([A-Za-z0-9_]*\)CookMeasure(data: .*/\1/p' "$cf"); do
				echo "    if root == \"$r\" {"
				echo "        let m = $ns::${r}CookMeasure(data, vals, nodes, at);"
				echo "        if m < 0 { return 1; }"
				echo "        var buf: u8[>..] = [];"
				echo "        buf.resize(m, 0);"
				echo "        if !$ns::${r}Cook(data, vals, nodes, at, buf[0..m], false) { return 1; }"
				echo "        return 0;"
				echo "    }"
			done
		done
		echo "    return -1;"
		echo "}"
		# THE ANNOUNCEMENT (announce): the unit's announcement as the
		# generator writes it ($ns::MessageAnnouncement), and AnnounceRead
		# into a fresh vocabulary of the unit, its strict flag set by the
		# runtime's own field or left at its default. -1 is a unit with no
		# message form.
		if grep -q '^let MessageAnnouncement:' "$1"/*.goose; then
			announce_write_glue "$ns"
			echo "fn conformance_announce_read(strict: bool, ann: const u8[:], out: u8[>..]&) -> i64 {"
			echo "    var voc = schema_rt::MsgVocabulary { .. };"
			echo "    voc.own_build_version = $ns::MessageBuildVersion;"
			echo "    if strict { voc.strict = true; }"
			echo "    var rep = schema_rt::MsgReport { .. };"
			echo "    if schema_rt::announce_read(voc, ann, rep) && rep.reason == 0 && !rep.damaged { out.append(\"read\"); } else { out.append(\"refused\"); }"
			echo "    out.push(10);"
			echo "    return 0;"
			echo "}"
		else
			echo "fn conformance_announce_write(out: u8[>..]&) -> i64 { return -1; }"
			echo "fn conformance_announce_read(strict: bool, ann: const u8[:], out: u8[>..]&) -> i64 { return -1; }"
		fi
		# announce send: SaveMessages of ONE value, loaded from the row's wire
		# or fresh (-), with no announcement read or written (FL-18)
		echo "fn conformance_announce_send(root: const u8[:], data: const u8[:], fresh: bool, out: u8[>..]&) -> i64 {"
		for r in $(sed -n 's/^fn \([A-Za-z0-9_]*\)SaveMessages(.*/\1/p' "$1"/*Table.goose); do
			echo "    if root == \"$r\" {"
			echo "        var values: $ns::$r[1] = [$ns::$r { .. }];"
			echo "        if !fresh {"
			if grep -q "^fn ${r}FixedEvolveLoad(" "$1"/*Table.goose; then
				echo "            var rep = schema_rt::FixedEvolveReport { .. };"
				echo "            if $ns::${r}FixedEvolveLoad(values[0..1], data, rep) != 1 || rep.damaged || rep.reason != 0 || rep.oor != 0 { return -2; }"
			elif grep -q "^fn ${r}FixedLoad(" "$1"/*Table.goose; then
				echo "            var rep = schema_rt::FixedReport { .. };"
				echo "            if $ns::${r}FixedLoad(values[0..1], data, rep) != 1 || rep.damaged || rep.reason != 0 || rep.oor != 0 { return -2; }"
			else
				echo "            return -2;"
			fi
			echo "        }"
			echo "        var srep = schema_rt::MsgReport { .. };"
			echo "        var saved: u8[>..] = [];"
			echo "        let n = $ns::${r}SaveMessages(values[0..1], saved, srep);"
			echo "        if n < 0 || srep.reason != 0 { out.append(\"refused\"); out.push(10); return 0; }"
			echo "        out.append(saved);"
			echo "        return 0;"
			echo "    }"
		done
		echo "    return -1;"
		echo "}"
		# READ INTO THE CALLER'S VALUES (read-into): the fixed load, LoadMessages
		# and the text read each take the caller's values and ONE report; the
		# same values and report go to all three reads, and the ToJson text of
		# every value the call was handed is written after the refused one.
		# -1 is a root with no such read.
		echo "fn conformance_ri_verdict(out: u8[>..]&, ok: bool) {"
		echo "    if ok { out.append(\"read\"); } else { out.append(\"refused\"); }"
		echo "    out.push(10);"
		echo "}"
		tojson=$(sed -n 's/^fn \([A-Za-z0-9_]*\)ToJson(.*/\1/p' "$1"/*Table.goose)
		echo "fn conformance_fresh_json(root: const u8[:], out: u8[>..]&) -> i64 {"
		for r in $tojson; do
			echo "    if root == \"$r\" { let v = $ns::$r { .. }; return $ns::${r}ToJson(v, out); }"
		done
		echo "    return -1;"
		echo "}"
		echo "fn conformance_read_into(root: const u8[:], form: const u8[:], lawful: const u8[:], damaged: const u8[:], count: i64, ann: const u8[:], out: u8[>..]&) -> i64 {"
		for r in $tojson; do
			if grep -q "^fn ${r}FixedLoad(" "$1"/*Table.goose; then
				echo "    if form == \"fixed\" && root == \"$r\" {"
				echo "        var values: $ns::$r[>..] = [];"
				echo "        for _ in count { values.push($ns::$r { .. }); }"
				echo "        var rep = schema_rt::FixedReport { .. };"
				echo "        for step in 3 {"
				echo "            let n = $ns::${r}FixedLoad(values[0..count], if step == 1 { damaged } else { lawful }, rep);"
				echo "            conformance_ri_verdict(out, n >= 0 && !rep.damaged && rep.reason == 0);"
				echo "            if step == 1 { for k in count { var t: u8[>..] = []; if $ns::${r}ToJson(values[k], t) < 0 { return -2; } out.append(t); } }"
				echo "        }"
				echo "        return 0;"
				echo "    }"
			fi
			if grep -q "^fn ${r}LoadMessages(" "$1"/*Table.goose; then
				echo "    if form == \"message\" && root == \"$r\" {"
				echo "        var voc = schema_rt::MsgVocabulary { .. };"
				echo "        var arep = schema_rt::MsgReport { .. };"
				echo "        if !schema_rt::announce_read(voc, ann, arep) { return -3; }"
				echo "        var values: $ns::$r[>..] = [];"
				echo "        for _ in count { values.push($ns::$r { .. }); }"
				echo "        var rep = schema_rt::MsgReport { .. };"
				echo "        for step in 3 {"
				echo "            let n = $ns::${r}LoadMessages(values[0..count], voc, if step == 1 { damaged } else { lawful }, rep);"
				echo "            conformance_ri_verdict(out, n >= 0 && rep.reason == 0 && !rep.damaged);"
				echo "            if step == 1 { for k in count { var t: u8[>..] = []; if $ns::${r}ToJson(values[k], t) < 0 { return -2; } out.append(t); } }"
				echo "        }"
				echo "        return 0;"
				echo "    }"
			fi
			if grep -q "^fn ${r}FromJson(" "$1"/*Table.goose; then
				echo "    if form == \"json\" && root == \"$r\" {"
				echo "        var v = $ns::$r { .. };"
				echo "        var rep = schema_rt::json_report();"
				echo "        for step in 3 {"
				echo "            let ok = $ns::${r}FromJson(v, if step == 1 { damaged } else { lawful }, rep);"
				echo "            conformance_ri_verdict(out, ok && !rep.damaged && rep.reason == 0);"
				echo "            if step == 1 { var t: u8[>..] = []; if $ns::${r}ToJson(v, t) < 0 { return -2; } out.append(t); }"
				echo "        }"
				echo "        return 0;"
				echo "    }"
			fi
		done
		# A FIXED ROOT WITH NO GENERATED ToJson (a fixed-point field, as
		# tblfixedevo's EvoRoot) still has text: json-write prints it through
		# the value bridge (_<Root>FixedWrite, fixed_body_to_loaded, then
		# json_save_table), and read-into prints through that same bridge. The
		# read is the one conformance_load uses: <Root>FixedEvolveLoad where the
		# root has a lineage, so an older writer's record reads (ri_fixed_lineage).
		for r in $(sed -n 's/^fn \([A-Za-z0-9_]*\)FixedLoad(.*/\1/p' "$1"/*Table.goose); do
			if printf '%s\n' $tojson | grep -qx "$r"; then continue; fi
			echo "    if form == \"fixed\" && root == \"$r\" {"
			echo "        var values: $ns::$r[>..] = [];"
			echo "        for _ in count { values.push($ns::$r { .. }); }"
			if grep -q "^fn ${r}FixedEvolveLoad(" "$1"/*Table.goose; then
				echo "        var rep = schema_rt::FixedEvolveReport { .. };"
				echo "        for step in 3 {"
				echo "            let n = $ns::${r}FixedEvolveLoad(values[0..count], if step == 1 { damaged } else { lawful }, rep);"
				echo "            conformance_ri_verdict(out, n >= 0 && !rep.damaged && rep.reason == 0 && rep.oor == 0);"
			else
				echo "        var rep = schema_rt::FixedReport { .. };"
				echo "        for step in 3 {"
				echo "            let n = $ns::${r}FixedLoad(values[0..count], if step == 1 { damaged } else { lawful }, rep);"
				echo "            conformance_ri_verdict(out, n >= 0 && !rep.damaged && rep.reason == 0);"
			fi
			echo "            if step == 1 {"
			echo "                for k in count {"
			echo "                    var body: u8[>..] = [];"
			echo "                    $ns::_${r}FixedWrite(body, values[k]);"
			echo "                    var data: u8[>..] = [];"
			echo "                    var vals: schema_rt::LoadVal[>..] = [];"
			echo "                    var nodes: schema_rt::LoadNode[>..] = [];"
			echo "                    let at = fixed_body_to_loaded(conformance_unit(), \"$r\", body, data, vals);"
			echo "                    if at < 0 { return -2; }"
			echo "                    var t: u8[>..] = [];"
			echo "                    if schema_rt::json_save_table($ns::TableUnit, $ns::TextUnit, \"$r\", data, vals, nodes, at, t) < 0 { return -2; }"
			echo "                    out.append(t);"
			echo "                }"
			echo "            }"
			echo "        }"
			echo "        return 0;"
			echo "    }"
		done
		echo "    return -1;"
		echo "}"
		NS="$ns" perl - "$1"/*.goose <<'EOF_WREF_PERL'
use strict;
use warnings;
my $ns = $ENV{NS};
my (%structs, %field_order, %slot_names, %enums, %unions, %fixed_load, %fixed_evolve, %msg_save, %json_to, %cook_typed, %block_begin, %block_build);
my $cur = "";
my $cur_desc = "";
my $in_ns = 0;
while (my $line = <>) {
	next if $ARGV =~ /(?:conformance_|main\.goose|unit\.goose|accel(?:_lib)?\.goose)/;
	if ($line =~ /^namespace\s+([A-Za-z0-9_]+)\s*;/) { $in_ns = ($1 eq $ns) ? 1 : 0; $cur = ""; next; }
	next unless $in_ns;
	if ($line =~ /^type\s+([A-Za-z0-9_]+)\s*=\s*(u8|u16|u32|u64|i8|i16|i32|i64)\s*;/) {
		$enums{$1} = $2;
	}
	if ($line =~ /^fn\s+EnumName([A-Za-z0-9_]+)Type\(/) {
		$unions{$1} = 1;
	}
	if ($line =~ /^fn\s+([A-Za-z0-9_]+)FixedLoad\(/) { $fixed_load{$1} = 1; }
	if ($line =~ /^fn\s+([A-Za-z0-9_]+)FixedEvolveLoad\(/) { $fixed_evolve{$1} = 1; }
	if ($line =~ /^fn\s+([A-Za-z0-9_]+)SaveMessages\(/) { $msg_save{$1} = 1; }
	if ($line =~ /^fn\s+([A-Za-z0-9_]+)ToJson\(/) { $json_to{$1} = 1; }
	if ($line =~ /^fn\s+([A-Za-z0-9_]+)CookMeasure\(\)/) { $cook_typed{$1} = 1; }
	if ($line =~ /^fn\s+([A-Za-z0-9_]+)BlockBegin\(/) { $block_begin{$1} = 1; }
	if ($line =~ /^fn\s+([A-Za-z0-9_]+)BlockBuildValue\(/) { $block_build{$1} = 1; }
	if ($line =~ /^struct\s+([A-Za-z0-9_]+)\s*\{/) {
		$cur = $1;
		$structs{$cur} = {};
		$field_order{$cur} = [];
		next;
	}
	if ($cur ne "") {
		if ($line =~ /^\}/) { $cur = ""; next; }
		if ($line =~ /^\s*([A-Za-z0-9_]+)\s*:\s*([^,=\/]+?)(?:\s*=.*)?\s*,/) {
			my ($fname, $ftype) = ($1, $2);
			$ftype =~ s/\s+$//;
			$structs{$cur}{$fname} = $ftype;
			push @{$field_order{$cur}}, $fname;
		}
	}
	if ($line =~ /^let _([A-Za-z0-9_]+)(?:Fields|Arms):/) {
		$cur_desc = $1;
		next;
	}
	if (defined($cur_desc) && $cur_desc ne "") {
		if ($line =~ /^\];/) { $cur_desc = ""; next; }
		if ($line =~ /name:\s*"([^"]+)".*?slot:\s*"([^"]+)"/) {
			$slot_names{$cur_desc}{$2} = $1;
		}
	}
}
sub snake {
	my ($s) = @_;
	$s =~ s/([a-z0-9])([A-Z])/${1}_${2}/g;
	return lc($s);
}
print <<'GOOSE_WREF_HELPERS';
// THE ONE CHECKED CONVERSION the setters below go through. wref_parse_i64
// keeps an i64 and wraps past it, and `as!` keeps the low bits, so a token
// past the declared kind (18446744073709551616 into a one-byte ordinal, a
// count of 4294967297 into an int32) landed as a lawful value and the row
// answered `wrote` for a value it never wrote. A setter asks wref_fits_i64
// (or wref_fits_u64 for a uint64 field) before it parses, holds the parsed
// value to the field's declared range, and answers 2, `unrepresentable`,
// when the kind cannot hold it.
fn wref_digits(s: const u8[:]) -> const u8[:] {
    var i: i64 = 0;
    if s.len > 0 && (s[0] == '-' || s[0] == '+') { i = 1; }
    if i >= s.len { return ""; }
    var k: i64 = i;
    while k < s.len {
        if s[k] < '0' || s[k] > '9' { return ""; }
        k += 1;
    }
    while i < s.len - 1 && s[i] == '0' { i += 1; }
    return s[i..s.len];
}
fn wref_at_most(a: const u8[:], b: const u8[:]) -> bool {
    if a.len != b.len { return a.len < b.len; }
    var i: i64 = 0;
    while i < a.len {
        if a[i] != b[i] { return a[i] < b[i]; }
        i += 1;
    }
    return true;
}
fn wref_fits_i64(s: const u8[:]) -> bool {
    let m = wref_digits(s);
    if m.len == 0 { return false; }
    if s[0] == '-' { return wref_at_most(m, "9223372036854775808"); }
    return wref_at_most(m, "9223372036854775807");
}
fn wref_fits_u64(s: const u8[:]) -> bool {
    let m = wref_digits(s);
    if m.len == 0 { return false; }
