mkdir -p "$3" || exit 1
out="$dir/$2.out"
: >"$out"
prog=main
case "$accel_surfaces" in *" $2 "*) prog=accel ;; esac
if [ "$prog" = accel ]; then
	active_units=$(accel_units "$1" "$2")
else
	active_units=$(main_units "$1" "$2")
fi
# the manifest's batch cache directory, and the batches of the units this
# call answers, warmed side by side before the units are read
batch_d=
case " $batch_surfaces " in *" $2 "*) batch_d=$(batch_dir "$1") || exit 1 ;; esac
[ -z "$batch_d" ] || batch_warm "$1" "$batch_d" "$active_units" >&2
running=0
pids=""
jobfailed=0
keys=""
for key in $(awk '$1 == "unit" { print $2 }' "$1"); do
	printf '%s\n' "$active_units" | grep -qx "$key" || continue
	keys="$keys $key"
	u="$units/$key"
	: >"$dir/$2.$key.out"
	if [ "$prog" = accel ]; then
		if [ ! -d "$u" ]; then
			awk -v k="$key" '
				NR == FNR { if ($1 == "cook-write") w[$2] = 1; next }
				$1 == "instance" && $3 == k && ($2 in w) { print $2 " absent"; print $2 "-be absent" }' "$1" "$1" >"$dir/$2.$key.out"
			echo 0 >"$dir/$2.$key.rc"
			continue
		fi
		(
			accel_answer "$1" "$2" "$key" >"$dir/$2.$key.out" 2>"$dir/$2.$key.err"
			echo $? >"$dir/$2.$key.rc"
		) &
	else
		if [ ! -d "$u" ]; then
			awk -v k="$key" -v s="$2" '
				$1 == "connection" { unit_of[$2] = $3 }
				$1 == "prior-connection" { prior_of[$2] = $3 }
				s == "message" && $1 == "message" && unit_of[$3] == k && $6 == "-" { print $2 " absent"; next }
				(s == "json-read" || s == "json-write") && $1 == "instance" && $3 == k {
					no_text = 0; for (i = 6; i <= NF; i++) if ($i == "no-text") no_text = 1;
					if (!no_text) print $2 (s == "json-write" ? ".json" : "") " absent";
					next
				}
				s == "json-write" && $1 == "json-write-refusal" && $3 == k { print $2 ".json absent"; next }
				(s == "message" && $1 == "message" && unit_of[$3] == k) ||
				(s == "message-prior" && $1 == "prior-message" && prior_of[$3] == k) ||
				(s == "wire" && $1 == "instance" && $3 == k) ||
				(s == "report" && $1 == "report" && $3 == k) ||
				(s == "framing" && $1 == "framing" && $3 == k) ||
				((s == "retain" || s == "retain-save") && $1 == "retain" && $3 == k) ||
				(s == "retain-refusal" && $1 == "retain-refusal" && $3 == k) ||
				(s == "json-hostile" && $1 == "json-hostile" && $3 == k) ||
				((s == "write-refusal" || s == "write-refusal-fixed" || s == "write-refusal-json" || s == "write-refusal-cook" || s == "write-refusal-block" || s == "announce" || s == "read-into" || s == "json-write-into") && $1 == s && $3 == k) ||
				(s == "write-refusal-message" && $1 == "write-refusal-message" && unit_of[$3] == k) { print $2 " absent" }' "$1" >"$dir/$2.$key.out"
			echo 0 >"$dir/$2.$key.rc"
			continue
		fi
		(
			batch_answer "$1" "$2" "$key" >"$dir/$2.$key.out" 2>"$dir/$2.$key.err"
			echo $? >"$dir/$2.$key.rc"
		) &
	fi
