		for t in $regions; do echo "    if root == \"$t\" { return $ns::${t}CookMeasure(data, vals, nodes, at); }"; done
		echo "    return -2;"
		echo "}"
		echo "fn accel_cook_write(root: const u8[:], data: const u8[:], vals: const schema_rt::LoadVal[:], nodes: const schema_rt::LoadNode[:], at: i64, out: u8[:], big: bool) -> bool {"
		echo "    if data.len > 0 && data[0] == 3 {"
		for t in $writers; do
			if grep -q "^fn ${t}FixedLoad(" "$1"/*Table.goose 2>/dev/null; then
				echo "        if root == \"$t\" {"
				echo "            var v: $ns::$t[1] = [$ns::$t { .. }];"
				echo "            var rep = schema_rt::FixedReport { .. };"
				echo "            if $ns::${t}FixedLoad(v[0..1], data, rep) != 1 || rep.damaged || rep.reason != 0 || rep.oor != 0 { return false; }"
				echo "            return $ns::${t}Cook(v[0], out, big);"
				echo "        }"
			fi
		done
		echo "        return false;"
		echo "    }"
		for t in $writers; do
			echo "    if root == \"$t\" {"
			echo "        var v = $ns::$t { .. };"
			echo "        $ns::${t}CookFromLoaded(v, data, vals, at);"
			echo "        return $ns::${t}Cook(v, out, big);"
			echo "    }"
		done
		for t in $regions; do echo "    if root == \"$t\" { return $ns::${t}Cook(data, vals, nodes, at, out, big); }"; done
		echo "    return false;"
		echo "}"
	}
}
# accel_units <manifest> <surface>: the units a surface's lines name
accel_units() {
	case "$2" in
	block | block-foreign | block-dump | forgery | block-reason | block-lead) awk '$1 == "block" { print $3 }' "$1" ;;
	cook | cook-foreign | cook-forgery | cook-reason) awk '$1 == "cook" { print $3 }' "$1" ;;
	cook-write) awk 'NR == FNR { if ($1 == "cook-write") w[$2] = 1; next } $1 == "instance" && ($2 in w) { print $3 }' "$1" "$1" ;;
	esac | sort -u
}
main_units() {
	case "$2" in
	wire | json-read) awk '$1 == "instance" { print $3 }' "$1" ;;
	json-write) awk '$1 == "instance" || $1 == "json-write-refusal" { print $3 }' "$1" ;;
	message) awk '$1 == "connection" { u[$2] = $3 } $1 == "message" && ($3 in u) { print u[$3] }' "$1" ;;
	message-prior) awk '$1 == "prior-connection" { u[$2] = $3 } $1 == "prior-message" && ($3 in u) { print u[$3] }' "$1" ;;
	report) awk '$1 == "report" { print $3 }' "$1" ;;
	framing) awk '$1 == "framing" { print $3 }' "$1" ;;
	retain | retain-save) awk '$1 == "retain" { print $3 }' "$1" ;;
	retain-refusal) awk '$1 == "retain-refusal" { print $3 }' "$1" ;;
	json-hostile) awk '$1 == "json-hostile" { print $3 }' "$1" ;;
	write-refusal | write-refusal-fixed | write-refusal-json | write-refusal-cook | write-refusal-block | write-refusal-shape | announce | read-into | json-write-into) awk -v s="$2" '$1 == s { print $3 }' "$1" ;;
	write-refusal-message) awk '$1 == "connection" { u[$2] = $3 } $1 == "write-refusal-message" && ($3 in u) { print u[$3] }' "$1" ;;
	*) awk '$1 == "unit" { print $2 }' "$1" ;;
	esac | sort -u
}
# THE BATCH (2026-11-25). `goose run` compiles the whole unit on every call,
# about a second for most units and twenty-five for each 4096-entry
# announcement unit, almost all of it typecheck, and the leg used to compile
# each unit once per surface: 191 s for the leg on four cores. Now the first
# call warms a cache: for every unit, main.goose's `batch` answers every
# surface that unit serves, the accelerators' too (accel_lib.goose), in ONE
# compile of the unit, the largest units first, nproc at a time; each surface
# then answers from its own section. The cache belongs to one harness run and
# is keyed by every file a batch answer comes from (batch_dir); a unit whose
# sources are newer than its cache is filled again. A section counts only when
# its "#done" line is there: a surface the batch died in, or never reached, is
# answered by its own single run exactly as before, so a failure reads the
# same, and the fallback is named on stderr.
#
# THE ANNOUNCEMENT-ONLY BATCH. A unit whose only batch surface is announce,
# with every one of its announce rows a `write` (tblann4096 and tblann4097,
# the vocabularies of exactly 4096 and 4097 entries), is answered by
# announce.goose instead, which imports only the module holding the
# announcement: under a second against about twenty-five, so those two units
# no longer set the leg's wall time. The write it answers is the same
# conformance_announce_write main.goose's glue writes (announce_write_glue).
# json-write-into reads SCHEMA_COMMA_LOCALE from its environment and is never
# batched; block-lead is a gate whose exit status is its verdict, and the
# fuzzers take a seed, so neither is batched either.
batch_main_surfaces="wire message message-prior report framing retain retain-save retain-refusal json-read json-write json-hostile write-refusal write-refusal-fixed write-refusal-message write-refusal-json write-refusal-cook write-refusal-block write-refusal-shape announce read-into"
batch_accel_surfaces="block block-foreign cook cook-foreign block-dump forgery block-reason cook-forgery cook-reason cook-write"
batch_surfaces="$batch_main_surfaces $batch_accel_surfaces"
# batch_map <manifest> <dir>: <dir>/batch.map, one line per unit naming the
# surfaces its batch answers, written once per cache (a lookup per unit and
# surface made thousands of short processes)
batch_map() {
	_t=$(mktemp "$2/map.XXXXXX") || return 1
	{
		for _s in $batch_main_surfaces; do
			main_units "$1" "$_s" | sed "s/\$/ $_s/"
		done
		for _s in $batch_accel_surfaces; do
			accel_units "$1" "$_s" | sed "s/\$/ $_s/"
		done
	} | awk '{ m[$1] = m[$1] " " $2 } END { for (u in m) print u m[u] }' >"$_t" &&
		mv "$_t" "$2/batch.map"
}
# batch_of <map> <unit>: the batch surfaces the map gives <unit>
batch_of() {
	awk -v u="$2" '$1 == u { $1 = ""; print substr($0, 2) }' "$1"
}
# batch_fresh <cache> <unit dir>: the cache is newer than every unit source
batch_fresh() {
	[ -f "$1" ] || return 1
	for _f in "$2"/*.goose; do
		[ "$_f" -nt "$1" ] && return 1
	done
	return 0
}
announce_prog=test/conformance/goose/announce.goose
# announce_only <manifest> <unit>: the unit has announce rows and every one is
# a `write` (the announcement-only batch serves it when announce is its only
# batch surface)
announce_only() {
	awk -v u="$2" '$1 == "announce" && $3 == u { n++; if ($5 != "write") other = 1 }
		END { exit !(n > 0 && !other) }' "$1"
}
# announce_prep <unit dir> <unit>: the announcement-only program in its own
# copy of the unit's directory under the batch cache, beside a
# conformance_announce.goose that imports only the module holding the
# announcement; it prints the copy's path
announce_prep() {
	_m=$(grep -l '^let MessageAnnouncement:' "$1"/*.goose | head -n 1)
	if [ -z "$_m" ]; then
		echo "goose driver: unit $2 has no module holding MessageAnnouncement" >&2
		return 1
	fi
	# the namespace as glue takes it, so the write names the same constant
	# main.goose's glue would; a module that holds it under another namespace
	# fails to compile here, and the surface falls back by name
	_ns=$(sed -n 's/^namespace \(.*\);$/\1/p' "$1"/*Table.goose | head -n 1)
	if [ -z "$_ns" ]; then
		echo "goose driver: unit $2's *Table.goose names no namespace" >&2
		return 1
	fi
	_a="$batch_d/announce/$2"
	rm -rf "$_a" && mkdir -p "$_a" || return 1
	cp "$1"/*.goose "$_a"/ || return 1
	rm -f "$_a/main.goose" "$_a/conformance_unit.goose" "$_a/conformance_accel.goose" "$_a/accel_lib.goose"
	cp "$announce_prog" "$_a/announce.goose" || return 1
	{
		echo "// generated by test/conformance/goose/driver: the unit's announcement alone"
		echo "import .$(basename "$_m" .goose);"
		announce_write_glue "$_ns"
	} >"$_a/conformance_announce.goose" || return 1
	echo "$_a"
}
# batch_lock <dir>: mkdir is the lock. It is never stolen: the cache belongs
# to one harness run (batch_dir), whose drivers die together, so a lock is
# only ever held by a live call of this run.
batch_lock() {
	while ! mkdir "$1" 2>/dev/null; do
		sleep 1
	done
}
# batch_dir <manifest>: the cache directory on stdout. It is keyed by the
# checksum of the manifest, this driver, main.goose, accel.goose,
# accel_lib.goose, announce.goose, every unit's text glue and the goose
# command, and by the
# pid of the process that runs the drivers (the harness), so the cache lives
# for one run and a run never meets another's answers or locks. The call
# that creates it removes the caches of runs that have ended, writes the map
# and then writes map.done; every other call waits for map.done, looking once
# a second. Nothing is warmed here: each call warms the units it answers
# (batch_warm), so a call scoped to a few cases never pays for the batches of
# units it does not ask (a scoped manifest still lists, for surfaces the run
# does not run, every unit's rows).
batch_dir() {
	# the key's text is gathered first, so a file that cannot be read (or a
	# units/*.goose that matches nothing) stops the batch by name instead of
	# keying it on part of its inputs
	mkdir -p "$base/batch" || return 1
	_kf="$base/batch/key.$$"
	if ! { cat "$1" "$0" "$main" "$accel" "$accel_lib" "$announce_prog" test/conformance/goose/unit.goose test/conformance/goose/units/*.goose && echo "$goose"; } >"$_kf"; then
		echo "goose driver: the batch cache key's inputs cannot all be read; no batch" >&2
		rm -f "$_kf"
		return 1
	fi
	_k=$(cksum <"$_kf" | cut -d" " -f1)
	rm -f "$_kf"
	_d="$base/batch/$_k-$PPID"
	mkdir -p "$_d" || return 1
	while [ ! -f "$_d/map.done" ]; do
		if mkdir "$_d/map.lock" 2>/dev/null; then
			# a map that was written between the look and the lock is done
			if [ -f "$_d/map.done" ]; then
				rm -rf "$_d/map.lock"
				break
			fi
			for _o in "$base"/batch/*-*; do
				[ "$_o" = "$_d" ] || [ ! -d "$_o" ] && continue
				kill -0 "${_o##*-}" 2>/dev/null || rm -rf "$_o"
			done
			if ! batch_map "$1" "$_d"; then
				echo "goose driver: no batch map in $_d" >&2
				rm -rf "$_d/map.lock"
				return 1
			fi
			: >"$_d/map.done"
			rm -rf "$_d/map.lock"
			break
		fi
		sleep 1
	done
	echo "$_d"
}
# batch_warm <manifest> <dir> <units>: the batches of <units> (the units
# this call answers, one per line) that the map gives a batch, the largest
# unit first, nproc at a time; a unit whose batch fails says so here, and its
# surfaces are answered by their single runs. A unit another call of the run
# is filling is waited for under its lock, never filled twice.
batch_warm() {
	for _k in $3; do
		[ -d "$units/$_k" ] && [ -n "$(batch_of "$2/batch.map" "$_k")" ] &&
			printf '%s %s\n' "$(du -sk "$units/$_k" | cut -f1)" "$_k"
	done | sort -rn | cut -d" " -f2 | batch_d="$2" xargs -P "$maxjobs" -n 1 "$0" "$1" __batch-fill ||
		echo "goose driver: a unit's batch failed (its .err in $2 says why); its surfaces fall back to single runs" >&2
}
# batch_fill <manifest> <unit>: the unit's batch cache under $batch_d, made
# under the unit's lock when it is missing or stale (a fresh cache is read
# without the lock: it is only ever replaced whole, by a rename; a unit no
# batch surface names gets an empty cache). False when the batch exits
# non-zero: what it finished is kept, and the rest falls back.
batch_fill() {
	batch_fresh "$batch_d/$2.out" "$units/$2" && return 0
	batch_lock "$batch_d/$2.lock"
	# the fill runs in a subshell: glue exits on a failed rename, and that
	# exit must end the fill, never the process that holds the unit's lock
	(
		batch_fresh "$batch_d/$2.out" "$units/$2" && exit 0
		_st=0
		_fs=$(batch_of "$batch_d/batch.map" "$2")
		if [ "$_fs" = announce ] && announce_only "$1" "$2"; then
			_a=$(announce_prep "$units/$2" "$2") || exit 1
			"$goose" run -O0 "$_a/announce.goose" -- batch "$1" "$2" announce >"$batch_d/$2.out.tmp" 2>"$batch_d/$2.err" || _st=$?
		elif [ -n "$_fs" ]; then
			glue "$units/$2"
			# shellcheck disable=SC2086 # the surface list is words by design
			"$goose" run -O0 "$units/$2/main.goose" -- batch "$1" "$2" $_fs >"$batch_d/$2.out.tmp" 2>"$batch_d/$2.err" || _st=$?
		else
			: >"$batch_d/$2.out.tmp"
		fi
		mv "$batch_d/$2.out.tmp" "$batch_d/$2.out" || exit 1
		exit "$_st"
	)
	_st=$?
	rm -rf "$batch_d/$2.lock"
	return "$_st"
}
# batch_section <surface> <unit>: the surface's section of the unit's batch
# on stdout, read in one pass, or false (and nothing printed) when the batch
# has no "#done" line for it. SCHEMA_TEST_PLANT_CONFORMANCE_GOOSE
# =wrong-byte:<case> flips the first hex digit of that case's wire answer here,
# and only here: the registry's plant (plant.corpus-plants.goose-batch-*)
# holds that the scored answers are the batch's.
batch_section() {
	awk -v s="$1" -v plant="${SCHEMA_TEST_PLANT_CONFORMANCE_GOOSE:-}" '
		BEGIN { if (s == "wire" && plant ~ /^wrong-byte:/) flip = substr(plant, 12) }
		$0 == "#surface " s { on = 1; n = 0; next }
		$0 == "#done " s { on = 0; done = 1; next }
		on {
			if (flip != "" && $1 == flip && $2 ~ /^[0-9a-f]/) {
				$2 = (substr($2, 1, 1) == "0" ? "1" : "0") substr($2, 2)
			}
			out[++n] = $0
		}
		END {
			if (!done) exit 1
			for (i = 1; i <= n; i++) print out[i]
		}' "$batch_d/$2.out"
}
# batch_answer <manifest> <surface> <unit>: a main surface's answer lines for
# one unit on stdout, and its exit status. A surface missing from the batch
# says so on stderr, naming the batch's own stderr, before its single run.
batch_answer() {
	case " $batch_main_surfaces " in *" $2 "*)
		batch_fill "$1" "$3" || echo "goose driver: unit $3's batch exited non-zero (its stderr: $batch_d/$3.err)" >&2
		batch_section "$2" "$3" && return 0
		echo "goose driver: batch has no \"#done $2\" for unit $3 (its stderr: $batch_d/$3.err); single run" >&2
		;;
	esac
	glue "$units/$3"
	"$goose" run -O0 "$units/$3/main.goose" -- "$2" "$1" "$3"
}
# accel_answer <manifest> <surface> <unit>: the same for an accelerator
# surface, whose single run is accel.goose's in a copy of the unit
# (accel_prep)
accel_answer() {
	case " $batch_accel_surfaces " in *" $2 "*)
		batch_fill "$1" "$3" || echo "goose driver: unit $3's batch exited non-zero (its stderr: $batch_d/$3.err)" >&2
		batch_section "$2" "$3" && return 0
		echo "goose driver: batch has no \"#done $2\" for unit $3 (its stderr: $batch_d/$3.err); single run" >&2
		;;
	esac
	_a=$(accel_prep "$units/$3" "$3") || return 1
	"$goose" run -O0 "$_a/accel.goose" -- "$2" "$1" "$3"
}
maxjobs=$(nproc 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null || echo 8)
# one unit's fill, for batch_warm's xargs ($batch_d comes from its
# environment)
if [ "$2" = __batch-fill ]; then
	if ! batch_fill "$1" "$3"; then
		echo "goose driver: unit $3's batch exited non-zero; its last lines:" >&2
		tail -n 5 "$batch_d/$3.err" >&2
		exit 1
	fi
	exit 0
fi
# THE FORGERY FUZZER (docs/PORTING.md I3): accel.goose's block-fuzz and
# cook-fuzz over every unit the manifest's block or cook lines name. The cook
# half reads the Go reference's cooks from <fixtures dir> (the harness
# materialises them: build/conformance/fixtures). Each prints its counts and
# the seed; the first mutant the oracle rejects is printed and the run fails.
if [ "$2" = block-fuzz ] || [ "$2" = cook-fuzz ]; then
	kind=${2%-fuzz}
	status=0
	for key in $(accel_units "$1" "$kind"); do
		[ -d "$units/$key" ] || { echo "driver: $units/$key is missing (make build/conformance-goose)" >&2; exit 1; }
		a=$(accel_prep "$units/$key" "$key") || exit 1
		if [ "$kind" = cook ]; then
			"$goose" run -O0 "$a/accel.goose" -- cook-fuzz "$1" "$key" "$3" "$4" "$5" 2>"$dir/cook-fuzz.$key.err" || status=1
		else
			"$goose" run -O0 "$a/accel.goose" -- block-fuzz "$1" "$key" "$3" "$4" 2>"$dir/block-fuzz.$key.err" || status=1
		fi
		[ "$status" -eq 0 ] || { cat "$dir/$2.$key.err" >&2; exit 1; }
	done
	exit "$status"
fi
if [ "$2" = block-lead ]; then
	status=0
	for key in $(accel_units "$1" block-lead); do
		[ -d "$units/$key" ] || { echo "driver: $units/$key is missing (make build/conformance-goose)" >&2; exit 1; }
		a=$(accel_prep "$units/$key" "$key") || exit 1
		"$goose" run -O0 "$a/accel.goose" -- block-lead "$1" "$key" 2>"$dir/block-lead.$key.err" || {
			status=1
			cat "$dir/block-lead.$key.err" >&2
		}
	done
	exit "$status"
fi
case "$2" in
list)
	# the program is the same in every unit: run it in the first one generated
	for key in $(awk '$1 == "unit" { print $2 }' "$1"); do
		[ -d "$units/$key" ] || continue
		glue "$units/$key"
		"$goose" run -O0 "$units/$key/main.goose" -- list "$1" 2>"$dir/list.err"
		status=$?
		[ "$status" -eq 0 ] || { cat "$dir/list.err" >&2; exit "$status"; }
		a=$(accel_prep "$units/$key" "$key") || exit 1
		"$goose" run -O0 "$a/accel.goose" -- list "$1" 2>"$dir/list.err"
		status=$?
		[ "$status" -eq 0 ] || cat "$dir/list.err" >&2
		exit "$status"
	done
