		echo "    return if at < 0 || report.damaged { -2 } else { at };"
		echo "}"
		echo "fn conformance_json_write(root: const u8[:], data: const u8[:], vals: const schema_rt::LoadVal[:], nodes: const schema_rt::LoadNode[:], at: i64, out: u8[>..]&) -> i64 {"
		echo "    if at < 0 { return conformance_save(root, data, vals, -1 - at, out); }"
		for r in $(sed -n 's/^fn \([A-Za-z0-9_]*\)ToLoaded(.*/\1/p' "$1"/*Table.goose); do
			echo "    if root == \"$r\" {"
			echo "        var v = $ns::$r { .. }; let unit = conformance_unit();"
			echo "        if !$ns::${r}FromLoaded(v, unit, data, vals, at) { return -2; }"
			echo "        let n = $ns::${r}ToJson(v, out);"
			echo "        return if n < 0 { -2 } else { n };"
			echo "    }"
		done
		echo "    let n = schema_rt::json_save_table($ns::TableUnit, $ns::TextUnit, root, data, vals, nodes, at, out);"
		echo "    return if n < 0 { -2 } else { n };"
		echo "}"
		# the write's exact length, or -2 when it refuses: a typed record's
		# <Root>ToJsonMeasure, and the flat value table's one writer otherwise
		echo "fn conformance_json_measure(root: const u8[:], data: const u8[:], vals: const schema_rt::LoadVal[:], nodes: const schema_rt::LoadNode[:], at: i64) -> i64 {"
		for r in $(sed -n 's/^fn \([A-Za-z0-9_]*\)ToLoaded(.*/\1/p' "$1"/*Table.goose); do
			echo "    if root == \"$r\" {"
			echo "        var v = $ns::$r { .. }; let unit = conformance_unit();"
			echo "        if !$ns::${r}FromLoaded(v, unit, data, vals, at) { return -2; }"
			echo "        let n = $ns::${r}ToJsonMeasure(v);"
			echo "        return if n < 0 { -2 } else { n };"
			echo "    }"
		done
		echo "    var out: u8[>..] = [];"
		echo "    let n = schema_rt::json_save_table($ns::TableUnit, $ns::TextUnit, root, data, vals, nodes, at, out);"
		echo "    return if n < 0 { -2 } else { n };"
		echo "}"
		# json-hostile through the flat value table: the verdict of a tolerant
		# read and the §16 text of the value it left, for a root the unit's own
		# text glue does not name
		echo "fn conformance_json_verdict(root: const u8[:], text: const u8[:], out: u8[>..]&) {"
		echo "    var data: u8[>..] = [];"
		echo "    var vals: schema_rt::LoadVal[>..] = [];"
		echo "    var nodes: schema_rt::LoadNode[>..] = [];"
		echo "    var r = schema_rt::json_report();"
		echo "    let at = schema_rt::json_load_table($ns::TableUnit, $ns::TextUnit, root, text, data, vals, nodes, r);"
		echo "    if at >= 0 && !r.damaged {"
		echo "        format(out, r.unknown, \",\", r.mismatch, \",\", r.widened, \",\", r.oor, \",\", r.repeated, \",false,read\");"
		echo "        out.push(10);"
		echo "        if schema_rt::json_save_table($ns::TableUnit, $ns::TextUnit, root, data, vals, nodes, at, out) < 0 { out.append(\"!no value\"); }"
		echo "    } else {"
		echo "        out.append(\"refused\");"
		echo "        out.push(10);"
		echo "    }"
		echo "}"
	} >"$1/conformance_unit.goose.$$"
	cp "$main" "$1/main.goose.$$"
	text=test/conformance/goose/units/$(basename "$1").goose
	[ -f "$text" ] || text=test/conformance/goose/unit.goose
	cp "$text" "$1/unit.goose.$$"
	# each lands by rename, so a call compiling this unit beside us never
	# reads a half-written module
	for f in conformance_unit main unit; do
		mv -f "$1/$f.goose.$$" "$1/$f.goose" || exit 1
	done
}
# THE ACCELERATORS (docs/SPEC-TABLES.md §7, §19): the block form's and the
# cook's surfaces run accel.goose in place of main.goose, beside a second glue
# module, conformance_accel.goose, that names the unit's block tables and cook
# roots (every generated <T>BlockOpenReason, <T>CookOpenReason and
# <T>CookMeasure: the fixed roots' typed writers, and the region writers over
# a loaded value) and its records as data. `block-lead` is the block lead
# gate (docs/PORTING.md I5): `driver <manifest> block-lead` prints its verdict
# and exits non-zero on any wrong lead.
accel=test/conformance/goose/accel.goose
accel_surfaces=" cook cook-write cook-foreign block block-foreign block-dump forgery cook-forgery cook-reason block-reason block-lead "
# accel_prep <unit dir> <unit>: the accelerator program runs in its OWN copy of
# the unit's directory, so main.goose's glue, which imports every module
# beside it, never meets accel.goose; it prints the copy's path
accel_prep() {
	a="$dir/accel/$2"
	rm -rf "$a" && mkdir -p "$a" || exit 1
	glue "$1"
	cp "$1"/*.goose "$a"/ || exit 1
	rm -f "$a/main.goose"
	accel_glue "$a"
	echo "$a"
}
# accel_glue <dir>
accel_glue() {
	ns=$(sed -n 's/^namespace \(.*\);$/\1/p' "$1"/*Table.goose | head -1)
	blocks=$(cat "$1"/*Block.goose 2>/dev/null | sed -n 's/^fn \([A-Za-z0-9_]*\)BlockOpenReason(.*/\1/p')
	cooks=$(cat "$1"/*Cook.goose 2>/dev/null | sed -n 's/^fn \([A-Za-z0-9_]*\)CookOpenReason(.*/\1/p')
	writers=$(cat "$1"/*Cook.goose 2>/dev/null | sed -n 's/^fn \([A-Za-z0-9_]*\)CookMeasure() .*/\1/p')
	regions=$(cat "$1"/*Cook.goose 2>/dev/null | sed -n 's/^fn \([A-Za-z0-9_]*\)CookMeasure(data: .*/\1/p')
	{
		echo "// generated by test/conformance/goose/driver: the unit's accelerators"
		for f in "$1"/*Block.goose "$1"/*Cook.goose "$1"/*Table.goose "$1"/*_block.goose "$1"/*_cook.goose; do
			[ -f "$f" ] && echo "import .$(basename "$f" .goose);"
		done
		[ -f "$1/fixed.goose" ] && echo "import .fixed;"
		echo "import .block_form;"
		echo "import .wire_load;"
		echo "let _accel_none: schema_rt::AccelRecord[1] = [schema_rt::AccelRecord { .. }];"
		echo "fn accel_block_reason(table: const u8[:], b: const u8[:], lead: i64) -> i64 {"
		for t in $blocks; do echo "    if table == \"$t\" { return $ns::${t}BlockOpenReason(b, lead); }"; done
		echo "    return -1;"
		echo "}"
		echo "fn accel_block_bytes(table: const u8[:], b: const u8[:]) -> i64 {"
		for t in $blocks; do echo "    if table == \"$t\" { return $ns::${t}BlockBytes(b); }"; done
		echo "    return -1;"
		echo "}"
		echo "fn accel_block_record(table: const u8[:]) -> i64 {"
		for t in $blocks; do echo "    if table == \"$t\" { return $ns::${t}BlockRecord; }"; done
		echo "    return -1;"
		echo "}"
		if grep -q '^let BlockRecords:' "$1"/*_block.goose 2>/dev/null; then
			echo "fn accel_block_records() -> const schema_rt::AccelRecord[:] { return $ns::BlockRecords; }"
		else
			echo "fn accel_block_records() -> const schema_rt::AccelRecord[:] { return _accel_none[0..0]; }"
		fi
		echo "fn accel_cook_reason(root: const u8[:], b: const u8[:], lead: i64) -> i64 {"
		for t in $cooks; do echo "    if root == \"$t\" { return $ns::${t}CookOpenReason(b, lead); }"; done
		echo "    return -1;"
		echo "}"
		echo "fn accel_cook_record(root: const u8[:]) -> i64 {"
		for t in $cooks; do echo "    if root == \"$t\" { return $ns::${t}CookRecord; }"; done
		echo "    return -1;"
		echo "}"
		if grep -q '^let CookRecords:' "$1"/*_cook.goose 2>/dev/null; then
			echo "fn accel_cook_records() -> const schema_rt::AccelRecord[:] { return $ns::CookRecords; }"
		else
			echo "fn accel_cook_records() -> const schema_rt::AccelRecord[:] { return _accel_none[0..0]; }"
		fi
		echo "fn accel_cook_measure(root: const u8[:], data: const u8[:], vals: const schema_rt::LoadVal[:], nodes: const schema_rt::LoadNode[:], at: i64) -> i64 {"
		echo "    if data.len > 0 && data[0] == 3 {"
		for t in $writers; do
			if grep -q "^fn ${t}FixedLoad(" "$1"/*Table.goose 2>/dev/null; then
				echo "        if root == \"$t\" {"
				echo "            var v: $ns::$t[1] = [$ns::$t { .. }];"
				echo "            var rep = schema_rt::FixedReport { .. };"
				echo "            if $ns::${t}FixedLoad(v[0..1], data, rep) != 1 || rep.damaged || rep.reason != 0 || rep.oor != 0 { return -3; }"
				echo "            return $ns::${t}CookMeasure();"
				echo "        }"
			fi
		done
		echo "        return -2;"
		echo "    }"
		for t in $writers; do echo "    if root == \"$t\" { return $ns::${t}CookMeasure(); }"; done
		for t in $regions; do echo "    if root == \"$t\" { return $ns::${t}CookMeasure(data, vals, nodes, at); }"; done
		echo "    return -2;"
		echo "}"
		echo "fn accel_cook_write(root: const u8[:], data: const u8[:], vals: const schema_rt::LoadVal[:], nodes: const schema_rt::LoadNode[:], at: i64, out: u8[:], big: bool) -> bool {"
		echo "    if data.len > 0 && data[0] == 3 {"
		for t in $writers; do
			if grep -q "^fn ${t}FixedLoad(" "$1"/*Table.goose 2>/dev/null; then
				echo "        if root == \"$t\" {"
				echo "            var v: $ns::$t[1] = [$ns::$t { .. }];"
				echo "            var rep = schema_rt::FixedReport { .. };"
				echo "            if $ns::${t}FixedLoad(v[0..1], data, rep) != 1 || rep.damaged || rep.reason != 0 || rep.oor != 0 { return false; }"
				echo "            return $ns::${t}Cook(v[0], out, big);"
				echo "        }"
			fi
		done
		echo "        return false;"
		echo "    }"
		for t in $writers; do
			echo "    if root == \"$t\" {"
			echo "        var v = $ns::$t { .. };"
			echo "        $ns::${t}CookFromLoaded(v, data, vals, at);"
			echo "        return $ns::${t}Cook(v, out, big);"
			echo "    }"
		done
		for t in $regions; do echo "    if root == \"$t\" { return $ns::${t}Cook(data, vals, nodes, at, out, big); }"; done
		echo "    return false;"
		echo "}"
	} >"$1/conformance_accel.goose"
	cp "$accel" "$1/accel.goose"
}
# accel_units <manifest> <surface>: the units a surface's lines name
accel_units() {
	case "$2" in
	block | block-foreign | block-dump | forgery | block-reason | block-lead) awk '$1 == "block" { print $3 }' "$1" ;;
	cook | cook-foreign | cook-forgery | cook-reason) awk '$1 == "cook" { print $3 }' "$1" ;;
	cook-write) awk 'NR == FNR { if ($1 == "cook-write") w[$2] = 1; next } $1 == "instance" && ($2 in w) { print $3 }' "$1" "$1" ;;
	esac | sort -u
}
main_units() {
	case "$2" in
	wire | json-read) awk '$1 == "instance" { print $3 }' "$1" ;;
	json-write) awk '$1 == "instance" || $1 == "json-write-refusal" { print $3 }' "$1" ;;
	message) awk '$1 == "connection" { u[$2] = $3 } $1 == "message" && ($3 in u) { print u[$3] }' "$1" ;;
	report) awk '$1 == "report" { print $3 }' "$1" ;;
	framing) awk '$1 == "framing" { print $3 }' "$1" ;;
	retain | retain-save) awk '$1 == "retain" { print $3 }' "$1" ;;
	json-hostile) awk '$1 == "json-hostile" { print $3 }' "$1" ;;
	*) awk '$1 == "unit" { print $2 }' "$1" ;;
	esac | sort -u
}
# THE FORGERY FUZZER (docs/PORTING.md I3): accel.goose's block-fuzz and
# cook-fuzz over every unit the manifest's block or cook lines name. The cook
# half reads the Go reference's cooks from <fixtures dir> (the harness
# materialises them: build/conformance/fixtures). Each prints its counts and
# the seed; the first mutant the oracle rejects is printed and the run fails.
if [ "$2" = block-fuzz ] || [ "$2" = cook-fuzz ]; then
	kind=${2%-fuzz}
	status=0
	for key in $(accel_units "$1" "$kind"); do
		[ -d "$units/$key" ] || { echo "driver: $units/$key is missing (make build/conformance-goose)" >&2; exit 1; }
		a=$(accel_prep "$units/$key" "$key") || exit 1
		if [ "$kind" = cook ]; then
			"$goose" run "$a/accel.goose" -- cook-fuzz "$1" "$key" "$3" "$4" "$5" 2>"$dir/cook-fuzz.$key.err" || status=1
		else
			"$goose" run "$a/accel.goose" -- block-fuzz "$1" "$key" "$3" "$4" 2>"$dir/block-fuzz.$key.err" || status=1
		fi
		[ "$status" -eq 0 ] || { cat "$dir/$2.$key.err" >&2; exit 1; }
	done
	exit "$status"
fi
if [ "$2" = block-lead ]; then
	status=0
	for key in $(accel_units "$1" block-lead); do
		[ -d "$units/$key" ] || { echo "driver: $units/$key is missing (make build/conformance-goose)" >&2; exit 1; }
		a=$(accel_prep "$units/$key" "$key") || exit 1
		"$goose" run "$a/accel.goose" -- block-lead "$1" "$key" 2>"$dir/block-lead.$key.err" || {
			status=1
			cat "$dir/block-lead.$key.err" >&2
		}
	done
	exit "$status"
fi
case "$2" in
list)
	# the program is the same in every unit: run it in the first one generated
	for key in $(awk '$1 == "unit" { print $2 }' "$1"); do
		[ -d "$units/$key" ] || continue
		glue "$units/$key"
		"$goose" run "$units/$key/main.goose" -- list "$1" 2>"$dir/list.err"
		status=$?
		[ "$status" -eq 0 ] || { cat "$dir/list.err" >&2; exit "$status"; }
		a=$(accel_prep "$units/$key" "$key") || exit 1
		"$goose" run "$a/accel.goose" -- list "$1" 2>"$dir/list.err"
		status=$?
		[ "$status" -eq 0 ] || cat "$dir/list.err" >&2
		exit "$status"
	done
	echo "driver: no unit generated under $units (make build/conformance-goose)" >&2
	exit 1
	;;
esac
mkdir -p "$3" || exit 1
out="$dir/$2.out"
: >"$out"
prog=main
case "$accel_surfaces" in *" $2 "*) prog=accel ;; esac
if [ "$prog" = accel ]; then
	active_units=$(accel_units "$1" "$2")
else
	active_units=$(main_units "$1" "$2")
fi
running=0
keys=""
for key in $(awk '$1 == "unit" { print $2 }' "$1"); do
	printf '%s\n' "$active_units" | grep -qx "$key" || continue
	keys="$keys $key"
	u="$units/$key"
	: >"$dir/$2.$key.out"
	if [ "$prog" = accel ]; then
		if [ ! -d "$u" ]; then
			awk -v k="$key" '
				NR == FNR { if ($1 == "cook-write") w[$2] = 1; next }
				$1 == "instance" && $3 == k && ($2 in w) { print $2 " absent"; print $2 "-be absent" }' "$1" "$1" >"$dir/$2.$key.out"
			echo 0 >"$dir/$2.$key.rc"
			continue
		fi
		(
			a=$(accel_prep "$u" "$key") || { echo 1 >"$dir/$2.$key.rc"; exit 1; }
			"$goose" run "$a/accel.goose" -- "$2" "$1" "$key" >"$dir/$2.$key.out" 2>"$dir/$2.$key.err"
			echo $? >"$dir/$2.$key.rc"
		) &
	else
		if [ ! -d "$u" ]; then
			awk -v k="$key" -v s="$2" '
				$1 == "connection" { unit_of[$2] = $3 }
				s == "message" && $1 == "message" && unit_of[$3] == k && $6 == "-" { print $2 " absent variable table: the message form is fixed tables only (SPEC-TABLES §3.3)"; next }
				(s == "json-read" || s == "json-write") && $1 == "instance" && $3 == k {
					no_text = 0; for (i = 6; i <= NF; i++) if ($i == "no-text") no_text = 1;
					if (!no_text) print $2 (s == "json-write" ? ".json" : "") " absent target-refuses-schema";
					next
				}
				s == "json-write" && $1 == "json-write-refusal" && $3 == k { print $2 ".json absent target-refuses-schema"; next }
				(s == "message" && $1 == "message" && unit_of[$3] == k) ||
				(s == "wire" && $1 == "instance" && $3 == k) ||
				(s == "report" && $1 == "report" && $3 == k) ||
				(s == "framing" && $1 == "framing" && $3 == k) ||
				((s == "retain" || s == "retain-save") && $1 == "retain" && $3 == k) ||
				(s == "json-hostile" && $1 == "json-hostile" && $3 == k) { print $2 " absent" }' "$1" >"$dir/$2.$key.out"
			echo 0 >"$dir/$2.$key.rc"
			continue
		fi
		(
			glue "$u"
			"$goose" run "$u/main.goose" -- "$2" "$1" "$key" >"$dir/$2.$key.out" 2>"$dir/$2.$key.err"
			echo $? >"$dir/$2.$key.rc"
		) &
	fi
	running=$((running + 1))
	if [ "$running" -ge 8 ]; then
		wait
		running=0
	fi
done
wait
for key in $keys; do
	status=$(cat "$dir/$2.$key.rc" 2>/dev/null || echo 1)
	if [ "$status" -ne 0 ]; then
		[ "$status" -eq 2 ] || cat "$dir/$2.$key.err" >&2
		exit "$status"
	fi
	cat "$dir/$2.$key.out" >>"$out"
done
GOOSE_OUTDIR=$3 perl -ne 'chomp; my ($c, $h) = split / /, $_, 2; next unless defined $c && $c ne ""; if (defined $h && $h =~ /^absent(?: (.*))?$/) { open(my $f, ">", "$ENV{GOOSE_OUTDIR}/$c.absent") or die; print $f (defined $1 ? $1 : ""); close $f; next } open(my $f, ">:raw", "$ENV{GOOSE_OUTDIR}/$c") or die "$c: $!"; print $f pack("H*", defined $h ? $h : ""); close $f;' <"$out"
