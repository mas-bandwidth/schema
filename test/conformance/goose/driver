	# back to its single run names itself here, never only in a file
	if [ -s "$dir/$2.$key.err" ]; then
		cat "$dir/$2.$key.err" >&2
	fi
	cat "$dir/$2.$key.out" >>"$out"
done
if [ "$jobfailed" -ne 0 ]; then
	echo "driver: a unit job exited non-zero and recorded no failing status" >&2
	exit 1
fi
perl test/conformance/answer-lines.pl "$3" "$out"
