		running=0
	fi
done
# Each job is waited on by its pid, never a bare wait (F-068). A unit's status
# is the one its job recorded in its .rc file, read below; a job that exited
# non-zero without a failing .rc is still a failure.
for p in $pids; do
	wait "$p" || jobfailed=1
done
for key in $keys; do
	status=$(cat "$dir/$2.$key.rc" 2>/dev/null || echo 1)
	if [ "$status" -ne 0 ]; then
		[ "$status" -eq 2 ] || cat "$dir/$2.$key.err" >&2
		exit "$status"
	fi
