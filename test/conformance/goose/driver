    if s == "inf" { return wref_f64_bits(0x7ff0000000000000); }
    if s == "-inf" { return wref_f64_bits(0xfff0000000000000); }
    let x, fin = schema_rt::json_token_f64(s);
    if !fin {
        if s.len > 0 && s[0] == '-' { return wref_f64_bits(0xfff0000000000000); }
