    if s == "inf" { return wref_f32_bits(0x7f800000); }
    if s == "-inf" { return wref_f32_bits(0xff800000); }
    let x, fin = schema_rt::json_token_f32(s);
    if !fin {
        let d, dfin = schema_rt::json_token_f64(s);
        if !dfin {
            if s.len > 0 && s[0] == '-' { return wref_f32_bits(0xff800000); }
            return wref_f32_bits(0x7f800000);
        }
        return d as f32;
    }
    return x;
}
fn wref_f64(s: const u8[:]) -> f64 {
