#!/bin/sh
# THE GOOSE LEG's driver (test/conformance/README.md; docs/PORT-GOOSE.md, THE
# HARNESS).
#
# Every call is handed to ONE Goose program, test/conformance/goose/main.goose,
# under the pinned compiler (`goose run`, the in-process TinyCC). The program's
# arguments follow `--`, without which `goose run` takes them as more input
# files. A surface runs ONCE PER UNIT: every generated unit
# (build/conformance-goose/<unit>, make/goose.mk) carries its own copy of the
# runtime, so two units cannot be one Goose program. For each unit this script
# copies main.goose into the unit's directory beside a glue module,
# conformance_unit.goose, that imports the unit's modules and names its
# registry (`<package>::TableUnit`), and runs it there.
#
# The program writes one line per case on stdout — the case name, a space, the
# answer's bytes as lowercase hex, or `absent` and an optional reason — which
# this script writes as one file per case into <outdir> (`<case>.absent`
# holding the reason). A case of a unit the target refused (a `.refused` file
# beside the units) is an absence. The program's exit status is the
# compiler's: 2 on a surface is ABSENT, and this script passes it through. The
# compiler's own progress lines go to stderr, kept under
# build/conformance-goose/driver.
#
# The working directory is the repository root.
#
# usage: driver <manifest> list
#        driver <manifest> <surface> <outdir>
main=test/conformance/goose/main.goose
goose=${GOOSE:-dist/goose-v2026.2-linux-x64/goose}
units=${SCHEMA_GOOSE_GENERATED:-build/conformance-goose}
dir=build/conformance-goose-driver
mkdir -p "$dir" || exit 1
# glue <unit dir>: the root and its glue module beside the unit's modules
glue() {
	ns=$(sed -n 's/^namespace \(.*\);$/\1/p' "$1"/*Table.goose | head -1)
	{
		echo "// generated by test/conformance/goose/driver: the unit under test"
		for f in "$1"/*.goose; do
			b=$(basename "$f" .goose)
			case "$b" in main|conformance_unit) continue ;; esac
			echo "import .$b;"
		done
		echo "fn conformance_unit() -> schema_rt::LoadUnit { return $ns::TableUnit; }"
	} >"$1/conformance_unit.goose"
	cp "$main" "$1/main.goose"
}
case "$2" in
list)
	# the program is the same in every unit: run it in the first one generated
	for key in $(awk '$1 == "unit" { print $2 }' "$1"); do
		[ -d "$units/$key" ] || continue
		glue "$units/$key"
		"$goose" run "$units/$key/main.goose" -- list "$1" 2>"$dir/list.err"
		status=$?
		[ "$status" -eq 0 ] || cat "$dir/list.err" >&2
		exit "$status"
	done
	echo "driver: no unit generated under $units (make build/conformance-goose)" >&2
	exit 1
	;;
esac
mkdir -p "$3" || exit 1
out="$dir/$2.out"
: >"$out"
for key in $(awk '$1 == "unit" { print $2 }' "$1"); do
	u="$units/$key"
	if [ ! -d "$u" ]; then
		# a refused unit answers none of its cases
		awk -v k="$key" -v s="$2" '
			(s == "wire" && $1 == "instance" && $3 == k) ||
			(s == "report" && $1 == "report" && $3 == k) ||
			((s == "retain" || s == "retain-save") && $1 == "retain" && $3 == k) ||
			((s == "retain" || s == "retain-save") && $1 == "retain-message" && $4 == k) { print $2 " absent" }' "$1" >>"$out"
		continue
	fi
	glue "$u"
	"$goose" run "$u/main.goose" -- "$2" "$1" "$key" >>"$out" 2>"$dir/$2.$key.err"
	status=$?
	if [ "$status" -ne 0 ]; then
		[ "$status" -eq 2 ] || cat "$dir/$2.$key.err" >&2
		exit "$status"
	fi
done
GOOSE_OUTDIR=$3 perl -ne 'chomp; my ($c, $h) = split / /, $_, 2; next unless defined $c && $c ne ""; if (defined $h && $h =~ /^absent(?: (.*))?$/) { open(my $f, ">", "$ENV{GOOSE_OUTDIR}/$c.absent") or die; print $f (defined $1 ? $1 : ""); close $f; next } open(my $f, ">:raw", "$ENV{GOOSE_OUTDIR}/$c") or die "$c: $!"; print $f pack("H*", defined $h ? $h : ""); close $f;' <"$out"
