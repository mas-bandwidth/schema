#!/bin/sh
# THE GOOSE LEG's conformance negative controls (test/conformance/README.md;
# make/goose.mk). Each mode breaks ONE clause of the Goose runtime in a COPY of
# build/conformance-goose (nothing tracked is written to), aims the driver at
# the copy (SCHEMA_GOOSE_GENERATED) and runs the harness over the load
# surfaces. The control passes only when the surfaces the clause owns go
# red and every other surface it runs stays green:
#
#   load    the retaining load stops keeping a field it cannot name (§4, §6.6:
#           an unknown field is skipped by its length and, when the caller asks,
#           retained and saved back): retain-save goes red; wire, report and
#           retain (the known value, unchanged) stay green. The old unknown
#           COUNT is retired from the compared report (docs/rulings.json
#           conformance-is-read-then-write), so the retained save is where the
#           clause is now observed.
#
#   write-refusal  the generated fixed writer's ranged-int refusal
#           (docs/SPEC.md §5.1: WeaponConfig.penetration's upper bound) is
#           removed from a copy of the tabledemo unit: Goose refuses in every
#           build, and a fixed root is saved through its own form's one
#           checked writer, so write-refusal and write-refusal-fixed go red
#           (wref_range_high, fref_range_high); wire, message and
#           write-refusal-message stay green.
#   write-refusal-fixed  the same writer's finite-float refusal (a NaN or an
#           infinity is refused on write, SPEC-TABLES.md §3.3) is removed from
#           the same copy: write-refusal-fixed goes red (fref_non_finite,
#           fref_infinite) with write-refusal beside it; wire, message and
#           write-refusal-message stay green.
#   write-refusal-message  SaveMessages's ranged-int refusal
#           (StorePurchase.quantity, both bounds) is removed from a copy of
#           the backenddemo unit: write-refusal-message goes red
#           (mref_range_high, mref_range_low); wire, message, write-refusal
#           and write-refusal-fixed stay green.
#
# usage: test/conformance/goose/negative-control <mode>
# The working directory is the repository root.
mode=$1
surfaces="wire report retain retain-save"
unit="*"
case "$mode" in
load)
	file=wire_load.goose
	from='            if c.retaining { capture(c, rec, id, kind, from, r.off); }'
	to='            // sabotaged: the unknown field is not retained'
	red="retain-save"
	;;
write-refusal)
	surfaces="wire message write-refusal write-refusal-fixed write-refusal-message"
	unit=tabledemo
	file=TablesTable.goose
	from='    if v.Penetration > 10 { return false; }'
	to='    // sabotaged: the ranged-int write refusal is gone'
	red="write-refusal write-refusal-fixed"
	;;
write-refusal-fixed)
	surfaces="wire message write-refusal write-refusal-fixed write-refusal-message"
	unit=tabledemo
	file=TablesTable.goose
	from='fn _WeaponConfigFixedCheck(v: const WeaponConfig&) -> bool {
    if (schema_rt::fixed_f32_bits(v.Damage) & 0x7f800000) == 0x7f800000 { return false; }'
	to='fn _WeaponConfigFixedCheck(v: const WeaponConfig&) -> bool {
    // sabotaged: the finite-float write refusal is gone'
	red="write-refusal write-refusal-fixed"
	;;
write-refusal-message)
	surfaces="wire message write-refusal write-refusal-fixed write-refusal-message"
	unit=backenddemo
	file=BackendTable.goose
	from='        if v.Quantity < 1 { return schema_rt::msg_refuse(w, schema_rt::MsgRefuseInvalidValue); }
        if v.Quantity > 99 { return schema_rt::msg_refuse(w, schema_rt::MsgRefuseInvalidValue); }'
	to='        // sabotaged: the ranged-int write refusal is gone'
	red="write-refusal-message"
	;;
*)
	echo "usage: $0 load|write-refusal|write-refusal-fixed|write-refusal-message" >&2
	exit 2
	;;
esac
green=$(for s in $surfaces; do case " $red " in *" $s "*) ;; *) printf '%s ' "$s" ;; esac; done)
nc=build/goose-negative-control/$mode
rm -rf "$nc" && mkdir -p "$nc" || exit 1
[ -d build/conformance-goose ] || { echo "NEGATIVE CONTROL FAILED: build/conformance-goose is missing (make build/conformance-goose)"; exit 1; }
cp -R build/conformance-goose "$nc/units" || exit 1
changed=0
for f in "$nc"/units/$unit/"$file"; do
	[ -f "$f" ] || continue
	FROM=$from TO=$to perl -0pi -e '$c += s/\Q$ENV{FROM}\E\n/$ENV{TO}\n/g; END { exit($c == 1 ? 0 : 1) }' "$f" ||
		{ echo "NEGATIVE CONTROL FAILED ($mode): $f does not hold the clause exactly once: $from"; exit 1; }
	changed=$((changed + 1))
done
[ "$changed" -gt 0 ] || { echo "NEGATIVE CONTROL FAILED ($mode): no unit holds $file"; exit 1; }
cat >"$nc/driver" <<EOS
#!/bin/sh
if [ "\$2" = list ]; then
	printf '%s\n' $surfaces
	exit 0
fi
exec test/conformance/goose/driver "\$@"
EOS
chmod +x "$nc/driver"
printf 'goose %s\n' "$nc/driver" >"$nc/drivers.txt"
if SCHEMA_GOOSE_GENERATED=$nc/units ./build/conformance-harness run --only goose --drivers "$nc/drivers.txt" --work "$nc/work" >"$nc/log" 2>&1; then
	echo "NEGATIVE CONTROL FAILED ($mode): the sabotage left conformance green"
	cat "$nc/log"
	exit 1
fi
for s in $red; do
	grep -Eq "^$s +FAIL" "$nc/log" ||
		{ echo "NEGATIVE CONTROL FAILED ($mode): $s did not go red"; cat "$nc/log"; exit 1; }
done
for s in $green; do
	grep -Eq "^$s +pass" "$nc/log" ||
		{ echo "NEGATIVE CONTROL FAILED ($mode): $s did not read a pass, so the control does not localise the clause"; cat "$nc/log"; exit 1; }
done
echo "goose conformance negative control ($mode): caught by $red, not by $green"
