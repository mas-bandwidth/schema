<Project Sdk="Microsoft.NET.Sdk">

  <!-- THE C# CONFORMANCE DRIVER (test/conformance/README.md). One process per
       surface, driven entirely by testdata/conformance/tables — this project
       carries no literal instance, no expected byte and no expected count.

       It compiles the table wire units (the corpus, the two-generation
       evolution pair, and the by-value/optional pointer twins) and the BLOCK
       unit, which is why it needs AllowUnsafeBlocks: a block is memory another
       language wrote, and pointing at it without a copy is the point (§12.1).

       This leg compiles the wire, native region, cook, block and view surfaces
       together. The region fuzzer loads into exact caller storage and checks
       a guard beyond the measured extent before copying into editable values.

       Sources come from build/, generated by the Makefile. No test framework;
       the exit code is the verdict, and TreatWarningsAsErrors is the refuser
       for the generated source. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>annotations</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>schemaconformance</AssemblyName>
    <!-- Overridable so the harness's NEGATIVE CONTROL can point this leg at a
         sabotaged copy of the generated sources and require it to go red. -->
    <TablesGeneratedDir Condition="'$(TablesGeneratedDir)' == ''">../../../build/tables-generated-cs</TablesGeneratedDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src/*.cs" />
    <Compile Include="$(TablesGeneratedDir)/rt1/*.cs" />
    <Compile Include="$(TablesGeneratedDir)/r2/*.cs" />
    <Compile Include="$(TablesGeneratedDir)/r1/*.cs" />
    <Compile Include="$(TablesGeneratedDir)/vocab9/*.cs" />
    <Compile Include="$(TablesGeneratedDir)/vocab/*.cs" />
    <Compile Include="$(TablesGeneratedDir)/backend/*.cs" />
    <Compile Include="$(TablesGeneratedDir)/g1/*.cs" />
    <Compile Include="$(TablesGeneratedDir)/stream/*.cs" />
    <Compile Include="$(TablesGeneratedDir)/maps/*.cs" />
    <Compile Include="$(TablesGeneratedDir)/lists/*.cs" />
    <Compile Include="$(TablesGeneratedDir)/w2/*.cs" />
    <Compile Include="$(TablesGeneratedDir)/w1/*.cs" />
    <Compile Include="$(TablesGeneratedDir)/p2/*.cs" />
    <Compile Include="$(TablesGeneratedDir)/blobs/*.cs" />
    <Compile Include="$(TablesGeneratedDir)/pointers/*.cs" />
    <Compile Include="$(TablesGeneratedDir)/caption/*.cs" />
    <Compile Include="$(TablesGeneratedDir)/scalars2/*.cs" />
    <Compile Include="$(TablesGeneratedDir)/scalars/*.cs" />
    <Compile Include="$(TablesGeneratedDir)/messages/*.cs" />
    <Compile Include="$(TablesGeneratedDir)/m1/*.cs" />
    <Compile Include="$(TablesGeneratedDir)/m2/*.cs" />
    <Compile Include="$(TablesGeneratedDir)/a1/*.cs" />
    <Compile Include="$(TablesGeneratedDir)/a2/*.cs" />
    <Compile Include="$(TablesGeneratedDir)/k1/*.cs" />
    <Compile Include="$(TablesGeneratedDir)/k2/*.cs" />
    <Compile Include="$(TablesGeneratedDir)/examples/*.cs" />
    <Compile Include="$(TablesGeneratedDir)/v1/*.cs" />
    <Compile Include="$(TablesGeneratedDir)/v2/*.cs" />
    <Compile Include="$(TablesGeneratedDir)/p1/*.cs" />
    <Compile Include="$(TablesGeneratedDir)/p3/*.cs" />
    <Compile Include="$(TablesGeneratedDir)/block/*.cs" />
    <Compile Include="../../../../serialize.cs/src/Serialize.cs" />
    <Compile Include="../../../../serialize.cs/src/Int128Pair.cs" />
  </ItemGroup>

</Project>
