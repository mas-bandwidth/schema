<Project Sdk="Microsoft.NET.Sdk">

  <!-- THE C# CONFORMANCE DRIVER (test/conformance/README.md). One process per
       surface, driven entirely by testdata/conformance/tables — this project
       carries no literal instance, no expected byte and no expected count.

       It compiles the table wire units (the corpus, the two-generation
       evolution pair, and the by-value/optional pointer twins) and the BLOCK
       unit, which is why it needs AllowUnsafeBlocks: a block is memory another
       language wrote, and pointing at it without a copy is the point (§12.1).

       The two ACCELERATORS are excluded from the WIRE units as a pair, for the
       reason test/cs-tables states: they share one set of blittable records.
       The block unit brings both, because that is the unit whose block form
       this driver opens.

       Sources come from build/, generated by the Makefile. No test framework;
       the exit code is the verdict, and TreatWarningsAsErrors is the refuser
       for the generated source. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>annotations</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>schemaconformance</AssemblyName>
    <!-- Overridable so the harness's NEGATIVE CONTROL can point this leg at a
         sabotaged copy of the generated sources and require it to go red. -->
    <TablesGeneratedDir Condition="'$(TablesGeneratedDir)' == ''">../../../build/tables-generated-cs</TablesGeneratedDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src/*.cs" />
    <Compile Include="$(TablesGeneratedDir)/r2/*.cs" Exclude="$(TablesGeneratedDir)/r2/*Block.cs;$(TablesGeneratedDir)/r2/*Cook.cs" />
    <Compile Include="$(TablesGeneratedDir)/r1/*.cs" Exclude="$(TablesGeneratedDir)/r1/*Block.cs;$(TablesGeneratedDir)/r1/*Cook.cs" />
    <Compile Include="$(TablesGeneratedDir)/vocab9/*.cs" Exclude="$(TablesGeneratedDir)/vocab9/*Block.cs;$(TablesGeneratedDir)/vocab9/*Cook.cs" />
    <Compile Include="$(TablesGeneratedDir)/vocab/*.cs" Exclude="$(TablesGeneratedDir)/vocab/*Block.cs;$(TablesGeneratedDir)/vocab/*Cook.cs" />
    <Compile Include="$(TablesGeneratedDir)/backend/*.cs" Exclude="$(TablesGeneratedDir)/backend/*Block.cs;$(TablesGeneratedDir)/backend/*Cook.cs" />
    <Compile Include="$(TablesGeneratedDir)/g1/*.cs" Exclude="$(TablesGeneratedDir)/g1/*Block.cs;$(TablesGeneratedDir)/g1/*Cook.cs" />
    <Compile Include="$(TablesGeneratedDir)/stream/*.cs" Exclude="$(TablesGeneratedDir)/stream/*Block.cs;$(TablesGeneratedDir)/stream/*Cook.cs" />
    <Compile Include="$(TablesGeneratedDir)/maps/*.cs" Exclude="$(TablesGeneratedDir)/maps/*Block.cs;$(TablesGeneratedDir)/maps/*Cook.cs" />
    <Compile Include="$(TablesGeneratedDir)/lists/*.cs" Exclude="$(TablesGeneratedDir)/lists/*Block.cs;$(TablesGeneratedDir)/lists/*Cook.cs" />
    <Compile Include="$(TablesGeneratedDir)/w2/*.cs" Exclude="$(TablesGeneratedDir)/w2/*Block.cs;$(TablesGeneratedDir)/w2/*Cook.cs" />
    <Compile Include="$(TablesGeneratedDir)/w1/*.cs" Exclude="$(TablesGeneratedDir)/w1/*Block.cs;$(TablesGeneratedDir)/w1/*Cook.cs" />
    <Compile Include="$(TablesGeneratedDir)/p2/*.cs" Exclude="$(TablesGeneratedDir)/p2/*Block.cs;$(TablesGeneratedDir)/p2/*Cook.cs" />
    <Compile Include="$(TablesGeneratedDir)/blobs/*.cs" Exclude="$(TablesGeneratedDir)/blobs/*Block.cs;$(TablesGeneratedDir)/blobs/*Cook.cs" />
    <Compile Include="$(TablesGeneratedDir)/pointers/*.cs" Exclude="$(TablesGeneratedDir)/pointers/*Block.cs;$(TablesGeneratedDir)/pointers/*Cook.cs" />
    <Compile Include="$(TablesGeneratedDir)/caption/*.cs" Exclude="$(TablesGeneratedDir)/caption/*Block.cs;$(TablesGeneratedDir)/caption/*Cook.cs" />
    <Compile Include="$(TablesGeneratedDir)/scalars2/*.cs" Exclude="$(TablesGeneratedDir)/scalars2/*Block.cs;$(TablesGeneratedDir)/scalars2/*Cook.cs" />
    <Compile Include="$(TablesGeneratedDir)/scalars/*.cs" Exclude="$(TablesGeneratedDir)/scalars/*Block.cs;$(TablesGeneratedDir)/scalars/*Cook.cs" />
    <Compile Include="$(TablesGeneratedDir)/messages/*.cs" Exclude="$(TablesGeneratedDir)/messages/*Block.cs;$(TablesGeneratedDir)/messages/*Cook.cs" />
    <Compile Include="$(TablesGeneratedDir)/m1/*.cs" Exclude="$(TablesGeneratedDir)/m1/*Block.cs;$(TablesGeneratedDir)/m1/*Cook.cs" />
    <Compile Include="$(TablesGeneratedDir)/m2/*.cs" Exclude="$(TablesGeneratedDir)/m2/*Block.cs;$(TablesGeneratedDir)/m2/*Cook.cs" />
    <Compile Include="$(TablesGeneratedDir)/a1/*.cs" Exclude="$(TablesGeneratedDir)/a1/*Block.cs;$(TablesGeneratedDir)/a1/*Cook.cs" />
    <Compile Include="$(TablesGeneratedDir)/a2/*.cs" Exclude="$(TablesGeneratedDir)/a2/*Block.cs;$(TablesGeneratedDir)/a2/*Cook.cs" />
    <Compile Include="$(TablesGeneratedDir)/k1/*.cs" Exclude="$(TablesGeneratedDir)/k1/*Block.cs;$(TablesGeneratedDir)/k1/*Cook.cs" />
    <Compile Include="$(TablesGeneratedDir)/k2/*.cs" Exclude="$(TablesGeneratedDir)/k2/*Block.cs;$(TablesGeneratedDir)/k2/*Cook.cs" />
    <Compile Include="$(TablesGeneratedDir)/examples/*.cs" Exclude="$(TablesGeneratedDir)/examples/*Block.cs;$(TablesGeneratedDir)/examples/*Cook.cs" />
    <Compile Include="$(TablesGeneratedDir)/v1/*.cs" Exclude="$(TablesGeneratedDir)/v1/*Block.cs;$(TablesGeneratedDir)/v1/*Cook.cs" />
    <Compile Include="$(TablesGeneratedDir)/v2/*.cs" Exclude="$(TablesGeneratedDir)/v2/*Block.cs;$(TablesGeneratedDir)/v2/*Cook.cs" />
    <Compile Include="$(TablesGeneratedDir)/p1/*.cs" Exclude="$(TablesGeneratedDir)/p1/*Block.cs;$(TablesGeneratedDir)/p1/*Cook.cs" />
    <Compile Include="$(TablesGeneratedDir)/p3/*.cs" Exclude="$(TablesGeneratedDir)/p3/*Block.cs;$(TablesGeneratedDir)/p3/*Cook.cs" />
    <Compile Include="$(TablesGeneratedDir)/block/*.cs" Exclude="$(TablesGeneratedDir)/block/*Cook.cs" />
    <Compile Include="../../../../serialize.cs/src/Serialize.cs" />
    <Compile Include="../../../../serialize.cs/src/Int128Pair.cs" />
  </ItemGroup>

</Project>
