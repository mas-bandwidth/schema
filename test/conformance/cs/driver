#!/bin/sh
# THE C# LEG's driver (test/conformance/README.md).
#
# The table surfaces come from test/conformance/cs; the cook's node dump comes
# from test/cs-cook, which already produces it and is already gated against the
# C++ walk. A driver is a COMMAND precisely so a leg can be assembled from what
# a backend already has.
#
# The working directory is the repository root, which is the contract: every
# path in the manifest is repo-relative, so a driver never resolves one itself.
#
# usage: driver <manifest> list
#        driver <manifest> <surface> <outdir>
set -e

manifest=$1
surface=$2
out=$3

CONF_DLL="test/conformance/cs/bin/Debug/net10.0/schemaconformance.dll"
COOK_DLL="test/cs-cook/bin/Debug/net10.0/schemacooktest.dll"

case "$surface" in
list)
    dotnet "$CONF_DLL" "$manifest" list
    echo cook
    echo cook-foreign
    echo cook-reason
    echo cook-forgery
    ;;
cook)
    # cook <case> <unit> <root> <file>
    grep '^cook ' "$manifest" | while read -r _ cookcase _ cookroot file; do
        dotnet "$COOK_DLL" dump "$cookroot" "$file" > "$out/$cookcase"
    done
    ;;
cook-foreign)
    # the cross-endian refusal, in ONE runtime start-up over the derived manifest
    dotnet "$COOK_DLL" foreign "$manifest" "$out"
    ;;
cook-reason)
    dotnet "$COOK_DLL" reason "$manifest" "$out"
    ;;
cook-forgery)
    # the whole 111-row battery in ONE runtime start-up, over the derived
    # manifest — the cook dump above is the one surface that cannot be
    # (its walk takes one root per invocation)
    dotnet "$COOK_DLL" conformance "$manifest" "$out"
    ;;
*)
    exec dotnet "$CONF_DLL" "$manifest" "$surface" "$out"
    ;;
esac
