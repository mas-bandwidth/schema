<Project Sdk="Microsoft.NET.Sdk">

  <!-- The release storage gate's C# program: the generated table wire and its
       message writer, compiled Release so every Debug.Assert is gone. The
       generated Storage.cs carries the unit's declared types beside the packet
       writer, so the serialize runtime those types name is compiled with it. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>annotations</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>StorageRelease</AssemblyName>
    <StorageGeneratedDir Condition="'$(StorageGeneratedDir)' == ''">../../../../build/storage-release-cs/generated</StorageGeneratedDir>
    <SerializeDir Condition="'$(SerializeDir)' == ''">../../../../serialize.cs</SerializeDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../storage_release.cs" />
    <Compile Include="$(StorageGeneratedDir)/*.cs" />
    <Compile Include="$(SerializeDir)/src/Serialize.cs" />
    <Compile Include="$(SerializeDir)/src/Int128Pair.cs" />
  </ItemGroup>

</Project>
