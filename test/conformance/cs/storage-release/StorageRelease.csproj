<Project Sdk="Microsoft.NET.Sdk">

  <!-- The release storage gate's C# program: the generated table wire and its
       message writer, compiled Release so every Debug.Assert is gone. The
       table's runtime and codecs carry no serialize dependency, so only those
       two generated files are compiled. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>annotations</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>StorageRelease</AssemblyName>
    <StorageGeneratedDir Condition="'$(StorageGeneratedDir)' == ''">../../../../build/storage-release-cs/generated</StorageGeneratedDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../storage_release.cs" />
    <Compile Include="$(StorageGeneratedDir)/StorageTable.cs" />
    <Compile Include="$(StorageGeneratedDir)/StoragereleaseTable.cs" />
  </ItemGroup>

</Project>
