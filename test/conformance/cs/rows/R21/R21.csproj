<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>annotations</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>cell-cs-r21</AssemblyName>
    <TablesGeneratedDir Condition="'$(TablesGeneratedDir)' == ''">../../../../../build/tables-generated-cs</TablesGeneratedDir>
    <RepoRoot Condition="'$(RepoRoot)' == ''">../../../../..</RepoRoot>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
  </ItemGroup>

  <!-- The generated units are not in the tables-generated-cs stamp, so the row
       generates its own and globs them INSIDE the target: a static glob is
       evaluated before any target runs and would miss a fresh tree. -->
  <Target Name="GenerateR21Tables" BeforeTargets="CoreCompile">
    <Exec Command="$(RepoRoot)/bin/schema generate --lang cs --out $(TablesGeneratedDir)/vold_float_widen $(RepoRoot)/test/tables/VOLD_float_widen.schema" />
    <Exec Command="$(RepoRoot)/bin/schema generate --lang cs --out $(TablesGeneratedDir)/vnew_float_widen $(RepoRoot)/test/tables/VNEW_float_widen.schema" />
    <ItemGroup>
      <Compile Include="$(TablesGeneratedDir)/vold_float_widen/*.cs" />
      <Compile Include="$(TablesGeneratedDir)/vnew_float_widen/*.cs" />
    </ItemGroup>
  </Target>

</Project>
