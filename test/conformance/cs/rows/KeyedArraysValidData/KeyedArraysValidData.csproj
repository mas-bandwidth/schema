<Project Sdk="Microsoft.NET.Sdk">

  <!-- cell3-cs-keyed-arrays-valid-data — Enum-keyed arrays: valid-data
       write/read acceptance. Standalone like rows/W14: the rt2 unit's table
       wire carries no serialize dependency, so the row compiles against
       build/tables-generated-cs alone. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>annotations</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>cell3-cs-keyed-arrays-valid-data</AssemblyName>
    <TablesGeneratedDir Condition="'$(TablesGeneratedDir)' == ''">../../../../../build/tables-generated-cs</TablesGeneratedDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="$(TablesGeneratedDir)/rt2/*.cs" />
  </ItemGroup>

</Project>
