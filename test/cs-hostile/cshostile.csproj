<Project Sdk="Microsoft.NET.Sdk">

  <!-- The C# port's hostile-corpus runner (make/schema-cs-runs-hostile-corpus.mk):
       Runner.cs, the dispatch and units test/cs-hostile/gen writes from the
       corpus manifest, and the serialize.cs runtime the packet units read with.
       Sources come from build/ and are never committed. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>annotations</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>cshostile</AssemblyName>
    <HostileGeneratedDir Condition="'$(HostileGeneratedDir)' == ''">../../build/cs-hostile/generated</HostileGeneratedDir>
    <SerializeCsDir Condition="'$(SerializeCsDir)' == ''">../../../serialize.cs</SerializeCsDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Runner.cs" />
    <Compile Include="$(HostileGeneratedDir)/**/*.cs" />
    <Compile Include="$(SerializeCsDir)/src/Serialize.cs" />
    <Compile Include="$(SerializeCsDir)/src/Int128Pair.cs" />
  </ItemGroup>

</Project>
