<Project Sdk="Microsoft.NET.Sdk">

  <!-- The committed corpus (generated/unity, generated/unity-ludicrous) in the
       Unity dialect. UnityGeneratedDir is overridable so a negative control can
       point it at a planted copy. -->
  <Import Project="../UnityDialect.props" />

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>schemaunity</AssemblyName>
    <UnityGeneratedDir Condition="'$(UnityGeneratedDir)' == ''">$(MSBuildThisFileDirectory)../../../generated/unity</UnityGeneratedDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(UnityGeneratedDir)/*.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)../../../generated/unity-ludicrous/*.cs" />
  </ItemGroup>

</Project>
