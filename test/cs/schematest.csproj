<Project Sdk="Microsoft.NET.Sdk">

  <!-- The C# wire-test console project: compiles the generated C# beside the
       serialize.cs runtime (sibling checkout, same relative-path convention as
       the Go and Rust test projects) and runs src/Program.cs — the twin of
       test/go/main.go. TreatWarningsAsErrors is the refuser for the generated
       source; no test framework, exit code = verdict (the family rule). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- annotations, not disable: Serialize.cs carries `object?` annotations,
         which warn (CS8632 -> error) outside an annotation context; the
         annotations context admits them without enabling nullable warnings,
         which the annotation-free generated code would otherwise trip. -->
    <Nullable>annotations</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>schematest</AssemblyName>
    <!-- DEFAULT STRICTNESS for the generated packet units (issue #547;
         make/cs.mk packet-clean-cs, docs/CS-TABLES.md "The generated C#
         dialect"): the SDK's own analyzers at the latest level in the Default
         mode, no stricter mode and no suppression file. Pinned here so the
         gate and this build mean the same thing whatever the SDK's default. -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Default</AnalysisMode>
    <!-- Overridable so packet-clean-cs-negative-control can point this build
         at a planted copy of the generated examples and require it to go red. -->
    <PacketGeneratedDir Condition="'$(PacketGeneratedDir)' == ''">../../generated/cs</PacketGeneratedDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(PacketGeneratedDir)/*.cs" />
    <!-- the bench corpus (BENCH-STANDARD.md §1.3, namespace Bench) rides this
         build as its C# compile proof — the bench runners' rt paths are
         hand-written, so nothing else compiles the generated bench C# -->
    <Compile Include="../../generated/bench/cs/*.cs" />
    <Compile Include="../../../serialize.cs/src/Serialize.cs" />
    <!-- the emulated 128-bit pair (Int128Value/UInt128Value) lives beside
         Serialize.cs and Serialize.cs references it on every TFM -->
    <Compile Include="../../../serialize.cs/src/Int128Pair.cs" />
  </ItemGroup>

</Project>
