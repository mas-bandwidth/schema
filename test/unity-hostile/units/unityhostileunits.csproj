<Project Sdk="Microsoft.NET.Sdk">

  <!-- Every generated Unity hostile-corpus unit compiled in the strict Unity dialect
       (C# 9 over netstandard2.1, warnings as errors, unsafe disallowed). -->
  <Import Project="../../../test/unity/UnityDialect.props" />

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>unityhostileunits</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(HostileGeneratedDir)/*/*.cs" />
  </ItemGroup>

</Project>
