<Project Sdk="Microsoft.NET.Sdk">

  <!-- The C# wire-test console project for the fixed-point + 128-bit unit
       (examples128/): compiles the generated C# beside the serialize.cs
       runtime (sibling checkout, same relative-path convention as test/cs)
       and runs src/Program.cs — the twin of test/go-ludicrous/main.go.
       TreatWarningsAsErrors is the refuser for the generated source; no test
       framework, exit code = verdict (the family rule). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- annotations, not disable: Serialize.cs carries `object?` annotations,
         which warn (CS8632 -> error) outside an annotation context; the
         annotations context admits them without enabling nullable warnings,
         which the annotation-free generated code would otherwise trip. -->
    <Nullable>annotations</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>ludicroustest</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../generated/cs-ludicrous/*.cs" />
    <Compile Include="../../../serialize.cs/src/Serialize.cs" />
    <!-- the emulated 128-bit pair (Int128Value/UInt128Value) lives beside
         Serialize.cs — the storage type of every int128/uint128/fixed(112+)
         field in the generated unit -->
    <Compile Include="../../../serialize.cs/src/Int128Pair.cs" />
  </ItemGroup>

</Project>
