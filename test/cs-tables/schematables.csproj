<Project Sdk="Microsoft.NET.Sdk">

  <!-- The C# TABLE-wire test project (SPEC-TABLES.md): compiles the generated
       table C# for the tables corpus and the two-generation evolution pair and
       runs src/Program.cs — the C# twin of test/tables/main.cpp's fixed-class
       half. No test framework, exit code = verdict (the family rule), and
       TreatWarningsAsErrors is the refuser for the generated source.

       The generated <Base>Table.cs files carry NO serialize dependency (the
       Makefile's tables-cs-standalone gate holds that); the packet <Base>.cs
       beside them does, so the runtime rides here exactly as it does in
       test/cs. Sources come from build/, generated by the Makefile — they are
       test-only and never part of the committed generated/ tree.

       The <Base>Block.cs files are EXCLUDED, and that exclusion is the point:
       nothing declares the block form, it is emitted on the side, and a
       consumer that never reads a block compiles none of it — not a type, not
       a constant, and not the `unsafe` the form needs to point at memory
       another language wrote (SPEC-TABLES.md §2.2, §19). test/cs-block is the
       leg that does compile them. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- annotations, not disable: Serialize.cs carries `object?` annotations,
         which warn (CS8632 -> error) outside an annotation context; the
         annotations context admits them without enabling nullable warnings,
         which the annotation-free generated code would otherwise trip. -->
    <Nullable>annotations</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>schematablestest</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- THE TWO ACCELERATORS ARE EXCLUDED, and they are excluded as a PAIR.
         This is the WIRE leg: a block (§19) and a cook (§7) are emitted on the
         side, and a consumer compiles them only if it uses one. They come as a
         pair because they SHARE one set of blittable <Name>Row records — a
         cooked record IS the blittable row (§7) — so compiling one file of the
         pair without the other leaves those records undefined. Both, or
         neither. -->
    <Compile Include="src/*.cs" />
    <Compile Include="../../build/tables-generated-cs/examples/*.cs" Exclude="../../build/tables-generated-cs/examples/*Block.cs;../../build/tables-generated-cs/examples/*Cook.cs" />
    <Compile Include="../../build/tables-generated-cs/v1/*.cs" Exclude="../../build/tables-generated-cs/v1/*Block.cs;../../build/tables-generated-cs/v1/*Cook.cs" />
    <Compile Include="../../build/tables-generated-cs/v2/*.cs" Exclude="../../build/tables-generated-cs/v2/*Block.cs;../../build/tables-generated-cs/v2/*Cook.cs" />
    <!-- the three-way T / ?T / *T set (SPEC-TABLES.md §2.3, §3.1). P2 is
         POINTERED, so this backend refuses it by name and the leg reads P2's
         C++-written golden bytes instead of generating it. -->
    <Compile Include="../../build/tables-generated-cs/p1/*.cs" Exclude="../../build/tables-generated-cs/p1/*Block.cs;../../build/tables-generated-cs/p1/*Cook.cs" />
    <Compile Include="../../build/tables-generated-cs/p3/*.cs" Exclude="../../build/tables-generated-cs/p3/*Block.cs;../../build/tables-generated-cs/p3/*Cook.cs" />
    <Compile Include="../../../serialize.cs/src/Serialize.cs" />
    <Compile Include="../../../serialize.cs/src/Int128Pair.cs" />
  </ItemGroup>

</Project>
