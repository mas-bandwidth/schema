<Project Sdk="Microsoft.NET.Sdk">

  <!-- The C# TABLE-wire test project (SPEC-TABLES.md): compiles the generated
       table C# for the tables corpus and the two-generation evolution pair and
       runs src/Program.cs — the C# twin of test/tables/main.cpp's fixed-class
       half. No test framework, exit code = verdict (the family rule), and
       TreatWarningsAsErrors is the refuser for the generated source.

       The generated <Base>Table.cs files carry NO serialize dependency (the
       Makefile's tables-cs-standalone gate holds that); the packet <Base>.cs
       beside them does, so the runtime rides here exactly as it does in
       test/cs. Sources come from build/, generated by the Makefile — they are
       test-only and never part of the committed generated/ tree. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- annotations, not disable: Serialize.cs carries `object?` annotations,
         which warn (CS8632 -> error) outside an annotation context; the
         annotations context admits them without enabling nullable warnings,
         which the annotation-free generated code would otherwise trip. -->
    <Nullable>annotations</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>schematablestest</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src/*.cs" />
    <Compile Include="../../build/tables-generated-cs/examples/*.cs" />
    <Compile Include="../../build/tables-generated-cs/v1/*.cs" />
    <Compile Include="../../build/tables-generated-cs/v2/*.cs" />
    <!-- the three-way T / ?T / *T set (SPEC-TABLES.md §2.3, §3.1). P2 is
         POINTERED, so this backend refuses it by name and the leg reads P2's
         C++-written golden bytes instead of generating it. -->
    <Compile Include="../../build/tables-generated-cs/p1/*.cs" />
    <Compile Include="../../build/tables-generated-cs/p3/*.cs" />
    <Compile Include="../../../serialize.cs/src/Serialize.cs" />
    <Compile Include="../../../serialize.cs/src/Int128Pair.cs" />
  </ItemGroup>

</Project>
