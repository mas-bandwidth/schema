<Project Sdk="Microsoft.NET.Sdk">

  <!-- The C# TABLE-wire test project (docs/SPEC-TABLES.md): compiles the generated
       table C# for the tables corpus and the two-generation evolution pair and
       runs src/Program.cs — the C# twin of test/tables/main.cpp's fixed-class
       half. No test framework, exit code = verdict (the family rule), and
       TreatWarningsAsErrors is the refuser for the generated source.

       The generated <Base>Table.cs files carry NO serialize dependency (the
       Makefile's tables-cs-standalone gate holds that); the packet <Base>.cs
       beside them does, so the runtime rides here exactly as it does in
       test/cs. Sources come from build/, generated by the Makefile — they are
       test-only and never part of the committed generated/ tree.

       This integration leg compiles wire, view, cook and block surfaces together.
       Separate standalone gates retain the optional-compilation contract. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- annotations, not disable: Serialize.cs carries `object?` annotations,
         which warn (CS8632 -> error) outside an annotation context; the
         annotations context admits them without enabling nullable warnings,
         which the annotation-free generated code would otherwise trip. -->
    <Nullable>annotations</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>schematablestest</AssemblyName>
  </PropertyGroup>

  <ItemGroup>

    <Compile Include="src/*.cs" />
    <Compile Include="../../build/tables-generated-cs/csview/*.cs" />
    <Compile Include="../../build/tables-generated-cs/block/*.cs" />
    <Compile Include="../../build/tables-generated-cs/blockhome/*.cs" />
    <Compile Include="../../build/tables-generated-cs/r2/*.cs" />
    <Compile Include="../../build/tables-generated-cs/r1/*.cs" />
    <Compile Include="../../build/tables-generated-cs/vocab9/*.cs" />
    <Compile Include="../../build/tables-generated-cs/vocab/*.cs" />
    <Compile Include="../../build/tables-generated-cs/backend/*.cs" />
    <Compile Include="../../build/tables-generated-cs/g1/*.cs" />
    <Compile Include="../../build/tables-generated-cs/stream/*.cs" />
    <Compile Include="../../build/tables-generated-cs/maps/*.cs" />
    <Compile Include="../../build/tables-generated-cs/lists/*.cs" />
    <Compile Include="../../build/tables-generated-cs/w2/*.cs" />
    <Compile Include="../../build/tables-generated-cs/w1/*.cs" />
    <Compile Include="../../build/tables-generated-cs/p2/*.cs" />
    <Compile Include="../../build/tables-generated-cs/blobs/*.cs" />
    <Compile Include="../../build/tables-generated-cs/pointers/*.cs" />
    <Compile Include="../../build/tables-generated-cs/caption/*.cs" />
    <Compile Include="../../build/tables-generated-cs/scalars2/*.cs" />
    <Compile Include="../../build/tables-generated-cs/scalars/*.cs" />
    <Compile Include="../../build/tables-generated-cs/csunions/*.cs" />
    <Compile Include="../../build/tables-generated-cs/messages/*.cs" />
    <Compile Include="../../build/tables-generated-cs/m1/*.cs" />
    <Compile Include="../../build/tables-generated-cs/m2/*.cs" />
    <Compile Include="../../build/tables-generated-cs/a1/*.cs" />
    <Compile Include="../../build/tables-generated-cs/a2/*.cs" />
    <Compile Include="../../build/tables-generated-cs/csids/*.cs" />
    <Compile Include="../../build/tables-generated-cs/examples/*.cs" />
    <Compile Include="../../build/tables-generated-cs/v1/*.cs" />
    <Compile Include="../../build/tables-generated-cs/v2/*.cs" />
    <!-- the three-way T / ?T / *T set (docs/SPEC-TABLES.md §2.3, §3.1). P2 is
         POINTERED, so this backend refuses it by name and the leg reads P2's
         C++-written golden bytes instead of generating it. -->
    <Compile Include="../../build/tables-generated-cs/p1/*.cs" />
    <Compile Include="../../build/tables-generated-cs/p3/*.cs" />
    <Compile Include="../../../serialize.cs/src/Serialize.cs" />
    <Compile Include="../../../serialize.cs/src/Int128Pair.cs" />
  </ItemGroup>

</Project>
