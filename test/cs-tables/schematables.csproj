<Project Sdk="Microsoft.NET.Sdk">

  <!-- The C# TABLE-wire test project (docs/SPEC-TABLES.md): compiles the generated
       table C# for the tables corpus and the two-generation evolution pair and
       runs src/Program.cs — the C# twin of test/tables/main.cpp's fixed-class
       half. No test framework, exit code = verdict (the family rule), and
       TreatWarningsAsErrors is the refuser for the generated source.

       The generated <Base>Table.cs files carry NO serialize dependency (the
       Makefile's tables-cs-standalone gate holds that); the packet <Base>.cs
       beside them does, so the runtime rides here exactly as it does in
       test/cs. Sources come from build/, generated by the Makefile — they are
       test-only and never part of the committed generated/ tree.

       This integration leg compiles wire, view, cook and block surfaces together.
       Separate standalone gates retain the optional-compilation contract. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- annotations, not disable: Serialize.cs carries `object?` annotations,
         which warn (CS8632 -> error) outside an annotation context; the
         annotations context admits them without enabling nullable warnings,
         which the annotation-free generated code would otherwise trip. -->
    <Nullable>annotations</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>schematablestest</AssemblyName>
    <!-- The generated units this leg compiles. make/cs.mk's leg controls
         point it at a tree regenerated from a sabotaged emitter. -->
    <TablesGeneratedDir Condition="'$(TablesGeneratedDir)' == ''">../../build/tables-generated-cs</TablesGeneratedDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(TablesGeneratedDir)/ut/*.cs" />
    <Compile Include="$(TablesGeneratedDir)/cscollections1/*.cs" />
    <Compile Include="$(TablesGeneratedDir)/cscollections2/*.cs" />

    <Compile Include="src/*.cs" />
    <Compile Include="$(TablesGeneratedDir)/csretain1/*.cs" />
    <Compile Include="$(TablesGeneratedDir)/csretain2/*.cs" />

    <Compile Include="$(TablesGeneratedDir)/rt1/*.cs" />
    <Compile Include="$(TablesGeneratedDir)/rt2/*.cs" />
    <Compile Include="$(TablesGeneratedDir)/rt3/*.cs" />

    <Compile Include="$(TablesGeneratedDir)/csview/*.cs" />
    <Compile Include="$(TablesGeneratedDir)/block/*.cs" />
    <Compile Include="$(TablesGeneratedDir)/blockhome/*.cs" />
    <Compile Include="$(TablesGeneratedDir)/r2/*.cs" />
    <Compile Include="$(TablesGeneratedDir)/r1/*.cs" />
    <Compile Include="$(TablesGeneratedDir)/vocab9/*.cs" />
    <Compile Include="$(TablesGeneratedDir)/vocab/*.cs" />
    <Compile Include="$(TablesGeneratedDir)/backend/*.cs" />
    <Compile Include="$(TablesGeneratedDir)/g1/*.cs" />
    <Compile Include="$(TablesGeneratedDir)/stream/*.cs" />
    <Compile Include="$(TablesGeneratedDir)/maps/*.cs" />
    <Compile Include="$(TablesGeneratedDir)/lists/*.cs" />
    <Compile Include="$(TablesGeneratedDir)/w2/*.cs" />
    <Compile Include="$(TablesGeneratedDir)/w1/*.cs" />
    <Compile Include="$(TablesGeneratedDir)/p2/*.cs" />
    <Compile Include="$(TablesGeneratedDir)/blobs/*.cs" />
    <Compile Include="$(TablesGeneratedDir)/pointers/*.cs" />
    <Compile Include="$(TablesGeneratedDir)/scalars2/*.cs" />
    <Compile Include="$(TablesGeneratedDir)/scalars/*.cs" />
    <Compile Include="$(TablesGeneratedDir)/csunions/*.cs" />
    <Compile Include="$(TablesGeneratedDir)/messages/*.cs" />
    <Compile Include="$(TablesGeneratedDir)/m1/*.cs" />
    <Compile Include="$(TablesGeneratedDir)/m2/*.cs" />
    <Compile Include="$(TablesGeneratedDir)/a1/*.cs" />
    <Compile Include="$(TablesGeneratedDir)/a2/*.cs" />
    <Compile Include="$(TablesGeneratedDir)/csids/*.cs" />
    <Compile Include="$(TablesGeneratedDir)/examples/*.cs" />
    <Compile Include="$(TablesGeneratedDir)/v1/*.cs" />
    <Compile Include="$(TablesGeneratedDir)/v2/*.cs" />
    <!-- The by-value and optional twins beside pointered P2 above. -->
    <Compile Include="$(TablesGeneratedDir)/p1/*.cs" />
    <Compile Include="$(TablesGeneratedDir)/p3/*.cs" />
    <Compile Include="$(TablesGeneratedDir)/fx1/*.cs" />
    <Compile Include="$(TablesGeneratedDir)/fx2/*.cs" />
    <Compile Include="../../../serialize.cs/src/Serialize.cs" />
    <Compile Include="../../../serialize.cs/src/Int128Pair.cs" />
  </ItemGroup>

</Project>
