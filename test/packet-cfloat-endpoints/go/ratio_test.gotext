package cfloat

import (
	"bufio"
	"encoding/hex"
	"os"
	"strconv"
	"strings"
	"testing"

	"github.com/mas-bandwidth/serialize.go/v2"
)

func TestRatioEndpoints(t *testing.T) {
	cases, err := os.Open("ratio-endpoints.txt")
	if err != nil {
		t.Fatal(err)
	}
	defer cases.Close()

	count := 0
	rows := bufio.NewScanner(cases)
	for rows.Scan() {
		line := strings.TrimSpace(rows.Text())
		if line == "" || strings.HasPrefix(line, "#") {
			continue
		}
		fields := strings.Fields(line)
		if len(fields) != 3 {
			t.Fatalf("invalid endpoint row %q", line)
		}
		count++
		t.Run(fields[0], func(t *testing.T) {
			value, err := strconv.ParseFloat(fields[1], 32)
			if err != nil {
				t.Fatal(err)
			}
			writer := serialize.NewWriteStream(make([]byte, 8))
			input := RatioEndpoint{Ratio: float32(value)}
			if err := WriteRatioEndpoint(writer, &input); err != nil {
				t.Fatal(err)
			}
			if got := writer.BitsProcessed(); got != 7 {
				t.Fatalf("wrote %d bits, want 7", got)
			}
			writer.Flush()
			if got := hex.EncodeToString(writer.Data()); got != fields[2] {
				t.Fatalf("wire = %s, want %s", got, fields[2])
			}
			var output RatioEndpoint
			if err := ReadRatioEndpoint(serialize.NewReadStream(writer.Data()), &output); err != nil {
				t.Fatal(err)
			}
			if output.Ratio != input.Ratio {
				t.Fatalf("decoded ratio = %v, want %v", output.Ratio, input.Ratio)
			}
		})
	}
	if err := rows.Err(); err != nil {
		t.Fatal(err)
	}
	if count != 2 {
		t.Fatalf("ran %d ratio endpoints, want 2", count)
	}
}
