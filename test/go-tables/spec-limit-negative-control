#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname "$0")/../.." && pwd)
mkdir -p "$root/build"
tmp=$(mktemp -d "$root/build/schema-go-spec-limit-plant.XXXXXX")
trap 'rm -rf "$tmp"' EXIT HUP INT TERM
cat > "$tmp/planted_test.go" <<'GO'
package schematables

import "testing"

func TestSchemaSpecLimitGatePlant(t *testing.T) {
	t.Parallel()
	t.Fatal("schema spec-limit gate plant reached")
}
GO
printf '{"Replace":{"%s":"%s"}}\n' \
	"$root/test/go-tables/zz_schema_spec_limit_plant_test.go" \
	"$tmp/planted_test.go" > "$tmp/overlay.json"
log="$tmp/test.log"
rc=0
(cd "$root/test/go-tables" && GOFLAGS=-mod=readonly NOVA_TEST_NO_HOST=1 \
	go test -overlay "$tmp/overlay.json" -run '^TestSchemaSpecLimitGatePlant$' \
		-count=1 -timeout 600s .) > "$log" 2>&1 || rc=$?
if [ "$rc" -eq 0 ]; then
	cat "$log"
	echo "schema-go-spec-limits: planted test was not run; the nested module gate is not watching its package" >&2
	exit 1
fi
if ! grep -F 'schema spec-limit gate plant reached' "$log" >/dev/null; then
	cat "$log"
	echo "schema-go-spec-limits: planted test failed for a reason other than reaching the expected test" >&2
	exit 1
fi
echo "schema-go-spec-limits: nested test module ran the planted failure and returned red"
