<Project Sdk="Microsoft.NET.Sdk">

  <!-- The C# BLOCK FORM conformance test (SPEC-TABLES.md §19, §19.5): the
       CONSUMER half of the two-language gate. A C++ producer wrote a block and
       pinned its bytes into testdata/wire/tables/block_render.bin; this program
       points at those very bytes and reads every field of every row, twice —
       through the generated blittable struct, and through the block
       descriptors — because §19.2 offers both and both must land the same
       values.

       It is its own project rather than a slice of test/cs-tables because it
       needs AllowUnsafeBlocks: a block is memory another language wrote, and
       pointing at it without a copy is the whole point (§12.1).

       No test framework, exit code = verdict (the family rule), and
       TreatWarningsAsErrors is the refuser for the generated source. Sources
       come from build/, generated by the Makefile — they are test-only and
       never part of the committed generated/ tree. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>annotations</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>schemablocktest</AssemblyName>
    <!-- Overridable so the Makefile's padding NEGATIVE CONTROL can point this
         leg at a sabotaged copy of the generated sources and require it to go
         red (SPEC-TABLES.md §19.5's negative-control rule). -->
    <BlockGeneratedDir Condition="'$(BlockGeneratedDir)' == ''">../../build/tables-generated-cs/block</BlockGeneratedDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src/*.cs" />
    <Compile Include="$(BlockGeneratedDir)/*.cs" />
    <Compile Include="../../../serialize.cs/src/Serialize.cs" />
    <Compile Include="../../../serialize.cs/src/Int128Pair.cs" />
  </ItemGroup>

</Project>
