<Project Sdk="Microsoft.NET.Sdk">

  <!-- The C# BLOCK FORM conformance test (docs/SPEC-TABLES.md §19, §19.5): the
       CONSUMER half of the two-language gate. A C++ producer wrote a block and
       pinned its bytes into testdata/wire/tables/block_render.bin; this program
       points at those very bytes and reads every field of every row, twice —
       through the generated blittable struct, and through the block
       descriptors — because §19.2 offers both and both must land the same
       values.

       It is its own project rather than a slice of test/cs-tables because it
       needs AllowUnsafeBlocks: a block is memory another language wrote, and
       pointing at it without a copy is the whole point (§12.1).

       No test framework, exit code = verdict (the family rule), and
       TreatWarningsAsErrors is the refuser for the generated source. Sources
       come from build/, generated by the Makefile — they are test-only and
       never part of the committed generated/ tree. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>annotations</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>schemablocktest</AssemblyName>
    <!-- Overridable so the Makefile's padding NEGATIVE CONTROL can point this
         leg at a sabotaged copy of the generated sources and require it to go
         red (docs/SPEC-TABLES.md §19.5's negative-control rule). -->
    <BlockGeneratedDir Condition="'$(BlockGeneratedDir)' == ''">../../build/tables-generated-cs/block</BlockGeneratedDir>
    <BlockHomeGeneratedDir Condition="'$(BlockHomeGeneratedDir)' == ''">../../build/tables-generated-cs/blockhome</BlockHomeGeneratedDir>
    <!-- and the examples unit's, so `make tables-cs-block-compile` can build
         this project over a tree it generated for itself -->
    <BlockExamplesGeneratedDir Condition="'$(BlockExamplesGeneratedDir)' == ''">../../build/tables-generated-cs/examples</BlockExamplesGeneratedDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src/*.cs" />
    <Compile Include="$(BlockGeneratedDir)/*.cs" />
    <!-- The BLOCK HOME unit (tables/blockhome): its protocol-id home declares
         no table, one of its files declares only `type`s, and no file is named
         for the package — so its runtime home, BlockhomeBlock.cs, is emitted
         for the UNIT (docs/SPEC-TABLES.md §19.2). Compiling it here IS the gate — a
         backend that left the shared runtime without a file, or put a blittable
         record in its declaring file, emits a unit that does not compile at
         all, and this project is where that is caught. -->
    <Compile Include="$(BlockHomeGeneratedDir)/*.cs" />
    <!-- EVERY corpus unit the C# backend emits a block form for, so §19.3's
         layout contract is a GENERATION-TIME gate and not only a throw the
         first time somebody opens a block. Compiling is half of it — a
         projected array where an inline one belongs does not compile the same
         — and src/LayoutGate.cs runs each unit's Verify() for the other half.

         And with NO TABLE SOURCE: the block and cook pair builds without
         <Base>Table.cs (docs/SPEC-TABLES.md §19.2, §7), so the files that
         need the table storage classes stay out — the table sources, the
         unit's View and Region, and <Package>BlockFill.cs, the Begin
         overloads that take a managed value. A pair that names a table
         symbol fails here; `make tables-cs-block-compile` runs this build on
         every pull request that touches the C# generator. -->
    <Compile Include="$(BlockExamplesGeneratedDir)/*.cs" Exclude="$(BlockExamplesGeneratedDir)/*Table.cs;$(BlockExamplesGeneratedDir)/*View.cs;$(BlockExamplesGeneratedDir)/*Region.cs;$(BlockExamplesGeneratedDir)/*BlockFill.cs" />
    <Compile Include="../../../serialize.cs/src/Serialize.cs" />
    <Compile Include="../../../serialize.cs/src/Int128Pair.cs" />
  </ItemGroup>

</Project>
