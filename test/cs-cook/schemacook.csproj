<Project Sdk="Microsoft.NET.Sdk">

  <!-- THE COOKED FORM's C# READ SIDE, under test (SPEC-TABLES.md §7, §7.5).

       `schema cook` writes the file and the generated <Root>Cook.Open points at
       it, and the two were written from the page independently: the tool in Go,
       this side in C#, neither reading the other. That is what makes the golden
       and dump modes CROSS-IMPLEMENTATION gates rather than one implementation
       agreeing with itself.

       It is its own project rather than a slice of test/cs-block because it
       opens a POINTERED unit, whose C# WIRE surface is refused by name (§11)
       and whose two accelerators are emitted all the same — so this project
       compiles the cook and block sources of tables/pointers and nothing else
       of that unit. Compiling it IS half the gate: a backend that emitted a
       blittable record in a file with no Cook source, or the shared runtime
       twice, produces a unit that does not compile at all.

       No test framework, exit code = verdict (the family rule), and
       TreatWarningsAsErrors is the refuser for the generated source. Sources
       come from build/, generated by the Makefile. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>annotations</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>schemacooktest</AssemblyName>
    <!-- Overridable so the Makefile's NEGATIVE CONTROLS can point this leg at a
         sabotaged copy of the generated sources and require it to go red
         (SPEC-TABLES.md §7.5's negative-control rule). -->
    <CookGeneratedDir Condition="'$(CookGeneratedDir)' == ''">../../build/tables-generated-cs/pointers</CookGeneratedDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src/*.cs" />
    <Compile Include="$(CookGeneratedDir)/*Cook.cs" />
    <Compile Include="$(CookGeneratedDir)/*Block.cs" />
  </ItemGroup>

</Project>
