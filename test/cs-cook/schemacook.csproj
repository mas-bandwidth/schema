<Project Sdk="Microsoft.NET.Sdk">

  <!-- THE COOKED FORM's C# READ SIDE, under test (docs/SPEC-TABLES.md §7, §7.5).

       `schema cook` writes the file and the generated <Root>Cook.Open points at
       it, and the two were written from the page independently: the tool in Go,
       this side in C#, neither reading the other. That is what makes the golden
       and dump modes CROSS-IMPLEMENTATION gates rather than one implementation
       agreeing with itself.

       It is its own project because it opens the pointered tables/pointers
       unit. Compile that unit together so the Block.Begin overloads can use
       the managed table classes and their packet type and enum declarations.

       No test framework, exit code = verdict (the family rule), and
       TreatWarningsAsErrors is the refuser for the generated source. Sources
       come from build/, generated by the Makefile. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>annotations</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>schemacooktest</AssemblyName>
    <!-- Overridable so the Makefile's NEGATIVE CONTROLS can point this leg at a
         sabotaged copy of the generated sources and require it to go red
         (docs/SPEC-TABLES.md §7.5's negative-control rule). -->
    <CookGeneratedDir Condition="'$(CookGeneratedDir)' == ''">../../build/tables-generated-cs/pointers</CookGeneratedDir>
    <SerializeCsDir Condition="'$(SerializeCsDir)' == ''">../../../serialize.cs</SerializeCsDir>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src/*.cs" />
    <Compile Include="$(CookGeneratedDir)/*.cs" />
    <Compile Include="$(SerializeCsDir)/src/Serialize.cs" />
    <Compile Include="$(SerializeCsDir)/src/Int128Pair.cs" />
  </ItemGroup>

</Project>
