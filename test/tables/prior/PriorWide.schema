// PriorWide.schema — the WRITER's half of the PRIOR-WRITER pair
// (docs/SPEC-TABLES.md §3.3, §4; testdata/conformance/tables/FORMAT.md,
// `message-prior`). PriorWide is an earlier release and PriorNarrow is
// today's: every ranged value of Prior is declared twice as wide by the writer
// as by the reader, one field per shape a ranged value takes in a message.
// A value the writer may lawfully send and the reader's declaration does not
// hold refuses the read `out_of_range`; no reader clamps it. Three fields
// change KIND instead: the writer's int32 is the reader's int16 (`narrowed`)
// and string(16) (`retyped`), which refuse `kind_mismatch`, and its int64
// (`widened`), the lawful widening, which reads. R14 adds two more that
// refuse, the writer's int64 as the reader's string(16) (`restring`) and as
// its timestamp (`stamp`), each beside a lawful twin of the same type
// (`kept64`, `stamped`). R15 adds `band`, uint8 200..250 to the writer and
// 200..240 to the reader: the writer's announcement is lawful though its top
// offsets pass 255, and each value is held on the body. R17 adds `perms`: the
// writer's Perms has a third flag, Exec, that the reader's does not, and a body
// with that bit set refuses `out_of_range`. The two files differ
// in these declarations and nothing else, which
// TestMessagePriorWriterIsRangesApart holds.
package tblprior

enum Axis { X, Y }

flags Perms { Read, Write, Exec }

type Inner
{
    level int32 | min = 0, max = 100
}

fixed table Cell
{
    depth int32 | min = 0, max = 100
}

union Arm
{
    idle
    amount int32 | min = 0, max = 100
    inner  Inner
}

fixed table Prior
{
    keep   uint32
    scalar int32      | min = 0, max = 100
    small  uint8      | min = 0, max = 100
    wide   int64      | min = 0, max = 100
    mask   bits(7)
    pair   [2]int32   | min = 0, max = 100
    list   [..4]int32 | min = 0, max = 100
    keyed  [Axis]int32 | min = 0, max = 100
    arm    Arm
    nested Inner
    cells  [2]Cell
    quant  float32    | min = 0, max = 100, resolution = 0.5
    fx     ufixed(16, 16) | min = 0, max = 100
    narrowed int32
    retyped  int32
    widened  int32
    restring int64
    kept64   int64
    stamp    int64
    stamped  timestamp
    band     uint8 = 200 | min = 200, max = 250
    perms    Perms
}
