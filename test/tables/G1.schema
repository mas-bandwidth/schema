// G1.schema — A FIELD THE WRITER DOES NOT WRITE IS NOT AN EDGE
// (docs/SPEC-TABLES.md §3.1, schema#440, schema#526). A pointer under a false
// guard, or inside an absent optional, is not visited by the numbering: its
// target takes no index, so a save never writes a record no written field
// names, and the region `Lock` lays out holds no such node either — it is the
// same walk.
//
// The GUARD is here beside a pointer that always rides, so a value with both
// slots filled writes ONE record when the guard is false and two when it is
// true. The OPTIONAL half is the same shape one field over: `Wrapped` holds a
// pointer and is variable-length, `optional ?Wrapped` stores its presence
// companion beside it, and the numbering, the pack measure and the pack gate
// on that companion — an absent optional's table is not descended, so setting
// a pointer inside it costs no record.
package tblg1

fixed table Node
{
    value int32
}

table Wrapped
{
    node *Node
}

table Guarded
{
    at_rest bool
    always  *Node
    if at_rest
    {
        resting *Node
    }
    optional ?Wrapped
}
