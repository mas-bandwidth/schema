package cscollections2

table Row
{
    values []uint64 | min = 0, max = 0
    past uint8 | was = "after"
}

fixed table WideNode { value uint128 }
table WideRoot
{
    nodes []*WideNode
    values []uint128
}

table CycleNode
{
    id     int32 = 7
    active bool
    next   *CycleNode
    if active
    {
        guarded *CycleNode
    }
    links  []*CycleNode
    edges  map[int32]*CycleNode
}
