// FH1.schema — TWO GAPS OF ISSUE #876 IN ONE SMALL SCHEMA
// (docs/FIXED-FORM-ALGORITHM.md §4.6, §4.1).
//
//   C11  an enum with `| max = K` HEADROOM. An ordinal above the last NAMED
//        variant and within the declared max is IN THE SET and stands: a reader
//        that derives the ceiling from the last name turns every headroom value
//        into None and counts a clamp, which is data loss that reads as
//        legitimate. Past the max it does land None, and counts.
//
//   W16  A UNION INSIDE A UNION. A union's guard is stamped over everything its
//        arm produced, so an arm inside an arm answers to the OUTER tag — and a
//        record whose outer tag selects the other arm must not run ONE of the
//        inner arm's entries: the other arm reads back whole, and storage no
//        entry of that read owns is left exactly as the caller handed it in,
//        since the identity plan prefills nothing (§4.3). FU1/FU2 are the C
//        leg's pair and are not this shape.
package tblfh1

enum Tier
{
    Bronze
    Silver
}

type Leaf
{
    n int32 = 0
}

type Other
{
    k int32 = 0
}

union Inner
{
    leaf  Leaf
    other Other
}

type OuterA
{
    inner Inner
    edge  int32 = 0
}

type OuterB
{
    m int32 = 0
}

union Outer
{
    a OuterA
    b OuterB
}

fixed table FhRoot
{
    tier Tier
    head int32 = 1
    pick Outer
}
