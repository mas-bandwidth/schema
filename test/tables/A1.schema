// A1.schema — the WRITER of the ARM-RETYPE pair (docs/SPEC-TABLES.md §2.6,
// §3, §4.1). A2 declares the same arms under the same names — arms ride under
// their name hash (§5) — at different types, so one saved value read by the
// other names each of the reader's answers exactly once: a width moved up the
// signed ladder is WIDENED and decodes exactly (§4), and every other retype
// is a kind mismatch, the union reading None and the siblings intact (§3).
package tbla1

type Body
{
    n uint32
}

union Value
{
    a int32
    b int32
    c int32
    d float32
    e Body
    f
}

table Root
{
    id    uint32
    value Value
    tail  uint32
}
