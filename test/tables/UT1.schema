// UT1.schema — A TEXT FIELD UNDER A UNION'S ARM (docs/SPEC-TABLES.md §3.4).
//
// A plan entry carries TWO facts that are not the same fact: the ordinal the
// guard byte must hold for the entry to run, and the argument the entry's own
// op takes — for a text entry, its flavour. They had ONE lane between them, so
// a `string(N)` under a union's arm could be guarded correctly or read with the
// right flavour and could not be both. This pair is what says so by test.
//
// The string sits under the SECOND arm. UT2's copy of it sits under the THIRD,
// and 3 is the bytes flavour, so there a shared lane reads a string as bytes
// and never terminates it: that is where the negative control watches it.
//
// UT2 inserts an arm IN THE MIDDLE, which moves the same string from arm 2 to
// arm 3 and makes the read a COMPILED plan: the guard must then hold THEIR
// ordinal while the tag lands MY ordinal, which is the other half of the same
// confusion.
package tblut1

type ArmA
{
    n int32 = 7
}

type ArmB
{
    label string(8) = "b"
    m     int32 = 9
}

union Pick
{
    a ArmA
    b ArmB
}

fixed table UtRoot
{
    head int32 = 1
    pick Pick
    tail int32 = 3
}
