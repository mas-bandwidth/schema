// VNEW_kind_moved.schema — NEW: v float32, a kind off every ladder
//
// One of the fixed form's versioning rows (docs/FIXED-FORM-VERSIONING-TESTS.md).
// The OLD and the NEW file of this pair differ by EXACTLY the row named above.
// Both kinds are four bytes wide, so a leg that REINTERPRETS the writer's bits
// lands a wrong float and a leg that COUNTS the pair and reads on lands the
// default: the row tells both failures apart from the one right answer.
//
// THIS PAIR IS DELIBERATELY UNLAWFUL: SPEC §5.1 refuses `int32` into `float32`
// ("ladder"), so this NEW side is generated and never dumped. The NEW build
// refuses old_kind_moved.bin `layout_malformed` and writes nothing
// (docs/FIXED-FORM-ALGORITHM.md §5.4, §5.9 #30). Do not "fix" it.

package vnew_kind_moved

fixed table KindMoved
{
    lead  uint32 = 1
    v     float32 = 0
    trail uint32 = 2
}
