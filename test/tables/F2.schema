// F2.schema — F1's root one generation on, every float32 respelled float64
// (docs/SPEC-TABLES.md §4). `f32` into `f64` is the float rung of the WIDENED
// ladder and the only one; every finite float32 widens exactly through the
// ordinary conversion, and a NaN or an infinity is refused on the float32's
// raw bits before it (§3.3) — the pin at testdata/wire/tables/floats_nan.bin
// is refused through this rung too.
package tblf2

fixed table Floats
{
    signalling float64
    payload    float64
    negative   float64
    quiet      float64
    wide       float64
    samples    [3]float32
    past      int32 | was = "after"
}
