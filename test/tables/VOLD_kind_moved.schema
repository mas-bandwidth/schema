// VOLD_kind_moved.schema — OLD: v int32
//
// One of the fixed form's versioning rows (docs/FIXED-FORM-VERSIONING-TESTS.md).
// The OLD and the NEW file of this pair differ by EXACTLY the row named above,
// so a leg can say which change the read answered for. `lead` and `trail`
// bracket the row's field: a mislaid field moves a neighbour, and the equality
// check sees it.
//
// THIS PAIR IS DELIBERATELY UNLAWFUL: SPEC §5.1 refuses `int32` into `float32`
// ("ladder"), so the lineage entry is handed in by the probe and never read
// from a lock. The NEW reader must refuse the file `layout_malformed` and write
// nothing (docs/FIXED-FORM-ALGORITHM.md §5.4, §5.9 #30). Do not "fix" it.

package vold_kind_moved

fixed table KindMoved
{
    lead  uint32 = 1
    v     int32 = 0
    trail uint32 = 2
}
