// VOLD_range_widen_array.schema — OLD: [4]int32 | 0..100
//
// One of the fixed form's versioning rows (docs/FIXED-FORM-VERSIONING-TESTS.md).
// The OLD and the NEW file of this pair differ by EXACTLY the row named above,
// so a case in test/tables/fixedform_dump.cpp can say which change the read
// answered for. `lead` and `trail` bracket the row's field: a mislaid size
// moves a neighbor, and the equality check sees it.

package vold_range_widen_array

fixed table RangeWidenArray
{
    lead  uint32 = 1
    vals  [4]int32 | min = 0, max = 100
    trail uint32 = 2
}
