// F1.schema — THE FINITE RULE'S PIN (docs/SPEC-TABLES.md §3.3): the corpus root
// testdata/wire/tables/floats_nan.bin was written from under the old
// bit-pattern rule (schema#480), carrying a SIGNALLING NaN and a NaN with a
// nonzero payload at both widths and as array elements. Floats are finite only
// now (2026-10-27): no writer writes those values and every read refuses the
// file as non_finite_float, so the file is frozen as the shared MUST-REFUSE
// vector, and test/tables/floatnan_main.cpp holds every C++ form to it.
//
// F2.schema is the same root one generation on, every float32 respelled
// float64: the WIDENED rung (§4), where the test runs on the float32's bits
// before the ordinary conversion.
package tblf1

fixed table Floats
{
    signalling float32 // 0x7F800001: the quiet bit CLEAR, the smallest payload
    payload    float32 // 0x7FC0DEAD: quiet, and a mantissa well past the quiet bit
    negative   float32 // 0xFFA5A5A5: the sign set, signalling, a rich payload
    quiet      float64 // 0x7FF8000000000000: the canonical double NaN
    wide       float64 // 0x7FF00DEFACED0001: signalling at sixty-four bits
    samples    [3]float32
    past      int32 | was = "after"
}
