package ebcontroltypeheld

// schema#606's CASE (docs/SPEC-TABLES.md §2.4): a `type` a table reaches keeps
// the positional spelling: the wire, not the body, closes the class, because
// an enum-extent array rides KEYED on the table wire wherever it is declared.
// This refusal stops at the table body and the union arm; the reached `type`'s
// kind-13 body keys the array rather than refusing it. A control that goes red
// says either the walk started refusing the type or the table wire stopped
// keying there.

enum ShipType { Fighter, Bomber, Scout }

const SlotCount = ShipType.Max

type Inner
{
    direct [ShipType.Max]int32
    named  [SlotCount]int32
}

fixed table Root
{
    inner Inner
}
