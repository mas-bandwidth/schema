// V2.schema — the NEW side of the evolution test: relative to V1, `a`
// changed kind (int32 -> float32), `c` was added, `b` was removed, `name`
// was renamed to `title` (was = "name" keeps the wire id), Inner gained a
// field, Grade gained Silver BETWEEN Bronze and Gold, and Effect gained a
// hex arm BETWEEN boost and ward. Any reader x any data, both directions
// (SPEC-TABLES.md).
package tblv2

const MaxSlots = 3

enum Mode { Alpha, Beta }

enum Grade { Bronze, Silver, Gold }

// Gamma REMOVED, Omega INSERTED in the middle, Sigma appended: Alpha holds
// ordinal 1, Beta slides from 2 to 3, Delta keeps 4, and Sigma is a slot V1
// has no name for at all.
enum Slot { Alpha, Omega, Beta, Delta, Sigma }

type Inner
{
    factor float32 = 2.5
    gain   float32 = 1.0
}

type Boost
{
    power int32 = 0
}

type Hex
{
    level int32 = 0
}

type Ward
{
    charge float32 = 0.0
}

union Effect
{
    boost Boost
    hex   Hex
    ward  Ward
}

table Cell
{
    power int32 = 0 | min = 0, max = 1000
    label string(8)
}

table Cfg
{
    a      float32 = 5.0
    c      bool = true
    mode   Mode = Beta
    title  string(32)           | was = "name"
    inner  Inner
    items  [..8]int32           | min = 0, max = 255
    grade  Grade
    grades [..4]Grade
    podium [3]Grade
    slots  [..MaxSlots]int32
    tally  [Grade.Max + 1]int32
    effect Effect
    bank   [Slot]Cell
    tokens [Slot]int32
    ranks  [Slot]Grade
    extra  ?Inner
    tier   ?int32
    mark   ?Grade
}
