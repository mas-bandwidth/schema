// V1.schema — the OLD side of the both-directions evolution test
// (SPEC-TABLES.md): V2 adds c, removes b, changes a's kind, renames name to
// title (with was), grows Inner, and inserts a variant IN THE MIDDLE of both
// Grade and Effect. Distinct packages so both generations compile into ONE
// test binary; the wire does not care — table identity is the field-name
// hash, and variant identity is the variant-name hash, not the package, not
// the ordinal and not the protocol id.
package tblv1

// a bounded array's BOUND is not wire identity: V2 shrinks MaxSlots from 6
// to 3, and tally is sized off Grade.Max + 1, which grows when Grade does.
// Both directions still load (SPEC-TABLES.md §4).
const MaxSlots = 6

enum Mode { Alpha, Beta }

// Grade gains Silver in the MIDDLE in V2: under ordinals Gold would slide
// from 2 to 3 and every stored Gold would read back as Silver. It rides as
// the hash of "Gold", so it does not (SPEC-TABLES.md §5).
enum Grade { Bronze, Gold }

// Slot keys the enum-keyed arrays below, and it takes BOTH edits in V2:
// Gamma is removed and Omega is inserted in the middle, so Beta slides from
// ordinal 2 to 3 and Sigma appears past this generation's last slot. Under a
// positional encoding every stored Beta would read back as Omega.
enum Slot { Alpha, Beta, Gamma, Delta }

type Inner
{
    factor float32 = 2.5
}

type Boost
{
    power int32 = 0
}

type Ward
{
    charge float32 = 0.0
}

// Effect gains a hex arm in the MIDDLE in V2, the union twin of Grade's case.
union Effect
{
    boost Boost
    ward  Ward
}

// the element of the enum-keyed array of tables
table Cell
{
    power int32 = 0 | min = 0, max = 1000
    label string(8)
}

table Cfg
{
    a      int32 = 5            | min = 0, max = 1000
    b      float32 = 1.5
    mode   Mode = Beta
    name   string(32)
    inner  Inner
    items  [..8]int32           | min = 0, max = 255
    grade  Grade
    grades [..4]Grade
    podium [3]Grade
    slots  [..MaxSlots]int32
    tally  [Grade.Max + 1]int32
    effect Effect
    bank   [Slot]Cell
    tokens [Slot]int32
    ranks  [Slot]Grade
    extra  ?Inner
    tier   ?int32
    mark   ?Grade
}
