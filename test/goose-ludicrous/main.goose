// The Goose cross-language wire test for the fixed-point + 128-bit unit
// (examples128/): the generated Goose module writes the SAME pinned instances
// test/ludicrous_main.cpp pins in testdata/wire/ludicrous_state*.bin,
// degenerate_probe.bin and unsigned_probe.bin and byte-compares against them
// — cross-language wire identity for fixed(I, F), ufixed(I, F), int128 and
// uint128 (SPEC §7.2) — plus round trips, the §5 branch zeroing over a
// 128-bit field, the specified defaults (one no int64 literal can spell) and
// the hostile reads, which REJECT and never clamp (STANDARD.md).
// It is test/go-ludicrous/main.go block for block, in Goose.
import os;
import .Ludicrous;
import .serialize;

var failed = 0;

fn check(ok: bool, what: const u8[:]) {
    if !ok {
        print("FAILED: ", what);
        failed += 1;
    }
}

fn ok(refusal: i32, what: const u8[:]) {
    if refusal != SERIALIZE_ERROR_NONE {
        print("FAILED: ", what, ": ", serialize_refusal_name(refusal));
        failed += 1;
    }
}

var wbuf: u8[256] = [0; 256];
var wlen: i64 = 0;
var rbuf: u8[264] = [0; 264];
var image: u8[256] = [0; 256];
var imageLen: i64 = 0;

fn fresh() -> WriteStream {
    for i in 256 { wbuf[i] = 0; }
    wlen = 0;
    return serialize_write_stream_init(wbuf);
}

fn done(w: WriteStream&) {
    serialize_flush(w);
    wlen = serialize_bytes_processed(w);
    for i in wlen { image[i] = wbuf[i]; }
    imageLen = wlen;
}

fn readImage() -> ReadStream {
    return serialize_read_stream_init_padded(rbuf, image[0..imageLen]);
}

fn golden(name: const u8[:]) {
    var want: u8[>..] = [];
    if !read_file(str(name, ".bin"), want) {
        check(false, str("read wire golden ", name));
        return;
    }
    var same = want.len == wlen;
    if same {
        for i in wlen {
            if wbuf[i] != want[i] { same = false; }
        }
    }
    check(same, str("wire golden ", name, " — Goose bytes must equal the C++-pinned bytes"));
}

// setBits forces bits [pos, pos + n) of the image to 1: smuggling an offset
// into the range's bit headroom, which a read must REJECT, never clamp.
fn setBits(pos: i64, n: i64) {
    for i in pos..pos + n { image[i / 8] = image[i / 8] | ((1 as u8) << ((i % 8) as! u8)); }
}

fn wide(lo: u64, hi: u64) -> schema_rt::Int128 { return schema_rt::Int128 { lo: lo, hi: hi }; }

// makeState is test/ludicrous_main.cpp's make_state.
fn makeState() -> ludicrous::LudicrousState {
    var v = ludicrous::NewLudicrousState();
    v.Mode = ludicrous::DriveModeLudicrous;
    v.Probe.Angle = 2981888;            // +45.5 * 2^16
    v.Probe.Position = -809119744;      // -12346.1875 * 2^16
    v.Probe.Reach = wide(65536000000 - 1, 0); // raw_max - 1
    v.Probe.Ticks = 777777;
    v.Probe.Samples[0] = -524288;       // raw_min
    v.Probe.Samples[1] = 524288;        // raw_max
    v.Wide.EntityId = wide(0xFEDCBA9876543210, 0x0123456789ABCDEF);
    v.Wide.Energy = wide(4999999999, 0);
    v.Wide.Flux = wide(7, 0x800000000); // 2^99 + 7
    // wide.bias and wide.seed stay at their SPECIFIED DEFAULTS (-250, 2^65)
    v.KeysCount = 2;
    v.Keys[0] = wide(1, 0);
    v.Keys[1] = wide(0, 0x8000000000000000); // 1 << 127
    v.HasTarget = true;
    v.TargetId = wide(42, 0);
    return v;
}

fn main() {
    // worst-case bounds, hand-derived (SPEC §6.1 item 4)
    check(ludicrous::FixedProbeMaxBits == 156, "FixedProbe worst case");
    check(ludicrous::WideProbeMaxBits == 403, "WideProbe worst case");
    check(ludicrous::LudicrousStateMaxBits == 1205, "LudicrousState worst case");
    check(ludicrous::ProtocolId != 0, "the unit has a protocol id");

    // specified defaults (SPEC §4.2): a fresh state starts at DriveMode None,
    // and the two defaulted 128-bit fields carry their declared values
    {
        let zero = ludicrous::NewLudicrousState();
        check(zero.Mode == ludicrous::DriveModeNone, "a fresh state starts at DriveMode None");
        check(zero.Probe.Reach == wide(0, 0), "reach starts zero");
        check(zero.Wide.EntityId == wide(0, 0), "entity_id starts zero");
        check(zero.Wide.Bias == wide(0xffffffffffffff06, 0xffffffffffffffff), "bias defaults -250");
        check(zero.Wide.Seed == wide(0, 2), "seed defaults 2^65");
        check(zero.KeysCount == 0, "keys start empty");
        check(zero.TargetId == wide(0, 0), "target_id starts zero");
        var z = ludicrous::NewLudicrousState();
        ludicrous::ZeroLudicrousState(z);
        check(z.Wide.Bias == wide(0, 0), "the zero form is zero, not the defaults (SPEC §5)");
    }

    // ---- the taken-branch wire: generated bytes == the C++-pinned golden ----
    var taken: u8[256] = [0; 256];
    var takenLen: i64 = 0;
    {
        let v = makeState();
        var w = fresh();
        ok(ludicrous::WriteLudicrousState(w, v), "write LudicrousState");
        done(w);
        golden("ludicrous_state");
        for i in wlen { taken[i] = wbuf[i]; }
        takenLen = wlen;
        var out = ludicrous::LudicrousState { .. };
        var r = readImage();
        check(ludicrous::ReadLudicrousState(r, out), "read LudicrousState");
        check(out.Mode == ludicrous::DriveModeLudicrous, "mode round-trips");
        check(out.Probe == v.Probe, "the fixed probe round-trips");
        check(out.Wide.EntityId == v.Wide.EntityId, "entity_id round-trips");
        check(out.Wide.Energy == v.Wide.Energy, "energy round-trips");
        check(out.Wide.Flux == v.Wide.Flux, "flux round-trips");
        check(out.Wide.Bias == wide(0xffffffffffffff06, 0xffffffffffffffff), "the bias default rides the wire");
        check(out.Wide.Seed == wide(0, 2), "the seed default rides the wire");
        check(out.KeysCount == 2 && out.Keys[0] == v.Keys[0] && out.Keys[1] == v.Keys[1], "keys round-trip");
        check(out.HasTarget && out.TargetId == wide(42, 0), "the taken branch round-trips");
    }

    // ---- the untaken branch: the 128-bit field under it reads back ZERO
    // into a dirty object (SPEC §5) ----
    {
        var v = makeState();
        v.HasTarget = false;
        var w = fresh();
        ok(ludicrous::WriteLudicrousState(w, v), "write LudicrousState untargeted");
        done(w);
        golden("ludicrous_state_untargeted");
        var out = ludicrous::LudicrousState { .. };
        out.TargetId = wide(0xDEAD, 0); // dirty: the read must zero it
        var r = readImage();
        check(ludicrous::ReadLudicrousState(r, out), "read LudicrousState untargeted");
        check(!out.HasTarget, "has_target reads false");
        check(out.TargetId == wide(0, 0), "the untaken 128-bit field reads as zero (SPEC §5)");
    }

    // ---- hostile reads REJECT, never clamp (STANDARD.md, SPEC §5) ----
    {
        // fixed: angle's 25 offset bits start at bit 2; all-ones is above
        // the raw range 360 * 2^16
        for i in takenLen { image[i] = taken[i]; }
        imageLen = takenLen;
        setBits(2, 25);
        var out = ludicrous::LudicrousState { .. };
        var r = readImage();
        check(!ludicrous::ReadLudicrousState(r, out), "a smuggled fixed offset is REJECTED");
        check(serialize_error(r) == SERIALIZE_ERROR_VALUE_OUT_OF_RANGE, "the fixed refusal latches value_out_of_range");
    }
    {
        // int128: energy's 34 offset bits start at bit 286 (2 + 156 + 128)
        for i in takenLen { image[i] = taken[i]; }
        imageLen = takenLen;
        setBits(286, 34);
        var out = ludicrous::LudicrousState { .. };
        var r = readImage();
        check(!ludicrous::ReadLudicrousState(r, out), "a smuggled int128 offset is REJECTED");
    }
    {
        // truncation: running out of input mid-read is a read failure
        for i in 4 { image[i] = taken[i]; }
        imageLen = 4;
        var out = ludicrous::LudicrousState { .. };
        var r = readImage();
        check(!ludicrous::ReadLudicrousState(r, out), "a truncated stream is a read failure");
        check(serialize_error(r) == SERIALIZE_ERROR_PAST_END, "truncation latches past_end");
    }

    // ---- DegenerateProbe: min == max costs ZERO bits (SPEC §4.6) ----
    {
        check(ludicrous::DegenerateProbeMaxBits == 8, "three degenerate fields cost zero bits");
        var v = ludicrous::DegenerateProbe { .. };
        v.LockedFixed = -196608; // -3 * 2^16, the ONE legal raw
        v.LockedInt = 7;
        v.LockedWide = wide(0xfffff4c58c31d00e, 0xffffffffffffffff); // -12345678901234
        v.Tail = 0xA5;
        var w = fresh();
        ok(ludicrous::WriteDegenerateProbe(w, v), "write DegenerateProbe");
        done(w);
        golden("degenerate_probe");
        var out = ludicrous::DegenerateProbe { .. };
        ludicrous::ZeroDegenerateProbe(out);
        var r = readImage();
        check(ludicrous::ReadDegenerateProbe(r, out), "read DegenerateProbe");
        check(out == v, "DegenerateProbe round-trips — every value materialized from its range");
        var bad = v;
        bad.LockedInt = 8;
        var w2 = fresh();
        check(ludicrous::WriteDegenerateProbe(w2, bad) == SERIALIZE_ERROR_VALUE_OUT_OF_RANGE, "a wrong degenerate int is REFUSED on write");
    }

    // ---- UnsignedProbe: ufixed(I, F), span's raw value in uint64's HIGH HALF ----
    {
        check(ludicrous::UnsignedProbeMaxBits == 196, "UnsignedProbe worst case");
        var v = ludicrous::UnsignedProbe { .. };
        v.Angle = 2981888;            // +45.5 * 2^16
        v.Span = 0xFFFFFFFFFFFF0000;  // raw_max, the uint64 HIGH HALF
        v.Reach = wide(131071999999, 0); // raw_max - 1
        v.Ticks = 777777;
        v.Samples[0] = 0;             // raw_min
        v.Samples[1] = 1048576;       // raw_max
        v.Locked = 196608;            // 3 * 2^16, the ONE legal raw
        v.Tail = 0xA5;
        var w = fresh();
        ok(ludicrous::WriteUnsignedProbe(w, v), "write UnsignedProbe");
        done(w);
        golden("unsigned_probe");
        var out = ludicrous::UnsignedProbe { .. };
        var r = readImage();
        check(ludicrous::ReadUnsignedProbe(r, out), "read UnsignedProbe");
        check(out == v, "UnsignedProbe round-trips — the uint64 high half bit-exact");

        // the write-side degenerate refusal: any raw but 3 * 2^16
        var bad = v;
        bad.Locked = 196609;
        var w2 = fresh();
        check(ludicrous::WriteUnsignedProbe(w2, bad) == SERIALIZE_ERROR_VALUE_OUT_OF_RANGE, "a wrong degenerate ufixed raw is REFUSED on write");

        // hostile: span's 64 offset bits (from bit 25) all-ones = 2^64 - 1,
        // above the raw range; the reject fires in the UNSIGNED domain
        var w3 = fresh();
        ok(ludicrous::WriteUnsignedProbe(w3, v), "rewrite UnsignedProbe");
        done(w3);
        setBits(25, 64);
        var hostile = ludicrous::UnsignedProbe { .. };
        var r2 = readImage();
        check(!ludicrous::ReadUnsignedProbe(r2, hostile), "a smuggled ufixed high-half offset is REJECTED");
    }

    if failed != 0 { exit(1); }
    print("OK");
}
