package probe

const MaxItems = 8

enum Kind
{ Alpha, Beta, Gamma }

type Inner
{
    a       float32
    b       float64
    c       uint128
    name    string(32)
    four    [4]float32
    counted [..MaxItems]uint16
    kind    Kind
}

enum batchBytes
{ Zfirst, Zsecond, Zthird }

enum batchMax
{ Zfirst, Zsecond, Zthird }

union NameArms0
{
    batchBytes Inner
    batchMax Inner
}

table NameTypes0
{
    one0  batchBytes
    many0 [..4]batchBytes
    one1  batchMax
    many1 [..4]batchMax
}

table NameFields0
{
    batchBytes uint32
    batchMax uint32
    armsOfNames  NameArms0
    typesOfNames NameTypes0
}
