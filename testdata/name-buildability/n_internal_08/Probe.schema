package probe

const MaxItems = 8

enum Kind
{ Alpha, Beta, Gamma }

type Inner
{
    a       float32
    b       float64
    c       uint128
    name    string(32)
    four    [4]float32
    counted [..MaxItems]uint16
    kind    Kind
}

enum batch
{ Zfirst, Zsecond, Zthird }

union NameArms0
{
    batch Inner
}

table NameTypes0
{
    one0  batch
    many0 [..4]batch
}

table NameFields0
{
    batch uint32
    armsOfNames  NameArms0
    typesOfNames NameTypes0
}
