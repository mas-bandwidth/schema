    one6  rawArr
    many6 [..4]rawArr
    one7  rawAt
    many7 [..4]rawAt
    one8  rawBase
    many8 [..4]rawBase
    one9  rawBytes
    many9 [..4]rawBytes
}

table NameFields0
{
    ratio uint32
    raw uint32
    raw12 uint32
    raw16 uint32
    raw32 uint32
    raw64 uint32
    rawArr uint32
    rawAt uint32
    rawBase uint32
