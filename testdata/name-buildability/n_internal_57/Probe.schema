{ Zfirst, Zsecond, Zthird }

union NameArms0
{
    rawFlavour Inner
    rawHi Inner
    rawKey Inner
    rawKind Inner
    rawLength Inner
    rawLo Inner
    rawMax Inner
    rawMin Inner
