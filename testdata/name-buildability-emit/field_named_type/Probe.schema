package probe

enum Kind
{ Alpha, Beta, Gamma }

const Count = 3

type Point
{
    x float32
    y float32
}

union Shape
{
    Point Point
}

fixed table Part
{
    x int32
}

union Pick
{
    Part Part
}

table Item
{
    Kind  Kind = Gamma
    Count [..Count]uint16
    Part  Part
    Pick  Pick
}

fixed table Grid | forms="wire,block"
{
    Kind  Kind
    Part  Part
}
