-- TrioStraddleMaxBits is the longest wire path, align padding at its worst case;
-- TrioStraddleMaxBytes sizes a write buffer, rounded up to 8 bytes (SPEC §6.1).
_M.TrioStraddleMaxBits = 408
_M.TrioStraddleMaxBytes = 56

-- WriteTrioStraddle writes the type wire (SPEC §6.1: the wire order is the declared
-- order); false refuses a value that breaks the writer contract (SPEC §5).
function _M.WriteTrioStraddle(stream: any, v: any): boolean
  if typeof(v.Pad0) ~= "integer" then return false end
  BIG.value = v.Pad0
  if not stream:serializeBits64(BIG, 64) then return false end -- the declared bit width
  if typeof(v.Pad1) ~= "integer" then return false end
  BIG.value = v.Pad1
  if not stream:serializeBits64(BIG, 64) then return false end -- the declared bit width
  if typeof(v.Pad2) ~= "integer" then return false end
  BIG.value = v.Pad2
  if not stream:serializeBits64(BIG, 64) then return false end -- the declared bit width
  if typeof(v.Pad3) ~= "integer" then return false end
  BIG.value = v.Pad3
  if not stream:serializeBits64(BIG, 64) then return false end -- the declared bit width
  if typeof(v.Pad4) ~= "integer" then return false end
  BIG.value = v.Pad4
  if not stream:serializeBits64(BIG, 64) then return false end -- the declared bit width
  if type(v.Pad5) ~= "number" or v.Pad5 % 1 ~= 0 or v.Pad5 < 0 or v.Pad5 > 16777215 then return false end
  BITS.value = v.Pad5
  if not stream:serializeBits(BITS, 24) then return false end -- the declared bit width
  if not _M.WriteTrio(stream, v.Inner) then return false end
  return true
end

return _M
