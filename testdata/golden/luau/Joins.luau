  if not stream:serializeBits(BITS, 29) then
    return false
  end
  value.Q = BITS.value
  if not stream:serializeBits(BITS, 19) then
    return false
  end
  value.R = BITS.value
  if not stream:serializeBits(BITS, 4) then
    return false
  end
  value.Tail = BITS.value
  return true
end

