// WriteArmsNested writes v in wire order (SPEC §6.1). Write misuse the runtime
// sees traps in every run; the schema's own contracts are asserts.
def WriteArmsNested(s·:serialize_write_stream, v·:ArmsNested) -> bool:
    s·.serialize_bits(v·.Lead, 3) // the declared bit width (SPEC §4.3)
    s·.serialize_bool(v·.Outer) // SPEC §4.3
    if v·.Outer: // the if/else branch rides only its taken side (SPEC §4.5)
        s·.serialize_bool(v·.Inner) // SPEC §4.3
        if v·.Inner: // the if/else branch rides only its taken side (SPEC §4.5)
            s·.serialize_bits(v·.X, 29) // the declared bit width (SPEC §4.3)
        else:
            s·.serialize_bits(v·.Y, 5) // the declared bit width (SPEC §4.3)
    else:
        s·.serialize_bits(v·.Z, 13) // the declared bit width (SPEC §4.3)
    s·.serialize_bits(v·.Tail, 6) // the declared bit width (SPEC §4.3)
    return true

// WriteArmAlign writes v in wire order (SPEC §6.1). Write misuse the runtime
// sees traps in every run; the schema's own contracts are asserts.
def WriteArmAlign(s·:serialize_write_stream, v·:ArmAlign) -> bool:
    s·.serialize_bits(v·.Lead, 5) // the declared bit width (SPEC §4.3)
    s·.serialize_bool(v·.Flag) // SPEC §4.3
    if v·.Flag: // the if/else branch rides only its taken side (SPEC §4.5)
        assert v·.SLength >= 0 and v·.SLength <= 4 // the used length is in [0, 4] (SPEC §4.7)
        assert schema_rt.text_refusal(v·.S, v·.SLength) == serialize_refusal_none // no interior NUL, well-formed UTF-8 (SPEC §4.7)
        s·.serialize_bits(v·.SLength, 3) // the used length (SPEC §4.7)
        s·.serialize_bytes(v·.S, v·.SLength) // aligns, then the used bytes (SPEC §4.7)
    else:
        s·.serialize_bits(v·.B, 10) // the declared bit width (SPEC §4.3)
    s·.serialize_bits(v·.Tail, 7) // the declared bit width (SPEC §4.3)
    return true

// WriteArmArray writes v in wire order (SPEC §6.1). Write misuse the runtime
// sees traps in every run; the schema's own contracts are asserts.
def WriteArmArray(s·:serialize_write_stream, v·:ArmArray) -> bool:
    s·.serialize_bits(v·.Lead, 5) // the declared bit width (SPEC §4.3)
    s·.serialize_bool(v·.Flag) // SPEC §4.3
    if v·.Flag: // the if/else branch rides only its taken side (SPEC §4.5)
        assert v·.ItemsCount >= 0 and v·.ItemsCount <= 3 // the count is in [0, 3] (SPEC §4.6)
        s·.serialize_bits(v·.ItemsCount, 2) // the count (SPEC §4.6)
        for(v·.ItemsCount) _i·: // the count guards the loop (SPEC §6.3)
            assert v·.Items[_i·] >= 0 and v·.Items[_i·] <= 8191 // the value is in [min, max] (SPEC §4.3)
            s·.serialize_bits(v·.Items[_i·], 13) // the offset from min (SPEC §4.3)
    else:
        s·.serialize_bits(v·.B, 9) // the declared bit width (SPEC §4.3)
    s·.serialize_bits(v·.Tail, 7) // the declared bit width (SPEC §4.3)
    return true

// WriteNarrow writes v in wire order (SPEC §6.1). Write misuse the runtime
// sees traps in every run; the schema's own contracts are asserts.
def WriteNarrow(s·:serialize_write_stream, v·:Narrow) -> bool:
    s·.serialize_bits(v·.N, 3) // the declared bit width (SPEC §4.3)
    return true

// WriteWide writes v in wire order (SPEC §6.1). Write misuse the runtime
// sees traps in every run; the schema's own contracts are asserts.
def WriteWide(s·:serialize_write_stream, v·:Wide) -> bool:
    s·.serialize_bits64(v·.W, 37) // the declared bit width (SPEC §4.3)
    return true

// WriteUneven writes the tag, then the selected arm only (SPEC §4.8: None = 0,
// then each declared arm).
def WriteUneven(s·:serialize_write_stream, v·:Uneven) -> bool:
    assert v·.Type >= 0 and v·.Type <= 2 // the tag is a write-side contract (SPEC §4.8)
    s·.serialize_bits(v·.Type, 2) // the union tag (SPEC §4.8)
    if v·.Type == UnevenTypeNarrow: // the selected arm only (SPEC §4.8)
        WriteNarrow(s·, v·.Narrow)
    if v·.Type == UnevenTypeWide: // the selected arm only (SPEC §4.8)
        WriteWide(s·, v·.Wide)
    return true

// WriteHoldsUneven writes v in wire order (SPEC §6.1). Write misuse the runtime
// sees traps in every run; the schema's own contracts are asserts.
def WriteHoldsUneven(s·:serialize_write_stream, v·:HoldsUneven) -> bool:
    s·.serialize_bits(v·.Lead, 5) // the declared bit width (SPEC §4.3)
    WriteUneven(s·, v·.U)
    s·.serialize_bits(v·.Tail, 11) // the declared bit width (SPEC §4.3)
    return true

// WriteArrUneven writes v in wire order (SPEC §6.1). Write misuse the runtime
// sees traps in every run; the schema's own contracts are asserts.
def WriteArrUneven(s·:serialize_write_stream, v·:ArrUneven) -> bool:
    s·.serialize_bits(v·.Lead, 5) // the declared bit width (SPEC §4.3)
    assert v·.ItemsCount >= 0 and v·.ItemsCount <= 3 // the count is in [0, 3] (SPEC §4.6)
    s·.serialize_bits(v·.ItemsCount, 2) // the count (SPEC §4.6)
    for(v·.ItemsCount) _i·: // the count guards the loop (SPEC §6.3)
        WriteUneven(s·, v·.Items[_i·])
    s·.serialize_bits(v·.Tail, 3) // the declared bit width (SPEC §4.3)
    return true

// WriteRegainAfterAlign writes v in wire order (SPEC §6.1). Write misuse the runtime
// sees traps in every run; the schema's own contracts are asserts.
def WriteRegainAfterAlign(s·:serialize_write_stream, v·:RegainAfterAlign) -> bool:
    s·.serialize_bits(v·.Lead, 5) // the declared bit width (SPEC §4.3)
    assert v·.ItemsCount >= 0 and v·.ItemsCount <= 3 // the count is in [0, 3] (SPEC §4.6)
    s·.serialize_bits(v·.ItemsCount, 2) // the count (SPEC §4.6)
    for(v·.ItemsCount) _i·: // the count guards the loop (SPEC §6.3)
        assert v·.Items[_i·] >= 0 and v·.Items[_i·] <= 8191 // the value is in [min, max] (SPEC §4.3)
        s·.serialize_bits(v·.Items[_i·], 13) // the offset from min (SPEC §4.3)
    assert v·.SLength >= 0 and v·.SLength <= 4 // the used length is in [0, 4] (SPEC §4.7)
    assert schema_rt.text_refusal(v·.S, v·.SLength) == serialize_refusal_none // no interior NUL, well-formed UTF-8 (SPEC §4.7)
    s·.serialize_bits(v·.SLength, 3) // the used length (SPEC §4.7)
    s·.serialize_bytes(v·.S, v·.SLength) // aligns, then the used bytes (SPEC §4.7)
    s·.serialize_bits(v·.P, 32) // the declared bit width (SPEC §4.3)
    s·.serialize_bits(v·.Q, 29) // the declared bit width (SPEC §4.3)
    s·.serialize_bits(v·.R, 19) // the declared bit width (SPEC §4.3)
    s·.serialize_bits(v·.Tail, 4) // the declared bit width (SPEC §4.3)
    return true
