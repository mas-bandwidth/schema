    rv·, rok· = stream·.serialize_bits(rv·, 4)
    if not rok·: return false
    value·.Tail = rv·
    return true

// ReadRegainAfterAlign reads one packet holding value: its body, then the packet's end
// (SPEC §5), which refuses a whole byte left over and set unused bits in
// the final byte. A refusal latches the stream with its reason and answers
// false.
def ReadRegainAfterAlign(stream·:serialize_read_stream, value·:RegainAfterAlign) -> bool:
    if not read_body_RegainAfterAlign(stream·, value·): return false
    return stream·.serialize_end() // one packet's end: no trailing byte, no set padding (SPEC §5)

// WriteArmsAgree writes v in wire order (SPEC §6.1). Write misuse the runtime
// sees traps in every run; the schema's own contracts are asserts.
def WriteArmsAgree(s·:serialize_write_stream, v·:ArmsAgree) -> bool:
    s·.serialize_bits(v·.Lead, 5) // the declared bit width (SPEC §4.3)
    s·.serialize_bool(v·.Flag) // SPEC §4.3
    if v·.Flag: // the if/else branch rides only its taken side (SPEC §4.5)
        s·.serialize_bits(v·.A, 11) // the declared bit width (SPEC §4.3)
    else:
        s·.serialize_bits(v·.B, 11) // the declared bit width (SPEC §4.3)
    s·.serialize_bits(v·.Tail, 7) // the declared bit width (SPEC §4.3)
    return true

// WriteArmsDisagree writes v in wire order (SPEC §6.1). Write misuse the runtime
// sees traps in every run; the schema's own contracts are asserts.
def WriteArmsDisagree(s·:serialize_write_stream, v·:ArmsDisagree) -> bool:
    s·.serialize_bits(v·.Lead, 5) // the declared bit width (SPEC §4.3)
    s·.serialize_bool(v·.Flag) // SPEC §4.3
    if v·.Flag: // the if/else branch rides only its taken side (SPEC §4.5)
        s·.serialize_bits(v·.A, 11) // the declared bit width (SPEC §4.3)
    else:
        s·.serialize_bits(v·.B, 3) // the declared bit width (SPEC §4.3)
    s·.serialize_bits(v·.Tail, 7) // the declared bit width (SPEC §4.3)
    return true

// WriteArmEmpty writes v in wire order (SPEC §6.1). Write misuse the runtime
