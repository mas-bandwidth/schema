    value·.FloorBound = rv·
    rv·, rok· = stream·.serialize_int64(rv·, 0x8000000000000000, 100) // the offset from min; past max is refused (SPEC §4.3)
    if not rok·: return false
    value·.DoubledFloor = rv·
    rv·, rok· = stream·.serialize_bits64(rv·, 64) // the offset from min (SPEC §4.3)
    if not rok·: return false
    if schema_rt.ult(0xfffffffffffffffe, rv·): return stream·.fail(serialize_refusal_value_out_of_range) // an offset in the bit headroom is past max (SPEC §4.3)
    value·.CeilingRange = rv· + 1
    rv·, rok· = stream·.serialize_bits64(rv·, 64) // the storage width (SPEC §4.3)
    if not rok·: return false
    value·.FloorDefault = rv·
    rv·, rok· = stream·.serialize_bits64(rv·, 64) // the storage width (SPEC §4.3)
    if not rok·: return false
    value·.CeilingDefault = rv·
    return true

// ReadExtremeProbe reads one packet holding value: its body, then the packet's end
// (SPEC §5), which refuses a whole byte left over and set unused bits in
// the final byte. A refusal latches the stream with its reason and answers
// false.
def ReadExtremeProbe(stream·:serialize_read_stream, value·:ExtremeProbe) -> bool:
    if not read_body_ExtremeProbe(stream·, value·): return false
    return stream·.serialize_end() // one packet's end: no trailing byte, no set padding (SPEC §5)

// read_body_ExtremeRow decodes the wire into value, filling its pre-allocated
// storage (SPEC §6.1); the untaken side of a branch reads as zero (SPEC §5).
// It does not end the packet. A refusal latches the stream with its reason
// and answers false.
def read_body_ExtremeRow(stream·:serialize_read_stream, value·:ExtremeRow) -> bool:
    var rv· = 0
    var rok· = true
    rv·, rok· = stream·.serialize_int64(rv·, 0x8000000000000000, 100) // the offset from min; past max is refused (SPEC §4.3)
    if not rok·: return false
    value·.ClampedFloor = rv·
    rv·, rok· = stream·.serialize_bits64(rv·, 64) // the offset from min (SPEC §4.3)
    if not rok·: return false
    if schema_rt.ult(0xfffffffffffffffd, rv·): return stream·.fail(serialize_refusal_value_out_of_range) // an offset in the bit headroom is past max (SPEC §4.3)
    value·.ClampedCeiling = rv· + 1
    rv·, rok· = stream·.serialize_bits64(rv·, 64) // the storage width (SPEC §4.3)
    if not rok·: return false
    value·.FloorDef = rv·
    rv·, rok· = stream·.serialize_bits64(rv·, 64) // the storage width (SPEC §4.3)
    if not rok·: return false
    value·.CeilingDef = rv·
    return true

// ReadExtremeRow reads one packet holding value: its body, then the packet's end
// (SPEC §5), which refuses a whole byte left over and set unused bits in
// the final byte. A refusal latches the stream with its reason and answers
// false.
def ReadExtremeRow(stream·:serialize_read_stream, value·:ExtremeRow) -> bool:
    if not read_body_ExtremeRow(stream·, value·): return false
    return stream·.serialize_end() // one packet's end: no trailing byte, no set padding (SPEC §5)

// WriteVec3 writes v in wire order (SPEC §6.1). Write misuse the runtime
// sees traps in every run; the schema's own contracts are asserts.
def WriteVec3(s·:serialize_write_stream, v·:Vec3) -> bool:
    s·.serialize_double(v·.X) // finite only: NaN and ±inf trap (SPEC §4.3)
    s·.serialize_double(v·.Y) // finite only: NaN and ±inf trap (SPEC §4.3)
    s·.serialize_double(v·.Z) // finite only: NaN and ±inf trap (SPEC §4.3)
    return true

// WriteQuat writes v in wire order (SPEC §6.1). Write misuse the runtime
// sees traps in every run; the schema's own contracts are asserts.
def WriteQuat(s·:serialize_write_stream, v·:Quat) -> bool:
    s·.serialize_double(v·.X) // finite only: NaN and ±inf trap (SPEC §4.3)
    s·.serialize_double(v·.Y) // finite only: NaN and ±inf trap (SPEC §4.3)
    s·.serialize_double(v·.Z) // finite only: NaN and ±inf trap (SPEC §4.3)
    s·.serialize_double(v·.W) // finite only: NaN and ±inf trap (SPEC §4.3)
    return true

// WriteHandle writes v in wire order (SPEC §6.1). Write misuse the runtime
// sees traps in every run; the schema's own contracts are asserts.
def WriteHandle(s·:serialize_write_stream, v·:Handle) -> bool:
    assert v·.ObjectId >= 0 and v·.ObjectId <= 9999 // the value is in [min, max] (SPEC §4.3)
    s·.serialize_bits(v·.ObjectId, 14) // the offset from min (SPEC §4.3)
    s·.serialize_bits(v·.ObjectSequence, 8) // the storage width (SPEC §4.3)
    return true

// WriteQuantizedPosition writes v in wire order (SPEC §6.1). Write misuse the runtime
// sees traps in every run; the schema's own contracts are asserts.
def WriteQuantizedPosition(s·:serialize_write_stream, v·:QuantizedPosition) -> bool:
    assert v·.X >= -8388608 and v·.X <= 8388608 // the value is in [min, max] (SPEC §4.3)
    s·.serialize_bits(v·.X - (-8388608), 25) // the offset from min (SPEC §4.3)
    assert v·.Y >= -8388608 and v·.Y <= 8388608 // the value is in [min, max] (SPEC §4.3)
    s·.serialize_bits(v·.Y - (-8388608), 25) // the offset from min (SPEC §4.3)
    assert v·.Z >= -8388608 and v·.Z <= 8388608 // the value is in [min, max] (SPEC §4.3)
    s·.serialize_bits(v·.Z - (-8388608), 25) // the offset from min (SPEC §4.3)
    return true

// WriteQuantizedVelocity writes v in wire order (SPEC §6.1). Write misuse the runtime
// sees traps in every run; the schema's own contracts are asserts.
def WriteQuantizedVelocity(s·:serialize_write_stream, v·:QuantizedVelocity) -> bool:
    assert v·.X >= -2097152 and v·.X <= 2097152 // the value is in [min, max] (SPEC §4.3)
    s·.serialize_bits(v·.X - (-2097152), 23) // the offset from min (SPEC §4.3)
    assert v·.Y >= -2097152 and v·.Y <= 2097152 // the value is in [min, max] (SPEC §4.3)
    s·.serialize_bits(v·.Y - (-2097152), 23) // the offset from min (SPEC §4.3)
    assert v·.Z >= -2097152 and v·.Z <= 2097152 // the value is in [min, max] (SPEC §4.3)
    s·.serialize_bits(v·.Z - (-2097152), 23) // the offset from min (SPEC §4.3)
    return true

// WriteQuantizedRotation writes v in wire order (SPEC §6.1). Write misuse the runtime
// sees traps in every run; the schema's own contracts are asserts.
def WriteQuantizedRotation(s·:serialize_write_stream, v·:QuantizedRotation) -> bool:
    assert v·.X >= -1024 and v·.X <= 1024 // the value is in [min, max] (SPEC §4.3)
    s·.serialize_bits(v·.X - (-1024), 12) // the offset from min (SPEC §4.3)
    assert v·.Y >= -1024 and v·.Y <= 1024 // the value is in [min, max] (SPEC §4.3)
    s·.serialize_bits(v·.Y - (-1024), 12) // the offset from min (SPEC §4.3)
    assert v·.Z >= -1024 and v·.Z <= 1024 // the value is in [min, max] (SPEC §4.3)
    s·.serialize_bits(v·.Z - (-1024), 12) // the offset from min (SPEC §4.3)
    assert v·.W >= -1024 and v·.W <= 1024 // the value is in [min, max] (SPEC §4.3)
    s·.serialize_bits(v·.W - (-1024), 12) // the offset from min (SPEC §4.3)
    return true

// WriteRigidBody writes v in wire order (SPEC §6.1). Write misuse the runtime
// sees traps in every run; the schema's own contracts are asserts.
def WriteRigidBody(s·:serialize_write_stream, v·:RigidBody) -> bool:
    WriteVec3(s·, v·.Position)
    WriteQuat(s·, v·.Orientation)
    s·.serialize_bool(v·.AtRest) // SPEC §4.3
    if not v·.AtRest: // the if/else branch rides only its taken side (SPEC §4.5)
        WriteVec3(s·, v·.LinearVelocity)
        WriteVec3(s·, v·.AngularVelocity)
    return true

// WriteInput writes v in wire order (SPEC §6.1). Write misuse the runtime
// sees traps in every run; the schema's own contracts are asserts.
def WriteInput(s·:serialize_write_stream, v·:Input) -> bool:
    s·.serialize_float(v·.StickX) // finite only: NaN and ±inf trap (SPEC §4.3)
    s·.serialize_float(v·.StickY) // finite only: NaN and ±inf trap (SPEC §4.3)
    s·.serialize_float(v·.Throttle) // finite only: NaN and ±inf trap (SPEC §4.3)
    s·.serialize_float(v·.Yaw) // finite only: NaN and ±inf trap (SPEC §4.3)
    s·.serialize_float(v·.Pitch) // finite only: NaN and ±inf trap (SPEC §4.3)
    s·.serialize_bool(v·.Fire) // SPEC §4.3
    s·.serialize_bool(v·.AltFire) // SPEC §4.3
    s·.serialize_bool(v·.Boost) // SPEC §4.3
    s·.serialize_bool(v·.Brake) // SPEC §4.3
    s·.serialize_bool(v·.Aim) // SPEC §4.3
    s·.serialize_bool(v·.LockOn) // SPEC §4.3
    s·.serialize_bool(v·.Zoom) // SPEC §4.3
    s·.serialize_bool(v·.Ping) // SPEC §4.3
    return true

// WriteInputPacket writes v in wire order (SPEC §6.1). Write misuse the runtime
// sees traps in every run; the schema's own contracts are asserts.
def WriteInputPacket(s·:serialize_write_stream, v·:InputPacket) -> bool:
    s·.serialize_bits(v·.SynchronizeSequence, 16) // the storage width (SPEC §4.3)
    s·.serialize_bits64(v·.CurrentFrame, 64) // the storage width (SPEC §4.3)
    s·.serialize_bits64(v·.StartFrame, 64) // the storage width (SPEC §4.3)
    assert v·.InputsCount >= 0 and v·.InputsCount <= 16 // the count is in [0, 16] (SPEC §4.6)
    s·.serialize_bits(v·.InputsCount, 5) // the count (SPEC §4.6)
    for(v·.InputsCount) _i·: // the count guards the loop (SPEC §6.3)
        WriteInput(s·, v·.Inputs[_i·])
    return true

// WriteShipCreate writes v in wire order (SPEC §6.1). Write misuse the runtime
// sees traps in every run; the schema's own contracts are asserts.
def WriteShipCreate(s·:serialize_write_stream, v·:ShipCreate) -> bool:
    assert v·.ShipType >= 0 and v·.ShipType <= 5 // the enum value (SPEC §4.2)
    s·.serialize_bits(v·.ShipType, 3) // the enum value (SPEC §4.2)
    WriteQuantizedPosition(s·, v·.Position)
    WriteQuantizedRotation(s·, v·.Rotation)
    WriteQuantizedVelocity(s·, v·.LinearVelocity)
    s·.serialize_bool(v·.HasFlags) // SPEC §4.3
    if v·.HasFlags: // the if/else branch rides only its taken side (SPEC §4.5)
        assert v·.Flags >= 0 and v·.Flags < 0x10 // the mask fits 4 bits (SPEC §4.2)
        s·.serialize_bits(v·.Flags, 4) // the flags wire width (SPEC §4.2)
    assert v·.Team >= 0 and v·.Team <= 2 // the enum value (SPEC §4.2)
    s·.serialize_bits(v·.Team, 2) // the enum value (SPEC §4.2)
    assert v·.Health >= 0 and v·.Health <= 1000 // the value is in [min, max] (SPEC §4.3)
    s·.serialize_bits(v·.Health, 10) // the offset from min (SPEC §4.3)
    assert v·.Thrust >= 0 and v·.Thrust <= 100 // the value is in [min, max] (SPEC §4.3)
    s·.serialize_bits(v·.Thrust, 7) // the offset from min (SPEC §4.3)
    assert v·.Pending >= 0 and v·.Pending <= 0 // the enum value (SPEC §4.2)
    return true

// WriteExpressionProbe writes v in wire order (SPEC §6.1). Write misuse the runtime
// sees traps in every run; the schema's own contracts are asserts.
def WriteExpressionProbe(s·:serialize_write_stream, v·:ExpressionProbe) -> bool:
    assert v·.HardpointIndex >= 0 and v·.HardpointIndex <= 31 // the value is in [min, max] (SPEC §4.3)
    s·.serialize_bits(v·.HardpointIndex, 5) // the offset from min (SPEC §4.3)
    assert v·.SpinRate >= 1024 and v·.SpinRate <= 2048 // the value is in [min, max] (SPEC §4.3)
    s·.serialize_bits(v·.SpinRate - (1024), 11) // the offset from min (SPEC §4.3)
    return true

// WriteExtremeProbe writes v in wire order (SPEC §6.1). Write misuse the runtime
// sees traps in every run; the schema's own contracts are asserts.
def WriteExtremeProbe(s·:serialize_write_stream, v·:ExtremeProbe) -> bool:
    assert v·.FloorBound >= 0x8000000000000000 and v·.FloorBound <= 100 // the value is in [min, max] (SPEC §4.3)
    s·.serialize_bits64(v·.FloorBound - (0x8000000000000000), 64) // the offset from min (SPEC §4.3)
    assert v·.DoubledFloor >= 0x8000000000000000 and v·.DoubledFloor <= 100 // the value is in [min, max] (SPEC §4.3)
    s·.serialize_bits64(v·.DoubledFloor - (0x8000000000000000), 64) // the offset from min (SPEC §4.3)
    assert not schema_rt.ult(v·.CeilingRange, 1) and not schema_rt.ult(0xffffffffffffffff, v·.CeilingRange) // the value is in [min, max], unsigned (SPEC §4.3)
    s·.serialize_bits64(v·.CeilingRange - (1), 64) // the offset from min (SPEC §4.3)
    s·.serialize_bits64(v·.FloorDefault, 64) // the storage width (SPEC §4.3)
    s·.serialize_bits64(v·.CeilingDefault, 64) // the storage width (SPEC §4.3)
    return true

// WriteExtremeRow writes v in wire order (SPEC §6.1). Write misuse the runtime
// sees traps in every run; the schema's own contracts are asserts.
def WriteExtremeRow(s·:serialize_write_stream, v·:ExtremeRow) -> bool:
    assert v·.ClampedFloor >= 0x8000000000000000 and v·.ClampedFloor <= 100 // the value is in [min, max] (SPEC §4.3)
    s·.serialize_bits64(v·.ClampedFloor - (0x8000000000000000), 64) // the offset from min (SPEC §4.3)
    assert not schema_rt.ult(v·.ClampedCeiling, 1) and not schema_rt.ult(0xfffffffffffffffe, v·.ClampedCeiling) // the value is in [min, max], unsigned (SPEC §4.3)
    s·.serialize_bits64(v·.ClampedCeiling - (1), 64) // the offset from min (SPEC §4.3)
    s·.serialize_bits64(v·.FloorDef, 64) // the storage width (SPEC §4.3)
    s·.serialize_bits64(v·.CeilingDef, 64) // the storage width (SPEC §4.3)
    return true
