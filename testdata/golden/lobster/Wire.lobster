    rv·, rok· = stream·.serialize_int(rv·, 0, 1000) // the offset from min; past max is refused (SPEC §4.3)
    if not rok·: return false
    value·.TestB = rv·
    rv·, rok· = stream·.serialize_int(rv·, 0, 1000) // the offset from min; past max is refused (SPEC §4.3)
    if not rok·: return false
    value·.TestC = rv·
    rv·, rok· = stream·.serialize_int(rv·, 0, 1000) // the offset from min; past max is refused (SPEC §4.3)
    if not rok·: return false
    value·.TestD = rv·
    return true

