    if not rok·: return false
    rs·, rok· = stream·.serialize_bytes(value·.Data, rv·) // aligns (padding zero), then the used bytes in place (SPEC §4.7)
    if not rok·: return false
    value·.DataLength = rv·
    return true

// ReadBlock reads one packet holding value: its body, then the packet's end
// (SPEC §5), which refuses a whole byte left over and set unused bits in
