// read_body_TestData decodes the wire into value, filling its pre-allocated
// storage (SPEC §6.1); the untaken side of a branch reads as zero (SPEC §5).
// It does not end the packet. A refusal latches the stream with its reason
// and answers false.
def read_body_TestData(stream·:serialize_read_stream, value·:TestData) -> bool:
    var rv· = 0
    var rok· = true
    var rf· = 0.0
    var rb· = false
    var rs· = ""
    var rt· = serialize_refusal_none
    rv·, rok· = stream·.serialize_int(rv·, -100, 100) // the offset from min; past max is refused (SPEC §4.3)
    if not rok·: return false
    value·.A = rv·
    rv·, rok· = stream·.serialize_int(rv·, -100, 100) // the offset from min; past max is refused (SPEC §4.3)
    if not rok·: return false
    value·.B = rv·
    rv·, rok· = stream·.serialize_int(rv·, -100, 150) // the offset from min; past max is refused (SPEC §4.3)
    if not rok·: return false
    value·.C = rv·
    rv·, rok· = stream·.serialize_bits(rv·, 8)
    if not rok·: return false
    value·.D = rv·
    rv·, rok· = stream·.serialize_bits(rv·, 8)
    if not rok·: return false
    value·.E = rv·
    rv·, rok· = stream·.serialize_bits(rv·, 8)
    if not rok·: return false
    value·.F = rv·
    rb·, rok· = stream·.serialize_bool(rb·)
    if not rok·: return false
    value·.G = rb·
    rv·, rok· = stream·.serialize_int(rv·, 0, 16) // the count, in [0, 16], guards the loop (SPEC §4.6, §6.3)
    if not rok·: return false
    value·.ItemsCount = rv·
    for(value·.ItemsCount) i·:
        rv·, rok· = stream·.serialize_int(rv·, 0, 255) // the offset from min; past max is refused (SPEC §4.3)
        if not rok·: return false
        value·.Items[i·] = rv·
    rf·, rok· = stream·.serialize_float(rf·) // NaN and ±inf refuse as non_finite_float on the raw bits (SPEC §4.3)
    if not rok·: return false
    value·.FloatValue = rf·
    rf·, rok· = stream·.serialize_compressed_float_precomputed(rf·, 1000, 10, 10.0, 0.0) // a step past the top, or a non-finite decode, is refused (SPEC §4.3)
    if not rok·: return false
    value·.CompressedFloatValue = rf·
    rf·, rok· = stream·.serialize_double(rf·) // NaN and ±inf refuse as non_finite_float on the raw bits (SPEC §4.3)
    if not rok·: return false
    value·.DoubleValue = rf·
    rv·, rok· = stream·.serialize_bits(rv·, 8) // the storage width (SPEC §4.3)
    if not rok·: return false
    value·.Int8Value = (rv· << 56) >> 56 // sign-extend the narrow pattern
    rv·, rok· = stream·.serialize_bits(rv·, 16) // the storage width (SPEC §4.3)
    if not rok·: return false
    value·.Int16Value = (rv· << 48) >> 48 // sign-extend the narrow pattern
    rv·, rok· = stream·.serialize_bits(rv·, 8) // the storage width (SPEC §4.3)
    if not rok·: return false
    value·.Uint8Value = rv·
    rv·, rok· = stream·.serialize_bits(rv·, 16) // the storage width (SPEC §4.3)
    if not rok·: return false
    value·.Uint16Value = rv·
    rv·, rok· = stream·.serialize_bits(rv·, 32) // the storage width (SPEC §4.3)
    if not rok·: return false
    value·.Uint32Value = rv·
    rv·, rok· = stream·.serialize_bits64(rv·, 64) // the storage width (SPEC §4.3)
    if not rok·: return false
    value·.Uint64Value = rv·
    rv·, rok· = stream·.serialize_bits64(rv·, 64) // the storage width (SPEC §4.3)
    if not rok·: return false
    value·.Int64Full = rv·
    rv·, rok· = stream·.serialize_int64(rv·, -1000000000000, 1000000000000) // the offset from min; past max is refused (SPEC §4.3)
    if not rok·: return false
    value·.Int64Range = rv·
    if not stream·.serialize_align(): return false // refuses nonzero padding (SPEC §4.3)
    rs·, rok· = stream·.serialize_bytes(value·.FixedBytes, 17) // [N]uint8 at a byte-aligned position: one bulk copy, in place (SPEC §4.7)
    if not rok·: return false
    rv·, rok· = stream·.serialize_int(rv·, 0, 255) // the used length guards the copy (SPEC §4.7, §6.3)
    if not rok·: return false
    rs·, rok· = stream·.serialize_bytes(value·.Text, rv·) // aligns (padding zero), then the used bytes in place (SPEC §4.7)
    if not rok·: return false
    value·.TextLength = rv·
    rt· = schema_rt.text_refusal(value·.Text, rv·)
    if rt· != serialize_refusal_none: return stream·.fail(rt·) // an interior NUL or malformed UTF-8 is refused (SPEC §4.7)
    return true

// ReadTestData reads one packet holding value: its body, then the packet's end
// (SPEC §5), which refuses a whole byte left over and set unused bits in
// the final byte. A refusal latches the stream with its reason and answers
// false.
def ReadTestData(stream·:serialize_read_stream, value·:TestData) -> bool:
    if not read_body_TestData(stream·, value·): return false
    return stream·.serialize_end() // one packet's end: no trailing byte, no set padding (SPEC §5)

// read_body_CompressedProbe decodes the wire into value, filling its pre-allocated
// storage (SPEC §6.1); the untaken side of a branch reads as zero (SPEC §5).
// It does not end the packet. A refusal latches the stream with its reason
// and answers false.
def read_body_CompressedProbe(stream·:serialize_read_stream, value·:CompressedProbe) -> bool:
    var rok· = true
    var rf· = 0.0
    rf·, rok· = stream·.serialize_compressed_float_precomputed(rf·, 1000, 10, 10.0, 0.0) // a step past the top, or a non-finite decode, is refused (SPEC §4.3)
    if not rok·: return false
    value·.Boundary = rf·
    rf·, rok· = stream·.serialize_compressed_float_precomputed(rf·, 10000, 14, 10.0, -5.0) // a step past the top, or a non-finite decode, is refused (SPEC §4.3)
    if not rok·: return false
    value·.Offset = rf·
    return true

// ReadCompressedProbe reads one packet holding value: its body, then the packet's end
// (SPEC §5), which refuses a whole byte left over and set unused bits in
// the final byte. A refusal latches the stream with its reason and answers
// false.
def ReadCompressedProbe(stream·:serialize_read_stream, value·:CompressedProbe) -> bool:
    if not read_body_CompressedProbe(stream·, value·): return false
    return stream·.serialize_end() // one packet's end: no trailing byte, no set padding (SPEC §5)

// WriteProbeHeader writes v in wire order (SPEC §6.1). Write misuse the runtime
// sees traps in every run; the schema's own contracts are asserts.
def WriteProbeHeader(s·:serialize_write_stream, v·:ProbeHeader) -> bool:
    s·.serialize_bits(171, 8) // const(171, 8) (SPEC §4.3)
    s·.serialize_bits(v·.Version, 3) // the declared bit width (SPEC §4.3)
    s·.serialize_bits(0, 5) // reserved(5) (SPEC §4.3)
    s·.serialize_align() // align (SPEC §4.3)
    s·.serialize_bits64(v·.ProbeId, 64) // the storage width (SPEC §4.3)
    return true

// WriteProbeBits writes v in wire order (SPEC §6.1). Write misuse the runtime
// sees traps in every run; the schema's own contracts are asserts.
def WriteProbeBits(s·:serialize_write_stream, v·:ProbeBits) -> bool:
    s·.serialize_bits(v·.Small, 9) // the declared bit width (SPEC §4.3)
    s·.serialize_bits64(v·.Boundary, 33) // the declared bit width (SPEC §4.3)
    s·.serialize_bits64(v·.Wide, 64) // the declared bit width (SPEC §4.3)
    assert v·.Sensor >= 0 and v·.Sensor <= 4294967295 // the value is in [min, max] (SPEC §4.3)
    s·.serialize_bits(v·.Sensor, 32) // the offset from min (SPEC §4.3)
    s·.serialize_bits64(v·.Nonce, 64) // the offset from min (SPEC §4.3)
    return true

// WriteProbeSample writes v in wire order (SPEC §6.1). Write misuse the runtime
// sees traps in every run; the schema's own contracts are asserts.
def WriteProbeSample(s·:serialize_write_stream, v·:ProbeSample) -> bool:
    s·.serialize_bool(v·.Active) // SPEC §4.3
    assert v·.Orientation - v·.Orientation != 0.0 or (v·.Orientation >= -180.0 and v·.Orientation <= 180.0) // a finite value is in [min, max] (SPEC §5.1 row 10)
    s·.serialize_compressed_float_precomputed(v·.Orientation, 36000, 16, 360.0, -180.0) // the step index; a non-finite value traps (SPEC §4.3)
    assert v·.RawDelta >= -2147483648 and v·.RawDelta <= 2147483647 // the value fits the declared 32-bit width (SPEC §5.1 row 11)
    s·.serialize_bits((v·.RawDelta & 0xffffffff), 32) // the storage width (SPEC §4.3)
    s·.serialize_bits64(v·.BigDelta, 64) // the storage width (SPEC §4.3)
    if v·.Active: // the if/else branch rides only its taken side (SPEC §4.5)
        assert v·.Weapon >= 0 and v·.Weapon <= 15 // the enum value (SPEC §4.2)
        s·.serialize_bits(v·.Weapon, 4) // the enum value (SPEC §4.2)
        s·.serialize_bool(v·.HasTarget) // SPEC §4.3
        if v·.HasTarget: // the if/else branch rides only its taken side (SPEC §4.5)
            s·.serialize_bits(v·.TargetId, 16) // the storage width (SPEC §4.3)
    else:
        s·.serialize_bits(v·.IdleTicks, 32) // the storage width (SPEC §4.3)
    assert v·.SamplesCount >= 1 and v·.SamplesCount <= 8 // the count is in [1, 8] (SPEC §4.6)
    s·.serialize_bits(v·.SamplesCount - (1), 3) // the count (SPEC §4.6)
    for(v·.SamplesCount) _i·: // the count guards the loop (SPEC §6.3)
        s·.serialize_bits(v·.Samples[_i·], 16) // the storage width (SPEC §4.3)
    return true

// WriteProbeRing writes v in wire order (SPEC §6.1). Write misuse the runtime
// sees traps in every run; the schema's own contracts are asserts.
def WriteProbeRing(s·:serialize_write_stream, v·:ProbeRing) -> bool:
    s·.serialize_bits(v·.Radius, 16) // the storage width (SPEC §4.3)
    return true

// WriteProbeSlab writes v in wire order (SPEC §6.1). Write misuse the runtime
// sees traps in every run; the schema's own contracts are asserts.
def WriteProbeSlab(s·:serialize_write_stream, v·:ProbeSlab) -> bool:
    assert v·.Width >= 0 and v·.Width <= 100 // the value is in [min, max] (SPEC §4.3)
    s·.serialize_bits(v·.Width, 7) // the offset from min (SPEC §4.3)
    s·.serialize_bits(v·.Height, 8) // the storage width (SPEC §4.3)
    return true

// WriteProbeShape writes the tag, then the selected arm only (SPEC §4.8: None = 0,
// then each declared arm).
def WriteProbeShape(s·:serialize_write_stream, v·:ProbeShape) -> bool:
    assert v·.Type >= 0 and v·.Type <= 2 // the tag is a write-side contract (SPEC §4.8)
    s·.serialize_bits(v·.Type, 2) // the union tag (SPEC §4.8)
    if v·.Type == ProbeShapeTypeRing: // the selected arm only (SPEC §4.8)
        WriteProbeRing(s·, v·.Ring)
    if v·.Type == ProbeShapeTypeSlab: // the selected arm only (SPEC §4.8)
        WriteProbeSlab(s·, v·.Slab)
    return true

// WriteProbeCollider writes v in wire order (SPEC §6.1). Write misuse the runtime
// sees traps in every run; the schema's own contracts are asserts.
def WriteProbeCollider(s·:serialize_write_stream, v·:ProbeCollider) -> bool:
    s·.serialize_bits(v·.Armor, 8) // the storage width (SPEC §4.3)
    WriteProbeShape(s·, v·.Shape)
    WriteProbeShape(s·, v·.Backup)
    assert v·.ExtrasCount >= 0 and v·.ExtrasCount <= 2 // the count is in [0, 2] (SPEC §4.6)
    s·.serialize_bits(v·.ExtrasCount, 2) // the count (SPEC §4.6)
    for(v·.ExtrasCount) _i·: // the count guards the loop (SPEC §6.3)
        WriteProbeShape(s·, v·.Extras[_i·])
    return true

// WriteProbeConfig writes v in wire order (SPEC §6.1). Write misuse the runtime
// sees traps in every run; the schema's own contracts are asserts.
def WriteProbeConfig(s·:serialize_write_stream, v·:ProbeConfig) -> bool:
    assert v·.Retries >= -2147483648 and v·.Retries <= 2147483647 // the value fits the declared 32-bit width (SPEC §5.1 row 11)
    s·.serialize_bits((v·.Retries & 0xffffffff), 32) // the storage width (SPEC §4.3)
    assert v·.Preferred >= 0 and v·.Preferred <= 15 // the enum value (SPEC §4.2)
    s·.serialize_bits(v·.Preferred, 4) // the enum value (SPEC §4.2)
    return true

// WriteProbeArray writes v in wire order (SPEC §6.1). Write misuse the runtime
// sees traps in every run; the schema's own contracts are asserts.
def WriteProbeArray(s·:serialize_write_stream, v·:ProbeArray) -> bool:
    for(2) _i·:
        WriteProbeSample(s·, v·.Samples[_i·])
    WriteProbeConfig(s·, v·.Config)
    return true

// WriteHeartbeat writes v in wire order (SPEC §6.1). Write misuse the runtime
// sees traps in every run; the schema's own contracts are asserts.
def WriteHeartbeat(s·:serialize_write_stream, v·:Heartbeat) -> bool:
    return true

// WriteTest writes v in wire order (SPEC §6.1). Write misuse the runtime
// sees traps in every run; the schema's own contracts are asserts.
def WriteTest(s·:serialize_write_stream, v·:Test) -> bool:
    s·.serialize_bits(v·.TestA, 16) // the storage width (SPEC §4.3)
    assert v·.TestB >= 0 and v·.TestB <= 1000 // the value is in [min, max] (SPEC §4.3)
    s·.serialize_bits(v·.TestB, 10) // the offset from min (SPEC §4.3)
    assert v·.TestC >= 0 and v·.TestC <= 1000 // the value is in [min, max] (SPEC §4.3)
    s·.serialize_bits(v·.TestC, 10) // the offset from min (SPEC §4.3)
    assert v·.TestD >= 0 and v·.TestD <= 1000 // the value is in [min, max] (SPEC §4.3)
    s·.serialize_bits(v·.TestD, 10) // the offset from min (SPEC §4.3)
    return true

// WriteBlock writes v in wire order (SPEC §6.1). Write misuse the runtime
// sees traps in every run; the schema's own contracts are asserts.
def WriteBlock(s·:serialize_write_stream, v·:Block) -> bool:
    assert v·.DataLength >= 0 and v·.DataLength <= 2000 // the used length is in [0, 2000] (SPEC §4.7)
    s·.serialize_bits(v·.DataLength, 11) // the used length (SPEC §4.7)
    s·.serialize_bytes(v·.Data, v·.DataLength) // aligns, then the used bytes (SPEC §4.7)
    return true

// WriteChat writes v in wire order (SPEC §6.1). Write misuse the runtime
// sees traps in every run; the schema's own contracts are asserts.
def WriteChat(s·:serialize_write_stream, v·:Chat) -> bool:
    assert v·.TextLength >= 0 and v·.TextLength <= 256 // the used length is in [0, 256] (SPEC §4.7)
    assert schema_rt.text_refusal(v·.Text, v·.TextLength) == serialize_refusal_none // no interior NUL, well-formed UTF-8 (SPEC §4.7)
    s·.serialize_bits(v·.TextLength, 9) // the used length (SPEC §4.7)
    s·.serialize_bytes(v·.Text, v·.TextLength) // aligns, then the used bytes (SPEC §4.7)
    return true

// WriteProbeReport writes v in wire order (SPEC §6.1). Write misuse the runtime
// sees traps in every run; the schema's own contracts are asserts.
def WriteProbeReport(s·:serialize_write_stream, v·:ProbeReport) -> bool:
    WriteProbeHeader(s·, v·.Header)
    assert v·.Flags >= 0 and v·.Flags < 0x100 // the mask fits 8 bits (SPEC §4.2)
    s·.serialize_bits(v·.Flags, 8) // the flags wire width (SPEC §4.2)
    WriteTest(s·, v·.Echo)
    return true

// WriteTestData writes v in wire order (SPEC §6.1). Write misuse the runtime
// sees traps in every run; the schema's own contracts are asserts.
def WriteTestData(s·:serialize_write_stream, v·:TestData) -> bool:
    assert v·.A >= -100 and v·.A <= 100 // the value is in [min, max] (SPEC §4.3)
    s·.serialize_bits(v·.A - (-100), 8) // the offset from min (SPEC §4.3)
    assert v·.B >= -100 and v·.B <= 100 // the value is in [min, max] (SPEC §4.3)
    s·.serialize_bits(v·.B - (-100), 8) // the offset from min (SPEC §4.3)
    assert v·.C >= -100 and v·.C <= 150 // the value is in [min, max] (SPEC §4.3)
    s·.serialize_bits(v·.C - (-100), 8) // the offset from min (SPEC §4.3)
    s·.serialize_bits(v·.D, 8) // the declared bit width (SPEC §4.3)
    s·.serialize_bits(v·.E, 8) // the declared bit width (SPEC §4.3)
    s·.serialize_bits(v·.F, 8) // the declared bit width (SPEC §4.3)
    s·.serialize_bool(v·.G) // SPEC §4.3
    assert v·.ItemsCount >= 0 and v·.ItemsCount <= 16 // the count is in [0, 16] (SPEC §4.6)
    s·.serialize_bits(v·.ItemsCount, 5) // the count (SPEC §4.6)
    for(v·.ItemsCount) _i·: // the count guards the loop (SPEC §6.3)
        assert v·.Items[_i·] >= 0 and v·.Items[_i·] <= 255 // the value is in [min, max] (SPEC §4.3)
        s·.serialize_bits(v·.Items[_i·], 8) // the offset from min (SPEC §4.3)
    s·.serialize_float(v·.FloatValue) // finite only: NaN and ±inf trap (SPEC §4.3)
    assert v·.CompressedFloatValue - v·.CompressedFloatValue != 0.0 or (v·.CompressedFloatValue >= 0.0 and v·.CompressedFloatValue <= 10.0) // a finite value is in [min, max] (SPEC §5.1 row 10)
    s·.serialize_compressed_float_precomputed(v·.CompressedFloatValue, 1000, 10, 10.0, 0.0) // the step index; a non-finite value traps (SPEC §4.3)
    s·.serialize_double(v·.DoubleValue) // finite only: NaN and ±inf trap (SPEC §4.3)
    assert v·.Int8Value >= -128 and v·.Int8Value <= 127 // the value fits the declared 8-bit width (SPEC §5.1 row 11)
    s·.serialize_bits((v·.Int8Value & 0xff), 8) // the storage width (SPEC §4.3)
    assert v·.Int16Value >= -32768 and v·.Int16Value <= 32767 // the value fits the declared 16-bit width (SPEC §5.1 row 11)
    s·.serialize_bits((v·.Int16Value & 0xffff), 16) // the storage width (SPEC §4.3)
    s·.serialize_bits(v·.Uint8Value, 8) // the storage width (SPEC §4.3)
    s·.serialize_bits(v·.Uint16Value, 16) // the storage width (SPEC §4.3)
    s·.serialize_bits(v·.Uint32Value, 32) // the storage width (SPEC §4.3)
    s·.serialize_bits64(v·.Uint64Value, 64) // the storage width (SPEC §4.3)
    s·.serialize_bits64(v·.Int64Full, 64) // the storage width (SPEC §4.3)
    assert v·.Int64Range >= -1000000000000 and v·.Int64Range <= 1000000000000 // the value is in [min, max] (SPEC §4.3)
    s·.serialize_bits64(v·.Int64Range - (-1000000000000), 41) // the offset from min (SPEC §4.3)
    s·.serialize_align() // align (SPEC §4.3)
    s·.serialize_bytes(v·.FixedBytes, 17) // [N]uint8 at a byte-aligned position: one bulk copy, wire-identical to the per-byte loop (SPEC §4.7)
    assert v·.TextLength >= 0 and v·.TextLength <= 255 // the used length is in [0, 255] (SPEC §4.7)
    assert schema_rt.text_refusal(v·.Text, v·.TextLength) == serialize_refusal_none // no interior NUL, well-formed UTF-8 (SPEC §4.7)
    s·.serialize_bits(v·.TextLength, 8) // the used length (SPEC §4.7)
    s·.serialize_bytes(v·.Text, v·.TextLength) // aligns, then the used bytes (SPEC §4.7)
    return true

// WriteCompressedProbe writes v in wire order (SPEC §6.1). Write misuse the runtime
// sees traps in every run; the schema's own contracts are asserts.
def WriteCompressedProbe(s·:serialize_write_stream, v·:CompressedProbe) -> bool:
    assert v·.Boundary - v·.Boundary != 0.0 or (v·.Boundary >= 0.0 and v·.Boundary <= 10.0) // a finite value is in [min, max] (SPEC §5.1 row 10)
    s·.serialize_compressed_float_precomputed(v·.Boundary, 1000, 10, 10.0, 0.0) // the step index; a non-finite value traps (SPEC §4.3)
    assert v·.Offset - v·.Offset != 0.0 or (v·.Offset >= -5.0 and v·.Offset <= 5.0) // a finite value is in [min, max] (SPEC §5.1 row 10)
    s·.serialize_compressed_float_precomputed(v·.Offset, 10000, 14, 10.0, -5.0) // the step index; a non-finite value traps (SPEC §4.3)
    return true
