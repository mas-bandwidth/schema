// read_body_Chat decodes the wire into value, filling its pre-allocated
// storage (SPEC §6.1); the untaken side of a branch reads as zero (SPEC §5).
// It does not end the packet. A refusal latches the stream with its reason
// and answers false.
def read_body_Chat(stream·:serialize_read_stream, value·:Chat) -> bool:
    var rv· = 0
    var rok· = true
