-- WriteTrioFirst writes the type wire (SPEC §4.3, §6.1: the declared order).
function M.WriteTrioFirst(stream: any, value: TrioFirst): boolean
	if type(value.Inner) ~= "table" then -- record storage
		return false
	end
	if not M.WriteTrio(stream, value.Inner) then
		return false
	end
	if not isInt(value.Trailer, 0, 65535) then
		return false
	end
	NUM.value = value.Trailer
	if not stream:serializeBits(NUM, 16) then
		return false
	end
	return true
end

-- ReadTrioFirstBody reads the type wire; false refuses (stream:error() names a runtime
-- refusal; a schema rule's refusal returns false unlatched). A nested read
-- stops here; the end check belongs to the public one-packet read (SPEC §5).
