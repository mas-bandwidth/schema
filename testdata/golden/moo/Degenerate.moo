-- type TrioFirst
export type TrioFirst = {
	Inner: Trio,
	Trailer: number,
}

-- TrioFirstMaxBits is the longest wire path; align pads at worst case (SPEC §6.1).
-- TrioFirstMaxBytes is rounded up to the 8-byte write-buffer granularity.
M.TrioFirstMaxBits = 80
M.TrioFirstMaxBytes = 16

-- NewTrioFirst builds the value at its defaults (SPEC §5).
function M.NewTrioFirst(): TrioFirst
	local value: TrioFirst = {
		Inner = M.NewTrio(),
		Trailer = 0,
	}
	return value
end

-- InitTrioFirst restores fresh construction values in place, preserving storage.
function M.InitTrioFirst(value: TrioFirst)
	M.InitTrio(value.Inner)
	value.Trailer = 0
end

-- ZeroTrioFirst resets the §5 zero form: all-zero storage, without declared defaults.
function M.ZeroTrioFirst(value: TrioFirst)
	M.ZeroTrio(value.Inner)
	value.Trailer = 0
