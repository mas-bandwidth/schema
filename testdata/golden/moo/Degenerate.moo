	if not M.ReadTrioBody(stream, value.Inner) then
		return false
	end
	if not stream:serializeBits(NUM, 16) then
		return false
	end
	value.Trailer = NUM.value
	return true
end

-- ReadTrioFirst is the one-packet read: ReadTrioFirstBody, then the end check once after
-- the top-level object (SPEC §5); it reports the object's bits consumed.
function M.ReadTrioFirst(stream: any, value: TrioFirst): boolean
	if not M.ReadTrioFirstBody(stream, value) then
		return false
	end
	local bits = stream:bitsProcessed()
	local reader = stream._reader
	local bitsRead = reader._bitsRead
	if not stream:serializeEnd() then
		return false
	end
	stream._bits = bits
	reader._bitsRead = bitsRead
	return true
