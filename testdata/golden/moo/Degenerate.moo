-- type TrioStraddle
export type TrioStraddle = {
	Pad0: any,
	Pad1: any,
	Pad2: any,
	Pad3: any,
	Pad4: any,
	Pad5: number,
	Inner: Trio,
}

-- TrioStraddleMaxBits is the longest wire path; align pads at worst case (SPEC §6.1).
-- TrioStraddleMaxBytes is rounded up to the 8-byte write-buffer granularity.
M.TrioStraddleMaxBits = 408
M.TrioStraddleMaxBytes = 56

-- NewTrioStraddle builds the value at its defaults (SPEC §5).
function M.NewTrioStraddle(): TrioStraddle
	local value: TrioStraddle = {
		Pad0 = K1,
		Pad1 = K1,
		Pad2 = K1,
		Pad3 = K1,
		Pad4 = K1,
		Pad5 = 0,
		Inner = M.NewTrio(),
	}
	return value
end

-- InitTrioStraddle restores fresh construction values in place, preserving storage.
function M.InitTrioStraddle(value: TrioStraddle)
	value.Pad0 = K1
	value.Pad1 = K1
	value.Pad2 = K1
	value.Pad3 = K1
	value.Pad4 = K1
	value.Pad5 = 0
	M.InitTrio(value.Inner)
end

-- ZeroTrioStraddle resets the §5 zero form: all-zero storage, without declared defaults.
function M.ZeroTrioStraddle(value: TrioStraddle)
	value.Pad0 = K1
	value.Pad1 = K1
	value.Pad2 = K1
	value.Pad3 = K1
	value.Pad4 = K1
	value.Pad5 = 0
	M.ZeroTrio(value.Inner)
end

-- WriteTrioStraddle writes the type wire (SPEC §4.3, §6.1: the declared order).
function M.WriteTrioStraddle(stream: any, value: TrioStraddle): boolean
	if not isWide(serialize.Uint64, value.Pad0, K1, K3) then
		return false
	end
	WIDE.value = value.Pad0
	if not stream:serializeBits64(WIDE, 64) then
		return false
	end
	if not isWide(serialize.Uint64, value.Pad1, K1, K3) then
		return false
	end
	WIDE.value = value.Pad1
	if not stream:serializeBits64(WIDE, 64) then
		return false
	end
	if not isWide(serialize.Uint64, value.Pad2, K1, K3) then
		return false
	end
	WIDE.value = value.Pad2
	if not stream:serializeBits64(WIDE, 64) then
		return false
	end
	if not isWide(serialize.Uint64, value.Pad3, K1, K3) then
		return false
	end
	WIDE.value = value.Pad3
	if not stream:serializeBits64(WIDE, 64) then
		return false
	end
	if not isWide(serialize.Uint64, value.Pad4, K1, K3) then
		return false
	end
	WIDE.value = value.Pad4
	if not stream:serializeBits64(WIDE, 64) then
		return false
	end
	if not isInt(value.Pad5, 0, 16777215) then
		return false
	end
	NUM.value = value.Pad5
	if not stream:serializeBits(NUM, 24) then
		return false
	end
	if type(value.Inner) ~= "table" then -- record storage
		return false
	end
	if not M.WriteTrio(stream, value.Inner) then
		return false
	end
	return true
end

-- ReadTrioStraddleBody reads the type wire; false refuses (stream:error() names a runtime
-- refusal; a schema rule's refusal returns false unlatched). A nested read
-- stops here; the end check belongs to the public one-packet read (SPEC §5).
function M.ReadTrioStraddleBody(stream: any, value: TrioStraddle): boolean
	if not stream:serializeBits64(WIDE, 64) then
		return false
	end
	value.Pad0 = WIDE.value
	if not stream:serializeBits64(WIDE, 64) then
		return false
	end
	value.Pad1 = WIDE.value
	if not stream:serializeBits64(WIDE, 64) then
		return false
	end
	value.Pad2 = WIDE.value
	if not stream:serializeBits64(WIDE, 64) then
		return false
	end
	value.Pad3 = WIDE.value
	if not stream:serializeBits64(WIDE, 64) then
		return false
	end
	value.Pad4 = WIDE.value
	if not stream:serializeBits(NUM, 24) then
		return false
	end
	value.Pad5 = NUM.value
	if not M.ReadTrioBody(stream, value.Inner) then
		return false
	end
	return true
end

-- ReadTrioStraddle is the one-packet read: ReadTrioStraddleBody, then the end check once after
-- the top-level object (SPEC §5); it reports the object's bits consumed.
function M.ReadTrioStraddle(stream: any, value: TrioStraddle): boolean
	if not M.ReadTrioStraddleBody(stream, value) then
		return false
	end
	local bits = stream:bitsProcessed()
	local reader = stream._reader
	local bitsRead = reader._bitsRead
	if not stream:serializeEnd() then
		return false
	end
	stream._bits = bits
	reader._bitsRead = bitsRead
	return true
end

return M
