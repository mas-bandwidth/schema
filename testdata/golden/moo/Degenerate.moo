	end
	if not isInt(value.B, 0, 1048575) then
		return false
	end
	NUM.value = value.B
	if not stream:serializeBits(NUM, 20) then
		return false
	end
	if not isInt(value.C, 0, 16777215) then
		return false
	end
	NUM.value = value.C
	if not stream:serializeBits(NUM, 24) then
		return false
	end
	return true
end

-- ReadTrioBody reads the type wire; false refuses (stream:error() names a runtime
-- refusal; a schema rule's refusal returns false unlatched). A nested read
-- stops here; the end check belongs to the public one-packet read (SPEC §5).
function M.ReadTrioBody(stream: any, value: Trio): boolean
	if not stream:serializeBits(NUM, 20) then
		return false
	end
	value.A = NUM.value
	if not stream:serializeBits(NUM, 20) then
		return false
	end
	value.B = NUM.value
	if not stream:serializeBits(NUM, 24) then
		return false
	end
	value.C = NUM.value
	return true
end

-- ReadTrio is the one-packet read: ReadTrioBody, then the end check once after
-- the top-level object (SPEC §5); it reports the object's bits consumed.
function M.ReadTrio(stream: any, value: Trio): boolean
	if not M.ReadTrioBody(stream, value) then
		return false
	end
	local bits = stream:bitsProcessed()
	local reader = stream._reader
	local bitsRead = reader._bitsRead
	if not stream:serializeEnd() then
		return false
	end
	stream._bits = bits
	reader._bitsRead = bitsRead
	return true
end

