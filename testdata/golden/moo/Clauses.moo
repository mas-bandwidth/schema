-- EmptyUnionType: union EmptyUnion's tag — None = 0, then each variant in declared order (SPEC §4.8)
export type EmptyUnionType = number
M.EmptyUnionType = table.freeze({
	None = 0,
	A = 1,
	B = 2,
})
M.EmptyUnionTypeMax = 2 -- the exported extent (SPEC §4.2)

local _EnumNameEmptyUnionType = table.freeze({ [0] = "None", [1] = "A", [2] = "B" })
-- EnumNameEmptyUnionType: the debug/log name of a EmptyUnionType value; out-of-set values name "???"
function M.EnumNameEmptyUnionType(value: number): string
	return _EnumNameEmptyUnionType[value] or "???"
end

-- EmptyUnion — at most one arm; Type says which. Construction is the empty union
-- (None); every arm is pre-allocated, and an unselected arm is unspecified.
export type EmptyUnion = {
	Type: number,
	A: EmptyA,
	B: EmptyB,
}

-- EmptyUnionMaxBits is the tag plus the largest arm; None costs the tag only (SPEC §4.8).
M.EmptyUnionMaxBits = 2
M.EmptyUnionMaxBytes = 8

function M.NewEmptyUnion(): EmptyUnion
	local value: EmptyUnion = {
		Type = 0,
		A = M.NewEmptyA(),
		B = M.NewEmptyB(),
	}
	return value
end

-- InitEmptyUnion and ZeroEmptyUnion reset the union to None; dormant arms keep their storage.
function M.InitEmptyUnion(value: EmptyUnion)
	value.Type = 0
end

function M.ZeroEmptyUnion(value: EmptyUnion)
	value.Type = 0
end

-- WriteEmptyUnion: the tag in minimal bits for [0, 2], validated before it rides,
-- then the selected arm only (SPEC §4.8).
function M.WriteEmptyUnion(stream: any, value: EmptyUnion): boolean
	if not isInt(value.Type, 0, 2) then -- the tag validates before it rides (SPEC §4.8)
		return false
	end
	NUM.value = value.Type
	if not stream:serializeInt(NUM, 0, 2) then
		return false
	end
	if value.Type == 1 then
		if type(value.A) ~= "table" then -- record storage
			return false
		end
		if not M.WriteEmptyA(stream, value.A) then
			return false
		end
	end
	if value.Type == 2 then
		if type(value.B) ~= "table" then -- record storage
			return false
		end
		if not M.WriteEmptyB(stream, value.B) then
			return false
		end
	end
	return true -- None, or a payload-free arm: the tag is the whole wire
end

-- ReadEmptyUnionBody: a tag above 2 is refused; a selected arm takes fresh declared
-- defaults, then its payload (SPEC §4.8). A nested read stops here; the end
-- check belongs to the public one-packet read (SPEC §5).
function M.ReadEmptyUnionBody(stream: any, value: EmptyUnion): boolean
	if not stream:serializeInt(NUM, 0, 2) then -- rejects a tag above the count (SPEC §4.8)
		return false
	end
	value.Type = NUM.value
	if value.Type == 1 then
		M.InitEmptyA(value.A)
		if not M.ReadEmptyABody(stream, value.A) then
			return false
		end
	end
	if value.Type == 2 then
		M.InitEmptyB(value.B)
		if not M.ReadEmptyBBody(stream, value.B) then
			return false
		end
	end
	return true
end

-- ReadEmptyUnion is the one-packet read: ReadEmptyUnionBody, then the end check once after
-- the top-level object (SPEC §5); it reports the object's bits consumed.
function M.ReadEmptyUnion(stream: any, value: EmptyUnion): boolean
	if not M.ReadEmptyUnionBody(stream, value) then
		return false
	end
	local bits = stream:bitsProcessed()
	local reader = stream._reader
	local bitsRead = reader._bitsRead
	if not stream:serializeEnd() then
		return false
	end
	stream._bits = bits
	reader._bitsRead = bitsRead
	return true
end

-- type HoldsEmptyUnion
export type HoldsEmptyUnion = {
	Lead: number,
	U: EmptyUnion,
	Tail: number,
}

-- HoldsEmptyUnionMaxBits is the longest wire path; align pads at worst case (SPEC §6.1).
-- HoldsEmptyUnionMaxBytes is rounded up to the 8-byte write-buffer granularity.
M.HoldsEmptyUnionMaxBits = 14
M.HoldsEmptyUnionMaxBytes = 8

-- NewHoldsEmptyUnion builds the value at its defaults (SPEC §5).
function M.NewHoldsEmptyUnion(): HoldsEmptyUnion
	local value: HoldsEmptyUnion = {
		Lead = 0,
		U = M.NewEmptyUnion(),
		Tail = 0,
	}
	return value
end

-- InitHoldsEmptyUnion restores fresh construction values in place, preserving storage.
function M.InitHoldsEmptyUnion(value: HoldsEmptyUnion)
	value.Lead = 0
	M.InitEmptyUnion(value.U)
	value.Tail = 0
end

-- ZeroHoldsEmptyUnion resets the §5 zero form: all-zero storage, without declared defaults.
function M.ZeroHoldsEmptyUnion(value: HoldsEmptyUnion)
	value.Lead = 0
	M.ZeroEmptyUnion(value.U)
	value.Tail = 0
end

-- WriteHoldsEmptyUnion writes the type wire (SPEC §4.3, §6.1: the declared order).
function M.WriteHoldsEmptyUnion(stream: any, value: HoldsEmptyUnion): boolean
	if not isInt(value.Lead, 0, 31) then
		return false
	end
	NUM.value = value.Lead
	if not stream:serializeBits(NUM, 5) then
		return false
	end
	if type(value.U) ~= "table" then -- record storage
		return false
	end
	if not M.WriteEmptyUnion(stream, value.U) then
		return false
	end
	if not isInt(value.Tail, 0, 127) then
		return false
	end
	NUM.value = value.Tail
	if not stream:serializeBits(NUM, 7) then
		return false
	end
	return true
end

-- ReadHoldsEmptyUnionBody reads the type wire; false refuses (stream:error() names a runtime
-- refusal; a schema rule's refusal returns false unlatched). A nested read
-- stops here; the end check belongs to the public one-packet read (SPEC §5).
function M.ReadHoldsEmptyUnionBody(stream: any, value: HoldsEmptyUnion): boolean
	if not stream:serializeBits(NUM, 5) then
		return false
	end
	value.Lead = NUM.value
	if not M.ReadEmptyUnionBody(stream, value.U) then
		return false
	end
	if not stream:serializeBits(NUM, 7) then
		return false
	end
	value.Tail = NUM.value
	return true
end

-- ReadHoldsEmptyUnion is the one-packet read: ReadHoldsEmptyUnionBody, then the end check once after
-- the top-level object (SPEC §5); it reports the object's bits consumed.
function M.ReadHoldsEmptyUnion(stream: any, value: HoldsEmptyUnion): boolean
	if not M.ReadHoldsEmptyUnionBody(stream, value) then
		return false
	end
	local bits = stream:bitsProcessed()
	local reader = stream._reader
	local bitsRead = reader._bitsRead
	if not stream:serializeEnd() then
		return false
	end
	stream._bits = bits
	reader._bitsRead = bitsRead
	return true
end

-- type Strs
export type Strs = {
	Lead: number,
	S: string,
	B: buffer,
	BLength: number,
	Tail: number,
}

-- StrsMaxBits is the longest wire path; align pads at worst case (SPEC §6.1).
-- StrsMaxBytes is rounded up to the 8-byte write-buffer granularity.
M.StrsMaxBits = 158
M.StrsMaxBytes = 24

-- NewStrs builds the value at its defaults (SPEC §5).
function M.NewStrs(): Strs
	local value: Strs = {
		Lead = 0,
		S = "",
		B = buffer.create(8), -- bytes(8), used length beside it (SPEC §4.7)
		BLength = 0,
		Tail = 0,
	}
	return value
end

-- InitStrs restores fresh construction values in place, preserving storage.
function M.InitStrs(value: Strs)
	value.Lead = 0
	value.S = ""
	buffer.fill(value.B, 0, 0)
	value.BLength = 0
	value.Tail = 0
end

-- ZeroStrs resets the §5 zero form: all-zero storage, without declared defaults.
function M.ZeroStrs(value: Strs)
	value.Lead = 0
	value.S = ""
	buffer.fill(value.B, 0, 0)
	value.BLength = 0
	value.Tail = 0
end

-- WriteStrs writes the type wire (SPEC §4.3, §6.1: the declared order).
function M.WriteStrs(stream: any, value: Strs): boolean
	if not isInt(value.Lead, 0, 31) then
		return false
	end
	NUM.value = value.Lead
	if not stream:serializeBits(NUM, 5) then
		return false
	end
	if type(value.S) ~= "string" or #value.S > 8 or not validText(value.S) then -- well-formed UTF-8, no zero byte, at most N bytes (SPEC §4.7)
		return false
	end
	STR.value = value.S
	if not stream:serializeString(STR, 9) then -- length, align, the bytes (SPEC §4.7)
		return false
	end
	if type(value.B) ~= "buffer" or not isInt(value.BLength, 0, 8) or buffer.len(value.B) < value.BLength then -- the length guards the slice (SPEC §6.3)
		return false
	end
	NUM.value = value.BLength
	if not stream:serializeInt(NUM, 0, 8) then
		return false
	end
	if not stream:serializeBytes(value.B, 0, value.BLength) then -- align, then the used bytes (SPEC §4.7)
		return false
	end
	if not isInt(value.Tail, 0, 7) then
		return false
	end
	NUM.value = value.Tail
	if not stream:serializeBits(NUM, 3) then
		return false
	end
	return true
end

-- ReadStrsBody reads the type wire; false refuses (stream:error() names a runtime
-- refusal; a schema rule's refusal returns false unlatched). A nested read
-- stops here; the end check belongs to the public one-packet read (SPEC §5).
function M.ReadStrsBody(stream: any, value: Strs): boolean
	if not stream:serializeBits(NUM, 5) then
		return false
	end
	value.Lead = NUM.value
	if not stream:serializeString(STR, 9) then -- refuses a zero byte, then malformed UTF-8 (SPEC §4.7)
		return false
	end
	value.S = STR.value
	if not stream:serializeInt(NUM, 0, 8) then -- the length guards the payload (SPEC §6.3)
		return false
	end
	value.BLength = NUM.value
	if not stream:serializeBytes(value.B, 0, value.BLength) then
		return false
	end
	if not stream:serializeBits(NUM, 3) then
		return false
	end
	value.Tail = NUM.value
	return true
end

-- ReadStrs is the one-packet read: ReadStrsBody, then the end check once after
-- the top-level object (SPEC §5); it reports the object's bits consumed.
function M.ReadStrs(stream: any, value: Strs): boolean
	if not M.ReadStrsBody(stream, value) then
		return false
	end
	local bits = stream:bitsProcessed()
	local reader = stream._reader
	local bitsRead = reader._bitsRead
	if not stream:serializeEnd() then
		return false
	end
	stream._bits = bits
	reader._bitsRead = bitsRead
	return true
end

-- type ArrNested
export type ArrNested = {
	Lead: number,
	Items: {Eleven},
	ItemsCount: number,
	Tail: number,
}

-- ArrNestedMaxBits is the longest wire path; align pads at worst case (SPEC §6.1).
-- ArrNestedMaxBytes is rounded up to the 8-byte write-buffer granularity.
M.ArrNestedMaxBits = 55
M.ArrNestedMaxBytes = 8

-- NewArrNested builds the value at its defaults (SPEC §5).
function M.NewArrNested(): ArrNested
	local value: ArrNested = {
		Lead = 0,
		Items = table.create(4) :: {Eleven},
		ItemsCount = 0,
		Tail = 0,
	}
	for i = 1, 4 do
		value.Items[i] = M.NewEleven()
	end
	return value
end

-- InitArrNested restores fresh construction values in place, preserving storage.
function M.InitArrNested(value: ArrNested)
	value.Lead = 0
	for i = 1, 4 do
	M.InitEleven(value.Items[i])
	end
	value.ItemsCount = 0
	value.Tail = 0
end

-- ZeroArrNested resets the §5 zero form: all-zero storage, without declared defaults.
function M.ZeroArrNested(value: ArrNested)
	value.Lead = 0
	for i = 1, 4 do
	M.ZeroEleven(value.Items[i])
	end
	value.ItemsCount = 0
	value.Tail = 0
end

-- WriteArrNested writes the type wire (SPEC §4.3, §6.1: the declared order).
function M.WriteArrNested(stream: any, value: ArrNested): boolean
	if not isInt(value.Lead, 0, 31) then
		return false
	end
	NUM.value = value.Lead
	if not stream:serializeBits(NUM, 5) then
		return false
	end
	if type(value.Items) ~= "table" then -- the array's table storage
		return false
	end
	if not isInt(value.ItemsCount, 0, 4) then -- the count guards the loop (SPEC §6.3)
		return false
	end
	for i = 1, value.ItemsCount do
		if type(value.Items[i]) ~= "table" then -- each live record has table storage
			return false
		end
	end
	NUM.value = value.ItemsCount
	if not stream:serializeInt(NUM, 0, 4) then -- the count (SPEC §4.6)
		return false
	end
	for i = 1, value.ItemsCount do
		if type(value.Items[i]) ~= "table" then -- record storage
			return false
		end
		if not M.WriteEleven(stream, value.Items[i]) then
			return false
		end
	end
	if not isInt(value.Tail, 0, 7) then
		return false
	end
	NUM.value = value.Tail
	if not stream:serializeBits(NUM, 3) then
		return false
	end
	return true
end

-- ReadArrNestedBody reads the type wire; false refuses (stream:error() names a runtime
-- refusal; a schema rule's refusal returns false unlatched). A nested read
-- stops here; the end check belongs to the public one-packet read (SPEC §5).
function M.ReadArrNestedBody(stream: any, value: ArrNested): boolean
	if not stream:serializeBits(NUM, 5) then
		return false
	end
	value.Lead = NUM.value
	if not stream:serializeInt(NUM, 0, 4) then -- the count guards the loop (SPEC §6.3)
		return false
	end
	value.ItemsCount = NUM.value
	for i = 1, value.ItemsCount do
		if not M.ReadElevenBody(stream, value.Items[i]) then
			return false
		end
	end
	if not stream:serializeBits(NUM, 3) then
		return false
	end
	value.Tail = NUM.value
	return true
end

-- ReadArrNested is the one-packet read: ReadArrNestedBody, then the end check once after
-- the top-level object (SPEC §5); it reports the object's bits consumed.
function M.ReadArrNested(stream: any, value: ArrNested): boolean
	if not M.ReadArrNestedBody(stream, value) then
		return false
	end
	local bits = stream:bitsProcessed()
	local reader = stream._reader
	local bitsRead = reader._bitsRead
	if not stream:serializeEnd() then
		return false
	end
	stream._bits = bits
	reader._bitsRead = bitsRead
	return true
end

-- type Sole
export type Sole = {
	Only: number,
}

-- SoleMaxBits is the longest wire path; align pads at worst case (SPEC §6.1).
-- SoleMaxBytes is rounded up to the 8-byte write-buffer granularity.
M.SoleMaxBits = 13
M.SoleMaxBytes = 8

-- NewSole builds the value at its defaults (SPEC §5).
function M.NewSole(): Sole
	local value: Sole = {
		Only = 0,
	}
	return value
end

-- InitSole restores fresh construction values in place, preserving storage.
function M.InitSole(value: Sole)
	value.Only = 0
end

-- ZeroSole resets the §5 zero form: all-zero storage, without declared defaults.
function M.ZeroSole(value: Sole)
	value.Only = 0
end

-- WriteSole writes the type wire (SPEC §4.3, §6.1: the declared order).
function M.WriteSole(stream: any, value: Sole): boolean
	if not isInt(value.Only, 0, 8191) then
		return false
	end
	NUM.value = value.Only
	if not stream:serializeBits(NUM, 13) then
		return false
	end
	return true
end

-- ReadSoleBody reads the type wire; false refuses (stream:error() names a runtime
-- refusal; a schema rule's refusal returns false unlatched). A nested read
-- stops here; the end check belongs to the public one-packet read (SPEC §5).
function M.ReadSoleBody(stream: any, value: Sole): boolean
	if not stream:serializeBits(NUM, 13) then
		return false
	end
	value.Only = NUM.value
	return true
end

-- ReadSole is the one-packet read: ReadSoleBody, then the end check once after
-- the top-level object (SPEC §5); it reports the object's bits consumed.
function M.ReadSole(stream: any, value: Sole): boolean
	if not M.ReadSoleBody(stream, value) then
		return false
	end
	local bits = stream:bitsProcessed()
	local reader = stream._reader
	local bitsRead = reader._bitsRead
	if not stream:serializeEnd() then
		return false
	end
	stream._bits = bits
	reader._bitsRead = bitsRead
	return true
end

return M
