function M.ZeroTri3(value: Tri3)
	value.A = 0
	value.B = 0
end

-- WriteTri3 writes the type wire (SPEC §4.3, §6.1: the declared order).
function M.WriteTri3(stream: any, value: Tri3): boolean
	if not isInt(value.A, 0, 1) then
		return false
	end
	NUM.value = value.A
	if not stream:serializeBits(NUM, 1) then
		return false
	end
	if not isInt(value.B, 0, 3) then
		return false
	end
	NUM.value = value.B
	if not stream:serializeBits(NUM, 2) then
		return false
	end
	return true
end

-- ReadTri3Body reads the type wire; false refuses (stream:error() names a runtime
-- refusal; a schema rule's refusal returns false unlatched). A nested read
-- stops here; the end check belongs to the public one-packet read (SPEC §5).
function M.ReadTri3Body(stream: any, value: Tri3): boolean
	if not stream:serializeBits(NUM, 1) then
		return false
	end
	value.A = NUM.value
	if not stream:serializeBits(NUM, 2) then
		return false
	end
	value.B = NUM.value
	return true
end

-- ReadTri3 is the one-packet read: ReadTri3Body, then the end check once after
-- the top-level object (SPEC §5); it reports the object's bits consumed.
function M.ReadTri3(stream: any, value: Tri3): boolean
	if not M.ReadTri3Body(stream, value) then
		return false
	end
	local bits = stream:bitsProcessed()
	local reader = stream._reader
	local bitsRead = reader._bitsRead
	if not stream:serializeEnd() then
		return false
	end
	stream._bits = bits
	reader._bitsRead = bitsRead
	return true
end

-- type ArrTri3
export type ArrTri3 = {
	Items: {Tri3},
	ItemsCount: number,
}

-- ArrTri3MaxBits is the longest wire path; align pads at worst case (SPEC §6.1).
-- ArrTri3MaxBytes is rounded up to the 8-byte write-buffer granularity.
M.ArrTri3MaxBits = 34
M.ArrTri3MaxBytes = 8

-- NewArrTri3 builds the value at its defaults (SPEC §5).
function M.NewArrTri3(): ArrTri3
	local value: ArrTri3 = {
		Items = table.create(10) :: {Tri3},
		ItemsCount = 0,
	}
	for i = 1, 10 do
		value.Items[i] = M.NewTri3()
	end
	return value
end

-- InitArrTri3 restores fresh construction values in place, preserving storage.
function M.InitArrTri3(value: ArrTri3)
	for i = 1, 10 do
	M.InitTri3(value.Items[i])
	end
	value.ItemsCount = 0
end

-- ZeroArrTri3 resets the §5 zero form: all-zero storage, without declared defaults.
function M.ZeroArrTri3(value: ArrTri3)
	for i = 1, 10 do
	M.ZeroTri3(value.Items[i])
	end
	value.ItemsCount = 0
end

-- WriteArrTri3 writes the type wire (SPEC §4.3, §6.1: the declared order).
function M.WriteArrTri3(stream: any, value: ArrTri3): boolean
	if type(value.Items) ~= "table" then -- the array's table storage
		return false
	end
	if not isInt(value.ItemsCount, 0, 10) then -- the count guards the loop (SPEC §6.3)
		return false
	end
	for i = 1, value.ItemsCount do
		if type(value.Items[i]) ~= "table" then -- each live record has table storage
			return false
		end
	end
	NUM.value = value.ItemsCount
	if not stream:serializeInt(NUM, 0, 10) then -- the count (SPEC §4.6)
		return false
	end
	for i = 1, value.ItemsCount do
		if type(value.Items[i]) ~= "table" then -- record storage
			return false
		end
		if not M.WriteTri3(stream, value.Items[i]) then
			return false
		end
	end
	return true
end

-- ReadArrTri3Body reads the type wire; false refuses (stream:error() names a runtime
-- refusal; a schema rule's refusal returns false unlatched). A nested read
-- stops here; the end check belongs to the public one-packet read (SPEC §5).
function M.ReadArrTri3Body(stream: any, value: ArrTri3): boolean
	if not stream:serializeInt(NUM, 0, 10) then -- the count guards the loop (SPEC §6.3)
		return false
	end
	value.ItemsCount = NUM.value
	for i = 1, value.ItemsCount do
		if not M.ReadTri3Body(stream, value.Items[i]) then
			return false
		end
	end
	return true
end

-- ReadArrTri3 is the one-packet read: ReadArrTri3Body, then the end check once after
-- the top-level object (SPEC §5); it reports the object's bits consumed.
function M.ReadArrTri3(stream: any, value: ArrTri3): boolean
	if not M.ReadArrTri3Body(stream, value) then
		return false
	end
	local bits = stream:bitsProcessed()
	local reader = stream._reader
	local bitsRead = reader._bitsRead
	if not stream:serializeEnd() then
		return false
	end
	stream._bits = bits
	reader._bitsRead = bitsRead
	return true
end

