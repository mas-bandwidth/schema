	end
	BOOL.value = value.Flag
	if not stream:serializeBool(BOOL) then
		return false
	end
	if value.Flag then
		if type(value.Items) ~= "table" then -- the array's table storage
			return false
		end
		if not isInt(value.ItemsCount, 0, 3) then -- the count guards the loop (SPEC §6.3)
			return false
		end
		NUM.value = value.ItemsCount
		if not stream:serializeInt(NUM, 0, 3) then -- the count (SPEC §4.6)
			return false
		end
		for i = 1, value.ItemsCount do
			if not isInt(value.Items[i], 0, 8191) then
				return false
			end
			NUM.value = value.Items[i]
			if not stream:serializeInt(NUM, 0, 8191) then -- int, offset from min (SPEC §4.3)
				return false
			end
		end
	else
		if not isInt(value.B, 0, 511) then
			return false
		end
		NUM.value = value.B
		if not stream:serializeBits(NUM, 9) then
			return false
		end
	end
	if not isInt(value.Tail, 0, 127) then
		return false
	end
	NUM.value = value.Tail
	if not stream:serializeBits(NUM, 7) then
		return false
	end
	return true
end

-- ReadArmArrayBody reads the type wire; false refuses (stream:error() names a runtime
-- refusal; a schema rule's refusal returns false unlatched). A nested read
-- stops here; the end check belongs to the public one-packet read (SPEC §5).
function M.ReadArmArrayBody(stream: any, value: ArmArray): boolean
	if not stream:serializeBits(NUM, 5) then
		return false
	end
	value.Lead = NUM.value
	if not stream:serializeBool(BOOL) then
		return false
	end
	value.Flag = BOOL.value
	if value.Flag then
		if not stream:serializeInt(NUM, 0, 3) then -- the count guards the loop (SPEC §6.3)
			return false
		end
		value.ItemsCount = NUM.value
		for i = 1, value.ItemsCount do
			if not stream:serializeInt(NUM, 0, 8191) then -- rejects out of range (SPEC §4.3)
				return false
			end
			value.Items[i] = NUM.value
		end
		value.B = 0
	else
		if not stream:serializeBits(NUM, 9) then
			return false
		end
		value.B = NUM.value
		for i = 1, 3 do
			value.Items[i] = 0
		end
		value.ItemsCount = 0
	end
	if not stream:serializeBits(NUM, 7) then
		return false
	end
	value.Tail = NUM.value
	return true
end

-- ReadArmArray is the one-packet read: ReadArmArrayBody, then the end check once after
-- the top-level object (SPEC §5); it reports the object's bits consumed.
function M.ReadArmArray(stream: any, value: ArmArray): boolean
	if not M.ReadArmArrayBody(stream, value) then
		return false
	end
	local bits = stream:bitsProcessed()
	local reader = stream._reader
	local bitsRead = reader._bitsRead
	if not stream:serializeEnd() then
		return false
	end
	stream._bits = bits
	reader._bitsRead = bitsRead
	return true
end

-- type Narrow
export type Narrow = {
	N: number,
}

-- NarrowMaxBits is the longest wire path; align pads at worst case (SPEC §6.1).
-- NarrowMaxBytes is rounded up to the 8-byte write-buffer granularity.
M.NarrowMaxBits = 3
M.NarrowMaxBytes = 8

-- NewNarrow builds the value at its defaults (SPEC §5).
function M.NewNarrow(): Narrow
	local value: Narrow = {
		N = 0,
	}
	return value
end

-- InitNarrow restores fresh construction values in place, preserving storage.
function M.InitNarrow(value: Narrow)
	value.N = 0
end

-- ZeroNarrow resets the §5 zero form: all-zero storage, without declared defaults.
function M.ZeroNarrow(value: Narrow)
	value.N = 0
end

-- WriteNarrow writes the type wire (SPEC §4.3, §6.1: the declared order).
function M.WriteNarrow(stream: any, value: Narrow): boolean
	if not isInt(value.N, 0, 7) then
		return false
	end
	NUM.value = value.N
	if not stream:serializeBits(NUM, 3) then
		return false
	end
	return true
end

-- ReadNarrowBody reads the type wire; false refuses (stream:error() names a runtime
-- refusal; a schema rule's refusal returns false unlatched). A nested read
-- stops here; the end check belongs to the public one-packet read (SPEC §5).
function M.ReadNarrowBody(stream: any, value: Narrow): boolean
	if not stream:serializeBits(NUM, 3) then
		return false
	end
	value.N = NUM.value
	return true
end

-- ReadNarrow is the one-packet read: ReadNarrowBody, then the end check once after
-- the top-level object (SPEC §5); it reports the object's bits consumed.
function M.ReadNarrow(stream: any, value: Narrow): boolean
	if not M.ReadNarrowBody(stream, value) then
		return false
	end
	local bits = stream:bitsProcessed()
	local reader = stream._reader
	local bitsRead = reader._bitsRead
	if not stream:serializeEnd() then
		return false
	end
	stream._bits = bits
	reader._bitsRead = bitsRead
	return true
end

-- type Wide
export type Wide = {
	W: any,
}

-- WideMaxBits is the longest wire path; align pads at worst case (SPEC §6.1).
-- WideMaxBytes is rounded up to the 8-byte write-buffer granularity.
M.WideMaxBits = 37
M.WideMaxBytes = 8

-- NewWide builds the value at its defaults (SPEC §5).
function M.NewWide(): Wide
	local value: Wide = {
		W = K1,
	}
	return value
end

-- InitWide restores fresh construction values in place, preserving storage.
function M.InitWide(value: Wide)
	value.W = K1
end

-- ZeroWide resets the §5 zero form: all-zero storage, without declared defaults.
function M.ZeroWide(value: Wide)
	value.W = K1
end

-- WriteWide writes the type wire (SPEC §4.3, §6.1: the declared order).
function M.WriteWide(stream: any, value: Wide): boolean
	if not isWide(serialize.Uint64, value.W, K1, K2) then
		return false
	end
	WIDE.value = value.W
	if not stream:serializeBits64(WIDE, 37) then
		return false
	end
	return true
end

-- ReadWideBody reads the type wire; false refuses (stream:error() names a runtime
-- refusal; a schema rule's refusal returns false unlatched). A nested read
-- stops here; the end check belongs to the public one-packet read (SPEC §5).
function M.ReadWideBody(stream: any, value: Wide): boolean
	if not stream:serializeBits64(WIDE, 37) then
		return false
	end
	value.W = WIDE.value
	return true
end

-- ReadWide is the one-packet read: ReadWideBody, then the end check once after
-- the top-level object (SPEC §5); it reports the object's bits consumed.
function M.ReadWide(stream: any, value: Wide): boolean
	if not M.ReadWideBody(stream, value) then
		return false
	end
	local bits = stream:bitsProcessed()
	local reader = stream._reader
	local bitsRead = reader._bitsRead
	if not stream:serializeEnd() then
		return false
	end
	stream._bits = bits
	reader._bitsRead = bitsRead
	return true
end

-- UnevenType: union Uneven's tag — None = 0, then each variant in declared order (SPEC §4.8)
export type UnevenType = number
M.UnevenType = table.freeze({
	None = 0,
	Narrow = 1,
	Wide = 2,
})
M.UnevenTypeMax = 2 -- the exported extent (SPEC §4.2)

local _EnumNameUnevenType = table.freeze({ [0] = "None", [1] = "Narrow", [2] = "Wide" })
-- EnumNameUnevenType: the debug/log name of a UnevenType value; out-of-set values name "???"
function M.EnumNameUnevenType(value: number): string
	return _EnumNameUnevenType[value] or "???"
end

-- Uneven — at most one arm; Type says which. Construction is the empty union
-- (None); every arm is pre-allocated, and an unselected arm is unspecified.
export type Uneven = {
	Type: number,
	Narrow: Narrow,
	Wide: Wide,
}

-- UnevenMaxBits is the tag plus the largest arm; None costs the tag only (SPEC §4.8).
M.UnevenMaxBits = 39
M.UnevenMaxBytes = 8

function M.NewUneven(): Uneven
	local value: Uneven = {
		Type = 0,
		Narrow = M.NewNarrow(),
		Wide = M.NewWide(),
	}
	return value
end

-- InitUneven and ZeroUneven reset the union to None; dormant arms keep their storage.
function M.InitUneven(value: Uneven)
	value.Type = 0
end

function M.ZeroUneven(value: Uneven)
	value.Type = 0
end

-- WriteUneven: the tag in minimal bits for [0, 2], validated before it rides,
-- then the selected arm only (SPEC §4.8).
function M.WriteUneven(stream: any, value: Uneven): boolean
	if not isInt(value.Type, 0, 2) then -- the tag validates before it rides (SPEC §4.8)
		return false
	end
	NUM.value = value.Type
	if not stream:serializeInt(NUM, 0, 2) then
		return false
	end
	if value.Type == 1 then
		if type(value.Narrow) ~= "table" then -- record storage
			return false
		end
		if not M.WriteNarrow(stream, value.Narrow) then
			return false
		end
	end
	if value.Type == 2 then
		if type(value.Wide) ~= "table" then -- record storage
			return false
		end
		if not M.WriteWide(stream, value.Wide) then
			return false
		end
	end
	return true -- None, or a payload-free arm: the tag is the whole wire
end

-- ReadUnevenBody: a tag above 2 is refused; a selected arm takes fresh declared
-- defaults, then its payload (SPEC §4.8). A nested read stops here; the end
-- check belongs to the public one-packet read (SPEC §5).
function M.ReadUnevenBody(stream: any, value: Uneven): boolean
	if not stream:serializeInt(NUM, 0, 2) then -- rejects a tag above the count (SPEC §4.8)
		return false
	end
	value.Type = NUM.value
	if value.Type == 1 then
		M.InitNarrow(value.Narrow)
		if not M.ReadNarrowBody(stream, value.Narrow) then
			return false
		end
	end
	if value.Type == 2 then
		M.InitWide(value.Wide)
		if not M.ReadWideBody(stream, value.Wide) then
			return false
		end
	end
	return true
end

-- ReadUneven is the one-packet read: ReadUnevenBody, then the end check once after
-- the top-level object (SPEC §5); it reports the object's bits consumed.
function M.ReadUneven(stream: any, value: Uneven): boolean
	if not M.ReadUnevenBody(stream, value) then
		return false
	end
	local bits = stream:bitsProcessed()
	local reader = stream._reader
	local bitsRead = reader._bitsRead
	if not stream:serializeEnd() then
		return false
	end
	stream._bits = bits
	reader._bitsRead = bitsRead
	return true
end

-- type HoldsUneven
export type HoldsUneven = {
	Lead: number,
	U: Uneven,
	Tail: number,
}

-- HoldsUnevenMaxBits is the longest wire path; align pads at worst case (SPEC §6.1).
-- HoldsUnevenMaxBytes is rounded up to the 8-byte write-buffer granularity.
M.HoldsUnevenMaxBits = 55
M.HoldsUnevenMaxBytes = 8

-- NewHoldsUneven builds the value at its defaults (SPEC §5).
function M.NewHoldsUneven(): HoldsUneven
	local value: HoldsUneven = {
		Lead = 0,
		U = M.NewUneven(),
		Tail = 0,
	}
	return value
end

-- InitHoldsUneven restores fresh construction values in place, preserving storage.
function M.InitHoldsUneven(value: HoldsUneven)
	value.Lead = 0
	M.InitUneven(value.U)
	value.Tail = 0
end

-- ZeroHoldsUneven resets the §5 zero form: all-zero storage, without declared defaults.
function M.ZeroHoldsUneven(value: HoldsUneven)
	value.Lead = 0
	M.ZeroUneven(value.U)
	value.Tail = 0
end

-- WriteHoldsUneven writes the type wire (SPEC §4.3, §6.1: the declared order).
function M.WriteHoldsUneven(stream: any, value: HoldsUneven): boolean
	if not isInt(value.Lead, 0, 31) then
		return false
	end
	NUM.value = value.Lead
	if not stream:serializeBits(NUM, 5) then
		return false
	end
	if type(value.U) ~= "table" then -- record storage
		return false
	end
	if not M.WriteUneven(stream, value.U) then
		return false
	end
	if not isInt(value.Tail, 0, 2047) then
		return false
	end
	NUM.value = value.Tail
	if not stream:serializeBits(NUM, 11) then
		return false
	end
	return true
end

-- ReadHoldsUnevenBody reads the type wire; false refuses (stream:error() names a runtime
-- refusal; a schema rule's refusal returns false unlatched). A nested read
-- stops here; the end check belongs to the public one-packet read (SPEC §5).
function M.ReadHoldsUnevenBody(stream: any, value: HoldsUneven): boolean
	if not stream:serializeBits(NUM, 5) then
		return false
	end
	value.Lead = NUM.value
	if not M.ReadUnevenBody(stream, value.U) then
		return false
	end
	if not stream:serializeBits(NUM, 11) then
		return false
	end
	value.Tail = NUM.value
	return true
end

-- ReadHoldsUneven is the one-packet read: ReadHoldsUnevenBody, then the end check once after
-- the top-level object (SPEC §5); it reports the object's bits consumed.
function M.ReadHoldsUneven(stream: any, value: HoldsUneven): boolean
	if not M.ReadHoldsUnevenBody(stream, value) then
		return false
	end
	local bits = stream:bitsProcessed()
	local reader = stream._reader
	local bitsRead = reader._bitsRead
	if not stream:serializeEnd() then
		return false
	end
	stream._bits = bits
	reader._bitsRead = bitsRead
	return true
end

-- type ArrUneven
export type ArrUneven = {
	Lead: number,
	Items: {Uneven},
	ItemsCount: number,
	Tail: number,
}

-- ArrUnevenMaxBits is the longest wire path; align pads at worst case (SPEC §6.1).
-- ArrUnevenMaxBytes is rounded up to the 8-byte write-buffer granularity.
M.ArrUnevenMaxBits = 127
M.ArrUnevenMaxBytes = 16

-- NewArrUneven builds the value at its defaults (SPEC §5).
function M.NewArrUneven(): ArrUneven
	local value: ArrUneven = {
		Lead = 0,
		Items = table.create(3) :: {Uneven},
		ItemsCount = 0,
		Tail = 0,
	}
	for i = 1, 3 do
		value.Items[i] = M.NewUneven()
	end
	return value
end

-- InitArrUneven restores fresh construction values in place, preserving storage.
function M.InitArrUneven(value: ArrUneven)
	value.Lead = 0
	for i = 1, 3 do
	M.InitUneven(value.Items[i])
	end
	value.ItemsCount = 0
	value.Tail = 0
end

-- ZeroArrUneven resets the §5 zero form: all-zero storage, without declared defaults.
function M.ZeroArrUneven(value: ArrUneven)
	value.Lead = 0
	for i = 1, 3 do
	M.ZeroUneven(value.Items[i])
	end
	value.ItemsCount = 0
	value.Tail = 0
end

-- WriteArrUneven writes the type wire (SPEC §4.3, §6.1: the declared order).
function M.WriteArrUneven(stream: any, value: ArrUneven): boolean
	if not isInt(value.Lead, 0, 31) then
		return false
	end
	NUM.value = value.Lead
	if not stream:serializeBits(NUM, 5) then
		return false
	end
	if type(value.Items) ~= "table" then -- the array's table storage
		return false
	end
	if not isInt(value.ItemsCount, 0, 3) then -- the count guards the loop (SPEC §6.3)
		return false
	end
	for i = 1, value.ItemsCount do
		if type(value.Items[i]) ~= "table" then -- each live record has table storage
			return false
		end
	end
	NUM.value = value.ItemsCount
	if not stream:serializeInt(NUM, 0, 3) then -- the count (SPEC §4.6)
		return false
	end
	for i = 1, value.ItemsCount do
		if type(value.Items[i]) ~= "table" then -- record storage
			return false
		end
		if not M.WriteUneven(stream, value.Items[i]) then
			return false
		end
	end
	if not isInt(value.Tail, 0, 7) then
		return false
	end
	NUM.value = value.Tail
	if not stream:serializeBits(NUM, 3) then
		return false
	end
	return true
end

-- ReadArrUnevenBody reads the type wire; false refuses (stream:error() names a runtime
-- refusal; a schema rule's refusal returns false unlatched). A nested read
-- stops here; the end check belongs to the public one-packet read (SPEC §5).
function M.ReadArrUnevenBody(stream: any, value: ArrUneven): boolean
	if not stream:serializeBits(NUM, 5) then
		return false
	end
	value.Lead = NUM.value
	if not stream:serializeInt(NUM, 0, 3) then -- the count guards the loop (SPEC §6.3)
		return false
	end
	value.ItemsCount = NUM.value
	for i = 1, value.ItemsCount do
		if not M.ReadUnevenBody(stream, value.Items[i]) then
			return false
		end
	end
	if not stream:serializeBits(NUM, 3) then
		return false
	end
	value.Tail = NUM.value
	return true
end

-- ReadArrUneven is the one-packet read: ReadArrUnevenBody, then the end check once after
-- the top-level object (SPEC §5); it reports the object's bits consumed.
function M.ReadArrUneven(stream: any, value: ArrUneven): boolean
	if not M.ReadArrUnevenBody(stream, value) then
		return false
	end
	local bits = stream:bitsProcessed()
	local reader = stream._reader
	local bitsRead = reader._bitsRead
	if not stream:serializeEnd() then
		return false
	end
	stream._bits = bits
	reader._bitsRead = bitsRead
	return true
end

-- type RegainAfterAlign
export type RegainAfterAlign = {
	Lead: number,
	Items: {number},
	ItemsCount: number,
	S: string,
	P: number,
	Q: number,
	R: number,
	Tail: number,
}

-- RegainAfterAlignMaxBits is the longest wire path; align pads at worst case (SPEC §6.1).
-- RegainAfterAlignMaxBytes is rounded up to the 8-byte write-buffer granularity.
M.RegainAfterAlignMaxBits = 172
M.RegainAfterAlignMaxBytes = 24

-- NewRegainAfterAlign builds the value at its defaults (SPEC §5).
function M.NewRegainAfterAlign(): RegainAfterAlign
	local value: RegainAfterAlign = {
		Lead = 0,
		Items = table.create(3, 0),
		ItemsCount = 0,
		S = "",
		P = 0,
		Q = 0,
		R = 0,
		Tail = 0,
	}
	return value
end

-- InitRegainAfterAlign restores fresh construction values in place, preserving storage.
function M.InitRegainAfterAlign(value: RegainAfterAlign)
	value.Lead = 0
	for i = 1, 3 do
		value.Items[i] = 0
	end
	value.ItemsCount = 0
	value.S = ""
	value.P = 0
	value.Q = 0
	value.R = 0
	value.Tail = 0
end

-- ZeroRegainAfterAlign resets the §5 zero form: all-zero storage, without declared defaults.
function M.ZeroRegainAfterAlign(value: RegainAfterAlign)
	value.Lead = 0
	for i = 1, 3 do
		value.Items[i] = 0
	end
	value.ItemsCount = 0
	value.S = ""
	value.P = 0
	value.Q = 0
	value.R = 0
	value.Tail = 0
end

-- WriteRegainAfterAlign writes the type wire (SPEC §4.3, §6.1: the declared order).
function M.WriteRegainAfterAlign(stream: any, value: RegainAfterAlign): boolean
	if not isInt(value.Lead, 0, 31) then
		return false
	end
	NUM.value = value.Lead
	if not stream:serializeBits(NUM, 5) then
		return false
	end
	if type(value.Items) ~= "table" then -- the array's table storage
		return false
	end
	if not isInt(value.ItemsCount, 0, 3) then -- the count guards the loop (SPEC §6.3)
		return false
	end
	NUM.value = value.ItemsCount
	if not stream:serializeInt(NUM, 0, 3) then -- the count (SPEC §4.6)
		return false
	end
	for i = 1, value.ItemsCount do
		if not isInt(value.Items[i], 0, 8191) then
			return false
		end
		NUM.value = value.Items[i]
		if not stream:serializeInt(NUM, 0, 8191) then -- int, offset from min (SPEC §4.3)
			return false
		end
	end
	if type(value.S) ~= "string" or #value.S > 4 or not validText(value.S) then -- well-formed UTF-8, no zero byte, at most N bytes (SPEC §4.7)
		return false
	end
	STR.value = value.S
	if not stream:serializeString(STR, 5) then -- length, align, the bytes (SPEC §4.7)
		return false
	end
	if not isInt(value.P, 0, 4294967295) then
		return false
	end
	NUM.value = value.P
	if not stream:serializeBits(NUM, 32) then
		return false
	end
	if not isInt(value.Q, 0, 536870911) then
		return false
	end
	NUM.value = value.Q
	if not stream:serializeBits(NUM, 29) then
		return false
	end
	if not isInt(value.R, 0, 524287) then
		return false
	end
	NUM.value = value.R
	if not stream:serializeBits(NUM, 19) then
		return false
	end
	if not isInt(value.Tail, 0, 15) then
		return false
	end
	NUM.value = value.Tail
	if not stream:serializeBits(NUM, 4) then
		return false
	end
	return true
end

-- ReadRegainAfterAlignBody reads the type wire; false refuses (stream:error() names a runtime
-- refusal; a schema rule's refusal returns false unlatched). A nested read
-- stops here; the end check belongs to the public one-packet read (SPEC §5).
function M.ReadRegainAfterAlignBody(stream: any, value: RegainAfterAlign): boolean
	if not stream:serializeBits(NUM, 5) then
		return false
	end
	value.Lead = NUM.value
	if not stream:serializeInt(NUM, 0, 3) then -- the count guards the loop (SPEC §6.3)
		return false
	end
	value.ItemsCount = NUM.value
	for i = 1, value.ItemsCount do
		if not stream:serializeInt(NUM, 0, 8191) then -- rejects out of range (SPEC §4.3)
			return false
		end
		value.Items[i] = NUM.value
	end
	if not stream:serializeString(STR, 5) then -- refuses a zero byte, then malformed UTF-8 (SPEC §4.7)
		return false
	end
	value.S = STR.value
	if not stream:serializeBits(NUM, 32) then
		return false
	end
	value.P = NUM.value
	if not stream:serializeBits(NUM, 29) then
		return false
	end
	value.Q = NUM.value
	if not stream:serializeBits(NUM, 19) then
		return false
	end
	value.R = NUM.value
	if not stream:serializeBits(NUM, 4) then
		return false
	end
	value.Tail = NUM.value
	return true
end

-- ReadRegainAfterAlign is the one-packet read: ReadRegainAfterAlignBody, then the end check once after
-- the top-level object (SPEC §5); it reports the object's bits consumed.
function M.ReadRegainAfterAlign(stream: any, value: RegainAfterAlign): boolean
	if not M.ReadRegainAfterAlignBody(stream, value) then
		return false
	end
	local bits = stream:bitsProcessed()
	local reader = stream._reader
	local bitsRead = reader._bitsRead
	if not stream:serializeEnd() then
		return false
	end
	stream._bits = bits
	reader._bitsRead = bitsRead
	return true
end

return M
