function M.ZeroHeartbeat(value: Heartbeat)
end

-- WriteHeartbeat writes the type wire (SPEC §4.3, §6.1: the declared order).
function M.WriteHeartbeat(stream: any, value: Heartbeat): boolean
	return true
end

-- ReadHeartbeatBody reads the type wire; false refuses (stream:error() names a runtime
-- refusal; a schema rule's refusal returns false unlatched). A nested read
-- stops here; the end check belongs to the public one-packet read (SPEC §5).
function M.ReadHeartbeatBody(stream: any, value: Heartbeat): boolean
	return true
