-- ChatMaxBits is the longest wire path; align pads at worst case (SPEC §6.1).
-- ChatMaxBytes is rounded up to the 8-byte write-buffer granularity.
M.ChatMaxBits = 2064
M.ChatMaxBytes = 264

-- NewChat builds the value at its defaults (SPEC §5).
function M.NewChat(): Chat
	local value: Chat = {
		Text = "",
	}
	return value
end

-- InitChat restores fresh construction values in place, preserving storage.
function M.InitChat(value: Chat)
	value.Text = ""
end

-- ZeroChat resets the §5 zero form: all-zero storage, without declared defaults.
function M.ZeroChat(value: Chat)
	value.Text = ""
end

-- WriteChat writes the type wire (SPEC §4.3, §6.1: the declared order).
function M.WriteChat(stream: any, value: Chat): boolean
	if type(value.Text) ~= "string" or #value.Text > 256 or not validText(value.Text) then -- well-formed UTF-8, no zero byte, at most N bytes (SPEC §4.7)
		return false
	end
	STR.value = value.Text
	if not stream:serializeString(STR, 257) then -- length, align, the bytes (SPEC §4.7)
		return false
	end
	return true
end

-- ReadChatBody reads the type wire; false refuses (stream:error() names a runtime
-- refusal; a schema rule's refusal returns false unlatched). A nested read
-- stops here; the end check belongs to the public one-packet read (SPEC §5).
function M.ReadChatBody(stream: any, value: Chat): boolean
	if not stream:serializeString(STR, 257) then -- refuses a zero byte, then malformed UTF-8 (SPEC §4.7)
		return false
	end
	value.Text = STR.value
	return true
end

-- ReadChat is the one-packet read: ReadChatBody, then the end check once after
-- the top-level object (SPEC §5); it reports the object's bits consumed.
function M.ReadChat(stream: any, value: Chat): boolean
	if not M.ReadChatBody(stream, value) then
		return false
	end
	local bits = stream:bitsProcessed()
	local reader = stream._reader
	local bitsRead = reader._bitsRead
	if not stream:serializeEnd() then
		return false
	end
	stream._bits = bits
	reader._bitsRead = bitsRead
	return true
end

-- type ProbeReport
export type ProbeReport = {
	Header: ProbeHeader,
	Flags: any,
	Echo: Test,
}

-- ProbeReportMaxBits is the longest wire path; align pads at worst case (SPEC §6.1).
-- ProbeReportMaxBytes is rounded up to the 8-byte write-buffer granularity.
M.ProbeReportMaxBits = 141
M.ProbeReportMaxBytes = 24

-- NewProbeReport builds the value at its defaults (SPEC §5).
function M.NewProbeReport(): ProbeReport
	local value: ProbeReport = {
		Header = M.NewProbeHeader(),
		Flags = K8,
		Echo = M.NewTest(),
	}
	return value
end

-- InitProbeReport restores fresh construction values in place, preserving storage.
function M.InitProbeReport(value: ProbeReport)
	M.InitProbeHeader(value.Header)
	value.Flags = K8
	M.InitTest(value.Echo)
end

-- ZeroProbeReport resets the §5 zero form: all-zero storage, without declared defaults.
function M.ZeroProbeReport(value: ProbeReport)
	M.ZeroProbeHeader(value.Header)
	value.Flags = K8
	M.ZeroTest(value.Echo)
end

-- WriteProbeReport writes the type wire (SPEC §4.3, §6.1: the declared order).
function M.WriteProbeReport(stream: any, value: ProbeReport): boolean
	if type(value.Header) ~= "table" then -- record storage
		return false
	end
	if not M.WriteProbeHeader(stream, value.Header) then
		return false
	end
	if not isWide(serialize.Uint64, value.Flags, K8, K16) then
		return false
	end
	WIDE.value = value.Flags
	if not stream:serializeBits64(WIDE, 8) then -- the flags wire width
		return false
	end
	if type(value.Echo) ~= "table" then -- record storage
		return false
	end
	if not M.WriteTest(stream, value.Echo) then
		return false
	end
	return true
end

-- ReadProbeReportBody reads the type wire; false refuses (stream:error() names a runtime
-- refusal; a schema rule's refusal returns false unlatched). A nested read
-- stops here; the end check belongs to the public one-packet read (SPEC §5).
function M.ReadProbeReportBody(stream: any, value: ProbeReport): boolean
	if not M.ReadProbeHeaderBody(stream, value.Header) then
		return false
	end
	if not stream:serializeBits64(WIDE, 8) then
		return false
	end
	value.Flags = WIDE.value
	if not M.ReadTestBody(stream, value.Echo) then
		return false
	end
	return true
end

-- ReadProbeReport is the one-packet read: ReadProbeReportBody, then the end check once after
-- the top-level object (SPEC §5); it reports the object's bits consumed.
function M.ReadProbeReport(stream: any, value: ProbeReport): boolean
	if not M.ReadProbeReportBody(stream, value) then
		return false
	end
	local bits = stream:bitsProcessed()
	local reader = stream._reader
	local bitsRead = reader._bitsRead
	if not stream:serializeEnd() then
		return false
	end
	stream._bits = bits
	reader._bitsRead = bitsRead
	return true
end

-- type TestData
export type TestData = {
	A: number,
	B: number,
	C: number,
	D: number,
	E: number,
	F: number,
	G: boolean,
	Items: {number},
	ItemsCount: number,
	FloatValue: number,
	CompressedFloatValue: number,
	DoubleValue: any,
	Int8Value: number,
	Int16Value: number,
	Uint8Value: number,
	Uint16Value: number,
	Uint32Value: number,
	Uint64Value: any,
	Int64Full: any,
	Int64Range: any,
	FixedBytes: buffer,
	Text: string,
}

-- TestDataMaxBits is the longest wire path; align pads at worst case (SPEC §6.1).
-- TestDataMaxBytes is rounded up to the 8-byte write-buffer granularity.
M.TestDataMaxBits = 2735
M.TestDataMaxBytes = 344

-- NewTestData builds the value at its defaults (SPEC §5).
function M.NewTestData(): TestData
	local value: TestData = {
		A = 0,
		B = 0,
		C = 0,
		D = 0,
		E = 0,
		F = 0,
		G = false,
		Items = table.create(16, 0),
		ItemsCount = 0,
		FloatValue = 0,
		CompressedFloatValue = 0,
		DoubleValue = K8,
		Int8Value = 0,
		Int16Value = 0,
		Uint8Value = 0,
		Uint16Value = 0,
		Uint32Value = 0,
		Uint64Value = K8,
		Int64Full = K11,
		Int64Range = K11,
		FixedBytes = buffer.create(17), -- [N]uint8: a buffer, 0-based
		Text = "",
	}
	return value
end

-- InitTestData restores fresh construction values in place, preserving storage.
function M.InitTestData(value: TestData)
	value.A = 0
	value.B = 0
	value.C = 0
	value.D = 0
	value.E = 0
	value.F = 0
	value.G = false
	for i = 1, 16 do
		value.Items[i] = 0
	end
	value.ItemsCount = 0
	value.FloatValue = 0
	value.CompressedFloatValue = 0
	value.DoubleValue = K8
	value.Int8Value = 0
	value.Int16Value = 0
	value.Uint8Value = 0
	value.Uint16Value = 0
	value.Uint32Value = 0
	value.Uint64Value = K8
	value.Int64Full = K11
	value.Int64Range = K11
	buffer.fill(value.FixedBytes, 0, 0)
	value.Text = ""
end

-- ZeroTestData resets the §5 zero form: all-zero storage, without declared defaults.
function M.ZeroTestData(value: TestData)
	value.A = 0
	value.B = 0
	value.C = 0
	value.D = 0
	value.E = 0
	value.F = 0
	value.G = false
	for i = 1, 16 do
		value.Items[i] = 0
	end
	value.ItemsCount = 0
	value.FloatValue = 0
	value.CompressedFloatValue = 0
	value.DoubleValue = K8
	value.Int8Value = 0
	value.Int16Value = 0
	value.Uint8Value = 0
	value.Uint16Value = 0
	value.Uint32Value = 0
	value.Uint64Value = K8
	value.Int64Full = K11
	value.Int64Range = K11
	buffer.fill(value.FixedBytes, 0, 0)
	value.Text = ""
end

-- WriteTestData writes the type wire (SPEC §4.3, §6.1: the declared order).
function M.WriteTestData(stream: any, value: TestData): boolean
	if not isInt(value.A, -100, 100) then
		return false
	end
	NUM.value = value.A
	if not stream:serializeInt(NUM, -100, 100) then -- int, offset from min (SPEC §4.3)
		return false
	end
	if not isInt(value.B, -100, 100) then
		return false
	end
	NUM.value = value.B
	if not stream:serializeInt(NUM, -100, 100) then -- int, offset from min (SPEC §4.3)
		return false
	end
	if not isInt(value.C, -100, 150) then
		return false
	end
	NUM.value = value.C
	if not stream:serializeInt(NUM, -100, 150) then -- int, offset from min (SPEC §4.3)
		return false
	end
	if not isInt(value.D, 0, 255) then
		return false
	end
	NUM.value = value.D
	if not stream:serializeBits(NUM, 8) then
		return false
	end
	if not isInt(value.E, 0, 255) then
		return false
	end
	NUM.value = value.E
	if not stream:serializeBits(NUM, 8) then
		return false
	end
	if not isInt(value.F, 0, 255) then
		return false
	end
	NUM.value = value.F
	if not stream:serializeBits(NUM, 8) then
		return false
	end
	if type(value.G) ~= "boolean" then
		return false
	end
	BOOL.value = value.G
	if not stream:serializeBool(BOOL) then
		return false
	end
	if type(value.Items) ~= "table" then -- the array's table storage
		return false
	end
	if not isInt(value.ItemsCount, 0, 16) then -- the count guards the loop (SPEC §6.3)
		return false
	end
	NUM.value = value.ItemsCount
	if not stream:serializeInt(NUM, 0, 16) then -- the count (SPEC §4.6)
		return false
	end
	for i = 1, value.ItemsCount do
		if not isInt(value.Items[i], 0, 255) then
			return false
		end
		NUM.value = value.Items[i]
		if not stream:serializeInt(NUM, 0, 255) then -- int, offset from min (SPEC §4.3)
			return false
		end
	end
	if not isInt(value.FloatValue, 0, 0xFFFFFFFF) or bit32.band(value.FloatValue, 0x7F800000) == 0x7F800000 then -- a float32 is its finite binary32 pattern (SPEC §4.3)
		return false
	end
	NUM.value = value.FloatValue
	if not stream:serializeFloatBits(NUM) then
		return false
	end
	if not isInt(value.CompressedFloatValue, 0, 0xFFFFFFFF) or bit32.band(value.CompressedFloatValue, 0x7F800000) == 0x7F800000 then -- a float32 is its finite binary32 pattern (SPEC §4.3)
		return false
	end
	NUM.value = value.CompressedFloatValue
	if (if bit32.band(value.CompressedFloatValue, 0x7FFFFFFF) == 0 then 0x80000000 elseif bit32.band(value.CompressedFloatValue, 0x80000000) ~= 0 then bit32.bnot(value.CompressedFloatValue) else bit32.bxor(value.CompressedFloatValue, 0x80000000)) < 0x80000000 or (if bit32.band(value.CompressedFloatValue, 0x7FFFFFFF) == 0 then 0x80000000 elseif bit32.band(value.CompressedFloatValue, 0x80000000) ~= 0 then bit32.bnot(value.CompressedFloatValue) else bit32.bxor(value.CompressedFloatValue, 0x80000000)) > 0xC1200000 then -- compressed float range
		return false
	end
	if not stream:serializeCompressedFloatPrecomputedBits(NUM, K19[1], K19[2], K19[3], K17) then -- the step index (SPEC §4.3)
		return false
	end
	if not serialize.Uint64.is(value.DoubleValue) or bit32.band(value.DoubleValue[2], 0x7FF00000) == 0x7FF00000 then -- a float64 is its finite binary64 pattern, a Uint64 (SPEC §4.3)
		return false
	end
	WIDE.value = value.DoubleValue
	if not stream:serializeDoubleBits(WIDE) then
		return false
	end
	if not isInt(value.Int8Value, -128, 127) then
		return false
	end
	NUM.value = if value.Int8Value < 0 then value.Int8Value + 256 else value.Int8Value
	if not stream:serializeBits(NUM, 8) then -- two's complement (SPEC §4.3)
		return false
	end
	if not isInt(value.Int16Value, -32768, 32767) then
		return false
	end
	NUM.value = if value.Int16Value < 0 then value.Int16Value + 65536 else value.Int16Value
	if not stream:serializeBits(NUM, 16) then -- two's complement (SPEC §4.3)
		return false
	end
	if not isInt(value.Uint8Value, 0, 255) then
		return false
	end
	NUM.value = value.Uint8Value
	if not stream:serializeBits(NUM, 8) then
		return false
	end
	if not isInt(value.Uint16Value, 0, 65535) then
		return false
	end
	NUM.value = value.Uint16Value
	if not stream:serializeBits(NUM, 16) then
		return false
	end
	if not isInt(value.Uint32Value, 0, 4294967295) then
		return false
	end
	NUM.value = value.Uint32Value
	if not stream:serializeBits(NUM, 32) then
		return false
	end
	if not isWide(serialize.Uint64, value.Uint64Value) then
		return false
	end
	WIDE.value = value.Uint64Value
	if not stream:serializeUint64(WIDE) then
		return false
	end
	if not isWide(serialize.Int64, value.Int64Full) then
		return false
	end
	WIDE.value = serialize.Int64.toUint64(value.Int64Full)
	if not stream:serializeBits64(WIDE, 64) then -- two's complement, the storage width (SPEC §4.3)
		return false
	end
	if not isWide(serialize.Int64, value.Int64Range, K20, K21) then
		return false
	end
	WIDE.value = value.Int64Range
	if not stream:serializeInt64(WIDE, K20, K21) then -- int64, offset from min (SPEC §4.3)
		return false
	end
	if not stream:serializeAlign() then
		return false
	end
	if type(value.FixedBytes) ~= "buffer" then -- the byte array's fixed storage
		return false
	end
	if buffer.len(value.FixedBytes) < 17 then -- the byte storage covers every element
		return false
	end
	for i = 1, 17 do
		NUM.value = buffer.readu8(value.FixedBytes, i - 1)
		if not stream:serializeBits(NUM, 8) then
			return false
		end
	end
	if type(value.Text) ~= "string" or #value.Text > 255 or not validText(value.Text) then -- well-formed UTF-8, no zero byte, at most N bytes (SPEC §4.7)
		return false
	end
	STR.value = value.Text
	if not stream:serializeString(STR, 256) then -- length, align, the bytes (SPEC §4.7)
		return false
	end
	return true
end

-- ReadTestDataBody reads the type wire; false refuses (stream:error() names a runtime
-- refusal; a schema rule's refusal returns false unlatched). A nested read
-- stops here; the end check belongs to the public one-packet read (SPEC §5).
function M.ReadTestDataBody(stream: any, value: TestData): boolean
	if not stream:serializeInt(NUM, -100, 100) then -- rejects out of range (SPEC §4.3)
		return false
	end
	value.A = NUM.value
	if not stream:serializeInt(NUM, -100, 100) then -- rejects out of range (SPEC §4.3)
		return false
	end
	value.B = NUM.value
	if not stream:serializeInt(NUM, -100, 150) then -- rejects out of range (SPEC §4.3)
		return false
	end
	value.C = NUM.value
	if not stream:serializeBits(NUM, 8) then
		return false
	end
	value.D = NUM.value
	if not stream:serializeBits(NUM, 8) then
		return false
	end
	value.E = NUM.value
	if not stream:serializeBits(NUM, 8) then
		return false
	end
	value.F = NUM.value
	if not stream:serializeBool(BOOL) then
		return false
	end
	value.G = BOOL.value
	if not stream:serializeInt(NUM, 0, 16) then -- the count guards the loop (SPEC §6.3)
		return false
	end
	value.ItemsCount = NUM.value
	for i = 1, value.ItemsCount do
		if not stream:serializeInt(NUM, 0, 255) then -- rejects out of range (SPEC §4.3)
			return false
		end
		value.Items[i] = NUM.value
	end
	if not stream:serializeFloatBits(NUM) then -- refuses NaN and the infinities (SPEC §4.3)
		return false
	end
	value.FloatValue = NUM.value
	if not stream:serializeCompressedFloatPrecomputedBits(NUM, K19[1], K19[2], K19[3], K17) then -- refuses a step above the count (SPEC §4.3)
		return false
	end
	value.CompressedFloatValue = NUM.value
	if not stream:serializeDoubleBits(WIDE) then -- refuses NaN and the infinities (SPEC §4.3)
		return false
	end
	value.DoubleValue = WIDE.value
	if not stream:serializeBits(NUM, 8) then
		return false
	end
	value.Int8Value = if NUM.value >= 128 then NUM.value - 256 else NUM.value
	if not stream:serializeBits(NUM, 16) then
		return false
	end
	value.Int16Value = if NUM.value >= 32768 then NUM.value - 65536 else NUM.value
	if not stream:serializeBits(NUM, 8) then
		return false
	end
	value.Uint8Value = NUM.value
	if not stream:serializeBits(NUM, 16) then
		return false
	end
	value.Uint16Value = NUM.value
	if not stream:serializeBits(NUM, 32) then
		return false
	end
	value.Uint32Value = NUM.value
	if not stream:serializeUint64(WIDE) then
		return false
	end
	value.Uint64Value = WIDE.value
	if not stream:serializeBits64(WIDE, 64) then
		return false
	end
	value.Int64Full = serialize.Uint64.toInt64(WIDE.value)
	if not stream:serializeInt64(WIDE, K20, K21) then -- rejects out of range (SPEC §4.3)
		return false
	end
	value.Int64Range = WIDE.value
	if not stream:serializeAlign() then -- rejects nonzero padding (SPEC §4.3)
		return false
	end
	for i = 1, 17 do
		if not stream:serializeBits(NUM, 8) then
			return false
		end
		buffer.writeu8(value.FixedBytes, i - 1, NUM.value)
	end
	if not stream:serializeString(STR, 256) then -- refuses a zero byte, then malformed UTF-8 (SPEC §4.7)
		return false
	end
	value.Text = STR.value
	return true
end

-- ReadTestData is the one-packet read: ReadTestDataBody, then the end check once after
-- the top-level object (SPEC §5); it reports the object's bits consumed.
function M.ReadTestData(stream: any, value: TestData): boolean
	if not M.ReadTestDataBody(stream, value) then
		return false
	end
	local bits = stream:bitsProcessed()
	local reader = stream._reader
	local bitsRead = reader._bitsRead
	if not stream:serializeEnd() then
		return false
	end
	stream._bits = bits
	reader._bitsRead = bitsRead
	return true
end

-- type CompressedProbe
export type CompressedProbe = {
	Boundary: number,
	Offset: number,
}

-- CompressedProbeMaxBits is the longest wire path; align pads at worst case (SPEC §6.1).
-- CompressedProbeMaxBytes is rounded up to the 8-byte write-buffer granularity.
M.CompressedProbeMaxBits = 24
M.CompressedProbeMaxBytes = 8

-- NewCompressedProbe builds the value at its defaults (SPEC §5).
function M.NewCompressedProbe(): CompressedProbe
	local value: CompressedProbe = {
		Boundary = 0,
		Offset = 0,
	}
	return value
end

-- InitCompressedProbe restores fresh construction values in place, preserving storage.
function M.InitCompressedProbe(value: CompressedProbe)
	value.Boundary = 0
	value.Offset = 0
end

-- ZeroCompressedProbe resets the §5 zero form: all-zero storage, without declared defaults.
function M.ZeroCompressedProbe(value: CompressedProbe)
	value.Boundary = 0
	value.Offset = 0
end

-- WriteCompressedProbe writes the type wire (SPEC §4.3, §6.1: the declared order).
function M.WriteCompressedProbe(stream: any, value: CompressedProbe): boolean
	if not isInt(value.Boundary, 0, 0xFFFFFFFF) or bit32.band(value.Boundary, 0x7F800000) == 0x7F800000 then -- a float32 is its finite binary32 pattern (SPEC §4.3)
		return false
	end
	NUM.value = value.Boundary
	if (if bit32.band(value.Boundary, 0x7FFFFFFF) == 0 then 0x80000000 elseif bit32.band(value.Boundary, 0x80000000) ~= 0 then bit32.bnot(value.Boundary) else bit32.bxor(value.Boundary, 0x80000000)) < 0x80000000 or (if bit32.band(value.Boundary, 0x7FFFFFFF) == 0 then 0x80000000 elseif bit32.band(value.Boundary, 0x80000000) ~= 0 then bit32.bnot(value.Boundary) else bit32.bxor(value.Boundary, 0x80000000)) > 0xC1200000 then -- compressed float range
		return false
	end
	if not stream:serializeCompressedFloatPrecomputedBits(NUM, K19[1], K19[2], K19[3], K17) then -- the step index (SPEC §4.3)
		return false
	end
	if not isInt(value.Offset, 0, 0xFFFFFFFF) or bit32.band(value.Offset, 0x7F800000) == 0x7F800000 then -- a float32 is its finite binary32 pattern (SPEC §4.3)
		return false
	end
	NUM.value = value.Offset
	if (if bit32.band(value.Offset, 0x7FFFFFFF) == 0 then 0x80000000 elseif bit32.band(value.Offset, 0x80000000) ~= 0 then bit32.bnot(value.Offset) else bit32.bxor(value.Offset, 0x80000000)) < 0x3F5FFFFF or (if bit32.band(value.Offset, 0x7FFFFFFF) == 0 then 0x80000000 elseif bit32.band(value.Offset, 0x80000000) ~= 0 then bit32.bnot(value.Offset) else bit32.bxor(value.Offset, 0x80000000)) > 0xC0A00000 then -- compressed float range
		return false
	end
	if not stream:serializeCompressedFloatPrecomputedBits(NUM, K25[1], K25[2], K25[3], K22) then -- the step index (SPEC §4.3)
		return false
	end
	return true
end

-- ReadCompressedProbeBody reads the type wire; false refuses (stream:error() names a runtime
-- refusal; a schema rule's refusal returns false unlatched). A nested read
-- stops here; the end check belongs to the public one-packet read (SPEC §5).
function M.ReadCompressedProbeBody(stream: any, value: CompressedProbe): boolean
	if not stream:serializeCompressedFloatPrecomputedBits(NUM, K19[1], K19[2], K19[3], K17) then -- refuses a step above the count (SPEC §4.3)
		return false
	end
	value.Boundary = NUM.value
	if not stream:serializeCompressedFloatPrecomputedBits(NUM, K25[1], K25[2], K25[3], K22) then -- refuses a step above the count (SPEC §4.3)
		return false
	end
	value.Offset = NUM.value
	return true
end

-- ReadCompressedProbe is the one-packet read: ReadCompressedProbeBody, then the end check once after
-- the top-level object (SPEC §5); it reports the object's bits consumed.
function M.ReadCompressedProbe(stream: any, value: CompressedProbe): boolean
	if not M.ReadCompressedProbeBody(stream, value) then
		return false
	end
	local bits = stream:bitsProcessed()
	local reader = stream._reader
	local bitsRead = reader._bitsRead
	if not stream:serializeEnd() then
		return false
	end
	stream._bits = bits
	reader._bitsRead = bitsRead
	return true
end

return M
