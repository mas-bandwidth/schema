	local value: ProbeSlab = {
		Width = 0,
		Height = 0,
	}
	return value
end

-- InitProbeSlab restores fresh construction values in place, preserving storage.
function M.InitProbeSlab(value: ProbeSlab)
	value.Width = 0
	value.Height = 0
end

-- ZeroProbeSlab resets the §5 zero form: all-zero storage, without declared defaults.
function M.ZeroProbeSlab(value: ProbeSlab)
	value.Width = 0
	value.Height = 0
end

-- WriteProbeSlab writes the type wire (SPEC §4.3, §6.1: the declared order).
function M.WriteProbeSlab(stream: any, value: ProbeSlab): boolean
	if not isInt(value.Width, 0, 100) then
		return false
	end
	NUM.value = value.Width
	if not stream:serializeInt(NUM, 0, 100) then -- int, offset from min (SPEC §4.3)
		return false
	end
	if not isInt(value.Height, 0, 255) then
		return false
	end
	NUM.value = value.Height
	if not stream:serializeBits(NUM, 8) then
		return false
	end
	return true
end

-- ReadProbeSlabBody reads the type wire; false refuses (stream:error() names a runtime
-- refusal; a schema rule's refusal returns false unlatched). A nested read
-- stops here; the end check belongs to the public one-packet read (SPEC §5).
function M.ReadProbeSlabBody(stream: any, value: ProbeSlab): boolean
	if not stream:serializeInt(NUM, 0, 100) then -- rejects out of range (SPEC §4.3)
		return false
	end
	value.Width = NUM.value
	if not stream:serializeBits(NUM, 8) then
		return false
	end
	value.Height = NUM.value
	return true
end

-- ReadProbeSlab is the one-packet read: ReadProbeSlabBody, then the end check once after
-- the top-level object (SPEC §5); it reports the object's bits consumed.
function M.ReadProbeSlab(stream: any, value: ProbeSlab): boolean
	if not M.ReadProbeSlabBody(stream, value) then
		return false
	end
	local bits = stream:bitsProcessed()
	local reader = stream._reader
	local bitsRead = reader._bitsRead
	if not stream:serializeEnd() then
		return false
	end
	stream._bits = bits
	reader._bitsRead = bitsRead
	return true
end

-- ProbeShapeType: union ProbeShape's tag — None = 0, then each variant in declared order (SPEC §4.8)
export type ProbeShapeType = number
M.ProbeShapeType = table.freeze({
	None = 0,
	Ring = 1,
	Slab = 2,
})
M.ProbeShapeTypeMax = 2 -- the exported extent (SPEC §4.2)

local _EnumNameProbeShapeType = table.freeze({ [0] = "None", [1] = "Ring", [2] = "Slab" })
-- EnumNameProbeShapeType: the debug/log name of a ProbeShapeType value; out-of-set values name "???"
function M.EnumNameProbeShapeType(value: number): string
	return _EnumNameProbeShapeType[value] or "???"
end

-- ProbeShape — at most one arm; Type says which. Construction is the empty union
-- (None); every arm is pre-allocated, and an unselected arm is unspecified.
export type ProbeShape = {
	Type: number,
	Ring: ProbeRing,
	Slab: ProbeSlab,
}

-- ProbeShapeMaxBits is the tag plus the largest arm; None costs the tag only (SPEC §4.8).
M.ProbeShapeMaxBits = 18
M.ProbeShapeMaxBytes = 8

function M.NewProbeShape(): ProbeShape
	local value: ProbeShape = {
		Type = 0,
		Ring = M.NewProbeRing(),
		Slab = M.NewProbeSlab(),
	}
	return value
end

-- InitProbeShape and ZeroProbeShape reset the union to None; dormant arms keep their storage.
function M.InitProbeShape(value: ProbeShape)
	value.Type = 0
end

function M.ZeroProbeShape(value: ProbeShape)
	value.Type = 0
end

-- WriteProbeShape: the tag in minimal bits for [0, 2], validated before it rides,
-- then the selected arm only (SPEC §4.8).
function M.WriteProbeShape(stream: any, value: ProbeShape): boolean
	if not isInt(value.Type, 0, 2) then -- the tag validates before it rides (SPEC §4.8)
		return false
	end
	NUM.value = value.Type
	if not stream:serializeInt(NUM, 0, 2) then
		return false
	end
	if value.Type == 1 then
		if type(value.Ring) ~= "table" then -- record storage
			return false
		end
		if not M.WriteProbeRing(stream, value.Ring) then
			return false
		end
	end
	if value.Type == 2 then
		if type(value.Slab) ~= "table" then -- record storage
			return false
		end
		if not M.WriteProbeSlab(stream, value.Slab) then
			return false
		end
	end
	return true -- None, or a payload-free arm: the tag is the whole wire
end

-- ReadProbeShapeBody: a tag above 2 is refused; a selected arm takes fresh declared
-- defaults, then its payload (SPEC §4.8). A nested read stops here; the end
-- check belongs to the public one-packet read (SPEC §5).
function M.ReadProbeShapeBody(stream: any, value: ProbeShape): boolean
	if not stream:serializeInt(NUM, 0, 2) then -- rejects a tag above the count (SPEC §4.8)
		return false
	end
	value.Type = NUM.value
	if value.Type == 1 then
		M.InitProbeRing(value.Ring)
		if not M.ReadProbeRingBody(stream, value.Ring) then
			return false
		end
	end
	if value.Type == 2 then
		M.InitProbeSlab(value.Slab)
		if not M.ReadProbeSlabBody(stream, value.Slab) then
			return false
		end
	end
	return true
end

-- ReadProbeShape is the one-packet read: ReadProbeShapeBody, then the end check once after
-- the top-level object (SPEC §5); it reports the object's bits consumed.
function M.ReadProbeShape(stream: any, value: ProbeShape): boolean
	if not M.ReadProbeShapeBody(stream, value) then
		return false
	end
	local bits = stream:bitsProcessed()
	local reader = stream._reader
	local bitsRead = reader._bitsRead
	if not stream:serializeEnd() then
		return false
	end
	stream._bits = bits
	reader._bitsRead = bitsRead
	return true
end

-- type ProbeCollider
export type ProbeCollider = {
	Armor: number,
	Shape: ProbeShape,
	Backup: ProbeShape,
	Extras: {ProbeShape},
	ExtrasCount: number,
}

-- ProbeColliderMaxBits is the longest wire path; align pads at worst case (SPEC §6.1).
-- ProbeColliderMaxBytes is rounded up to the 8-byte write-buffer granularity.
M.ProbeColliderMaxBits = 82
M.ProbeColliderMaxBytes = 16

-- NewProbeCollider builds the value at its defaults (SPEC §5).
function M.NewProbeCollider(): ProbeCollider
	local value: ProbeCollider = {
		Armor = 0,
		Shape = M.NewProbeShape(),
		Backup = M.NewProbeShape(),
		Extras = table.create(2) :: {ProbeShape},
		ExtrasCount = 0,
	}
	for i = 1, 2 do
		value.Extras[i] = M.NewProbeShape()
	end
	return value
end

-- InitProbeCollider restores fresh construction values in place, preserving storage.
function M.InitProbeCollider(value: ProbeCollider)
	value.Armor = 0
	M.InitProbeShape(value.Shape)
	M.InitProbeShape(value.Backup)
	for i = 1, 2 do
	M.InitProbeShape(value.Extras[i])
	end
	value.ExtrasCount = 0
end

-- ZeroProbeCollider resets the §5 zero form: all-zero storage, without declared defaults.
function M.ZeroProbeCollider(value: ProbeCollider)
	value.Armor = 0
	M.ZeroProbeShape(value.Shape)
	M.ZeroProbeShape(value.Backup)
	for i = 1, 2 do
	M.ZeroProbeShape(value.Extras[i])
	end
	value.ExtrasCount = 0
end

-- WriteProbeCollider writes the type wire (SPEC §4.3, §6.1: the declared order).
function M.WriteProbeCollider(stream: any, value: ProbeCollider): boolean
	if not isInt(value.Armor, 0, 255) then
		return false
	end
	NUM.value = value.Armor
	if not stream:serializeBits(NUM, 8) then
		return false
	end
	if type(value.Shape) ~= "table" then -- record storage
		return false
	end
	if not M.WriteProbeShape(stream, value.Shape) then
		return false
	end
	if type(value.Backup) ~= "table" then -- record storage
		return false
	end
	if not M.WriteProbeShape(stream, value.Backup) then
		return false
	end
	if type(value.Extras) ~= "table" then -- the array's table storage
		return false
	end
	if not isInt(value.ExtrasCount, 0, 2) then -- the count guards the loop (SPEC §6.3)
		return false
	end
	for i = 1, value.ExtrasCount do
		if type(value.Extras[i]) ~= "table" then -- each live record has table storage
			return false
		end
	end
	NUM.value = value.ExtrasCount
	if not stream:serializeInt(NUM, 0, 2) then -- the count (SPEC §4.6)
		return false
	end
	for i = 1, value.ExtrasCount do
		if type(value.Extras[i]) ~= "table" then -- record storage
			return false
		end
		if not M.WriteProbeShape(stream, value.Extras[i]) then
			return false
		end
	end
	return true
end

-- ReadProbeColliderBody reads the type wire; false refuses (stream:error() names a runtime
-- refusal; a schema rule's refusal returns false unlatched). A nested read
-- stops here; the end check belongs to the public one-packet read (SPEC §5).
function M.ReadProbeColliderBody(stream: any, value: ProbeCollider): boolean
	if not stream:serializeBits(NUM, 8) then
		return false
	end
	value.Armor = NUM.value
	if not M.ReadProbeShapeBody(stream, value.Shape) then
		return false
	end
	if not M.ReadProbeShapeBody(stream, value.Backup) then
		return false
	end
	if not stream:serializeInt(NUM, 0, 2) then -- the count guards the loop (SPEC §6.3)
		return false
	end
	value.ExtrasCount = NUM.value
	for i = 1, value.ExtrasCount do
		if not M.ReadProbeShapeBody(stream, value.Extras[i]) then
			return false
		end
	end
	return true
end

-- ReadProbeCollider is the one-packet read: ReadProbeColliderBody, then the end check once after
-- the top-level object (SPEC §5); it reports the object's bits consumed.
function M.ReadProbeCollider(stream: any, value: ProbeCollider): boolean
	if not M.ReadProbeColliderBody(stream, value) then
		return false
	end
	local bits = stream:bitsProcessed()
	local reader = stream._reader
	local bitsRead = reader._bitsRead
	if not stream:serializeEnd() then
		return false
	end
	stream._bits = bits
	reader._bitsRead = bitsRead
	return true
end

-- type ProbeConfig
export type ProbeConfig = {
	Retries: number,
	Preferred: Weapon,
}

-- ProbeConfigMaxBits is the longest wire path; align pads at worst case (SPEC §6.1).
-- ProbeConfigMaxBytes is rounded up to the 8-byte write-buffer granularity.
M.ProbeConfigMaxBits = 36
M.ProbeConfigMaxBytes = 8

-- NewProbeConfig builds the value at its defaults (SPEC §5).
function M.NewProbeConfig(): ProbeConfig
	local value: ProbeConfig = {
		Retries = -1, -- specified default (SPEC §5)
		Preferred = 3, -- specified default (SPEC §5)
	}
	return value
end

-- InitProbeConfig restores fresh construction values in place, preserving storage.
function M.InitProbeConfig(value: ProbeConfig)
	value.Retries = -1
	value.Preferred = 3
end

-- ZeroProbeConfig resets the §5 zero form: all-zero storage, without declared defaults.
function M.ZeroProbeConfig(value: ProbeConfig)
	value.Retries = 0
	value.Preferred = 0
end

-- WriteProbeConfig writes the type wire (SPEC §4.3, §6.1: the declared order).
function M.WriteProbeConfig(stream: any, value: ProbeConfig): boolean
	if not isInt(value.Retries, -2147483648, 2147483647) then
		return false
	end
	NUM.value = if value.Retries < 0 then value.Retries + 4294967296 else value.Retries
	if not stream:serializeBits(NUM, 32) then -- two's complement (SPEC §4.3)
		return false
	end
	if not isInt(value.Preferred, 0, 15) then
		return false
	end
	NUM.value = value.Preferred
	if not stream:serializeInt(NUM, 0, 15) then
		return false
	end
	return true
end

-- ReadProbeConfigBody reads the type wire; false refuses (stream:error() names a runtime
-- refusal; a schema rule's refusal returns false unlatched). A nested read
-- stops here; the end check belongs to the public one-packet read (SPEC §5).
function M.ReadProbeConfigBody(stream: any, value: ProbeConfig): boolean
	if not stream:serializeBits(NUM, 32) then
		return false
	end
	value.Retries = if NUM.value >= 2147483648 then NUM.value - 4294967296 else NUM.value
	if not stream:serializeInt(NUM, 0, 15) then -- rejects a value above max (SPEC §4.3)
		return false
	end
	value.Preferred = NUM.value
	return true
end

-- ReadProbeConfig is the one-packet read: ReadProbeConfigBody, then the end check once after
-- the top-level object (SPEC §5); it reports the object's bits consumed.
function M.ReadProbeConfig(stream: any, value: ProbeConfig): boolean
	if not M.ReadProbeConfigBody(stream, value) then
		return false
	end
	local bits = stream:bitsProcessed()
	local reader = stream._reader
	local bitsRead = reader._bitsRead
	if not stream:serializeEnd() then
		return false
	end
	stream._bits = bits
	reader._bitsRead = bitsRead
	return true
end

-- type ProbeArray
export type ProbeArray = {
	Samples: {ProbeSample},
	Config: ProbeConfig,
}

-- ProbeArrayMaxBits is the longest wire path; align pads at worst case (SPEC §6.1).
-- ProbeArrayMaxBytes is rounded up to the 8-byte write-buffer granularity.
M.ProbeArrayMaxBits = 588
M.ProbeArrayMaxBytes = 80

-- NewProbeArray builds the value at its defaults (SPEC §5).
function M.NewProbeArray(): ProbeArray
	local value: ProbeArray = {
		Samples = table.create(2) :: {ProbeSample},
		Config = M.NewProbeConfig(),
	}
	for i = 1, 2 do
		value.Samples[i] = M.NewProbeSample()
	end
	return value
end

-- InitProbeArray restores fresh construction values in place, preserving storage.
function M.InitProbeArray(value: ProbeArray)
	for i = 1, 2 do
	M.InitProbeSample(value.Samples[i])
	end
	M.InitProbeConfig(value.Config)
end

-- ZeroProbeArray resets the §5 zero form: all-zero storage, without declared defaults.
function M.ZeroProbeArray(value: ProbeArray)
	for i = 1, 2 do
	M.ZeroProbeSample(value.Samples[i])
	end
	M.ZeroProbeConfig(value.Config)
end

-- WriteProbeArray writes the type wire (SPEC §4.3, §6.1: the declared order).
function M.WriteProbeArray(stream: any, value: ProbeArray): boolean
	if type(value.Samples) ~= "table" then -- the array's table storage
		return false
	end
	for i = 1, 2 do
		if type(value.Samples[i]) ~= "table" then -- each live record has table storage
			return false
		end
	end
	for i = 1, 2 do
		if type(value.Samples[i]) ~= "table" then -- record storage
			return false
		end
		if not M.WriteProbeSample(stream, value.Samples[i]) then
			return false
		end
	end
	if type(value.Config) ~= "table" then -- record storage
		return false
	end
	if not M.WriteProbeConfig(stream, value.Config) then
		return false
	end
	return true
end

-- ReadProbeArrayBody reads the type wire; false refuses (stream:error() names a runtime
-- refusal; a schema rule's refusal returns false unlatched). A nested read
-- stops here; the end check belongs to the public one-packet read (SPEC §5).
function M.ReadProbeArrayBody(stream: any, value: ProbeArray): boolean
	for i = 1, 2 do
		if not M.ReadProbeSampleBody(stream, value.Samples[i]) then
			return false
		end
	end
	if not M.ReadProbeConfigBody(stream, value.Config) then
		return false
	end
	return true
end

-- ReadProbeArray is the one-packet read: ReadProbeArrayBody, then the end check once after
-- the top-level object (SPEC §5); it reports the object's bits consumed.
function M.ReadProbeArray(stream: any, value: ProbeArray): boolean
	if not M.ReadProbeArrayBody(stream, value) then
		return false
	end
	local bits = stream:bitsProcessed()
	local reader = stream._reader
	local bitsRead = reader._bitsRead
	if not stream:serializeEnd() then
		return false
	end
	stream._bits = bits
	reader._bitsRead = bitsRead
	return true
end

