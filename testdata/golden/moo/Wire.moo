export type Heartbeat = {
}

-- HeartbeatMaxBits is the longest wire path; align pads at worst case (SPEC §6.1).
-- HeartbeatMaxBytes is rounded up to the 8-byte write-buffer granularity.
M.HeartbeatMaxBits = 0
M.HeartbeatMaxBytes = 0

-- NewHeartbeat builds the value at its defaults (SPEC §5).
function M.NewHeartbeat(): Heartbeat
	local value: Heartbeat = {
	}
