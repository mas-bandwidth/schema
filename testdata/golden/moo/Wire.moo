-- type Test
export type Test = {
	TestA: number,
	TestB: number,
	TestC: number,
	TestD: number,
}

-- TestMaxBits is the longest wire path; align pads at worst case (SPEC §6.1).
-- TestMaxBytes is rounded up to the 8-byte write-buffer granularity.
M.TestMaxBits = 46
M.TestMaxBytes = 8

-- NewTest builds the value at its defaults (SPEC §5).
function M.NewTest(): Test
	local value: Test = {
		TestA = 0,
		TestB = 0,
		TestC = 0,
		TestD = 0,
	}
	return value
end

-- InitTest restores fresh construction values in place, preserving storage.
function M.InitTest(value: Test)
	value.TestA = 0
	value.TestB = 0
	value.TestC = 0
	value.TestD = 0
end

-- ZeroTest resets the §5 zero form: all-zero storage, without declared defaults.
function M.ZeroTest(value: Test)
	value.TestA = 0
	value.TestB = 0
	value.TestC = 0
	value.TestD = 0
end

-- WriteTest writes the type wire (SPEC §4.3, §6.1: the declared order).
function M.WriteTest(stream: any, value: Test): boolean
	if not isInt(value.TestA, 0, 65535) then
		return false
	end
	NUM.value = value.TestA
	if not stream:serializeBits(NUM, 16) then
		return false
	end
	if not isInt(value.TestB, 0, 1000) then
		return false
	end
	NUM.value = value.TestB
	if not stream:serializeInt(NUM, 0, 1000) then -- int, offset from min (SPEC §4.3)
		return false
	end
	if not isInt(value.TestC, 0, 1000) then
		return false
	end
	NUM.value = value.TestC
	if not stream:serializeInt(NUM, 0, 1000) then -- int, offset from min (SPEC §4.3)
		return false
	end
	if not isInt(value.TestD, 0, 1000) then
		return false
	end
	NUM.value = value.TestD
	if not stream:serializeInt(NUM, 0, 1000) then -- int, offset from min (SPEC §4.3)
		return false
	end
	return true
end

-- ReadTestBody reads the type wire; false refuses (stream:error() names a runtime
-- refusal; a schema rule's refusal returns false unlatched). A nested read
-- stops here; the end check belongs to the public one-packet read (SPEC §5).
function M.ReadTestBody(stream: any, value: Test): boolean
	if not stream:serializeBits(NUM, 16) then
		return false
	end
	value.TestA = NUM.value
	if not stream:serializeInt(NUM, 0, 1000) then -- rejects out of range (SPEC §4.3)
		return false
	end
	value.TestB = NUM.value
	if not stream:serializeInt(NUM, 0, 1000) then -- rejects out of range (SPEC §4.3)
		return false
	end
	value.TestC = NUM.value
	if not stream:serializeInt(NUM, 0, 1000) then -- rejects out of range (SPEC §4.3)
		return false
	end
	value.TestD = NUM.value
	return true
end

-- ReadTest is the one-packet read: ReadTestBody, then the end check once after
-- the top-level object (SPEC §5); it reports the object's bits consumed.
function M.ReadTest(stream: any, value: Test): boolean
	if not M.ReadTestBody(stream, value) then
		return false
	end
	local bits = stream:bitsProcessed()
	local reader = stream._reader
	local bitsRead = reader._bitsRead
	if not stream:serializeEnd() then
		return false
	end
	stream._bits = bits
	reader._bitsRead = bitsRead
	return true
end

-- type Block
export type Block = {
	Data: buffer,
	DataLength: number,
}

-- BlockMaxBits is the longest wire path; align pads at worst case (SPEC §6.1).
-- BlockMaxBytes is rounded up to the 8-byte write-buffer granularity.
M.BlockMaxBits = 16018
M.BlockMaxBytes = 2008

-- NewBlock builds the value at its defaults (SPEC §5).
function M.NewBlock(): Block
	local value: Block = {
		Data = buffer.create(2000), -- bytes(2000), used length beside it (SPEC §4.7)
		DataLength = 0,
	}
	return value
end

-- InitBlock restores fresh construction values in place, preserving storage.
function M.InitBlock(value: Block)
	buffer.fill(value.Data, 0, 0)
	value.DataLength = 0
end

-- ZeroBlock resets the §5 zero form: all-zero storage, without declared defaults.
function M.ZeroBlock(value: Block)
	buffer.fill(value.Data, 0, 0)
	value.DataLength = 0
end

-- WriteBlock writes the type wire (SPEC §4.3, §6.1: the declared order).
function M.WriteBlock(stream: any, value: Block): boolean
	if type(value.Data) ~= "buffer" or not isInt(value.DataLength, 0, 2000) or buffer.len(value.Data) < value.DataLength then -- the length guards the slice (SPEC §6.3)
		return false
	end
	NUM.value = value.DataLength
	if not stream:serializeInt(NUM, 0, 2000) then
		return false
	end
	if not stream:serializeBytes(value.Data, 0, value.DataLength) then -- align, then the used bytes (SPEC §4.7)
		return false
	end
	return true
end

-- ReadBlockBody reads the type wire; false refuses (stream:error() names a runtime
-- refusal; a schema rule's refusal returns false unlatched). A nested read
-- stops here; the end check belongs to the public one-packet read (SPEC §5).
function M.ReadBlockBody(stream: any, value: Block): boolean
	if not stream:serializeInt(NUM, 0, 2000) then -- the length guards the payload (SPEC §6.3)
		return false
	end
	value.DataLength = NUM.value
	if not stream:serializeBytes(value.Data, 0, value.DataLength) then
		return false
	end
	return true
end

-- ReadBlock is the one-packet read: ReadBlockBody, then the end check once after
-- the top-level object (SPEC §5); it reports the object's bits consumed.
function M.ReadBlock(stream: any, value: Block): boolean
	if not M.ReadBlockBody(stream, value) then
		return false
	end
	local bits = stream:bitsProcessed()
	local reader = stream._reader
	local bitsRead = reader._bitsRead
	if not stream:serializeEnd() then
		return false
	end
	stream._bits = bits
	reader._bitsRead = bitsRead
	return true
end

