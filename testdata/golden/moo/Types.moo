function M.ReadRigidBodyBody(stream: any, value: RigidBody): boolean
	if not M.ReadVec3Body(stream, value.Position) then
		return false
	end
	if not M.ReadQuatBody(stream, value.Orientation) then
		return false
	end
	if not stream:serializeBool(BOOL) then
		return false
	end
	value.AtRest = BOOL.value
	if not value.AtRest then
		if not M.ReadVec3Body(stream, value.LinearVelocity) then
			return false
		end
		if not M.ReadVec3Body(stream, value.AngularVelocity) then
			return false
		end
	else
		M.ZeroVec3(value.LinearVelocity)
		M.ZeroVec3(value.AngularVelocity)
	end
	return true
end

-- ReadRigidBody is the one-packet read: ReadRigidBodyBody, then the end check once after
-- the top-level object (SPEC §5); it reports the object's bits consumed.
function M.ReadRigidBody(stream: any, value: RigidBody): boolean
	if not M.ReadRigidBodyBody(stream, value) then
		return false
	end
	local bits = stream:bitsProcessed()
	local reader = stream._reader
	local bitsRead = reader._bitsRead
	if not stream:serializeEnd() then
		return false
	end
	stream._bits = bits
	reader._bitsRead = bitsRead
	return true
end

-- type Input
export type Input = {
	StickX: number,
	StickY: number,
	Throttle: number,
	Yaw: number,
	Pitch: number,
	Fire: boolean,
	AltFire: boolean,
	Boost: boolean,
	Brake: boolean,
	Aim: boolean,
	LockOn: boolean,
	Zoom: boolean,
	Ping: boolean,
}

-- InputMaxBits is the longest wire path; align pads at worst case (SPEC §6.1).
-- InputMaxBytes is rounded up to the 8-byte write-buffer granularity.
M.InputMaxBits = 168
M.InputMaxBytes = 24

-- NewInput builds the value at its defaults (SPEC §5).
function M.NewInput(): Input
	local value: Input = {
		StickX = 0,
		StickY = 0,
		Throttle = 0,
		Yaw = 0,
		Pitch = 0,
		Fire = false,
		AltFire = false,
		Boost = false,
		Brake = false,
		Aim = false,
		LockOn = false,
		Zoom = false,
		Ping = false,
	}
	return value
end

-- InitInput restores fresh construction values in place, preserving storage.
function M.InitInput(value: Input)
	value.StickX = 0
	value.StickY = 0
	value.Throttle = 0
	value.Yaw = 0
	value.Pitch = 0
	value.Fire = false
	value.AltFire = false
	value.Boost = false
	value.Brake = false
	value.Aim = false
	value.LockOn = false
	value.Zoom = false
	value.Ping = false
end

-- ZeroInput resets the §5 zero form: all-zero storage, without declared defaults.
function M.ZeroInput(value: Input)
	value.StickX = 0
	value.StickY = 0
	value.Throttle = 0
	value.Yaw = 0
	value.Pitch = 0
	value.Fire = false
	value.AltFire = false
	value.Boost = false
	value.Brake = false
	value.Aim = false
	value.LockOn = false
	value.Zoom = false
	value.Ping = false
end

-- WriteInput writes the type wire (SPEC §4.3, §6.1: the declared order).
function M.WriteInput(stream: any, value: Input): boolean
	if not isInt(value.StickX, 0, 0xFFFFFFFF) or bit32.band(value.StickX, 0x7F800000) == 0x7F800000 then -- a float32 is its finite binary32 pattern (SPEC §4.3)
		return false
	end
	NUM.value = value.StickX
	if not stream:serializeFloatBits(NUM) then
		return false
	end
	if not isInt(value.StickY, 0, 0xFFFFFFFF) or bit32.band(value.StickY, 0x7F800000) == 0x7F800000 then -- a float32 is its finite binary32 pattern (SPEC §4.3)
		return false
	end
	NUM.value = value.StickY
	if not stream:serializeFloatBits(NUM) then
		return false
	end
	if not isInt(value.Throttle, 0, 0xFFFFFFFF) or bit32.band(value.Throttle, 0x7F800000) == 0x7F800000 then -- a float32 is its finite binary32 pattern (SPEC §4.3)
		return false
	end
	NUM.value = value.Throttle
	if not stream:serializeFloatBits(NUM) then
		return false
	end
	if not isInt(value.Yaw, 0, 0xFFFFFFFF) or bit32.band(value.Yaw, 0x7F800000) == 0x7F800000 then -- a float32 is its finite binary32 pattern (SPEC §4.3)
		return false
	end
	NUM.value = value.Yaw
	if not stream:serializeFloatBits(NUM) then
		return false
	end
	if not isInt(value.Pitch, 0, 0xFFFFFFFF) or bit32.band(value.Pitch, 0x7F800000) == 0x7F800000 then -- a float32 is its finite binary32 pattern (SPEC §4.3)
		return false
	end
	NUM.value = value.Pitch
	if not stream:serializeFloatBits(NUM) then
		return false
	end
	if type(value.Fire) ~= "boolean" then
		return false
	end
	BOOL.value = value.Fire
	if not stream:serializeBool(BOOL) then
		return false
	end
	if type(value.AltFire) ~= "boolean" then
		return false
	end
	BOOL.value = value.AltFire
	if not stream:serializeBool(BOOL) then
		return false
	end
	if type(value.Boost) ~= "boolean" then
		return false
	end
	BOOL.value = value.Boost
	if not stream:serializeBool(BOOL) then
		return false
	end
	if type(value.Brake) ~= "boolean" then
		return false
	end
	BOOL.value = value.Brake
	if not stream:serializeBool(BOOL) then
		return false
	end
	if type(value.Aim) ~= "boolean" then
		return false
	end
	BOOL.value = value.Aim
	if not stream:serializeBool(BOOL) then
		return false
	end
	if type(value.LockOn) ~= "boolean" then
		return false
	end
	BOOL.value = value.LockOn
	if not stream:serializeBool(BOOL) then
		return false
	end
	if type(value.Zoom) ~= "boolean" then
		return false
	end
	BOOL.value = value.Zoom
	if not stream:serializeBool(BOOL) then
		return false
	end
	if type(value.Ping) ~= "boolean" then
		return false
	end
	BOOL.value = value.Ping
	if not stream:serializeBool(BOOL) then
		return false
	end
	return true
end

-- ReadInputBody reads the type wire; false refuses (stream:error() names a runtime
-- refusal; a schema rule's refusal returns false unlatched). A nested read
-- stops here; the end check belongs to the public one-packet read (SPEC §5).
function M.ReadInputBody(stream: any, value: Input): boolean
	if not stream:serializeFloatBits(NUM) then -- refuses NaN and the infinities (SPEC §4.3)
		return false
	end
	value.StickX = NUM.value
	if not stream:serializeFloatBits(NUM) then -- refuses NaN and the infinities (SPEC §4.3)
		return false
	end
	value.StickY = NUM.value
	if not stream:serializeFloatBits(NUM) then -- refuses NaN and the infinities (SPEC §4.3)
		return false
	end
	value.Throttle = NUM.value
	if not stream:serializeFloatBits(NUM) then -- refuses NaN and the infinities (SPEC §4.3)
		return false
	end
	value.Yaw = NUM.value
	if not stream:serializeFloatBits(NUM) then -- refuses NaN and the infinities (SPEC §4.3)
		return false
	end
	value.Pitch = NUM.value
	if not stream:serializeBool(BOOL) then
		return false
	end
	value.Fire = BOOL.value
	if not stream:serializeBool(BOOL) then
		return false
	end
	value.AltFire = BOOL.value
	if not stream:serializeBool(BOOL) then
		return false
	end
	value.Boost = BOOL.value
	if not stream:serializeBool(BOOL) then
		return false
	end
	value.Brake = BOOL.value
	if not stream:serializeBool(BOOL) then
		return false
	end
	value.Aim = BOOL.value
	if not stream:serializeBool(BOOL) then
		return false
	end
	value.LockOn = BOOL.value
	if not stream:serializeBool(BOOL) then
		return false
	end
	value.Zoom = BOOL.value
	if not stream:serializeBool(BOOL) then
		return false
	end
	value.Ping = BOOL.value
	return true
end

-- ReadInput is the one-packet read: ReadInputBody, then the end check once after
-- the top-level object (SPEC §5); it reports the object's bits consumed.
function M.ReadInput(stream: any, value: Input): boolean
	if not M.ReadInputBody(stream, value) then
		return false
	end
	local bits = stream:bitsProcessed()
	local reader = stream._reader
	local bitsRead = reader._bitsRead
	if not stream:serializeEnd() then
		return false
	end
	stream._bits = bits
	reader._bitsRead = bitsRead
	return true
end

-- type InputPacket
export type InputPacket = {
	SynchronizeSequence: number,
	CurrentFrame: any,
	StartFrame: any,
	Inputs: {Input},
	InputsCount: number,
}

-- InputPacketMaxBits is the longest wire path; align pads at worst case (SPEC §6.1).
-- InputPacketMaxBytes is rounded up to the 8-byte write-buffer granularity.
M.InputPacketMaxBits = 2837
M.InputPacketMaxBytes = 360

-- NewInputPacket builds the value at its defaults (SPEC §5).
function M.NewInputPacket(): InputPacket
	local value: InputPacket = {
		SynchronizeSequence = 0,
		CurrentFrame = K1,
		StartFrame = K1,
		Inputs = table.create(16) :: {Input},
		InputsCount = 0,
	}
	for i = 1, 16 do
		value.Inputs[i] = M.NewInput()
	end
	return value
end

-- InitInputPacket restores fresh construction values in place, preserving storage.
function M.InitInputPacket(value: InputPacket)
	value.SynchronizeSequence = 0
	value.CurrentFrame = K1
	value.StartFrame = K1
	for i = 1, 16 do
	M.InitInput(value.Inputs[i])
	end
	value.InputsCount = 0
end

-- ZeroInputPacket resets the §5 zero form: all-zero storage, without declared defaults.
function M.ZeroInputPacket(value: InputPacket)
	value.SynchronizeSequence = 0
	value.CurrentFrame = K1
	value.StartFrame = K1
	for i = 1, 16 do
	M.ZeroInput(value.Inputs[i])
	end
	value.InputsCount = 0
end

-- WriteInputPacket writes the type wire (SPEC §4.3, §6.1: the declared order).
function M.WriteInputPacket(stream: any, value: InputPacket): boolean
	if not isInt(value.SynchronizeSequence, 0, 65535) then
		return false
	end
	NUM.value = value.SynchronizeSequence
	if not stream:serializeBits(NUM, 16) then
		return false
	end
	if not isWide(serialize.Uint64, value.CurrentFrame) then
		return false
	end
	WIDE.value = value.CurrentFrame
	if not stream:serializeUint64(WIDE) then
		return false
	end
	if not isWide(serialize.Uint64, value.StartFrame) then
		return false
	end
	WIDE.value = value.StartFrame
	if not stream:serializeUint64(WIDE) then
		return false
	end
	if type(value.Inputs) ~= "table" then -- the array's table storage
		return false
	end
	if not isInt(value.InputsCount, 0, 16) then -- the count guards the loop (SPEC §6.3)
		return false
	end
	for i = 1, value.InputsCount do
		if type(value.Inputs[i]) ~= "table" then -- each live record has table storage
			return false
		end
	end
	NUM.value = value.InputsCount
	if not stream:serializeInt(NUM, 0, 16) then -- the count (SPEC §4.6)
		return false
	end
	for i = 1, value.InputsCount do
		if type(value.Inputs[i]) ~= "table" then -- record storage
			return false
		end
		if not M.WriteInput(stream, value.Inputs[i]) then
			return false
		end
	end
	return true
end

-- ReadInputPacketBody reads the type wire; false refuses (stream:error() names a runtime
-- refusal; a schema rule's refusal returns false unlatched). A nested read
-- stops here; the end check belongs to the public one-packet read (SPEC §5).
function M.ReadInputPacketBody(stream: any, value: InputPacket): boolean
	if not stream:serializeBits(NUM, 16) then
		return false
	end
	value.SynchronizeSequence = NUM.value
	if not stream:serializeUint64(WIDE) then
		return false
	end
	value.CurrentFrame = WIDE.value
	if not stream:serializeUint64(WIDE) then
		return false
	end
	value.StartFrame = WIDE.value
	if not stream:serializeInt(NUM, 0, 16) then -- the count guards the loop (SPEC §6.3)
		return false
	end
	value.InputsCount = NUM.value
	for i = 1, value.InputsCount do
		if not M.ReadInputBody(stream, value.Inputs[i]) then
			return false
		end
	end
	return true
end

-- ReadInputPacket is the one-packet read: ReadInputPacketBody, then the end check once after
-- the top-level object (SPEC §5); it reports the object's bits consumed.
function M.ReadInputPacket(stream: any, value: InputPacket): boolean
	if not M.ReadInputPacketBody(stream, value) then
		return false
	end
	local bits = stream:bitsProcessed()
	local reader = stream._reader
	local bitsRead = reader._bitsRead
	if not stream:serializeEnd() then
		return false
	end
	stream._bits = bits
	reader._bitsRead = bitsRead
	return true
end

-- type ShipCreate
export type ShipCreate = {
	ShipType: _Enums.ShipType,
	Position: QuantizedPosition,
	Rotation: QuantizedRotation,
	LinearVelocity: QuantizedVelocity,
	HasFlags: boolean,
	Flags: any,
	Team: _Enums.Team,
	Health: number,
	Thrust: number,
	Pending: _Enums.Pending,
}

-- ShipCreateMaxBits is the longest wire path; align pads at worst case (SPEC §6.1).
-- ShipCreateMaxBytes is rounded up to the 8-byte write-buffer granularity.
M.ShipCreateMaxBits = 219
M.ShipCreateMaxBytes = 32

-- NewShipCreate builds the value at its defaults (SPEC §5).
function M.NewShipCreate(): ShipCreate
	local value: ShipCreate = {
		ShipType = 0,
		Position = M.NewQuantizedPosition(),
		Rotation = M.NewQuantizedRotation(),
		LinearVelocity = M.NewQuantizedVelocity(),
		HasFlags = false,
		Flags = K1,
		Team = 0,
		Health = 0,
		Thrust = 0,
		Pending = 0,
	}
	return value
end

-- InitShipCreate restores fresh construction values in place, preserving storage.
function M.InitShipCreate(value: ShipCreate)
	value.ShipType = 0
	M.InitQuantizedPosition(value.Position)
	M.InitQuantizedRotation(value.Rotation)
	M.InitQuantizedVelocity(value.LinearVelocity)
	value.HasFlags = false
	value.Flags = K1
	value.Team = 0
	value.Health = 0
	value.Thrust = 0
	value.Pending = 0
end

-- ZeroShipCreate resets the §5 zero form: all-zero storage, without declared defaults.
function M.ZeroShipCreate(value: ShipCreate)
	value.ShipType = 0
	M.ZeroQuantizedPosition(value.Position)
	M.ZeroQuantizedRotation(value.Rotation)
	M.ZeroQuantizedVelocity(value.LinearVelocity)
	value.HasFlags = false
	value.Flags = K1
	value.Team = 0
	value.Health = 0
	value.Thrust = 0
	value.Pending = 0
end

-- WriteShipCreate writes the type wire (SPEC §4.3, §6.1: the declared order).
function M.WriteShipCreate(stream: any, value: ShipCreate): boolean
	if not isInt(value.ShipType, 0, 5) then
		return false
	end
	NUM.value = value.ShipType
	if not stream:serializeInt(NUM, 0, 5) then
		return false
	end
	if type(value.Position) ~= "table" then -- record storage
		return false
	end
	if not M.WriteQuantizedPosition(stream, value.Position) then
		return false
	end
	if type(value.Rotation) ~= "table" then -- record storage
		return false
	end
	if not M.WriteQuantizedRotation(stream, value.Rotation) then
		return false
	end
	if type(value.LinearVelocity) ~= "table" then -- record storage
		return false
	end
	if not M.WriteQuantizedVelocity(stream, value.LinearVelocity) then
		return false
	end
	if type(value.HasFlags) ~= "boolean" then
		return false
	end
	BOOL.value = value.HasFlags
	if not stream:serializeBool(BOOL) then
		return false
	end
	if value.HasFlags then
		if not isWide(serialize.Uint64, value.Flags, K1, K2) then
			return false
		end
		WIDE.value = value.Flags
		if not stream:serializeBits64(WIDE, 4) then -- the flags wire width
			return false
		end
	end
	if not isInt(value.Team, 0, 2) then
		return false
	end
	NUM.value = value.Team
	if not stream:serializeInt(NUM, 0, 2) then
		return false
	end
	if not isInt(value.Health, 0, 1000) then
		return false
	end
	NUM.value = value.Health
	if not stream:serializeInt(NUM, 0, 1000) then -- int, offset from min (SPEC §4.3)
		return false
	end
	if not isInt(value.Thrust, 0, 100) then
		return false
	end
	NUM.value = value.Thrust
	if not stream:serializeInt(NUM, 0, 100) then -- int, offset from min (SPEC §4.3)
		return false
	end
	if not isInt(value.Pending, 0, 0) then
		return false
	end
	NUM.value = value.Pending
	if not stream:serializeInt(NUM, 0, 0) then
		return false
	end
	return true
end

-- ReadShipCreateBody reads the type wire; false refuses (stream:error() names a runtime
-- refusal; a schema rule's refusal returns false unlatched). A nested read
-- stops here; the end check belongs to the public one-packet read (SPEC §5).
function M.ReadShipCreateBody(stream: any, value: ShipCreate): boolean
	if not stream:serializeInt(NUM, 0, 5) then -- rejects a value above max (SPEC §4.3)
		return false
	end
	value.ShipType = NUM.value
	if not M.ReadQuantizedPositionBody(stream, value.Position) then
		return false
	end
	if not M.ReadQuantizedRotationBody(stream, value.Rotation) then
		return false
	end
	if not M.ReadQuantizedVelocityBody(stream, value.LinearVelocity) then
		return false
	end
	if not stream:serializeBool(BOOL) then
		return false
	end
	value.HasFlags = BOOL.value
	if value.HasFlags then
		if not stream:serializeBits64(WIDE, 4) then
			return false
		end
		value.Flags = WIDE.value
	else
		value.Flags = K1
	end
	if not stream:serializeInt(NUM, 0, 2) then -- rejects a value above max (SPEC §4.3)
		return false
	end
	value.Team = NUM.value
	if not stream:serializeInt(NUM, 0, 1000) then -- rejects out of range (SPEC §4.3)
		return false
	end
	value.Health = NUM.value
	if not stream:serializeInt(NUM, 0, 100) then -- rejects out of range (SPEC §4.3)
		return false
	end
	value.Thrust = NUM.value
	if not stream:serializeInt(NUM, 0, 0) then -- rejects a value above max (SPEC §4.3)
		return false
	end
	value.Pending = NUM.value
	return true
end

-- ReadShipCreate is the one-packet read: ReadShipCreateBody, then the end check once after
-- the top-level object (SPEC §5); it reports the object's bits consumed.
function M.ReadShipCreate(stream: any, value: ShipCreate): boolean
	if not M.ReadShipCreateBody(stream, value) then
		return false
	end
	local bits = stream:bitsProcessed()
	local reader = stream._reader
	local bitsRead = reader._bitsRead
	if not stream:serializeEnd() then
		return false
	end
	stream._bits = bits
	reader._bitsRead = bitsRead
	return true
end

-- type ExpressionProbe
export type ExpressionProbe = {
	HardpointIndex: number,
	SpinRate: number,
}

-- ExpressionProbeMaxBits is the longest wire path; align pads at worst case (SPEC §6.1).
-- ExpressionProbeMaxBytes is rounded up to the 8-byte write-buffer granularity.
M.ExpressionProbeMaxBits = 16
M.ExpressionProbeMaxBytes = 8

-- NewExpressionProbe builds the value at its defaults (SPEC §5).
function M.NewExpressionProbe(): ExpressionProbe
	local value: ExpressionProbe = {
		HardpointIndex = 0,
		SpinRate = 1024, -- specified default (SPEC §5)
	}
	return value
end

-- InitExpressionProbe restores fresh construction values in place, preserving storage.
function M.InitExpressionProbe(value: ExpressionProbe)
	value.HardpointIndex = 0
	value.SpinRate = 1024
end

-- ZeroExpressionProbe resets the §5 zero form: all-zero storage, without declared defaults.
function M.ZeroExpressionProbe(value: ExpressionProbe)
	value.HardpointIndex = 0
	value.SpinRate = 0
end

-- WriteExpressionProbe writes the type wire (SPEC §4.3, §6.1: the declared order).
function M.WriteExpressionProbe(stream: any, value: ExpressionProbe): boolean
	if not isInt(value.HardpointIndex, 0, 31) then
		return false
	end
	NUM.value = value.HardpointIndex
	if not stream:serializeInt(NUM, 0, 31) then -- int, offset from min (SPEC §4.3)
		return false
	end
	if not isInt(value.SpinRate, 1024, 2048) then
		return false
	end
	NUM.value = value.SpinRate
	if not stream:serializeInt(NUM, 1024, 2048) then -- int, offset from min (SPEC §4.3)
		return false
	end
	return true
end

-- ReadExpressionProbeBody reads the type wire; false refuses (stream:error() names a runtime
-- refusal; a schema rule's refusal returns false unlatched). A nested read
-- stops here; the end check belongs to the public one-packet read (SPEC §5).
function M.ReadExpressionProbeBody(stream: any, value: ExpressionProbe): boolean
	if not stream:serializeInt(NUM, 0, 31) then -- rejects out of range (SPEC §4.3)
		return false
	end
	value.HardpointIndex = NUM.value
	if not stream:serializeInt(NUM, 1024, 2048) then -- rejects out of range (SPEC §4.3)
		return false
	end
	value.SpinRate = NUM.value
	return true
end

-- ReadExpressionProbe is the one-packet read: ReadExpressionProbeBody, then the end check once after
-- the top-level object (SPEC §5); it reports the object's bits consumed.
function M.ReadExpressionProbe(stream: any, value: ExpressionProbe): boolean
	if not M.ReadExpressionProbeBody(stream, value) then
		return false
	end
	local bits = stream:bitsProcessed()
	local reader = stream._reader
	local bitsRead = reader._bitsRead
	if not stream:serializeEnd() then
		return false
	end
	stream._bits = bits
	reader._bitsRead = bitsRead
	return true
end

M.FloorLimit = K3

M.CeilingCount = K4

-- type ExtremeProbe
export type ExtremeProbe = {
	FloorBound: any,
	DoubledFloor: any,
	CeilingRange: any,
	FloorDefault: any,
	CeilingDefault: any,
}

-- ExtremeProbeMaxBits is the longest wire path; align pads at worst case (SPEC §6.1).
-- ExtremeProbeMaxBytes is rounded up to the 8-byte write-buffer granularity.
M.ExtremeProbeMaxBits = 320
M.ExtremeProbeMaxBytes = 40

-- NewExtremeProbe builds the value at its defaults (SPEC §5).
function M.NewExtremeProbe(): ExtremeProbe
	local value: ExtremeProbe = {
		FloorBound = K5,
		DoubledFloor = K5,
		CeilingRange = K6, -- specified default (SPEC §5)
		FloorDefault = K3, -- specified default (SPEC §5)
		CeilingDefault = K4, -- specified default (SPEC §5)
	}
	return value
end

-- InitExtremeProbe restores fresh construction values in place, preserving storage.
function M.InitExtremeProbe(value: ExtremeProbe)
	value.FloorBound = K5
	value.DoubledFloor = K5
	value.CeilingRange = K6
	value.FloorDefault = K3
	value.CeilingDefault = K4
end

-- ZeroExtremeProbe resets the §5 zero form: all-zero storage, without declared defaults.
function M.ZeroExtremeProbe(value: ExtremeProbe)
	value.FloorBound = K5
	value.DoubledFloor = K5
	value.CeilingRange = K1
	value.FloorDefault = K5
	value.CeilingDefault = K1
end

-- WriteExtremeProbe writes the type wire (SPEC §4.3, §6.1: the declared order).
function M.WriteExtremeProbe(stream: any, value: ExtremeProbe): boolean
	if not isWide(serialize.Int64, value.FloorBound, K3, K7) then
		return false
	end
	WIDE.value = value.FloorBound
	if not stream:serializeInt64(WIDE, K3, K7) then -- int64, offset from min (SPEC §4.3)
		return false
	end
	if not isWide(serialize.Int64, value.DoubledFloor, K3, K7) then
		return false
	end
	WIDE.value = value.DoubledFloor
	if not stream:serializeInt64(WIDE, K3, K7) then -- int64, offset from min (SPEC §4.3)
		return false
	end
	if not isWide(serialize.Uint64, value.CeilingRange, K6, K4) then
		return false
	end
	WIDE.value = serialize.Uint64.sub(value.CeilingRange, K6)
	if not stream:serializeBits64(WIDE, 64) then -- the offset from min (SPEC §4.3)
		return false
	end
	if not isWide(serialize.Int64, value.FloorDefault) then
		return false
	end
	WIDE.value = serialize.Int64.toUint64(value.FloorDefault)
	if not stream:serializeBits64(WIDE, 64) then -- two's complement, the storage width (SPEC §4.3)
		return false
	end
	if not isWide(serialize.Uint64, value.CeilingDefault) then
		return false
	end
	WIDE.value = value.CeilingDefault
	if not stream:serializeUint64(WIDE) then
		return false
	end
	return true
end

-- ReadExtremeProbeBody reads the type wire; false refuses (stream:error() names a runtime
-- refusal; a schema rule's refusal returns false unlatched). A nested read
-- stops here; the end check belongs to the public one-packet read (SPEC §5).
function M.ReadExtremeProbeBody(stream: any, value: ExtremeProbe): boolean
	if not stream:serializeInt64(WIDE, K3, K7) then -- rejects out of range (SPEC §4.3)
		return false
	end
	value.FloorBound = WIDE.value
	if not stream:serializeInt64(WIDE, K3, K7) then -- rejects out of range (SPEC §4.3)
		return false
	end
	value.DoubledFloor = WIDE.value
	if not stream:serializeBits64(WIDE, 64) then
		return false
	end
	if serialize.Uint64.cmp(WIDE.value, K8) > 0 then -- a read rejects out of range (SPEC §4.3)
		stream:fail("value_out_of_range")
		return false
	end
	value.CeilingRange = serialize.Uint64.add(WIDE.value, K6)
	if not stream:serializeBits64(WIDE, 64) then
		return false
	end
	value.FloorDefault = serialize.Uint64.toInt64(WIDE.value)
	if not stream:serializeUint64(WIDE) then
		return false
	end
	value.CeilingDefault = WIDE.value
	return true
end

-- ReadExtremeProbe is the one-packet read: ReadExtremeProbeBody, then the end check once after
-- the top-level object (SPEC §5); it reports the object's bits consumed.
function M.ReadExtremeProbe(stream: any, value: ExtremeProbe): boolean
	if not M.ReadExtremeProbeBody(stream, value) then
		return false
	end
	local bits = stream:bitsProcessed()
	local reader = stream._reader
	local bitsRead = reader._bitsRead
	if not stream:serializeEnd() then
		return false
	end
	stream._bits = bits
	reader._bitsRead = bitsRead
	return true
end

-- type ExtremeRow
export type ExtremeRow = {
	ClampedFloor: any,
	ClampedCeiling: any,
	FloorDef: any,
	CeilingDef: any,
}

-- ExtremeRowMaxBits is the longest wire path; align pads at worst case (SPEC §6.1).
-- ExtremeRowMaxBytes is rounded up to the 8-byte write-buffer granularity.
M.ExtremeRowMaxBits = 256
M.ExtremeRowMaxBytes = 32

-- NewExtremeRow builds the value at its defaults (SPEC §5).
function M.NewExtremeRow(): ExtremeRow
	local value: ExtremeRow = {
		ClampedFloor = K5,
		ClampedCeiling = K6, -- specified default (SPEC §5)
		FloorDef = K3, -- specified default (SPEC §5)
		CeilingDef = K4, -- specified default (SPEC §5)
	}
	return value
end

-- InitExtremeRow restores fresh construction values in place, preserving storage.
function M.InitExtremeRow(value: ExtremeRow)
	value.ClampedFloor = K5
	value.ClampedCeiling = K6
	value.FloorDef = K3
	value.CeilingDef = K4
end

-- ZeroExtremeRow resets the §5 zero form: all-zero storage, without declared defaults.
function M.ZeroExtremeRow(value: ExtremeRow)
	value.ClampedFloor = K5
	value.ClampedCeiling = K1
	value.FloorDef = K5
	value.CeilingDef = K1
end

-- WriteExtremeRow writes the type wire (SPEC §4.3, §6.1: the declared order).
function M.WriteExtremeRow(stream: any, value: ExtremeRow): boolean
	if not isWide(serialize.Int64, value.ClampedFloor, K3, K7) then
		return false
	end
	WIDE.value = value.ClampedFloor
	if not stream:serializeInt64(WIDE, K3, K7) then -- int64, offset from min (SPEC §4.3)
		return false
	end
	if not isWide(serialize.Uint64, value.ClampedCeiling, K6, K8) then
		return false
	end
	WIDE.value = serialize.Uint64.sub(value.ClampedCeiling, K6)
	if not stream:serializeBits64(WIDE, 64) then -- the offset from min (SPEC §4.3)
		return false
	end
	if not isWide(serialize.Int64, value.FloorDef) then
		return false
	end
	WIDE.value = serialize.Int64.toUint64(value.FloorDef)
	if not stream:serializeBits64(WIDE, 64) then -- two's complement, the storage width (SPEC §4.3)
		return false
	end
	if not isWide(serialize.Uint64, value.CeilingDef) then
		return false
	end
	WIDE.value = value.CeilingDef
	if not stream:serializeUint64(WIDE) then
		return false
	end
	return true
end

-- ReadExtremeRowBody reads the type wire; false refuses (stream:error() names a runtime
-- refusal; a schema rule's refusal returns false unlatched). A nested read
-- stops here; the end check belongs to the public one-packet read (SPEC §5).
function M.ReadExtremeRowBody(stream: any, value: ExtremeRow): boolean
	if not stream:serializeInt64(WIDE, K3, K7) then -- rejects out of range (SPEC §4.3)
		return false
	end
	value.ClampedFloor = WIDE.value
	if not stream:serializeBits64(WIDE, 64) then
		return false
	end
	if serialize.Uint64.cmp(WIDE.value, K9) > 0 then -- a read rejects out of range (SPEC §4.3)
		stream:fail("value_out_of_range")
		return false
	end
	value.ClampedCeiling = serialize.Uint64.add(WIDE.value, K6)
	if not stream:serializeBits64(WIDE, 64) then
		return false
	end
	value.FloorDef = serialize.Uint64.toInt64(WIDE.value)
	if not stream:serializeUint64(WIDE) then
		return false
	end
	value.CeilingDef = WIDE.value
	return true
end

-- ReadExtremeRow is the one-packet read: ReadExtremeRowBody, then the end check once after
-- the top-level object (SPEC §5); it reports the object's bits consumed.
function M.ReadExtremeRow(stream: any, value: ExtremeRow): boolean
	if not M.ReadExtremeRowBody(stream, value) then
		return false
	end
	local bits = stream:bitsProcessed()
	local reader = stream._reader
	local bitsRead = reader._bitsRead
	if not stream:serializeEnd() then
		return false
	end
	stream._bits = bits
	reader._bitsRead = bitsRead
	return true
end

return M
