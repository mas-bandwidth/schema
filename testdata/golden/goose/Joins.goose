    guard schema_rt::wire_bits(s, value.Lead, 5) else { return false; }
    guard schema_rt::wire_bool(s, value.Flag) else { return false; }
    if value.Flag {
        var narrow2: u32 = 0;
        guard schema_rt::wire_bits(s, narrow2, 3) else { return false; }
        let raw1: u64 = narrow2;
        guard raw1 <= 4 else { return serialize_fail(s, SERIALIZE_ERROR_VALUE_OUT_OF_RANGE); } // a value smuggled into the bit headroom is refused
        value.SLength = (raw1) as! i32;
        guard serialize_bytes(s, value.S[0..value.SLength]) else { return false; }
        guard serialize_valid_utf8(value.S[0..value.SLength]) else { return serialize_fail(s, SERIALIZE_ERROR_INVALID_UTF8); } // malformed UTF-8 is content the read refuses
        for c3 in value.S[0..value.SLength] { guard c3 != 0 else { return serialize_fail(s, SERIALIZE_ERROR_EMBEDDED_NUL); } } // an interior null is content the read refuses
        value.B = 0;
    } else {
        guard schema_rt::wire_bits(s, value.B, 10) else { return false; }
        for ix4 in 4 { value.S[ix4] = 0; }
        value.SLength = 0;
    }
    guard schema_rt::wire_bits(s, value.Tail, 7) else { return false; }
    return true;
}

// ArmArrayMaxBits is the longest wire path in bits, alignment padding at its worst case.
let ArmArrayMaxBits: i64 = 54;
// ArmArrayMaxBytes is ArmArrayMaxBits in bytes, rounded up to the 8-byte write-buffer granularity:
// size write buffers from it.
let ArmArrayMaxBytes: i64 = 8;

// ZeroArmArray sets value to its zero form (SPEC §5): every field zero, a
// nested type at ITS zero form — not the specified defaults, which NewArmArray
// builds. A read zeroes the untaken side of a branch with it.
fn ZeroArmArray(value: ArmArray&) {
    value.Lead = 0;
    value.Flag = false;
    for ix1 in 3 {
        value.Items[ix1] = 0;
    }
    value.ItemsCount = 0;
    value.B = 0;
    value.Tail = 0;
}

// WriteArmArray writes value in wire order. It returns SERIALIZE_ERROR_NONE, or the
// refusal kind of the first value the wire cannot carry; the size written is
// serialize_bits_processed(s).
fn WriteArmArray(s: WriteStream&, value: ArmArray&) -> i32 {
    if s.num_bits - s.bits_written < ArmArrayMaxBits {
        // a stream too small for the value refuses before the runtime sees the
        // write; serialize.goose aborts on a write past the buffer (U9)
        let need = _MeasureArmArray(value, s.bits_written) - s.bits_written;
        if need > s.num_bits - s.bits_written { return SERIALIZE_ERROR_PAST_END; }
    }
    var l = schema_rt::wire_open(s);
    let refusal = _WriteArmArray(s, l, value);
    schema_rt::wire_close(s, l);
    return refusal;
}

inline fn _WriteArmArray(s: WriteStream&, l: schema_rt::WireW&, value: ArmArray&) -> i32 {
    if value.Lead > 31 { return SERIALIZE_ERROR_VALUE_OUT_OF_RANGE; } // a value wider than bits(5) cannot ride
    schema_rt::wire_bits(s, l, value.Lead, 5);
    schema_rt::wire_bool(s, l, value.Flag);
    if value.Flag {
        if value.ItemsCount < 0 || value.ItemsCount > 3 { return SERIALIZE_ERROR_VALUE_OUT_OF_RANGE; }
        schema_rt::wire_bits(s, l, (value.ItemsCount) as! u32, 2); // the count, offset from 0
        for ix1 in value.ItemsCount {
            if value.Items[ix1] > 8191 { return SERIALIZE_ERROR_VALUE_OUT_OF_RANGE; }
            let offset2: u64 = value.Items[ix1];
            schema_rt::wire_bits(s, l, (offset2) as! u32, 13);
        }
    } else {
        if value.B > 511 { return SERIALIZE_ERROR_VALUE_OUT_OF_RANGE; } // a value wider than bits(9) cannot ride
        schema_rt::wire_bits(s, l, value.B, 9);
    }
    if value.Tail > 127 { return SERIALIZE_ERROR_VALUE_OUT_OF_RANGE; } // a value wider than bits(7) cannot ride
    schema_rt::wire_bits(s, l, value.Tail, 7);
    return SERIALIZE_ERROR_NONE;
}

fn _MeasureArmArray(value: ArmArray&, bits: i64) -> i64 {
    var total = bits;
    total += 5;
    total += 1;
    if value.Flag {
        total += 2; // the count
        let n1 = if value.ItemsCount > 3 { 3 } else if value.ItemsCount < 0 { 0 } else { value.ItemsCount };
        if n1 > 0 {
            for ix2 in n1 {
                total += 13;
            }
        }
    } else {
        total += 9;
    }
    total += 7;
    return total;
}

// ReadArmArray reads value, validating every field, then ends the packet (SPEC §5).
// It returns false with the reason latched on the stream (serialize_error(s)).
fn ReadArmArray(s: ReadStream&, value: ArmArray&) -> bool {
    guard _ReadArmArray(s, value) else { return false; }
    guard serialize_end(s) else { return false; } // one packet's end: no trailing byte, no set padding (SPEC §5)
    return true;
}

inline fn _ReadArmArray(s: ReadStream&, value: ArmArray&) -> bool {
    guard schema_rt::wire_bits(s, value.Lead, 5) else { return false; }
    guard schema_rt::wire_bool(s, value.Flag) else { return false; }
    if value.Flag {
        var narrow2: u32 = 0;
        guard schema_rt::wire_bits(s, narrow2, 2) else { return false; }
        let raw1: u64 = narrow2;
        value.ItemsCount = (raw1) as! i32;
        for ix3 in value.ItemsCount {
            var narrow5: u32 = 0;
            guard schema_rt::wire_bits(s, narrow5, 13) else { return false; }
            let raw4: u64 = narrow5;
            value.Items[ix3] = (raw4) as! u16;
        }
        value.B = 0;
    } else {
        guard schema_rt::wire_bits(s, value.B, 9) else { return false; }
        for ix6 in 3 {
            value.Items[ix6] = 0;
        }
        value.ItemsCount = 0;
    }
    guard schema_rt::wire_bits(s, value.Tail, 7) else { return false; }
    return true;
}

// NarrowMaxBits is the longest wire path in bits, alignment padding at its worst case.
let NarrowMaxBits: i64 = 3;
// NarrowMaxBytes is NarrowMaxBits in bytes, rounded up to the 8-byte write-buffer granularity:
// size write buffers from it.
let NarrowMaxBytes: i64 = 8;

// ZeroNarrow sets value to its zero form (SPEC §5): every field zero, a
// nested type at ITS zero form — not the specified defaults, which NewNarrow
// builds. A read zeroes the untaken side of a branch with it.
fn ZeroNarrow(value: Narrow&) {
    value.N = 0;
}

// WriteNarrow writes value in wire order. It returns SERIALIZE_ERROR_NONE, or the
// refusal kind of the first value the wire cannot carry; the size written is
// serialize_bits_processed(s).
fn WriteNarrow(s: WriteStream&, value: Narrow&) -> i32 {
    if s.num_bits - s.bits_written < NarrowMaxBits {
        // a stream too small for the value refuses before the runtime sees the
        // write; serialize.goose aborts on a write past the buffer (U9)
        let need = _MeasureNarrow(value, s.bits_written) - s.bits_written;
        if need > s.num_bits - s.bits_written { return SERIALIZE_ERROR_PAST_END; }
    }
    var l = schema_rt::wire_open(s);
    let refusal = _WriteNarrow(s, l, value);
    schema_rt::wire_close(s, l);
    return refusal;
}

inline fn _WriteNarrow(s: WriteStream&, l: schema_rt::WireW&, value: Narrow&) -> i32 {
    if value.N > 7 { return SERIALIZE_ERROR_VALUE_OUT_OF_RANGE; } // a value wider than bits(3) cannot ride
    schema_rt::wire_bits(s, l, value.N, 3);
    return SERIALIZE_ERROR_NONE;
}

fn _MeasureNarrow(value: Narrow&, bits: i64) -> i64 {
    var total = bits;
    total += 3;
    return total;
}

// ReadNarrow reads value, validating every field, then ends the packet (SPEC §5).
// It returns false with the reason latched on the stream (serialize_error(s)).
fn ReadNarrow(s: ReadStream&, value: Narrow&) -> bool {
    guard _ReadNarrow(s, value) else { return false; }
    guard serialize_end(s) else { return false; } // one packet's end: no trailing byte, no set padding (SPEC §5)
    return true;
}

inline fn _ReadNarrow(s: ReadStream&, value: Narrow&) -> bool {
    guard schema_rt::wire_bits(s, value.N, 3) else { return false; }
    return true;
}

// WideMaxBits is the longest wire path in bits, alignment padding at its worst case.
let WideMaxBits: i64 = 37;
// WideMaxBytes is WideMaxBits in bytes, rounded up to the 8-byte write-buffer granularity:
// size write buffers from it.
let WideMaxBytes: i64 = 8;

// ZeroWide sets value to its zero form (SPEC §5): every field zero, a
// nested type at ITS zero form — not the specified defaults, which NewWide
// builds. A read zeroes the untaken side of a branch with it.
fn ZeroWide(value: Wide&) {
    value.W = 0;
}

// WriteWide writes value in wire order. It returns SERIALIZE_ERROR_NONE, or the
// refusal kind of the first value the wire cannot carry; the size written is
// serialize_bits_processed(s).
fn WriteWide(s: WriteStream&, value: Wide&) -> i32 {
    if s.num_bits - s.bits_written < WideMaxBits {
        // a stream too small for the value refuses before the runtime sees the
        // write; serialize.goose aborts on a write past the buffer (U9)
        let need = _MeasureWide(value, s.bits_written) - s.bits_written;
        if need > s.num_bits - s.bits_written { return SERIALIZE_ERROR_PAST_END; }
    }
    var l = schema_rt::wire_open(s);
    let refusal = _WriteWide(s, l, value);
    schema_rt::wire_close(s, l);
    return refusal;
}

inline fn _WriteWide(s: WriteStream&, l: schema_rt::WireW&, value: Wide&) -> i32 {
    if value.W > 137438953471 { return SERIALIZE_ERROR_VALUE_OUT_OF_RANGE; } // a value wider than bits(37) cannot ride
    schema_rt::wire_bits64(s, l, value.W, 37);
    return SERIALIZE_ERROR_NONE;
}

fn _MeasureWide(value: Wide&, bits: i64) -> i64 {
    var total = bits;
    total += 37;
    return total;
}

// ReadWide reads value, validating every field, then ends the packet (SPEC §5).
// It returns false with the reason latched on the stream (serialize_error(s)).
fn ReadWide(s: ReadStream&, value: Wide&) -> bool {
    guard _ReadWide(s, value) else { return false; }
    guard serialize_end(s) else { return false; } // one packet's end: no trailing byte, no set padding (SPEC §5)
    return true;
}

inline fn _ReadWide(s: ReadStream&, value: Wide&) -> bool {
    guard schema_rt::wire_bits64(s, value.W, 37) else { return false; }
    return true;
}

// UnevenMaxBits is the longest wire path in bits, alignment padding at its worst case.
let UnevenMaxBits: i64 = 39;
// UnevenMaxBytes is UnevenMaxBits in bytes, rounded up to the 8-byte write-buffer granularity:
// size write buffers from it.
let UnevenMaxBytes: i64 = 8;

// ZeroUneven sets value to its zero form (SPEC §5): the empty union (None),
// every arm's storage at its zero form.
fn ZeroUneven(value: Uneven&) {
    value.Type = UnevenTypeNone;
    ZeroNarrow(value.Narrow);
    ZeroWide(value.Wide);
}

// WriteUneven writes the tag, then the selected arm's payload (SPEC §4.8). The
// tag validates BEFORE it rides: an out-of-set tag writes nothing.
fn WriteUneven(s: WriteStream&, value: Uneven&) -> i32 {
    if s.num_bits - s.bits_written < UnevenMaxBits {
        // a stream too small for the value refuses before the runtime sees the
        // write; serialize.goose aborts on a write past the buffer (U9)
        let need = _MeasureUneven(value, s.bits_written) - s.bits_written;
        if need > s.num_bits - s.bits_written { return SERIALIZE_ERROR_PAST_END; }
    }
    var l = schema_rt::wire_open(s);
    let refusal = _WriteUneven(s, l, value);
    schema_rt::wire_close(s, l);
    return refusal;
}

inline fn _WriteUneven(s: WriteStream&, l: schema_rt::WireW&, value: Uneven&) -> i32 {
    if value.Type > UnevenTypeMax { return SERIALIZE_ERROR_VALUE_OUT_OF_RANGE; } // the tag validates BEFORE it rides
    schema_rt::wire_bits(s, l, value.Type, 2);
    if value.Type == UnevenTypeNarrow {
        return _WriteNarrow(s, l, value.Narrow);
    }
    if value.Type == UnevenTypeWide {
        return _WriteWide(s, l, value.Wide);
    }
    return SERIALIZE_ERROR_NONE; // None or a payload-free arm: the tag is the whole wire
}

fn _MeasureUneven(value: Uneven&, bits: i64) -> i64 {
    var total = bits;
    total += 2; // the tag
    if value.Type == UnevenTypeNarrow { total = _MeasureNarrow(value.Narrow, total); }
    if value.Type == UnevenTypeWide { total = _MeasureWide(value.Wide, total); }
    return total;
}

// ReadUneven reads the tag, refusing one above the arm count, then builds the
// selected arm FRESH at its defaults, reads its payload, and ends the packet (SPEC §5).
fn ReadUneven(s: ReadStream&, value: Uneven&) -> bool {
    guard _ReadUneven(s, value) else { return false; }
    guard serialize_end(s) else { return false; } // one packet's end: no trailing byte, no set padding (SPEC §5)
    return true;
}

inline fn _ReadUneven(s: ReadStream&, value: Uneven&) -> bool {
    var tag: u32 = 0;
    guard schema_rt::wire_bits(s, tag, 2) else { return false; }
    guard tag <= 2 else { return serialize_fail(s, SERIALIZE_ERROR_VALUE_OUT_OF_RANGE); } // not a wire-legal tag
    value.Type = tag as! UnevenType;
    if value.Type == UnevenTypeNarrow {
        value.Narrow = Narrow { .. }; // a fresh payload on every selection
        return _ReadNarrow(s, value.Narrow);
    }
    if value.Type == UnevenTypeWide {
        value.Wide = Wide { .. }; // a fresh payload on every selection
        return _ReadWide(s, value.Wide);
    }
    return true; // None or a payload-free arm: the tag is the whole wire
}

// HoldsUnevenMaxBits is the longest wire path in bits, alignment padding at its worst case.
let HoldsUnevenMaxBits: i64 = 55;
// HoldsUnevenMaxBytes is HoldsUnevenMaxBits in bytes, rounded up to the 8-byte write-buffer granularity:
// size write buffers from it.
let HoldsUnevenMaxBytes: i64 = 8;

// ZeroHoldsUneven sets value to its zero form (SPEC §5): every field zero, a
// nested type at ITS zero form — not the specified defaults, which NewHoldsUneven
// builds. A read zeroes the untaken side of a branch with it.
fn ZeroHoldsUneven(value: HoldsUneven&) {
    value.Lead = 0;
    ZeroUneven(value.U);
    value.Tail = 0;
}

// WriteHoldsUneven writes value in wire order. It returns SERIALIZE_ERROR_NONE, or the
// refusal kind of the first value the wire cannot carry; the size written is
// serialize_bits_processed(s).
fn WriteHoldsUneven(s: WriteStream&, value: HoldsUneven&) -> i32 {
    if s.num_bits - s.bits_written < HoldsUnevenMaxBits {
        // a stream too small for the value refuses before the runtime sees the
        // write; serialize.goose aborts on a write past the buffer (U9)
        let need = _MeasureHoldsUneven(value, s.bits_written) - s.bits_written;
        if need > s.num_bits - s.bits_written { return SERIALIZE_ERROR_PAST_END; }
    }
    var l = schema_rt::wire_open(s);
    let refusal = _WriteHoldsUneven(s, l, value);
    schema_rt::wire_close(s, l);
    return refusal;
}

inline fn _WriteHoldsUneven(s: WriteStream&, l: schema_rt::WireW&, value: HoldsUneven&) -> i32 {
    if value.Lead > 31 { return SERIALIZE_ERROR_VALUE_OUT_OF_RANGE; } // a value wider than bits(5) cannot ride
    schema_rt::wire_bits(s, l, value.Lead, 5);
    let refusal1 = _WriteUneven(s, l, value.U);
    if refusal1 != SERIALIZE_ERROR_NONE { return refusal1; }
    if value.Tail > 2047 { return SERIALIZE_ERROR_VALUE_OUT_OF_RANGE; } // a value wider than bits(11) cannot ride
    schema_rt::wire_bits(s, l, value.Tail, 11);
    return SERIALIZE_ERROR_NONE;
}

fn _MeasureHoldsUneven(value: HoldsUneven&, bits: i64) -> i64 {
    var total = bits;
    total += 5;
    total = _MeasureUneven(value.U, total);
    total += 11;
    return total;
}

// ReadHoldsUneven reads value, validating every field, then ends the packet (SPEC §5).
// It returns false with the reason latched on the stream (serialize_error(s)).
fn ReadHoldsUneven(s: ReadStream&, value: HoldsUneven&) -> bool {
    guard _ReadHoldsUneven(s, value) else { return false; }
    guard serialize_end(s) else { return false; } // one packet's end: no trailing byte, no set padding (SPEC §5)
    return true;
}

inline fn _ReadHoldsUneven(s: ReadStream&, value: HoldsUneven&) -> bool {
    guard schema_rt::wire_bits(s, value.Lead, 5) else { return false; }
    guard _ReadUneven(s, value.U) else { return false; }
    guard schema_rt::wire_bits(s, value.Tail, 11) else { return false; }
    return true;
}

// ArrUnevenMaxBits is the longest wire path in bits, alignment padding at its worst case.
let ArrUnevenMaxBits: i64 = 127;
// ArrUnevenMaxBytes is ArrUnevenMaxBits in bytes, rounded up to the 8-byte write-buffer granularity:
// size write buffers from it.
let ArrUnevenMaxBytes: i64 = 16;

// ZeroArrUneven sets value to its zero form (SPEC §5): every field zero, a
// nested type at ITS zero form — not the specified defaults, which NewArrUneven
// builds. A read zeroes the untaken side of a branch with it.
fn ZeroArrUneven(value: ArrUneven&) {
    value.Lead = 0;
    for ix1 in 3 {
        ZeroUneven(value.Items[ix1]);
    }
    value.ItemsCount = 0;
    value.Tail = 0;
}

// WriteArrUneven writes value in wire order. It returns SERIALIZE_ERROR_NONE, or the
// refusal kind of the first value the wire cannot carry; the size written is
// serialize_bits_processed(s).
fn WriteArrUneven(s: WriteStream&, value: ArrUneven&) -> i32 {
    if s.num_bits - s.bits_written < ArrUnevenMaxBits {
        // a stream too small for the value refuses before the runtime sees the
        // write; serialize.goose aborts on a write past the buffer (U9)
        let need = _MeasureArrUneven(value, s.bits_written) - s.bits_written;
        if need > s.num_bits - s.bits_written { return SERIALIZE_ERROR_PAST_END; }
    }
    var l = schema_rt::wire_open(s);
    let refusal = _WriteArrUneven(s, l, value);
    schema_rt::wire_close(s, l);
    return refusal;
}

inline fn _WriteArrUneven(s: WriteStream&, l: schema_rt::WireW&, value: ArrUneven&) -> i32 {
    if value.Lead > 31 { return SERIALIZE_ERROR_VALUE_OUT_OF_RANGE; } // a value wider than bits(5) cannot ride
    schema_rt::wire_bits(s, l, value.Lead, 5);
    if value.ItemsCount < 0 || value.ItemsCount > 3 { return SERIALIZE_ERROR_VALUE_OUT_OF_RANGE; }
    schema_rt::wire_bits(s, l, (value.ItemsCount) as! u32, 2); // the count, offset from 0
    for ix1 in value.ItemsCount {
        let refusal2 = _WriteUneven(s, l, value.Items[ix1]);
        if refusal2 != SERIALIZE_ERROR_NONE { return refusal2; }
    }
    if value.Tail > 7 { return SERIALIZE_ERROR_VALUE_OUT_OF_RANGE; } // a value wider than bits(3) cannot ride
    schema_rt::wire_bits(s, l, value.Tail, 3);
    return SERIALIZE_ERROR_NONE;
}

fn _MeasureArrUneven(value: ArrUneven&, bits: i64) -> i64 {
    var total = bits;
    total += 5;
    total += 2; // the count
    let n1 = if value.ItemsCount > 3 { 3 } else if value.ItemsCount < 0 { 0 } else { value.ItemsCount };
    if n1 > 0 {
        for ix2 in n1 {
            total = _MeasureUneven(value.Items[ix2], total);
        }
    }
    total += 3;
    return total;
}

// ReadArrUneven reads value, validating every field, then ends the packet (SPEC §5).
// It returns false with the reason latched on the stream (serialize_error(s)).
fn ReadArrUneven(s: ReadStream&, value: ArrUneven&) -> bool {
    guard _ReadArrUneven(s, value) else { return false; }
    guard serialize_end(s) else { return false; } // one packet's end: no trailing byte, no set padding (SPEC §5)
    return true;
}

inline fn _ReadArrUneven(s: ReadStream&, value: ArrUneven&) -> bool {
    guard schema_rt::wire_bits(s, value.Lead, 5) else { return false; }
    var narrow2: u32 = 0;
    guard schema_rt::wire_bits(s, narrow2, 2) else { return false; }
    let raw1: u64 = narrow2;
    value.ItemsCount = (raw1) as! i32;
    for ix3 in value.ItemsCount {
        guard _ReadUneven(s, value.Items[ix3]) else { return false; }
    }
    guard schema_rt::wire_bits(s, value.Tail, 3) else { return false; }
    return true;
}

// RegainAfterAlignMaxBits is the longest wire path in bits, alignment padding at its worst case.
let RegainAfterAlignMaxBits: i64 = 172;
// RegainAfterAlignMaxBytes is RegainAfterAlignMaxBits in bytes, rounded up to the 8-byte write-buffer granularity:
// size write buffers from it.
let RegainAfterAlignMaxBytes: i64 = 24;

// ZeroRegainAfterAlign sets value to its zero form (SPEC §5): every field zero, a
// nested type at ITS zero form — not the specified defaults, which NewRegainAfterAlign
// builds. A read zeroes the untaken side of a branch with it.
fn ZeroRegainAfterAlign(value: RegainAfterAlign&) {
    value.Lead = 0;
    for ix1 in 3 {
        value.Items[ix1] = 0;
    }
    value.ItemsCount = 0;
    for ix2 in 4 { value.S[ix2] = 0; }
    value.SLength = 0;
    value.P = 0;
    value.Q = 0;
    value.R = 0;
    value.Tail = 0;
}

// WriteRegainAfterAlign writes value in wire order. It returns SERIALIZE_ERROR_NONE, or the
// refusal kind of the first value the wire cannot carry; the size written is
// serialize_bits_processed(s).
fn WriteRegainAfterAlign(s: WriteStream&, value: RegainAfterAlign&) -> i32 {
    if s.num_bits - s.bits_written < RegainAfterAlignMaxBits {
        // a stream too small for the value refuses before the runtime sees the
        // write; serialize.goose aborts on a write past the buffer (U9)
        let need = _MeasureRegainAfterAlign(value, s.bits_written) - s.bits_written;
        if need > s.num_bits - s.bits_written { return SERIALIZE_ERROR_PAST_END; }
    }
    var l = schema_rt::wire_open(s);
    let refusal = _WriteRegainAfterAlign(s, l, value);
    schema_rt::wire_close(s, l);
    return refusal;
}

inline fn _WriteRegainAfterAlign(s: WriteStream&, l: schema_rt::WireW&, value: RegainAfterAlign&) -> i32 {
    if value.Lead > 31 { return SERIALIZE_ERROR_VALUE_OUT_OF_RANGE; } // a value wider than bits(5) cannot ride
    schema_rt::wire_bits(s, l, value.Lead, 5);
    if value.ItemsCount < 0 || value.ItemsCount > 3 { return SERIALIZE_ERROR_VALUE_OUT_OF_RANGE; }
    schema_rt::wire_bits(s, l, (value.ItemsCount) as! u32, 2); // the count, offset from 0
    for ix1 in value.ItemsCount {
        if value.Items[ix1] > 8191 { return SERIALIZE_ERROR_VALUE_OUT_OF_RANGE; }
        let offset2: u64 = value.Items[ix1];
        schema_rt::wire_bits(s, l, (offset2) as! u32, 13);
    }
    if value.SLength < 0 || value.SLength > 4 { return SERIALIZE_ERROR_VALUE_OUT_OF_RANGE; }
    if !serialize_valid_utf8(value.S[0..value.SLength]) { return SERIALIZE_ERROR_INVALID_UTF8; } // malformed UTF-8 is not a value of the type
    for c3 in value.S[0..value.SLength] { if c3 == 0 { return SERIALIZE_ERROR_EMBEDDED_NUL; } } // a zero byte is not a value of the type
    schema_rt::wire_bits(s, l, value.SLength as! u32, 3);
    schema_rt::wire_close(s, l);
    serialize_bytes(s, value.S[0..value.SLength]);
    schema_rt::wire_reopen(s, l);
    schema_rt::wire_bits(s, l, value.P, 32);
    if value.Q > 536870911 { return SERIALIZE_ERROR_VALUE_OUT_OF_RANGE; } // a value wider than bits(29) cannot ride
    schema_rt::wire_bits(s, l, value.Q, 29);
    if value.R > 524287 { return SERIALIZE_ERROR_VALUE_OUT_OF_RANGE; } // a value wider than bits(19) cannot ride
    schema_rt::wire_bits(s, l, value.R, 19);
    if value.Tail > 15 { return SERIALIZE_ERROR_VALUE_OUT_OF_RANGE; } // a value wider than bits(4) cannot ride
    schema_rt::wire_bits(s, l, value.Tail, 4);
    return SERIALIZE_ERROR_NONE;
}

fn _MeasureRegainAfterAlign(value: RegainAfterAlign&, bits: i64) -> i64 {
    var total = bits;
    total += 5;
    total += 2; // the count
    let n1 = if value.ItemsCount > 3 { 3 } else if value.ItemsCount < 0 { 0 } else { value.ItemsCount };
    if n1 > 0 {
        for ix2 in n1 {
            total += 13;
        }
    }
    total += 3; // the length
    total += (8 - total % 8) % 8; // the payload aligns
    let len3: i64 = if value.SLength > 4 { 4 } else if value.SLength < 0 { 0 } else { value.SLength };
    total += len3 * 8;
    total += 32;
    total += 29;
    total += 19;
    total += 4;
    return total;
}

// ReadRegainAfterAlign reads value, validating every field, then ends the packet (SPEC §5).
// It returns false with the reason latched on the stream (serialize_error(s)).
fn ReadRegainAfterAlign(s: ReadStream&, value: RegainAfterAlign&) -> bool {
    guard _ReadRegainAfterAlign(s, value) else { return false; }
    guard serialize_end(s) else { return false; } // one packet's end: no trailing byte, no set padding (SPEC §5)
    return true;
}

inline fn _ReadRegainAfterAlign(s: ReadStream&, value: RegainAfterAlign&) -> bool {
    guard schema_rt::wire_bits(s, value.Lead, 5) else { return false; }
    var narrow2: u32 = 0;
    guard schema_rt::wire_bits(s, narrow2, 2) else { return false; }
    let raw1: u64 = narrow2;
    value.ItemsCount = (raw1) as! i32;
    for ix3 in value.ItemsCount {
        var narrow5: u32 = 0;
        guard schema_rt::wire_bits(s, narrow5, 13) else { return false; }
        let raw4: u64 = narrow5;
        value.Items[ix3] = (raw4) as! u16;
    }
    var narrow7: u32 = 0;
    guard schema_rt::wire_bits(s, narrow7, 3) else { return false; }
    let raw6: u64 = narrow7;
    guard raw6 <= 4 else { return serialize_fail(s, SERIALIZE_ERROR_VALUE_OUT_OF_RANGE); } // a value smuggled into the bit headroom is refused
    value.SLength = (raw6) as! i32;
    guard serialize_bytes(s, value.S[0..value.SLength]) else { return false; }
    guard serialize_valid_utf8(value.S[0..value.SLength]) else { return serialize_fail(s, SERIALIZE_ERROR_INVALID_UTF8); } // malformed UTF-8 is content the read refuses
    for c8 in value.S[0..value.SLength] { guard c8 != 0 else { return serialize_fail(s, SERIALIZE_ERROR_EMBEDDED_NUL); } } // an interior null is content the read refuses
    guard schema_rt::wire_bits(s, value.P, 32) else { return false; }
    guard schema_rt::wire_bits(s, value.Q, 29) else { return false; }
    guard schema_rt::wire_bits(s, value.R, 19) else { return false; }
    guard schema_rt::wire_bits(s, value.Tail, 4) else { return false; }
    return true;
}

