// TrioMaxBytes is TrioMaxBits in bytes, rounded up to the 8-byte write-buffer granularity:
// size write buffers from it.
let TrioMaxBytes: i64 = 8;

// ZeroTrio sets value to its zero form (SPEC §5): every field zero, a
// nested type at ITS zero form — not the specified defaults, which NewTrio
// builds. A read zeroes the untaken side of a branch with it.
fn ZeroTrio(value: Trio&) {
    value.A = 0;
    value.B = 0;
    value.C = 0;
}

// WriteTrio writes value in wire order. It returns SERIALIZE_ERROR_NONE, or the
// refusal kind of the first value the wire cannot carry; the size written is
// serialize_bits_processed(s).
fn WriteTrio(s: WriteStream&, value: Trio&) -> i32 {
    if s.num_bits - s.bits_written < TrioMaxBits {
        // a stream too small for the value refuses before the runtime sees the
        // write; serialize.goose aborts on a write past the buffer (U9)
        let need = _MeasureTrio(value, s.bits_written) - s.bits_written;
        if need > s.num_bits - s.bits_written { return SERIALIZE_ERROR_PAST_END; }
    }
    var l = schema_rt::wire_open(s);
    let refusal = _WriteTrio(s, l, value);
    schema_rt::wire_close(s, l);
    return refusal;
}

inline fn _WriteTrio(s: WriteStream&, l: schema_rt::WireW&, value: Trio&) -> i32 {
    if value.A > 1048575 { return SERIALIZE_ERROR_VALUE_OUT_OF_RANGE; } // a value wider than bits(20) cannot ride
    schema_rt::wire_bits(s, l, value.A, 20);
    if value.B > 1048575 { return SERIALIZE_ERROR_VALUE_OUT_OF_RANGE; } // a value wider than bits(20) cannot ride
    schema_rt::wire_bits(s, l, value.B, 20);
    if value.C > 16777215 { return SERIALIZE_ERROR_VALUE_OUT_OF_RANGE; } // a value wider than bits(24) cannot ride
    schema_rt::wire_bits(s, l, value.C, 24);
    return SERIALIZE_ERROR_NONE;
}

fn _MeasureTrio(value: Trio&, bits: i64) -> i64 {
    var total = bits;
    total += 20;
    total += 20;
    total += 24;
    return total;
}

// ReadTrio reads value, validating every field, then ends the packet (SPEC §5).
// It returns false with the reason latched on the stream (serialize_error(s)).
fn ReadTrio(s: ReadStream&, value: Trio&) -> bool {
    guard _ReadTrio(s, value) else { return false; }
    guard serialize_end(s) else { return false; } // one packet's end: no trailing byte, no set padding (SPEC §5)
    return true;
}

inline fn _ReadTrio(s: ReadStream&, value: Trio&) -> bool {
    guard schema_rt::wire_bits(s, value.A, 20) else { return false; }
    guard schema_rt::wire_bits(s, value.B, 20) else { return false; }
    guard schema_rt::wire_bits(s, value.C, 24) else { return false; }
    return true;
}

// TrioSoleMaxBits is the longest wire path in bits, alignment padding at its worst case.
let TrioSoleMaxBits: i64 = 64;
// TrioSoleMaxBytes is TrioSoleMaxBits in bytes, rounded up to the 8-byte write-buffer granularity:
// size write buffers from it.
let TrioSoleMaxBytes: i64 = 8;

// ZeroTrioSole sets value to its zero form (SPEC §5): every field zero, a
// nested type at ITS zero form — not the specified defaults, which NewTrioSole
// builds. A read zeroes the untaken side of a branch with it.
fn ZeroTrioSole(value: TrioSole&) {
    ZeroTrio(value.Inner);
}

// WriteTrioSole writes value in wire order. It returns SERIALIZE_ERROR_NONE, or the
// refusal kind of the first value the wire cannot carry; the size written is
// serialize_bits_processed(s).
fn WriteTrioSole(s: WriteStream&, value: TrioSole&) -> i32 {
    if s.num_bits - s.bits_written < TrioSoleMaxBits {
        // a stream too small for the value refuses before the runtime sees the
        // write; serialize.goose aborts on a write past the buffer (U9)
        let need = _MeasureTrioSole(value, s.bits_written) - s.bits_written;
        if need > s.num_bits - s.bits_written { return SERIALIZE_ERROR_PAST_END; }
    }
    var l = schema_rt::wire_open(s);
    let refusal = _WriteTrioSole(s, l, value);
    schema_rt::wire_close(s, l);
    return refusal;
}

inline fn _WriteTrioSole(s: WriteStream&, l: schema_rt::WireW&, value: TrioSole&) -> i32 {
    let refusal1 = _WriteTrio(s, l, value.Inner);
    if refusal1 != SERIALIZE_ERROR_NONE { return refusal1; }
    return SERIALIZE_ERROR_NONE;
}

fn _MeasureTrioSole(value: TrioSole&, bits: i64) -> i64 {
    var total = bits;
    total = _MeasureTrio(value.Inner, total);
    return total;
}

// ReadTrioSole reads value, validating every field, then ends the packet (SPEC §5).
// It returns false with the reason latched on the stream (serialize_error(s)).
fn ReadTrioSole(s: ReadStream&, value: TrioSole&) -> bool {
    guard _ReadTrioSole(s, value) else { return false; }
    guard serialize_end(s) else { return false; } // one packet's end: no trailing byte, no set padding (SPEC §5)
    return true;
}

inline fn _ReadTrioSole(s: ReadStream&, value: TrioSole&) -> bool {
    guard _ReadTrio(s, value.Inner) else { return false; }
    return true;
}

// Vec3SoleMaxBits is the longest wire path in bits, alignment padding at its worst case.
let Vec3SoleMaxBits: i64 = 192;
// Vec3SoleMaxBytes is Vec3SoleMaxBits in bytes, rounded up to the 8-byte write-buffer granularity:
// size write buffers from it.
let Vec3SoleMaxBytes: i64 = 24;

