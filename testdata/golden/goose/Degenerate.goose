// TrioFirstMaxBits is the longest wire path in bits, alignment padding at its worst case.
let TrioFirstMaxBits: i64 = 80;
// TrioFirstMaxBytes is TrioFirstMaxBits in bytes, rounded up to the 8-byte write-buffer granularity:
// size write buffers from it.
let TrioFirstMaxBytes: i64 = 16;

// ZeroTrioFirst sets value to its zero form (SPEC §5): every field zero, a
// nested type at ITS zero form — not the specified defaults, which NewTrioFirst
// builds. A read zeroes the untaken side of a branch with it.
fn ZeroTrioFirst(value: TrioFirst&) {
    ZeroTrio(value.Inner);
    value.Trailer = 0;
}

// WriteTrioFirst writes value in wire order. It returns SERIALIZE_ERROR_NONE, or the
// refusal kind of the first value the wire cannot carry; the size written is
// serialize_bits_processed(s).
fn WriteTrioFirst(s: WriteStream&, value: TrioFirst&) -> i32 {
    if s.num_bits - s.bits_written < TrioFirstMaxBits {
        // a stream too small for the value refuses before the runtime sees the
        // write; serialize.goose aborts on a write past the buffer (U9)
        let need = _MeasureTrioFirst(value, s.bits_written) - s.bits_written;
        if need > s.num_bits - s.bits_written { return SERIALIZE_ERROR_PAST_END; }
    }
    var l = schema_rt::wire_open(s);
    let refusal = _WriteTrioFirst(s, l, value);
    schema_rt::wire_close(s, l);
    return refusal;
}

inline fn _WriteTrioFirst(s: WriteStream&, l: schema_rt::WireW&, value: TrioFirst&) -> i32 {
    let refusal1 = _WriteTrio(s, l, value.Inner);
    if refusal1 != SERIALIZE_ERROR_NONE { return refusal1; }
    if value.Trailer > 65535 { return SERIALIZE_ERROR_VALUE_OUT_OF_RANGE; } // a value wider than bits(16) cannot ride
    schema_rt::wire_bits(s, l, value.Trailer, 16);
    return SERIALIZE_ERROR_NONE;
}

fn _MeasureTrioFirst(value: TrioFirst&, bits: i64) -> i64 {
    var total = bits;
    total = _MeasureTrio(value.Inner, total);
    total += 16;
    return total;
}

// ReadTrioFirst reads value, validating every field, then ends the packet (SPEC §5).
// It returns false with the reason latched on the stream (serialize_error(s)).
fn ReadTrioFirst(s: ReadStream&, value: TrioFirst&) -> bool {
    guard _ReadTrioFirst(s, value) else { return false; }
    guard serialize_end(s) else { return false; } // one packet's end: no trailing byte, no set padding (SPEC §5)
    return true;
}

inline fn _ReadTrioFirst(s: ReadStream&, value: TrioFirst&) -> bool {
    guard _ReadTrio(s, value.Inner) else { return false; }
    guard schema_rt::wire_bits(s, value.Trailer, 16) else { return false; }
    return true;
}

// TrioStraddleMaxBits is the longest wire path in bits, alignment padding at its worst case.
let TrioStraddleMaxBits: i64 = 408;
// TrioStraddleMaxBytes is TrioStraddleMaxBits in bytes, rounded up to the 8-byte write-buffer granularity:
// size write buffers from it.
let TrioStraddleMaxBytes: i64 = 56;

// ZeroTrioStraddle sets value to its zero form (SPEC §5): every field zero, a
// nested type at ITS zero form — not the specified defaults, which NewTrioStraddle
// builds. A read zeroes the untaken side of a branch with it.
fn ZeroTrioStraddle(value: TrioStraddle&) {
    value.Pad0 = 0;
    value.Pad1 = 0;
    value.Pad2 = 0;
    value.Pad3 = 0;
    value.Pad4 = 0;
    value.Pad5 = 0;
    ZeroTrio(value.Inner);
}

// WriteTrioStraddle writes value in wire order. It returns SERIALIZE_ERROR_NONE, or the
// refusal kind of the first value the wire cannot carry; the size written is
// serialize_bits_processed(s).
fn WriteTrioStraddle(s: WriteStream&, value: TrioStraddle&) -> i32 {
    if s.num_bits - s.bits_written < TrioStraddleMaxBits {
        // a stream too small for the value refuses before the runtime sees the
        // write; serialize.goose aborts on a write past the buffer (U9)
        let need = _MeasureTrioStraddle(value, s.bits_written) - s.bits_written;
        if need > s.num_bits - s.bits_written { return SERIALIZE_ERROR_PAST_END; }
    }
    var l = schema_rt::wire_open(s);
    let refusal = _WriteTrioStraddle(s, l, value);
    schema_rt::wire_close(s, l);
    return refusal;
}

inline fn _WriteTrioStraddle(s: WriteStream&, l: schema_rt::WireW&, value: TrioStraddle&) -> i32 {
    schema_rt::wire_bits64(s, l, value.Pad0, 64);
    schema_rt::wire_bits64(s, l, value.Pad1, 64);
    schema_rt::wire_bits64(s, l, value.Pad2, 64);
    schema_rt::wire_bits64(s, l, value.Pad3, 64);
    schema_rt::wire_bits64(s, l, value.Pad4, 64);
    if value.Pad5 > 16777215 { return SERIALIZE_ERROR_VALUE_OUT_OF_RANGE; } // a value wider than bits(24) cannot ride
    schema_rt::wire_bits(s, l, value.Pad5, 24);
    let refusal1 = _WriteTrio(s, l, value.Inner);
    if refusal1 != SERIALIZE_ERROR_NONE { return refusal1; }
    return SERIALIZE_ERROR_NONE;
}

fn _MeasureTrioStraddle(value: TrioStraddle&, bits: i64) -> i64 {
    var total = bits;
    total += 64;
    total += 64;
    total += 64;
    total += 64;
    total += 64;
    total += 24;
    total = _MeasureTrio(value.Inner, total);
    return total;
}

// ReadTrioStraddle reads value, validating every field, then ends the packet (SPEC §5).
// It returns false with the reason latched on the stream (serialize_error(s)).
fn ReadTrioStraddle(s: ReadStream&, value: TrioStraddle&) -> bool {
    guard _ReadTrioStraddle(s, value) else { return false; }
    guard serialize_end(s) else { return false; } // one packet's end: no trailing byte, no set padding (SPEC §5)
    return true;
}

inline fn _ReadTrioStraddle(s: ReadStream&, value: TrioStraddle&) -> bool {
    guard schema_rt::wire_bits64(s, value.Pad0, 64) else { return false; }
    guard schema_rt::wire_bits64(s, value.Pad1, 64) else { return false; }
    guard schema_rt::wire_bits64(s, value.Pad2, 64) else { return false; }
    guard schema_rt::wire_bits64(s, value.Pad3, 64) else { return false; }
    guard schema_rt::wire_bits64(s, value.Pad4, 64) else { return false; }
    guard schema_rt::wire_bits(s, value.Pad5, 24) else { return false; }
    guard _ReadTrio(s, value.Inner) else { return false; }
    return true;
}

