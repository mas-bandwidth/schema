inline fn _WriteProbeConfig(s: WriteStream&, l: schema_rt::WireW&, value: ProbeConfig&) -> i32 {
    schema_rt::wire_bits(s, l, value.Retries as! u32, 32);
    if value.Preferred > 15 { return SERIALIZE_ERROR_VALUE_OUT_OF_RANGE; } // not a Weapon value
    schema_rt::wire_bits(s, l, value.Preferred, 4);
    return SERIALIZE_ERROR_NONE;
}

fn _MeasureProbeConfig(value: ProbeConfig&, bits: i64) -> i64 {
    var total = bits;
    total += 32;
    total += 4;
    return total;
}

// ReadProbeConfig reads value, validating every field, then ends the packet (SPEC §5).
