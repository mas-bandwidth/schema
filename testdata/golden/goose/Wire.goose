    var narrow17: u32 = 0;
    guard schema_rt::wire_bits(s, narrow17, 8) else { return false; }
    let raw16: u64 = narrow17;
    value.Uint8Value = raw16 as! u8;
    var narrow19: u32 = 0;
    guard schema_rt::wire_bits(s, narrow19, 16) else { return false; }
    let raw18: u64 = narrow19;
    value.Uint16Value = raw18 as! u16;
