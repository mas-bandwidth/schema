    return true;
}

inline fn _ReadProbeConfig(s: ReadStream&, value: ProbeConfig&) -> bool {
    var narrow2: u32 = 0;
    guard schema_rt::wire_bits(s, narrow2, 32) else { return false; }
    let raw1: u64 = narrow2;
    value.Retries = (raw1 as! u32) as! i32;
    var narrow4: u32 = 0;
    guard schema_rt::wire_bits(s, narrow4, 4) else { return false; }
    let raw3: u64 = narrow4;
    value.Preferred = (raw3) as! Weapon;
    return true;
}

// ProbeArrayMaxBits is the longest wire path in bits, alignment padding at its worst case.
let ProbeArrayMaxBits: i64 = 588;
// ProbeArrayMaxBytes is ProbeArrayMaxBits in bytes, rounded up to the 8-byte write-buffer granularity:
// size write buffers from it.
let ProbeArrayMaxBytes: i64 = 80;

// ZeroProbeArray sets value to its zero form (SPEC §5): every field zero, a
// nested type at ITS zero form — not the specified defaults, which NewProbeArray
