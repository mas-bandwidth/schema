// ChatMaxBits is the longest wire path in bits, alignment padding at its worst case.
let ChatMaxBits: i64 = 2064;
// ChatMaxBytes is ChatMaxBits in bytes, rounded up to the 8-byte write-buffer granularity:
// size write buffers from it.
let ChatMaxBytes: i64 = 264;

// ZeroChat sets value to its zero form (SPEC §5): every field zero, a
// nested type at ITS zero form — not the specified defaults, which NewChat
// builds. A read zeroes the untaken side of a branch with it.
fn ZeroChat(value: Chat&) {
    for ix1 in 256 { value.Text[ix1] = 0; }
    value.TextLength = 0;
}

// WriteChat writes value in wire order. It returns SERIALIZE_ERROR_NONE, or the
// refusal kind of the first value the wire cannot carry; the size written is
// serialize_bits_processed(s).
fn WriteChat(s: WriteStream&, value: Chat&) -> i32 {
    if s.num_bits - s.bits_written < ChatMaxBits {
        // a stream too small for the value refuses before the runtime sees the
        // write; serialize.goose aborts on a write past the buffer (U9)
        let need = _MeasureChat(value, s.bits_written) - s.bits_written;
        if need > s.num_bits - s.bits_written { return SERIALIZE_ERROR_PAST_END; }
    }
    var l = schema_rt::wire_open(s);
    let refusal = _WriteChat(s, l, value);
    schema_rt::wire_close(s, l);
    return refusal;
}

inline fn _WriteChat(s: WriteStream&, l: schema_rt::WireW&, value: Chat&) -> i32 {
    if value.TextLength < 0 || value.TextLength > 256 { return SERIALIZE_ERROR_VALUE_OUT_OF_RANGE; }
    if !serialize_valid_utf8(value.Text[0..value.TextLength]) { return SERIALIZE_ERROR_INVALID_UTF8; } // malformed UTF-8 is not a value of the type
    for c1 in value.Text[0..value.TextLength] { if c1 == 0 { return SERIALIZE_ERROR_EMBEDDED_NUL; } } // a zero byte is not a value of the type
    schema_rt::wire_bits(s, l, value.TextLength as! u32, 9);
    schema_rt::wire_close(s, l);
    serialize_bytes(s, value.Text[0..value.TextLength]);
    schema_rt::wire_reopen(s, l);
    return SERIALIZE_ERROR_NONE;
}

fn _MeasureChat(value: Chat&, bits: i64) -> i64 {
    var total = bits;
    total += 9; // the length
    total += (8 - total % 8) % 8; // the payload aligns
    let len1: i64 = if value.TextLength > 256 { 256 } else if value.TextLength < 0 { 0 } else { value.TextLength };
    total += len1 * 8;
    return total;
}

// ReadChat reads value, validating every field, then ends the packet (SPEC §5).
// It returns false with the reason latched on the stream (serialize_error(s)).
fn ReadChat(s: ReadStream&, value: Chat&) -> bool {
    guard _ReadChat(s, value) else { return false; }
    guard serialize_end(s) else { return false; } // one packet's end: no trailing byte, no set padding (SPEC §5)
    return true;
}

inline fn _ReadChat(s: ReadStream&, value: Chat&) -> bool {
    var narrow2: u32 = 0;
    guard schema_rt::wire_bits(s, narrow2, 9) else { return false; }
    let raw1: u64 = narrow2;
    guard raw1 <= 256 else { return serialize_fail(s, SERIALIZE_ERROR_VALUE_OUT_OF_RANGE); } // a value smuggled into the bit headroom is refused
    value.TextLength = (raw1) as! i32;
    guard serialize_bytes(s, value.Text[0..value.TextLength]) else { return false; }
    guard serialize_valid_utf8(value.Text[0..value.TextLength]) else { return serialize_fail(s, SERIALIZE_ERROR_INVALID_UTF8); } // malformed UTF-8 is content the read refuses
    for c3 in value.Text[0..value.TextLength] { guard c3 != 0 else { return serialize_fail(s, SERIALIZE_ERROR_EMBEDDED_NUL); } } // an interior null is content the read refuses
    return true;
}

// ProbeReportMaxBits is the longest wire path in bits, alignment padding at its worst case.
let ProbeReportMaxBits: i64 = 141;
// ProbeReportMaxBytes is ProbeReportMaxBits in bytes, rounded up to the 8-byte write-buffer granularity:
