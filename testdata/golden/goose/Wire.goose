    if value.C < (-100) || value.C > 150 { return SERIALIZE_ERROR_VALUE_OUT_OF_RANGE; }
    let offset3: u64 = value.C as! u64;
    schema_rt::wire_bits(s, l, (offset3 - 18446744073709551516) as! u32, 8);
    if value.D > 255 { return SERIALIZE_ERROR_VALUE_OUT_OF_RANGE; } // a value wider than bits(8) cannot ride
    schema_rt::wire_bits(s, l, value.D, 8);
    if value.E > 255 { return SERIALIZE_ERROR_VALUE_OUT_OF_RANGE; } // a value wider than bits(8) cannot ride
    schema_rt::wire_bits(s, l, value.E, 8);
    if value.F > 255 { return SERIALIZE_ERROR_VALUE_OUT_OF_RANGE; } // a value wider than bits(8) cannot ride
    schema_rt::wire_bits(s, l, value.F, 8);
    schema_rt::wire_bool(s, l, value.G);
