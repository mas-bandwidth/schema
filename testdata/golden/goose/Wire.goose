fn ZeroTest(value: Test&) {
    value.TestA = 0;
    value.TestB = 0;
    value.TestC = 0;
    value.TestD = 0;
}

// WriteTest writes value in wire order. It returns SERIALIZE_ERROR_NONE, or the
// refusal kind of the first value the wire cannot carry; the size written is
// serialize_bits_processed(s).
