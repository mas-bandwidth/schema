    value.Width = 0;
    value.Height = 0;
}

// WriteProbeSlab writes value in wire order. It returns SERIALIZE_ERROR_NONE, or the
// refusal kind of the first value the wire cannot carry; the size written is
// serialize_bits_processed(s).
fn WriteProbeSlab(s: WriteStream&, value: ProbeSlab&) -> i32 {
    if s.num_bits - s.bits_written < ProbeSlabMaxBits {
        // a stream too small for the value refuses before the runtime sees the
        // write; serialize.goose aborts on a write past the buffer (U9)
        let need = _MeasureProbeSlab(value, s.bits_written) - s.bits_written;
        if need > s.num_bits - s.bits_written { return SERIALIZE_ERROR_PAST_END; }
    }
    var l = schema_rt::wire_open(s);
    let refusal = _WriteProbeSlab(s, l, value);
    schema_rt::wire_close(s, l);
    return refusal;
}

inline fn _WriteProbeSlab(s: WriteStream&, l: schema_rt::WireW&, value: ProbeSlab&) -> i32 {
    if value.Width > 100 { return SERIALIZE_ERROR_VALUE_OUT_OF_RANGE; }
    let offset1: u64 = value.Width;
    schema_rt::wire_bits(s, l, (offset1) as! u32, 7);
    schema_rt::wire_bits(s, l, value.Height, 8);
    return SERIALIZE_ERROR_NONE;
}

fn _MeasureProbeSlab(value: ProbeSlab&, bits: i64) -> i64 {
    var total = bits;
    total += 7;
    total += 8;
    return total;
}

// ReadProbeSlab reads value, validating every field, then ends the packet (SPEC §5).
// It returns false with the reason latched on the stream (serialize_error(s)).
fn ReadProbeSlab(s: ReadStream&, value: ProbeSlab&) -> bool {
    guard _ReadProbeSlab(s, value) else { return false; }
    guard serialize_end(s) else { return false; } // one packet's end: no trailing byte, no set padding (SPEC §5)
    return true;
}

inline fn _ReadProbeSlab(s: ReadStream&, value: ProbeSlab&) -> bool {
    var narrow2: u32 = 0;
    guard schema_rt::wire_bits(s, narrow2, 7) else { return false; }
    let raw1: u64 = narrow2;
    guard raw1 <= 100 else { return serialize_fail(s, SERIALIZE_ERROR_VALUE_OUT_OF_RANGE); } // a value smuggled into the bit headroom is refused
    value.Width = (raw1) as! u8;
    var narrow4: u32 = 0;
    guard schema_rt::wire_bits(s, narrow4, 8) else { return false; }
    let raw3: u64 = narrow4;
    value.Height = raw3 as! u8;
    return true;
}

// ProbeShapeMaxBits is the longest wire path in bits, alignment padding at its worst case.
let ProbeShapeMaxBits: i64 = 18;
// ProbeShapeMaxBytes is ProbeShapeMaxBits in bytes, rounded up to the 8-byte write-buffer granularity:
// size write buffers from it.
let ProbeShapeMaxBytes: i64 = 8;

// ZeroProbeShape sets value to its zero form (SPEC §5): the empty union (None),
// every arm's storage at its zero form.
fn ZeroProbeShape(value: ProbeShape&) {
    value.Type = ProbeShapeTypeNone;
    ZeroProbeRing(value.Ring);
    ZeroProbeSlab(value.Slab);
}

// WriteProbeShape writes the tag, then the selected arm's payload (SPEC §4.8). The
// tag validates BEFORE it rides: an out-of-set tag writes nothing.
fn WriteProbeShape(s: WriteStream&, value: ProbeShape&) -> i32 {
    if s.num_bits - s.bits_written < ProbeShapeMaxBits {
        // a stream too small for the value refuses before the runtime sees the
        // write; serialize.goose aborts on a write past the buffer (U9)
        let need = _MeasureProbeShape(value, s.bits_written) - s.bits_written;
        if need > s.num_bits - s.bits_written { return SERIALIZE_ERROR_PAST_END; }
    }
    var l = schema_rt::wire_open(s);
    let refusal = _WriteProbeShape(s, l, value);
    schema_rt::wire_close(s, l);
    return refusal;
}

inline fn _WriteProbeShape(s: WriteStream&, l: schema_rt::WireW&, value: ProbeShape&) -> i32 {
    if value.Type > ProbeShapeTypeMax { return SERIALIZE_ERROR_VALUE_OUT_OF_RANGE; } // the tag validates BEFORE it rides
    schema_rt::wire_bits(s, l, value.Type, 2);
    if value.Type == ProbeShapeTypeRing {
        return _WriteProbeRing(s, l, value.Ring);
    }
    if value.Type == ProbeShapeTypeSlab {
        return _WriteProbeSlab(s, l, value.Slab);
    }
    return SERIALIZE_ERROR_NONE; // None or a payload-free arm: the tag is the whole wire
}

fn _MeasureProbeShape(value: ProbeShape&, bits: i64) -> i64 {
    var total = bits;
    total += 2; // the tag
    if value.Type == ProbeShapeTypeRing { total = _MeasureProbeRing(value.Ring, total); }
    if value.Type == ProbeShapeTypeSlab { total = _MeasureProbeSlab(value.Slab, total); }
    return total;
}

// ReadProbeShape reads the tag, refusing one above the arm count, then builds the
// selected arm FRESH at its defaults, reads its payload, and ends the packet (SPEC §5).
fn ReadProbeShape(s: ReadStream&, value: ProbeShape&) -> bool {
    guard _ReadProbeShape(s, value) else { return false; }
    guard serialize_end(s) else { return false; } // one packet's end: no trailing byte, no set padding (SPEC §5)
    return true;
}

inline fn _ReadProbeShape(s: ReadStream&, value: ProbeShape&) -> bool {
    var tag: u32 = 0;
    guard schema_rt::wire_bits(s, tag, 2) else { return false; }
    guard tag <= 2 else { return serialize_fail(s, SERIALIZE_ERROR_VALUE_OUT_OF_RANGE); } // not a wire-legal tag
    value.Type = tag as! ProbeShapeType;
    if value.Type == ProbeShapeTypeRing {
        value.Ring = ProbeRing { .. }; // a fresh payload on every selection
        return _ReadProbeRing(s, value.Ring);
    }
    if value.Type == ProbeShapeTypeSlab {
        value.Slab = ProbeSlab { .. }; // a fresh payload on every selection
        return _ReadProbeSlab(s, value.Slab);
    }
    return true; // None or a payload-free arm: the tag is the whole wire
}

// ProbeColliderMaxBits is the longest wire path in bits, alignment padding at its worst case.
let ProbeColliderMaxBits: i64 = 82;
// ProbeColliderMaxBytes is ProbeColliderMaxBits in bytes, rounded up to the 8-byte write-buffer granularity:
// size write buffers from it.
let ProbeColliderMaxBytes: i64 = 16;

// ZeroProbeCollider sets value to its zero form (SPEC §5): every field zero, a
// nested type at ITS zero form — not the specified defaults, which NewProbeCollider
// builds. A read zeroes the untaken side of a branch with it.
fn ZeroProbeCollider(value: ProbeCollider&) {
    value.Armor = 0;
    ZeroProbeShape(value.Shape);
    ZeroProbeShape(value.Backup);
    for ix1 in 2 {
        ZeroProbeShape(value.Extras[ix1]);
    }
    value.ExtrasCount = 0;
}

// WriteProbeCollider writes value in wire order. It returns SERIALIZE_ERROR_NONE, or the
// refusal kind of the first value the wire cannot carry; the size written is
// serialize_bits_processed(s).
fn WriteProbeCollider(s: WriteStream&, value: ProbeCollider&) -> i32 {
    if s.num_bits - s.bits_written < ProbeColliderMaxBits {
        // a stream too small for the value refuses before the runtime sees the
        // write; serialize.goose aborts on a write past the buffer (U9)
        let need = _MeasureProbeCollider(value, s.bits_written) - s.bits_written;
        if need > s.num_bits - s.bits_written { return SERIALIZE_ERROR_PAST_END; }
    }
    var l = schema_rt::wire_open(s);
    let refusal = _WriteProbeCollider(s, l, value);
    schema_rt::wire_close(s, l);
    return refusal;
}

inline fn _WriteProbeCollider(s: WriteStream&, l: schema_rt::WireW&, value: ProbeCollider&) -> i32 {
    schema_rt::wire_bits(s, l, value.Armor, 8);
    let refusal1 = _WriteProbeShape(s, l, value.Shape);
    if refusal1 != SERIALIZE_ERROR_NONE { return refusal1; }
    let refusal2 = _WriteProbeShape(s, l, value.Backup);
    if refusal2 != SERIALIZE_ERROR_NONE { return refusal2; }
    if value.ExtrasCount < 0 || value.ExtrasCount > 2 { return SERIALIZE_ERROR_VALUE_OUT_OF_RANGE; }
    schema_rt::wire_bits(s, l, (value.ExtrasCount) as! u32, 2); // the count, offset from 0
    for ix3 in value.ExtrasCount {
        let refusal4 = _WriteProbeShape(s, l, value.Extras[ix3]);
        if refusal4 != SERIALIZE_ERROR_NONE { return refusal4; }
    }
    return SERIALIZE_ERROR_NONE;
}

fn _MeasureProbeCollider(value: ProbeCollider&, bits: i64) -> i64 {
    var total = bits;
    total += 8;
    total = _MeasureProbeShape(value.Shape, total);
    total = _MeasureProbeShape(value.Backup, total);
    total += 2; // the count
    let n1 = if value.ExtrasCount > 2 { 2 } else if value.ExtrasCount < 0 { 0 } else { value.ExtrasCount };
    if n1 > 0 {
        for ix2 in n1 {
            total = _MeasureProbeShape(value.Extras[ix2], total);
        }
    }
    return total;
}

// ReadProbeCollider reads value, validating every field, then ends the packet (SPEC §5).
// It returns false with the reason latched on the stream (serialize_error(s)).
fn ReadProbeCollider(s: ReadStream&, value: ProbeCollider&) -> bool {
    guard _ReadProbeCollider(s, value) else { return false; }
    guard serialize_end(s) else { return false; } // one packet's end: no trailing byte, no set padding (SPEC §5)
    return true;
}

inline fn _ReadProbeCollider(s: ReadStream&, value: ProbeCollider&) -> bool {
    var narrow2: u32 = 0;
    guard schema_rt::wire_bits(s, narrow2, 8) else { return false; }
    let raw1: u64 = narrow2;
    value.Armor = raw1 as! u8;
    guard _ReadProbeShape(s, value.Shape) else { return false; }
    guard _ReadProbeShape(s, value.Backup) else { return false; }
    var narrow4: u32 = 0;
    guard schema_rt::wire_bits(s, narrow4, 2) else { return false; }
    let raw3: u64 = narrow4;
    guard raw3 <= 2 else { return serialize_fail(s, SERIALIZE_ERROR_VALUE_OUT_OF_RANGE); } // a value smuggled into the bit headroom is refused
    value.ExtrasCount = (raw3) as! i32;
    for ix5 in value.ExtrasCount {
        guard _ReadProbeShape(s, value.Extras[ix5]) else { return false; }
    }
    return true;
}

