inline fn _WriteTest(s: WriteStream&, l: schema_rt::WireW&, value: Test&) -> i32 {
    schema_rt::wire_bits(s, l, value.TestA, 16);
    if value.TestB < 0 || value.TestB > 1000 { return SERIALIZE_ERROR_VALUE_OUT_OF_RANGE; }
    let offset1: u64 = value.TestB as! u64;
    schema_rt::wire_bits(s, l, (offset1) as! u32, 10);
    if value.TestC < 0 || value.TestC > 1000 { return SERIALIZE_ERROR_VALUE_OUT_OF_RANGE; }
    let offset2: u64 = value.TestC as! u64;
    schema_rt::wire_bits(s, l, (offset2) as! u32, 10);
    if value.TestD < 0 || value.TestD > 1000 { return SERIALIZE_ERROR_VALUE_OUT_OF_RANGE; }
    let offset3: u64 = value.TestD as! u64;
    schema_rt::wire_bits(s, l, (offset3) as! u32, 10);
    return SERIALIZE_ERROR_NONE;
}

fn _MeasureTest(value: Test&, bits: i64) -> i64 {
    var total = bits;
    total += 16;
    total += 10;
    total += 10;
    total += 10;
    return total;
}

// ReadTest reads value, validating every field, then ends the packet (SPEC §5).
// It returns false with the reason latched on the stream (serialize_error(s)).
fn ReadTest(s: ReadStream&, value: Test&) -> bool {
