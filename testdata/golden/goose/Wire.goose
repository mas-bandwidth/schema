// BlockMaxBits is the longest wire path in bits, alignment padding at its worst case.
let BlockMaxBits: i64 = 16018;
// BlockMaxBytes is BlockMaxBits in bytes, rounded up to the 8-byte write-buffer granularity:
// size write buffers from it.
let BlockMaxBytes: i64 = 2008;

// ZeroBlock sets value to its zero form (SPEC §5): every field zero, a
// nested type at ITS zero form — not the specified defaults, which NewBlock
// builds. A read zeroes the untaken side of a branch with it.
fn ZeroBlock(value: Block&) {
    for ix1 in 2000 { value.Data[ix1] = 0; }
    value.DataLength = 0;
}

// WriteBlock writes value in wire order. It returns SERIALIZE_ERROR_NONE, or the
// refusal kind of the first value the wire cannot carry; the size written is
// serialize_bits_processed(s).
fn WriteBlock(s: WriteStream&, value: Block&) -> i32 {
    if s.num_bits - s.bits_written < BlockMaxBits {
        // a stream too small for the value refuses before the runtime sees the
        // write; serialize.goose aborts on a write past the buffer (U9)
        let need = _MeasureBlock(value, s.bits_written) - s.bits_written;
        if need > s.num_bits - s.bits_written { return SERIALIZE_ERROR_PAST_END; }
    }
    var l = schema_rt::wire_open(s);
    let refusal = _WriteBlock(s, l, value);
    schema_rt::wire_close(s, l);
    return refusal;
}

inline fn _WriteBlock(s: WriteStream&, l: schema_rt::WireW&, value: Block&) -> i32 {
    if value.DataLength < 0 || value.DataLength > 2000 { return SERIALIZE_ERROR_VALUE_OUT_OF_RANGE; }
    schema_rt::wire_bits(s, l, value.DataLength as! u32, 11);
    schema_rt::wire_close(s, l);
    serialize_bytes(s, value.Data[0..value.DataLength]);
    schema_rt::wire_reopen(s, l);
    return SERIALIZE_ERROR_NONE;
}

fn _MeasureBlock(value: Block&, bits: i64) -> i64 {
    var total = bits;
    total += 11; // the length
    total += (8 - total % 8) % 8; // the payload aligns
    let len1: i64 = if value.DataLength > 2000 { 2000 } else if value.DataLength < 0 { 0 } else { value.DataLength };
    total += len1 * 8;
    return total;
}

// ReadBlock reads value, validating every field, then ends the packet (SPEC §5).
// It returns false with the reason latched on the stream (serialize_error(s)).
fn ReadBlock(s: ReadStream&, value: Block&) -> bool {
