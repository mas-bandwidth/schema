    if value.Int64Range < (-1000000000000) || value.Int64Range > 1000000000000 { return SERIALIZE_ERROR_VALUE_OUT_OF_RANGE; }
    let offset8: u64 = value.Int64Range as! u64;
    schema_rt::wire_bits64(s, l, offset8 - 18446743073709551616, 41);
    schema_rt::wire_close(s, l);
