// CompressedProbeMaxBits is the longest wire path in bits, alignment padding at its worst case.
let CompressedProbeMaxBits: i64 = 24;
// CompressedProbeMaxBytes is CompressedProbeMaxBits in bytes, rounded up to the 8-byte write-buffer granularity:
// size write buffers from it.
let CompressedProbeMaxBytes: i64 = 8;

// ZeroCompressedProbe sets value to its zero form (SPEC §5): every field zero, a
// nested type at ITS zero form — not the specified defaults, which NewCompressedProbe
// builds. A read zeroes the untaken side of a branch with it.
fn ZeroCompressedProbe(value: CompressedProbe&) {
    value.Boundary = 0.0;
    value.Offset = 0.0;
}

// WriteCompressedProbe writes value in wire order. It returns SERIALIZE_ERROR_NONE, or the
// refusal kind of the first value the wire cannot carry; the size written is
// serialize_bits_processed(s).
fn WriteCompressedProbe(s: WriteStream&, value: CompressedProbe&) -> i32 {
    if s.num_bits - s.bits_written < CompressedProbeMaxBits {
        // a stream too small for the value refuses before the runtime sees the
        // write; serialize.goose aborts on a write past the buffer (U9)
        let need = _MeasureCompressedProbe(value, s.bits_written) - s.bits_written;
        if need > s.num_bits - s.bits_written { return SERIALIZE_ERROR_PAST_END; }
    }
    var l = schema_rt::wire_open(s);
    let refusal = _WriteCompressedProbe(s, l, value);
    schema_rt::wire_close(s, l);
    return refusal;
}

inline fn _WriteCompressedProbe(s: WriteStream&, l: schema_rt::WireW&, value: CompressedProbe&) -> i32 {
    if !serialize_float_bits_are_finite(serialize_f32_bits(value.Boundary)) { return SERIALIZE_ERROR_NON_FINITE_FLOAT; } // NaN and the infinities are not values of the type (SPEC §4.3)
    if value.Boundary < 0.0 || value.Boundary > 10.0 { return SERIALIZE_ERROR_VALUE_OUT_OF_RANGE; }
    schema_rt::wire_close(s, l);
    serialize_compressed_float_precomputed(s, value.Boundary, 1000, 10, 10.0, 0.0);
    schema_rt::wire_reopen(s, l);
    if !serialize_float_bits_are_finite(serialize_f32_bits(value.Offset)) { return SERIALIZE_ERROR_NON_FINITE_FLOAT; } // NaN and the infinities are not values of the type (SPEC §4.3)
    if value.Offset < (-5.0) || value.Offset > 5.0 { return SERIALIZE_ERROR_VALUE_OUT_OF_RANGE; }
    schema_rt::wire_close(s, l);
    serialize_compressed_float_precomputed(s, value.Offset, 10000, 14, 10.0, (-5.0));
    schema_rt::wire_reopen(s, l);
    return SERIALIZE_ERROR_NONE;
}

fn _MeasureCompressedProbe(value: CompressedProbe&, bits: i64) -> i64 {
    var total = bits;
    total += 10;
    total += 14;
    return total;
}

// ReadCompressedProbe reads value, validating every field, then ends the packet (SPEC §5).
// It returns false with the reason latched on the stream (serialize_error(s)).
fn ReadCompressedProbe(s: ReadStream&, value: CompressedProbe&) -> bool {
    guard _ReadCompressedProbe(s, value) else { return false; }
    guard serialize_end(s) else { return false; } // one packet's end: no trailing byte, no set padding (SPEC §5)
    return true;
}

inline fn _ReadCompressedProbe(s: ReadStream&, value: CompressedProbe&) -> bool {
    guard serialize_compressed_float_precomputed(s, value.Boundary, 1000, 10, 10.0, 0.0) else { return false; }
    guard serialize_compressed_float_precomputed(s, value.Offset, 10000, 14, 10.0, (-5.0)) else { return false; }
    return true;
}

