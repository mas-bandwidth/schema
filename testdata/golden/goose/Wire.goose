fn _MeasureTestData(value: TestData&, bits: i64) -> i64 {
    var total = bits;
    total += 8;
    total += 8;
    total += 8;
    total += 8;
    total += 8;
    total += 8;
    total += 1;
    total += 5; // the count
    let n1 = if value.ItemsCount > 16 { 16 } else if value.ItemsCount < 0 { 0 } else { value.ItemsCount };
    if n1 > 0 {
        for ix2 in n1 {
            total += 8;
        }
    }
    total += 32;
    total += 10;
    total += 64;
    total += 8;
    total += 16;
    total += 8;
    total += 16;
    total += 32;
    total += 64;
    total += 64;
    total += 41;
    total += (8 - total % 8) % 8;
    for ix3 in 17 {
        total += 8;
    }
    total += 8; // the length
    total += (8 - total % 8) % 8; // the payload aligns
    let len4: i64 = if value.TextLength > 255 { 255 } else if value.TextLength < 0 { 0 } else { value.TextLength };
    total += len4 * 8;
    return total;
