inline fn _WriteProbeArray(s: WriteStream&, l: schema_rt::WireW&, value: ProbeArray&) -> i32 {
    for ix1 in 2 {
        let refusal2 = _WriteProbeSample(s, l, value.Samples[ix1]);
        if refusal2 != SERIALIZE_ERROR_NONE { return refusal2; }
    }
    let refusal3 = _WriteProbeConfig(s, l, value.Config);
    if refusal3 != SERIALIZE_ERROR_NONE { return refusal3; }
    return SERIALIZE_ERROR_NONE;
}

fn _MeasureProbeArray(value: ProbeArray&, bits: i64) -> i64 {
