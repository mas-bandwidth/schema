inline fn _WriteTestData(s: WriteStream&, l: schema_rt::WireW&, value: TestData&) -> i32 {
    if value.A < (-100) || value.A > 100 { return SERIALIZE_ERROR_VALUE_OUT_OF_RANGE; }
    let offset1: u64 = value.A as! u64;
    schema_rt::wire_bits(s, l, (offset1 - 18446744073709551516) as! u32, 8);
    if value.B < (-100) || value.B > 100 { return SERIALIZE_ERROR_VALUE_OUT_OF_RANGE; }
    let offset2: u64 = value.B as! u64;
