    guard schema_rt::wire_bits(s, narrow4, 10) else { return false; }
    let raw3: u64 = narrow4;
    guard raw3 <= 1000 else { return serialize_fail(s, SERIALIZE_ERROR_VALUE_OUT_OF_RANGE); } // a value smuggled into the bit headroom is refused
    value.TestB = (raw3) as! i16;
    var narrow6: u32 = 0;
    guard schema_rt::wire_bits(s, narrow6, 10) else { return false; }
    let raw5: u64 = narrow6;
    guard raw5 <= 1000 else { return serialize_fail(s, SERIALIZE_ERROR_VALUE_OUT_OF_RANGE); } // a value smuggled into the bit headroom is refused
    value.TestC = (raw5) as! i16;
    var narrow8: u32 = 0;
