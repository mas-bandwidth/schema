    return true;
}

inline fn _ReadProbeArray(s: ReadStream&, value: ProbeArray&) -> bool {
    for ix1 in 2 {
        guard _ReadProbeSample(s, value.Samples[ix1]) else { return false; }
    }
    guard _ReadProbeConfig(s, value.Config) else { return false; }
    return true;
}

