// WriteProbeReport writes value in wire order. It returns SERIALIZE_ERROR_NONE, or the
// refusal kind of the first value the wire cannot carry; the size written is
// serialize_bits_processed(s).
fn WriteProbeReport(s: WriteStream&, value: ProbeReport&) -> i32 {
