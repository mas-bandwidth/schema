inline fn _WriteExtremeRow(s: WriteStream&, l: schema_rt::WireW&, value: ExtremeRow&) -> i32 {
    if value.ClampedFloor > 100 { return SERIALIZE_ERROR_VALUE_OUT_OF_RANGE; }
    let offset1: u64 = value.ClampedFloor as! u64;
    schema_rt::wire_bits64(s, l, offset1 - 9223372036854775808, 64);
