    let offset3: u64 = value.Z as! u64;
    schema_rt::wire_bits(s, l, (offset3 - 18446744073709550592) as! u32, 12);
    if value.W < (-1024) || value.W > 1024 { return SERIALIZE_ERROR_VALUE_OUT_OF_RANGE; }
    let offset4: u64 = value.W as! u64;
    schema_rt::wire_bits(s, l, (offset4 - 18446744073709550592) as! u32, 12);
    return SERIALIZE_ERROR_NONE;
}

fn _MeasureQuantizedRotation(value: QuantizedRotation&, bits: i64) -> i64 {
    var total = bits;
    total += 12;
    total += 12;
    total += 12;
    total += 12;
    return total;
}

// ReadQuantizedRotation reads value, validating every field, then ends the packet (SPEC §5).
// It returns false with the reason latched on the stream (serialize_error(s)).
fn ReadQuantizedRotation(s: ReadStream&, value: QuantizedRotation&) -> bool {
    guard _ReadQuantizedRotation(s, value) else { return false; }
    guard serialize_end(s) else { return false; } // one packet's end: no trailing byte, no set padding (SPEC §5)
    return true;
}

inline fn _ReadQuantizedRotation(s: ReadStream&, value: QuantizedRotation&) -> bool {
    var narrow2: u32 = 0;
    guard schema_rt::wire_bits(s, narrow2, 12) else { return false; }
    let raw1: u64 = narrow2;
    guard raw1 <= 2048 else { return serialize_fail(s, SERIALIZE_ERROR_VALUE_OUT_OF_RANGE); } // a value smuggled into the bit headroom is refused
    value.X = (raw1 + 18446744073709550592) as! i16;
    var narrow4: u32 = 0;
    guard schema_rt::wire_bits(s, narrow4, 12) else { return false; }
    let raw3: u64 = narrow4;
    guard raw3 <= 2048 else { return serialize_fail(s, SERIALIZE_ERROR_VALUE_OUT_OF_RANGE); } // a value smuggled into the bit headroom is refused
    value.Y = (raw3 + 18446744073709550592) as! i16;
    var narrow6: u32 = 0;
    guard schema_rt::wire_bits(s, narrow6, 12) else { return false; }
    let raw5: u64 = narrow6;
    guard raw5 <= 2048 else { return serialize_fail(s, SERIALIZE_ERROR_VALUE_OUT_OF_RANGE); } // a value smuggled into the bit headroom is refused
    value.Z = (raw5 + 18446744073709550592) as! i16;
    var narrow8: u32 = 0;
    guard schema_rt::wire_bits(s, narrow8, 12) else { return false; }
    let raw7: u64 = narrow8;
    guard raw7 <= 2048 else { return serialize_fail(s, SERIALIZE_ERROR_VALUE_OUT_OF_RANGE); } // a value smuggled into the bit headroom is refused
    value.W = (raw7 + 18446744073709550592) as! i16;
    return true;
}

// RigidBodyMaxBits is the longest wire path in bits, alignment padding at its worst case.
let RigidBodyMaxBits: i64 = 833;
// RigidBodyMaxBytes is RigidBodyMaxBits in bytes, rounded up to the 8-byte write-buffer granularity:
// size write buffers from it.
let RigidBodyMaxBytes: i64 = 112;

// ZeroRigidBody sets value to its zero form (SPEC §5): every field zero, a
// nested type at ITS zero form — not the specified defaults, which NewRigidBody
// builds. A read zeroes the untaken side of a branch with it.
fn ZeroRigidBody(value: RigidBody&) {
    ZeroVec3(value.Position);
    ZeroQuat(value.Orientation);
    value.AtRest = false;
    ZeroVec3(value.LinearVelocity);
    ZeroVec3(value.AngularVelocity);
}

// WriteRigidBody writes value in wire order. It returns SERIALIZE_ERROR_NONE, or the
// refusal kind of the first value the wire cannot carry; the size written is
// serialize_bits_processed(s).
fn WriteRigidBody(s: WriteStream&, value: RigidBody&) -> i32 {
    if s.num_bits - s.bits_written < RigidBodyMaxBits {
        // a stream too small for the value refuses before the runtime sees the
        // write; serialize.goose aborts on a write past the buffer (U9)
        let need = _MeasureRigidBody(value, s.bits_written) - s.bits_written;
        if need > s.num_bits - s.bits_written { return SERIALIZE_ERROR_PAST_END; }
    }
    var l = schema_rt::wire_open(s);
    let refusal = _WriteRigidBody(s, l, value);
    schema_rt::wire_close(s, l);
    return refusal;
}

inline fn _WriteRigidBody(s: WriteStream&, l: schema_rt::WireW&, value: RigidBody&) -> i32 {
    let refusal1 = _WriteVec3(s, l, value.Position);
    if refusal1 != SERIALIZE_ERROR_NONE { return refusal1; }
    let refusal2 = _WriteQuat(s, l, value.Orientation);
    if refusal2 != SERIALIZE_ERROR_NONE { return refusal2; }
    schema_rt::wire_bool(s, l, value.AtRest);
    if !value.AtRest {
        let refusal3 = _WriteVec3(s, l, value.LinearVelocity);
        if refusal3 != SERIALIZE_ERROR_NONE { return refusal3; }
        let refusal4 = _WriteVec3(s, l, value.AngularVelocity);
        if refusal4 != SERIALIZE_ERROR_NONE { return refusal4; }
    }
    return SERIALIZE_ERROR_NONE;
}

fn _MeasureRigidBody(value: RigidBody&, bits: i64) -> i64 {
    var total = bits;
    total = _MeasureVec3(value.Position, total);
    total = _MeasureQuat(value.Orientation, total);
    total += 1;
    if !value.AtRest {
        total = _MeasureVec3(value.LinearVelocity, total);
        total = _MeasureVec3(value.AngularVelocity, total);
    }
    return total;
}

// ReadRigidBody reads value, validating every field, then ends the packet (SPEC §5).
// It returns false with the reason latched on the stream (serialize_error(s)).
fn ReadRigidBody(s: ReadStream&, value: RigidBody&) -> bool {
    guard _ReadRigidBody(s, value) else { return false; }
    guard serialize_end(s) else { return false; } // one packet's end: no trailing byte, no set padding (SPEC §5)
    return true;
}

inline fn _ReadRigidBody(s: ReadStream&, value: RigidBody&) -> bool {
    guard _ReadVec3(s, value.Position) else { return false; }
    guard _ReadQuat(s, value.Orientation) else { return false; }
    guard schema_rt::wire_bool(s, value.AtRest) else { return false; }
    if !value.AtRest {
        guard _ReadVec3(s, value.LinearVelocity) else { return false; }
        guard _ReadVec3(s, value.AngularVelocity) else { return false; }
    } else {
        ZeroVec3(value.LinearVelocity);
        ZeroVec3(value.AngularVelocity);
    }
    return true;
}

// InputMaxBits is the longest wire path in bits, alignment padding at its worst case.
let InputMaxBits: i64 = 168;
// InputMaxBytes is InputMaxBits in bytes, rounded up to the 8-byte write-buffer granularity:
// size write buffers from it.
let InputMaxBytes: i64 = 24;

// ZeroInput sets value to its zero form (SPEC §5): every field zero, a
// nested type at ITS zero form — not the specified defaults, which NewInput
// builds. A read zeroes the untaken side of a branch with it.
fn ZeroInput(value: Input&) {
    value.StickX = 0.0;
    value.StickY = 0.0;
    value.Throttle = 0.0;
    value.Yaw = 0.0;
    value.Pitch = 0.0;
    value.Fire = false;
    value.AltFire = false;
    value.Boost = false;
    value.Brake = false;
    value.Aim = false;
    value.LockOn = false;
    value.Zoom = false;
    value.Ping = false;
}

// WriteInput writes value in wire order. It returns SERIALIZE_ERROR_NONE, or the
// refusal kind of the first value the wire cannot carry; the size written is
// serialize_bits_processed(s).
fn WriteInput(s: WriteStream&, value: Input&) -> i32 {
    if s.num_bits - s.bits_written < InputMaxBits {
        // a stream too small for the value refuses before the runtime sees the
        // write; serialize.goose aborts on a write past the buffer (U9)
        let need = _MeasureInput(value, s.bits_written) - s.bits_written;
        if need > s.num_bits - s.bits_written { return SERIALIZE_ERROR_PAST_END; }
    }
    var l = schema_rt::wire_open(s);
    let refusal = _WriteInput(s, l, value);
    schema_rt::wire_close(s, l);
    return refusal;
}

inline fn _WriteInput(s: WriteStream&, l: schema_rt::WireW&, value: Input&) -> i32 {
    let bits1 = serialize_f32_bits(value.StickX);
    if !serialize_float_bits_are_finite(bits1) { return SERIALIZE_ERROR_NON_FINITE_FLOAT; } // NaN and the infinities are not values of the type (SPEC §4.3)
    schema_rt::wire_bits(s, l, bits1, 32);
    let bits2 = serialize_f32_bits(value.StickY);
    if !serialize_float_bits_are_finite(bits2) { return SERIALIZE_ERROR_NON_FINITE_FLOAT; } // NaN and the infinities are not values of the type (SPEC §4.3)
    schema_rt::wire_bits(s, l, bits2, 32);
    let bits3 = serialize_f32_bits(value.Throttle);
    if !serialize_float_bits_are_finite(bits3) { return SERIALIZE_ERROR_NON_FINITE_FLOAT; } // NaN and the infinities are not values of the type (SPEC §4.3)
    schema_rt::wire_bits(s, l, bits3, 32);
    let bits4 = serialize_f32_bits(value.Yaw);
    if !serialize_float_bits_are_finite(bits4) { return SERIALIZE_ERROR_NON_FINITE_FLOAT; } // NaN and the infinities are not values of the type (SPEC §4.3)
    schema_rt::wire_bits(s, l, bits4, 32);
    let bits5 = serialize_f32_bits(value.Pitch);
    if !serialize_float_bits_are_finite(bits5) { return SERIALIZE_ERROR_NON_FINITE_FLOAT; } // NaN and the infinities are not values of the type (SPEC §4.3)
    schema_rt::wire_bits(s, l, bits5, 32);
    schema_rt::wire_bool(s, l, value.Fire);
    schema_rt::wire_bool(s, l, value.AltFire);
    schema_rt::wire_bool(s, l, value.Boost);
    schema_rt::wire_bool(s, l, value.Brake);
    schema_rt::wire_bool(s, l, value.Aim);
    schema_rt::wire_bool(s, l, value.LockOn);
    schema_rt::wire_bool(s, l, value.Zoom);
    schema_rt::wire_bool(s, l, value.Ping);
    return SERIALIZE_ERROR_NONE;
}

fn _MeasureInput(value: Input&, bits: i64) -> i64 {
    var total = bits;
    total += 32;
    total += 32;
    total += 32;
    total += 32;
    total += 32;
    total += 1;
    total += 1;
    total += 1;
    total += 1;
    total += 1;
    total += 1;
    total += 1;
    total += 1;
    return total;
}

// ReadInput reads value, validating every field, then ends the packet (SPEC §5).
// It returns false with the reason latched on the stream (serialize_error(s)).
fn ReadInput(s: ReadStream&, value: Input&) -> bool {
    guard _ReadInput(s, value) else { return false; }
    guard serialize_end(s) else { return false; } // one packet's end: no trailing byte, no set padding (SPEC §5)
    return true;
}

inline fn _ReadInput(s: ReadStream&, value: Input&) -> bool {
    guard serialize_float(s, value.StickX) else { return false; }
    guard serialize_float(s, value.StickY) else { return false; }
    guard serialize_float(s, value.Throttle) else { return false; }
    guard serialize_float(s, value.Yaw) else { return false; }
    guard serialize_float(s, value.Pitch) else { return false; }
    guard schema_rt::wire_bool(s, value.Fire) else { return false; }
    guard schema_rt::wire_bool(s, value.AltFire) else { return false; }
    guard schema_rt::wire_bool(s, value.Boost) else { return false; }
    guard schema_rt::wire_bool(s, value.Brake) else { return false; }
    guard schema_rt::wire_bool(s, value.Aim) else { return false; }
    guard schema_rt::wire_bool(s, value.LockOn) else { return false; }
    guard schema_rt::wire_bool(s, value.Zoom) else { return false; }
    guard schema_rt::wire_bool(s, value.Ping) else { return false; }
    return true;
}

// InputPacketMaxBits is the longest wire path in bits, alignment padding at its worst case.
let InputPacketMaxBits: i64 = 2837;
// InputPacketMaxBytes is InputPacketMaxBits in bytes, rounded up to the 8-byte write-buffer granularity:
// size write buffers from it.
let InputPacketMaxBytes: i64 = 360;

// ZeroInputPacket sets value to its zero form (SPEC §5): every field zero, a
// nested type at ITS zero form — not the specified defaults, which NewInputPacket
// builds. A read zeroes the untaken side of a branch with it.
fn ZeroInputPacket(value: InputPacket&) {
    value.SynchronizeSequence = 0;
    value.CurrentFrame = 0;
    value.StartFrame = 0;
    for ix1 in 16 {
        ZeroInput(value.Inputs[ix1]);
    }
    value.InputsCount = 0;
}

// WriteInputPacket writes value in wire order. It returns SERIALIZE_ERROR_NONE, or the
// refusal kind of the first value the wire cannot carry; the size written is
// serialize_bits_processed(s).
fn WriteInputPacket(s: WriteStream&, value: InputPacket&) -> i32 {
    if s.num_bits - s.bits_written < InputPacketMaxBits {
        // a stream too small for the value refuses before the runtime sees the
        // write; serialize.goose aborts on a write past the buffer (U9)
        let need = _MeasureInputPacket(value, s.bits_written) - s.bits_written;
        if need > s.num_bits - s.bits_written { return SERIALIZE_ERROR_PAST_END; }
    }
    var l = schema_rt::wire_open(s);
    let refusal = _WriteInputPacket(s, l, value);
    schema_rt::wire_close(s, l);
    return refusal;
}

inline fn _WriteInputPacket(s: WriteStream&, l: schema_rt::WireW&, value: InputPacket&) -> i32 {
    schema_rt::wire_bits(s, l, value.SynchronizeSequence, 16);
    schema_rt::wire_bits64(s, l, value.CurrentFrame, 64);
    schema_rt::wire_bits64(s, l, value.StartFrame, 64);
    if value.InputsCount < 0 || value.InputsCount > 16 { return SERIALIZE_ERROR_VALUE_OUT_OF_RANGE; }
    schema_rt::wire_bits(s, l, (value.InputsCount) as! u32, 5); // the count, offset from 0
    for ix1 in value.InputsCount {
        let refusal2 = _WriteInput(s, l, value.Inputs[ix1]);
        if refusal2 != SERIALIZE_ERROR_NONE { return refusal2; }
    }
    return SERIALIZE_ERROR_NONE;
}

fn _MeasureInputPacket(value: InputPacket&, bits: i64) -> i64 {
    var total = bits;
    total += 16;
    total += 64;
    total += 64;
    total += 5; // the count
    let n1 = if value.InputsCount > 16 { 16 } else if value.InputsCount < 0 { 0 } else { value.InputsCount };
    if n1 > 0 {
        for ix2 in n1 {
            total = _MeasureInput(value.Inputs[ix2], total);
        }
    }
    return total;
}

// ReadInputPacket reads value, validating every field, then ends the packet (SPEC §5).
// It returns false with the reason latched on the stream (serialize_error(s)).
fn ReadInputPacket(s: ReadStream&, value: InputPacket&) -> bool {
    guard _ReadInputPacket(s, value) else { return false; }
    guard serialize_end(s) else { return false; } // one packet's end: no trailing byte, no set padding (SPEC §5)
    return true;
}

inline fn _ReadInputPacket(s: ReadStream&, value: InputPacket&) -> bool {
    var narrow2: u32 = 0;
    guard schema_rt::wire_bits(s, narrow2, 16) else { return false; }
    let raw1: u64 = narrow2;
    value.SynchronizeSequence = raw1 as! u16;
    guard schema_rt::wire_bits64(s, value.CurrentFrame, 64) else { return false; }
    guard schema_rt::wire_bits64(s, value.StartFrame, 64) else { return false; }
    var narrow4: u32 = 0;
    guard schema_rt::wire_bits(s, narrow4, 5) else { return false; }
    let raw3: u64 = narrow4;
    guard raw3 <= 16 else { return serialize_fail(s, SERIALIZE_ERROR_VALUE_OUT_OF_RANGE); } // a value smuggled into the bit headroom is refused
    value.InputsCount = (raw3) as! i32;
    for ix5 in value.InputsCount {
        guard _ReadInput(s, value.Inputs[ix5]) else { return false; }
    }
    return true;
}

// ShipCreateMaxBits is the longest wire path in bits, alignment padding at its worst case.
let ShipCreateMaxBits: i64 = 219;
// ShipCreateMaxBytes is ShipCreateMaxBits in bytes, rounded up to the 8-byte write-buffer granularity:
// size write buffers from it.
let ShipCreateMaxBytes: i64 = 32;

// ZeroShipCreate sets value to its zero form (SPEC §5): every field zero, a
// nested type at ITS zero form — not the specified defaults, which NewShipCreate
// builds. A read zeroes the untaken side of a branch with it.
fn ZeroShipCreate(value: ShipCreate&) {
    value.ShipType = 0;
    ZeroQuantizedPosition(value.Position);
    ZeroQuantizedRotation(value.Rotation);
    ZeroQuantizedVelocity(value.LinearVelocity);
    value.HasFlags = false;
    value.Flags = 0;
    value.Team = 0;
    value.Health = 0;
    value.Thrust = 0;
    value.Pending = 0;
}

// WriteShipCreate writes value in wire order. It returns SERIALIZE_ERROR_NONE, or the
// refusal kind of the first value the wire cannot carry; the size written is
// serialize_bits_processed(s).
fn WriteShipCreate(s: WriteStream&, value: ShipCreate&) -> i32 {
    if s.num_bits - s.bits_written < ShipCreateMaxBits {
        // a stream too small for the value refuses before the runtime sees the
        // write; serialize.goose aborts on a write past the buffer (U9)
        let need = _MeasureShipCreate(value, s.bits_written) - s.bits_written;
        if need > s.num_bits - s.bits_written { return SERIALIZE_ERROR_PAST_END; }
    }
    var l = schema_rt::wire_open(s);
    let refusal = _WriteShipCreate(s, l, value);
    schema_rt::wire_close(s, l);
    return refusal;
}

inline fn _WriteShipCreate(s: WriteStream&, l: schema_rt::WireW&, value: ShipCreate&) -> i32 {
    if value.ShipType > 5 { return SERIALIZE_ERROR_VALUE_OUT_OF_RANGE; } // not a ShipType value
    schema_rt::wire_bits(s, l, value.ShipType, 3);
    let refusal1 = _WriteQuantizedPosition(s, l, value.Position);
    if refusal1 != SERIALIZE_ERROR_NONE { return refusal1; }
    let refusal2 = _WriteQuantizedRotation(s, l, value.Rotation);
    if refusal2 != SERIALIZE_ERROR_NONE { return refusal2; }
    let refusal3 = _WriteQuantizedVelocity(s, l, value.LinearVelocity);
    if refusal3 != SERIALIZE_ERROR_NONE { return refusal3; }
    schema_rt::wire_bool(s, l, value.HasFlags);
    if value.HasFlags {
        if value.Flags > 15 { return SERIALIZE_ERROR_VALUE_OUT_OF_RANGE; } // a mask bit above the flags wire width cannot ride
        schema_rt::wire_bits(s, l, value.Flags as! u32, 4);
    }
    if value.Team > 2 { return SERIALIZE_ERROR_VALUE_OUT_OF_RANGE; } // not a Team value
    schema_rt::wire_bits(s, l, value.Team, 2);
    if value.Health < 0 || value.Health > 1000 { return SERIALIZE_ERROR_VALUE_OUT_OF_RANGE; }
    let offset4: u64 = value.Health as! u64;
    schema_rt::wire_bits(s, l, (offset4) as! u32, 10);
    if value.Thrust < 0 || value.Thrust > 100 { return SERIALIZE_ERROR_VALUE_OUT_OF_RANGE; }
    let offset5: u64 = value.Thrust as! u64;
    schema_rt::wire_bits(s, l, (offset5) as! u32, 7);
    if value.Pending > 0 { return SERIALIZE_ERROR_VALUE_OUT_OF_RANGE; } // not a Pending value
    return SERIALIZE_ERROR_NONE;
}

fn _MeasureShipCreate(value: ShipCreate&, bits: i64) -> i64 {
    var total = bits;
    total += 3;
    total = _MeasureQuantizedPosition(value.Position, total);
    total = _MeasureQuantizedRotation(value.Rotation, total);
    total = _MeasureQuantizedVelocity(value.LinearVelocity, total);
    total += 1;
    if value.HasFlags {
        total += 4;
    }
    total += 2;
    total += 10;
    total += 7;
    return total;
}

// ReadShipCreate reads value, validating every field, then ends the packet (SPEC §5).
// It returns false with the reason latched on the stream (serialize_error(s)).
fn ReadShipCreate(s: ReadStream&, value: ShipCreate&) -> bool {
    guard _ReadShipCreate(s, value) else { return false; }
    guard serialize_end(s) else { return false; } // one packet's end: no trailing byte, no set padding (SPEC §5)
    return true;
}

inline fn _ReadShipCreate(s: ReadStream&, value: ShipCreate&) -> bool {
    var narrow2: u32 = 0;
    guard schema_rt::wire_bits(s, narrow2, 3) else { return false; }
    let raw1: u64 = narrow2;
    guard raw1 <= 5 else { return serialize_fail(s, SERIALIZE_ERROR_VALUE_OUT_OF_RANGE); } // a value smuggled into the bit headroom is refused
    value.ShipType = (raw1) as! ShipType;
    guard _ReadQuantizedPosition(s, value.Position) else { return false; }
    guard _ReadQuantizedRotation(s, value.Rotation) else { return false; }
    guard _ReadQuantizedVelocity(s, value.LinearVelocity) else { return false; }
    guard schema_rt::wire_bool(s, value.HasFlags) else { return false; }
    if value.HasFlags {
        var narrow4: u32 = 0;
        guard schema_rt::wire_bits(s, narrow4, 4) else { return false; }
        let raw3: u64 = narrow4;
        value.Flags = raw3;
    } else {
        value.Flags = 0;
    }
    var narrow6: u32 = 0;
    guard schema_rt::wire_bits(s, narrow6, 2) else { return false; }
    let raw5: u64 = narrow6;
    guard raw5 <= 2 else { return serialize_fail(s, SERIALIZE_ERROR_VALUE_OUT_OF_RANGE); } // a value smuggled into the bit headroom is refused
    value.Team = (raw5) as! Team;
    var narrow8: u32 = 0;
    guard schema_rt::wire_bits(s, narrow8, 10) else { return false; }
    let raw7: u64 = narrow8;
    guard raw7 <= 1000 else { return serialize_fail(s, SERIALIZE_ERROR_VALUE_OUT_OF_RANGE); } // a value smuggled into the bit headroom is refused
    value.Health = (raw7) as! i16;
    var narrow10: u32 = 0;
    guard schema_rt::wire_bits(s, narrow10, 7) else { return false; }
    let raw9: u64 = narrow10;
    guard raw9 <= 100 else { return serialize_fail(s, SERIALIZE_ERROR_VALUE_OUT_OF_RANGE); } // a value smuggled into the bit headroom is refused
    value.Thrust = (raw9) as! i8;
    guard serialize_error(s) == SERIALIZE_ERROR_NONE else { return false; }
    value.Pending = 0; // degenerate: zero bits, the value is the range (SPEC §4.6)
    return true;
}

// ExpressionProbeMaxBits is the longest wire path in bits, alignment padding at its worst case.
let ExpressionProbeMaxBits: i64 = 16;
// ExpressionProbeMaxBytes is ExpressionProbeMaxBits in bytes, rounded up to the 8-byte write-buffer granularity:
// size write buffers from it.
let ExpressionProbeMaxBytes: i64 = 8;

// ZeroExpressionProbe sets value to its zero form (SPEC §5): every field zero, a
// nested type at ITS zero form — not the specified defaults, which NewExpressionProbe
// builds. A read zeroes the untaken side of a branch with it.
fn ZeroExpressionProbe(value: ExpressionProbe&) {
    value.HardpointIndex = 0;
    value.SpinRate = 0;
}

// WriteExpressionProbe writes value in wire order. It returns SERIALIZE_ERROR_NONE, or the
// refusal kind of the first value the wire cannot carry; the size written is
// serialize_bits_processed(s).
fn WriteExpressionProbe(s: WriteStream&, value: ExpressionProbe&) -> i32 {
    if s.num_bits - s.bits_written < ExpressionProbeMaxBits {
        // a stream too small for the value refuses before the runtime sees the
        // write; serialize.goose aborts on a write past the buffer (U9)
        let need = _MeasureExpressionProbe(value, s.bits_written) - s.bits_written;
        if need > s.num_bits - s.bits_written { return SERIALIZE_ERROR_PAST_END; }
    }
    var l = schema_rt::wire_open(s);
    let refusal = _WriteExpressionProbe(s, l, value);
    schema_rt::wire_close(s, l);
    return refusal;
}

inline fn _WriteExpressionProbe(s: WriteStream&, l: schema_rt::WireW&, value: ExpressionProbe&) -> i32 {
    if value.HardpointIndex < 0 || value.HardpointIndex > 31 { return SERIALIZE_ERROR_VALUE_OUT_OF_RANGE; }
    let offset1: u64 = value.HardpointIndex as! u64;
    schema_rt::wire_bits(s, l, (offset1) as! u32, 5);
    if value.SpinRate < 1024 || value.SpinRate > 2048 { return SERIALIZE_ERROR_VALUE_OUT_OF_RANGE; }
    let offset2: u64 = value.SpinRate as! u64;
    schema_rt::wire_bits(s, l, (offset2 - 1024) as! u32, 11);
    return SERIALIZE_ERROR_NONE;
}

fn _MeasureExpressionProbe(value: ExpressionProbe&, bits: i64) -> i64 {
    var total = bits;
    total += 5;
    total += 11;
    return total;
}

// ReadExpressionProbe reads value, validating every field, then ends the packet (SPEC §5).
// It returns false with the reason latched on the stream (serialize_error(s)).
fn ReadExpressionProbe(s: ReadStream&, value: ExpressionProbe&) -> bool {
    guard _ReadExpressionProbe(s, value) else { return false; }
    guard serialize_end(s) else { return false; } // one packet's end: no trailing byte, no set padding (SPEC §5)
    return true;
}

inline fn _ReadExpressionProbe(s: ReadStream&, value: ExpressionProbe&) -> bool {
    var narrow2: u32 = 0;
    guard schema_rt::wire_bits(s, narrow2, 5) else { return false; }
    let raw1: u64 = narrow2;
    value.HardpointIndex = (raw1) as! i32;
    var narrow4: u32 = 0;
    guard schema_rt::wire_bits(s, narrow4, 11) else { return false; }
    let raw3: u64 = narrow4;
    guard raw3 <= 1024 else { return serialize_fail(s, SERIALIZE_ERROR_VALUE_OUT_OF_RANGE); } // a value smuggled into the bit headroom is refused
    value.SpinRate = (raw3 + 1024) as! i32;
    return true;
}

// ExtremeProbeMaxBits is the longest wire path in bits, alignment padding at its worst case.
let ExtremeProbeMaxBits: i64 = 320;
// ExtremeProbeMaxBytes is ExtremeProbeMaxBits in bytes, rounded up to the 8-byte write-buffer granularity:
// size write buffers from it.
let ExtremeProbeMaxBytes: i64 = 40;

// ZeroExtremeProbe sets value to its zero form (SPEC §5): every field zero, a
// nested type at ITS zero form — not the specified defaults, which NewExtremeProbe
// builds. A read zeroes the untaken side of a branch with it.
fn ZeroExtremeProbe(value: ExtremeProbe&) {
    value.FloorBound = 0;
    value.DoubledFloor = 0;
    value.CeilingRange = 0;
    value.FloorDefault = 0;
    value.CeilingDefault = 0;
}

// WriteExtremeProbe writes value in wire order. It returns SERIALIZE_ERROR_NONE, or the
// refusal kind of the first value the wire cannot carry; the size written is
// serialize_bits_processed(s).
fn WriteExtremeProbe(s: WriteStream&, value: ExtremeProbe&) -> i32 {
    if s.num_bits - s.bits_written < ExtremeProbeMaxBits {
        // a stream too small for the value refuses before the runtime sees the
        // write; serialize.goose aborts on a write past the buffer (U9)
        let need = _MeasureExtremeProbe(value, s.bits_written) - s.bits_written;
        if need > s.num_bits - s.bits_written { return SERIALIZE_ERROR_PAST_END; }
    }
    var l = schema_rt::wire_open(s);
    let refusal = _WriteExtremeProbe(s, l, value);
    schema_rt::wire_close(s, l);
    return refusal;
}

inline fn _WriteExtremeProbe(s: WriteStream&, l: schema_rt::WireW&, value: ExtremeProbe&) -> i32 {
    if value.FloorBound > 100 { return SERIALIZE_ERROR_VALUE_OUT_OF_RANGE; }
    let offset1: u64 = value.FloorBound as! u64;
    schema_rt::wire_bits64(s, l, offset1 - 9223372036854775808, 64);
    if value.DoubledFloor > 100 { return SERIALIZE_ERROR_VALUE_OUT_OF_RANGE; }
    let offset2: u64 = value.DoubledFloor as! u64;
    schema_rt::wire_bits64(s, l, offset2 - 9223372036854775808, 64);
    if value.CeilingRange < 1 { return SERIALIZE_ERROR_VALUE_OUT_OF_RANGE; }
    let offset3: u64 = value.CeilingRange;
    schema_rt::wire_bits64(s, l, offset3 - 1, 64);
    schema_rt::wire_bits64(s, l, value.FloorDefault as! u64, 64);
    schema_rt::wire_bits64(s, l, value.CeilingDefault, 64);
    return SERIALIZE_ERROR_NONE;
}

fn _MeasureExtremeProbe(value: ExtremeProbe&, bits: i64) -> i64 {
    var total = bits;
    total += 64;
    total += 64;
    total += 64;
    total += 64;
    total += 64;
    return total;
}

// ReadExtremeProbe reads value, validating every field, then ends the packet (SPEC §5).
// It returns false with the reason latched on the stream (serialize_error(s)).
fn ReadExtremeProbe(s: ReadStream&, value: ExtremeProbe&) -> bool {
    guard _ReadExtremeProbe(s, value) else { return false; }
    guard serialize_end(s) else { return false; } // one packet's end: no trailing byte, no set padding (SPEC §5)
    return true;
}

inline fn _ReadExtremeProbe(s: ReadStream&, value: ExtremeProbe&) -> bool {
    var raw1: u64 = 0;
    guard schema_rt::wire_bits64(s, raw1, 64) else { return false; }
    guard raw1 <= 9223372036854775908 else { return serialize_fail(s, SERIALIZE_ERROR_VALUE_OUT_OF_RANGE); } // a value smuggled into the bit headroom is refused
    value.FloorBound = (raw1 + 9223372036854775808) as! i64;
    var raw2: u64 = 0;
    guard schema_rt::wire_bits64(s, raw2, 64) else { return false; }
    guard raw2 <= 9223372036854775908 else { return serialize_fail(s, SERIALIZE_ERROR_VALUE_OUT_OF_RANGE); } // a value smuggled into the bit headroom is refused
    value.DoubledFloor = (raw2 + 9223372036854775808) as! i64;
    var raw3: u64 = 0;
    guard schema_rt::wire_bits64(s, raw3, 64) else { return false; }
    guard raw3 <= 18446744073709551614 else { return serialize_fail(s, SERIALIZE_ERROR_VALUE_OUT_OF_RANGE); } // a value smuggled into the bit headroom is refused
    value.CeilingRange = raw3 + 1;
    var raw4: u64 = 0;
    guard schema_rt::wire_bits64(s, raw4, 64) else { return false; }
    value.FloorDefault = raw4 as! i64;
    guard schema_rt::wire_bits64(s, value.CeilingDefault, 64) else { return false; }
    return true;
}

// ExtremeRowMaxBits is the longest wire path in bits, alignment padding at its worst case.
let ExtremeRowMaxBits: i64 = 256;
// ExtremeRowMaxBytes is ExtremeRowMaxBits in bytes, rounded up to the 8-byte write-buffer granularity:
// size write buffers from it.
let ExtremeRowMaxBytes: i64 = 32;

// ZeroExtremeRow sets value to its zero form (SPEC §5): every field zero, a
// nested type at ITS zero form — not the specified defaults, which NewExtremeRow
// builds. A read zeroes the untaken side of a branch with it.
fn ZeroExtremeRow(value: ExtremeRow&) {
    value.ClampedFloor = 0;
    value.ClampedCeiling = 0;
