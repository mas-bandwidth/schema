    value.CeilingDef = 0;
}

// WriteExtremeRow writes value in wire order. It returns SERIALIZE_ERROR_NONE, or the
// refusal kind of the first value the wire cannot carry; the size written is
// serialize_bits_processed(s).
fn WriteExtremeRow(s: WriteStream&, value: ExtremeRow&) -> i32 {
    if s.num_bits - s.bits_written < ExtremeRowMaxBits {
