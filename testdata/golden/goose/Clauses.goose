    total += 2; // the tag
    if value.Type == EmptyUnionTypeA { total = _MeasureEmptyA(value.A, total); }
    if value.Type == EmptyUnionTypeB { total = _MeasureEmptyB(value.B, total); }
    return total;
}

// ReadEmptyUnion reads the tag, refusing one above the arm count, then builds the
// selected arm FRESH at its defaults, reads its payload, and ends the packet (SPEC §5).
fn ReadEmptyUnion(s: ReadStream&, value: EmptyUnion&) -> bool {
    guard _ReadEmptyUnion(s, value) else { return false; }
    guard serialize_end(s) else { return false; } // one packet's end: no trailing byte, no set padding (SPEC §5)
    return true;
}

inline fn _ReadEmptyUnion(s: ReadStream&, value: EmptyUnion&) -> bool {
    var tag: u32 = 0;
    guard schema_rt::wire_bits(s, tag, 2) else { return false; }
    guard tag <= 2 else { return serialize_fail(s, SERIALIZE_ERROR_VALUE_OUT_OF_RANGE); } // not a wire-legal tag
    value.Type = tag as! EmptyUnionType;
    if value.Type == EmptyUnionTypeA {
        value.A = EmptyA { .. }; // a fresh payload on every selection
        return _ReadEmptyA(s, value.A);
    }
    if value.Type == EmptyUnionTypeB {
        value.B = EmptyB { .. }; // a fresh payload on every selection
        return _ReadEmptyB(s, value.B);
    }
    return true; // None or a payload-free arm: the tag is the whole wire
