}

// StrsMaxBits is the longest wire path in bits, alignment padding at its worst case.
let StrsMaxBits: i64 = 158;
// StrsMaxBytes is StrsMaxBits in bytes, rounded up to the 8-byte write-buffer granularity:
// size write buffers from it.
let StrsMaxBytes: i64 = 24;

// ZeroStrs sets value to its zero form (SPEC §5): every field zero, a
// nested type at ITS zero form — not the specified defaults, which NewStrs
// builds. A read zeroes the untaken side of a branch with it.
fn ZeroStrs(value: Strs&) {
    value.Lead = 0;
    for ix1 in 8 { value.S[ix1] = 0; }
    value.SLength = 0;
    for ix2 in 8 { value.B[ix2] = 0; }
    value.BLength = 0;
    value.Tail = 0;
}

// WriteStrs writes value in wire order. It returns SERIALIZE_ERROR_NONE, or the
// refusal kind of the first value the wire cannot carry; the size written is
// serialize_bits_processed(s).
fn WriteStrs(s: WriteStream&, value: Strs&) -> i32 {
    if s.num_bits - s.bits_written < StrsMaxBits {
        // a stream too small for the value refuses before the runtime sees the
        // write; serialize.goose aborts on a write past the buffer (U9)
        let need = _MeasureStrs(value, s.bits_written) - s.bits_written;
        if need > s.num_bits - s.bits_written { return SERIALIZE_ERROR_PAST_END; }
    }
    var l = schema_rt::wire_open(s);
    let refusal = _WriteStrs(s, l, value);
    schema_rt::wire_close(s, l);
    return refusal;
}

inline fn _WriteStrs(s: WriteStream&, l: schema_rt::WireW&, value: Strs&) -> i32 {
    if value.Lead > 31 { return SERIALIZE_ERROR_VALUE_OUT_OF_RANGE; } // a value wider than bits(5) cannot ride
    schema_rt::wire_bits(s, l, value.Lead, 5);
    if value.SLength < 0 || value.SLength > 8 { return SERIALIZE_ERROR_VALUE_OUT_OF_RANGE; }
    if !serialize_valid_utf8(value.S[0..value.SLength]) { return SERIALIZE_ERROR_INVALID_UTF8; } // malformed UTF-8 is not a value of the type
    for c1 in value.S[0..value.SLength] { if c1 == 0 { return SERIALIZE_ERROR_EMBEDDED_NUL; } } // a zero byte is not a value of the type
    schema_rt::wire_bits(s, l, value.SLength as! u32, 4);
    schema_rt::wire_close(s, l);
    serialize_bytes(s, value.S[0..value.SLength]);
    schema_rt::wire_reopen(s, l);
    if value.BLength < 0 || value.BLength > 8 { return SERIALIZE_ERROR_VALUE_OUT_OF_RANGE; }
    schema_rt::wire_bits(s, l, value.BLength as! u32, 4);
    schema_rt::wire_close(s, l);
    serialize_bytes(s, value.B[0..value.BLength]);
    schema_rt::wire_reopen(s, l);
    if value.Tail > 7 { return SERIALIZE_ERROR_VALUE_OUT_OF_RANGE; } // a value wider than bits(3) cannot ride
    schema_rt::wire_bits(s, l, value.Tail, 3);
    return SERIALIZE_ERROR_NONE;
}

fn _MeasureStrs(value: Strs&, bits: i64) -> i64 {
    var total = bits;
    total += 5;
    total += 4; // the length
    total += (8 - total % 8) % 8; // the payload aligns
    let len1: i64 = if value.SLength > 8 { 8 } else if value.SLength < 0 { 0 } else { value.SLength };
    total += len1 * 8;
    total += 4; // the length
    total += (8 - total % 8) % 8; // the payload aligns
    let len2: i64 = if value.BLength > 8 { 8 } else if value.BLength < 0 { 0 } else { value.BLength };
    total += len2 * 8;
    total += 3;
    return total;
}

// ReadStrs reads value, validating every field, then ends the packet (SPEC §5).
// It returns false with the reason latched on the stream (serialize_error(s)).
fn ReadStrs(s: ReadStream&, value: Strs&) -> bool {
    guard _ReadStrs(s, value) else { return false; }
    guard serialize_end(s) else { return false; } // one packet's end: no trailing byte, no set padding (SPEC §5)
    return true;
}

inline fn _ReadStrs(s: ReadStream&, value: Strs&) -> bool {
    guard schema_rt::wire_bits(s, value.Lead, 5) else { return false; }
    var narrow2: u32 = 0;
    guard schema_rt::wire_bits(s, narrow2, 4) else { return false; }
    let raw1: u64 = narrow2;
    guard raw1 <= 8 else { return serialize_fail(s, SERIALIZE_ERROR_VALUE_OUT_OF_RANGE); } // a value smuggled into the bit headroom is refused
    value.SLength = (raw1) as! i32;
    guard serialize_bytes(s, value.S[0..value.SLength]) else { return false; }
    guard serialize_valid_utf8(value.S[0..value.SLength]) else { return serialize_fail(s, SERIALIZE_ERROR_INVALID_UTF8); } // malformed UTF-8 is content the read refuses
    for c3 in value.S[0..value.SLength] { guard c3 != 0 else { return serialize_fail(s, SERIALIZE_ERROR_EMBEDDED_NUL); } } // an interior null is content the read refuses
    var narrow5: u32 = 0;
    guard schema_rt::wire_bits(s, narrow5, 4) else { return false; }
    let raw4: u64 = narrow5;
    guard raw4 <= 8 else { return serialize_fail(s, SERIALIZE_ERROR_VALUE_OUT_OF_RANGE); } // a value smuggled into the bit headroom is refused
    value.BLength = (raw4) as! i32;
    guard serialize_bytes(s, value.B[0..value.BLength]) else { return false; }
    guard schema_rt::wire_bits(s, value.Tail, 3) else { return false; }
    return true;
}

// ArrNestedMaxBits is the longest wire path in bits, alignment padding at its worst case.
let ArrNestedMaxBits: i64 = 55;
// ArrNestedMaxBytes is ArrNestedMaxBits in bytes, rounded up to the 8-byte write-buffer granularity:
// size write buffers from it.
let ArrNestedMaxBytes: i64 = 8;

// ZeroArrNested sets value to its zero form (SPEC §5): every field zero, a
// nested type at ITS zero form — not the specified defaults, which NewArrNested
// builds. A read zeroes the untaken side of a branch with it.
fn ZeroArrNested(value: ArrNested&) {
    value.Lead = 0;
    for ix1 in 4 {
        ZeroEleven(value.Items[ix1]);
    }
    value.ItemsCount = 0;
    value.Tail = 0;
}

// WriteArrNested writes value in wire order. It returns SERIALIZE_ERROR_NONE, or the
// refusal kind of the first value the wire cannot carry; the size written is
// serialize_bits_processed(s).
fn WriteArrNested(s: WriteStream&, value: ArrNested&) -> i32 {
    if s.num_bits - s.bits_written < ArrNestedMaxBits {
        // a stream too small for the value refuses before the runtime sees the
        // write; serialize.goose aborts on a write past the buffer (U9)
        let need = _MeasureArrNested(value, s.bits_written) - s.bits_written;
        if need > s.num_bits - s.bits_written { return SERIALIZE_ERROR_PAST_END; }
    }
    var l = schema_rt::wire_open(s);
    let refusal = _WriteArrNested(s, l, value);
    schema_rt::wire_close(s, l);
    return refusal;
}

inline fn _WriteArrNested(s: WriteStream&, l: schema_rt::WireW&, value: ArrNested&) -> i32 {
    if value.Lead > 31 { return SERIALIZE_ERROR_VALUE_OUT_OF_RANGE; } // a value wider than bits(5) cannot ride
    schema_rt::wire_bits(s, l, value.Lead, 5);
    if value.ItemsCount < 0 || value.ItemsCount > 4 { return SERIALIZE_ERROR_VALUE_OUT_OF_RANGE; }
    schema_rt::wire_bits(s, l, (value.ItemsCount) as! u32, 3); // the count, offset from 0
    for ix1 in value.ItemsCount {
        let refusal2 = _WriteEleven(s, l, value.Items[ix1]);
        if refusal2 != SERIALIZE_ERROR_NONE { return refusal2; }
    }
    if value.Tail > 7 { return SERIALIZE_ERROR_VALUE_OUT_OF_RANGE; } // a value wider than bits(3) cannot ride
    schema_rt::wire_bits(s, l, value.Tail, 3);
    return SERIALIZE_ERROR_NONE;
}

fn _MeasureArrNested(value: ArrNested&, bits: i64) -> i64 {
    var total = bits;
    total += 5;
    total += 3; // the count
    let n1 = if value.ItemsCount > 4 { 4 } else if value.ItemsCount < 0 { 0 } else { value.ItemsCount };
    if n1 > 0 {
        for ix2 in n1 {
            total = _MeasureEleven(value.Items[ix2], total);
        }
    }
    total += 3;
    return total;
}

// ReadArrNested reads value, validating every field, then ends the packet (SPEC §5).
// It returns false with the reason latched on the stream (serialize_error(s)).
fn ReadArrNested(s: ReadStream&, value: ArrNested&) -> bool {
    guard _ReadArrNested(s, value) else { return false; }
    guard serialize_end(s) else { return false; } // one packet's end: no trailing byte, no set padding (SPEC §5)
    return true;
}

inline fn _ReadArrNested(s: ReadStream&, value: ArrNested&) -> bool {
    guard schema_rt::wire_bits(s, value.Lead, 5) else { return false; }
    var narrow2: u32 = 0;
    guard schema_rt::wire_bits(s, narrow2, 3) else { return false; }
    let raw1: u64 = narrow2;
    guard raw1 <= 4 else { return serialize_fail(s, SERIALIZE_ERROR_VALUE_OUT_OF_RANGE); } // a value smuggled into the bit headroom is refused
    value.ItemsCount = (raw1) as! i32;
    for ix3 in value.ItemsCount {
        guard _ReadEleven(s, value.Items[ix3]) else { return false; }
    }
    guard schema_rt::wire_bits(s, value.Tail, 3) else { return false; }
    return true;
}

// SoleMaxBits is the longest wire path in bits, alignment padding at its worst case.
let SoleMaxBits: i64 = 13;
// SoleMaxBytes is SoleMaxBits in bytes, rounded up to the 8-byte write-buffer granularity:
// size write buffers from it.
let SoleMaxBytes: i64 = 8;

// ZeroSole sets value to its zero form (SPEC §5): every field zero, a
// nested type at ITS zero form — not the specified defaults, which NewSole
// builds. A read zeroes the untaken side of a branch with it.
fn ZeroSole(value: Sole&) {
    value.Only = 0;
}

// WriteSole writes value in wire order. It returns SERIALIZE_ERROR_NONE, or the
// refusal kind of the first value the wire cannot carry; the size written is
// serialize_bits_processed(s).
fn WriteSole(s: WriteStream&, value: Sole&) -> i32 {
    if s.num_bits - s.bits_written < SoleMaxBits {
        // a stream too small for the value refuses before the runtime sees the
        // write; serialize.goose aborts on a write past the buffer (U9)
        let need = _MeasureSole(value, s.bits_written) - s.bits_written;
        if need > s.num_bits - s.bits_written { return SERIALIZE_ERROR_PAST_END; }
    }
    var l = schema_rt::wire_open(s);
    let refusal = _WriteSole(s, l, value);
    schema_rt::wire_close(s, l);
    return refusal;
}

inline fn _WriteSole(s: WriteStream&, l: schema_rt::WireW&, value: Sole&) -> i32 {
    if value.Only > 8191 { return SERIALIZE_ERROR_VALUE_OUT_OF_RANGE; } // a value wider than bits(13) cannot ride
    schema_rt::wire_bits(s, l, value.Only, 13);
    return SERIALIZE_ERROR_NONE;
}

fn _MeasureSole(value: Sole&, bits: i64) -> i64 {
    var total = bits;
    total += 13;
    return total;
}

// ReadSole reads value, validating every field, then ends the packet (SPEC §5).
// It returns false with the reason latched on the stream (serialize_error(s)).
fn ReadSole(s: ReadStream&, value: Sole&) -> bool {
    guard _ReadSole(s, value) else { return false; }
    guard serialize_end(s) else { return false; } // one packet's end: no trailing byte, no set padding (SPEC §5)
    return true;
}

inline fn _ReadSole(s: ReadStream&, value: Sole&) -> bool {
    guard schema_rt::wire_bits(s, value.Only, 13) else { return false; }
    return true;
}

