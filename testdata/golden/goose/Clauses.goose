    if value.Type > EmptyUnionTypeMax { return SERIALIZE_ERROR_VALUE_OUT_OF_RANGE; } // the tag validates BEFORE it rides
    schema_rt::wire_bits(s, l, value.Type, 2);
    if value.Type == EmptyUnionTypeA {
        return _WriteEmptyA(s, l, value.A);
    }
    if value.Type == EmptyUnionTypeB {
        return _WriteEmptyB(s, l, value.B);
    }
    return SERIALIZE_ERROR_NONE; // None or a payload-free arm: the tag is the whole wire
