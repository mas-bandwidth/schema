    ZeroEmptyB(value.B);
}

// WriteEmptyUnion writes the tag, then the selected arm's payload (SPEC §4.8). The
// tag validates BEFORE it rides: an out-of-set tag writes nothing.
fn WriteEmptyUnion(s: WriteStream&, value: EmptyUnion&) -> i32 {
    if s.num_bits - s.bits_written < EmptyUnionMaxBits {
        // a stream too small for the value refuses before the runtime sees the
        // write; serialize.goose aborts on a write past the buffer (U9)
        let need = _MeasureEmptyUnion(value, s.bits_written) - s.bits_written;
        if need > s.num_bits - s.bits_written { return SERIALIZE_ERROR_PAST_END; }
    }
