fn ReadLudicrousState(s: ReadStream&, value: LudicrousState&) -> bool {
    guard _ReadLudicrousState(s, value) else { return false; }
    guard serialize_end(s) else { return false; } // one packet's end: no trailing byte, no set padding (SPEC §5)
    return true;
}

inline fn _ReadLudicrousState(s: ReadStream&, value: LudicrousState&) -> bool {
    var narrow2: u32 = 0;
    guard schema_rt::wire_bits(s, narrow2, 2) else { return false; }
    let raw1: u64 = narrow2;
    value.Mode = (raw1) as! DriveMode;
    guard _ReadFixedProbe(s, value.Probe) else { return false; }
    guard _ReadWideProbe(s, value.Wide) else { return false; }
    var narrow4: u32 = 0;
    guard schema_rt::wire_bits(s, narrow4, 3) else { return false; }
    let raw3: u64 = narrow4;
    guard raw3 <= 4 else { return serialize_fail(s, SERIALIZE_ERROR_VALUE_OUT_OF_RANGE); } // a value smuggled into the bit headroom is refused
    value.KeysCount = (raw3) as! i32;
    for ix5 in value.KeysCount {
        var wide6 = Uint128 { lo: 0, hi: 0 };
        guard serialize_uint128(s, wide6) else { return false; }
        value.Keys[ix5] = schema_rt::Int128 { lo: wide6.lo, hi: wide6.hi };
    }
    guard schema_rt::wire_bool(s, value.HasTarget) else { return false; }
    if value.HasTarget {
        var wide7 = Uint128 { lo: 0, hi: 0 };
        guard serialize_uint128(s, wide7) else { return false; }
        value.TargetId = schema_rt::Int128 { lo: wide7.lo, hi: wide7.hi };
    } else {
        value.TargetId = schema_rt::Int128 { lo: 0, hi: 0 };
    }
    return true;
}

// DegenerateProbeMaxBits is the longest wire path in bits, alignment padding at its worst case.
let DegenerateProbeMaxBits: i64 = 8;
// DegenerateProbeMaxBytes is DegenerateProbeMaxBits in bytes, rounded up to the 8-byte write-buffer granularity:
// size write buffers from it.
let DegenerateProbeMaxBytes: i64 = 8;

// ZeroDegenerateProbe sets value to its zero form (SPEC §5): every field zero, a
// nested type at ITS zero form — not the specified defaults, which NewDegenerateProbe
// builds. A read zeroes the untaken side of a branch with it.
fn ZeroDegenerateProbe(value: DegenerateProbe&) {
    value.LockedFixed = 0;
    value.LockedInt = 0;
    value.LockedWide = schema_rt::Int128 { lo: 0, hi: 0 };
    value.Tail = 0;
}

// WriteDegenerateProbe writes value in wire order. It returns SERIALIZE_ERROR_NONE, or the
// refusal kind of the first value the wire cannot carry; the size written is
// serialize_bits_processed(s).
fn WriteDegenerateProbe(s: WriteStream&, value: DegenerateProbe&) -> i32 {
    if s.num_bits - s.bits_written < DegenerateProbeMaxBits {
        // a stream too small for the value refuses before the runtime sees the
        // write; serialize.goose aborts on a write past the buffer (U9)
        let need = _MeasureDegenerateProbe(value, s.bits_written) - s.bits_written;
        if need > s.num_bits - s.bits_written { return SERIALIZE_ERROR_PAST_END; }
    }
    var l = schema_rt::wire_open(s);
    let refusal = _WriteDegenerateProbe(s, l, value);
    schema_rt::wire_close(s, l);
    return refusal;
}

inline fn _WriteDegenerateProbe(s: WriteStream&, l: schema_rt::WireW&, value: DegenerateProbe&) -> i32 {
    if value.LockedFixed < (-196608) || value.LockedFixed > (-196608) { return SERIALIZE_ERROR_VALUE_OUT_OF_RANGE; }
    if value.LockedInt < 7 || value.LockedInt > 7 { return SERIALIZE_ERROR_VALUE_OUT_OF_RANGE; }
    let wide1 = Int128 { lo: value.LockedWide.lo, hi: value.LockedWide.hi };
    if serialize_int128_compare(wide1, serialize_int128_make(0xffffffffffffffff, 0xfffff4c58c31d00e)) != 0 { return SERIALIZE_ERROR_VALUE_OUT_OF_RANGE; } // degenerate: zero bits (SPEC §4.6)
    schema_rt::wire_bits(s, l, value.Tail, 8);
    return SERIALIZE_ERROR_NONE;
}

fn _MeasureDegenerateProbe(value: DegenerateProbe&, bits: i64) -> i64 {
    var total = bits;
    total += 8;
    return total;
}

// ReadDegenerateProbe reads value, validating every field, then ends the packet (SPEC §5).
// It returns false with the reason latched on the stream (serialize_error(s)).
fn ReadDegenerateProbe(s: ReadStream&, value: DegenerateProbe&) -> bool {
    guard _ReadDegenerateProbe(s, value) else { return false; }
    guard serialize_end(s) else { return false; } // one packet's end: no trailing byte, no set padding (SPEC §5)
    return true;
}

inline fn _ReadDegenerateProbe(s: ReadStream&, value: DegenerateProbe&) -> bool {
    guard serialize_error(s) == SERIALIZE_ERROR_NONE else { return false; }
    value.LockedFixed = (-196608);
    guard serialize_error(s) == SERIALIZE_ERROR_NONE else { return false; }
    value.LockedInt = 7; // degenerate: zero bits, the value is the range (SPEC §4.6)
    guard serialize_error(s) == SERIALIZE_ERROR_NONE else { return false; }
    value.LockedWide = schema_rt::Int128 { lo: 0xfffff4c58c31d00e, hi: 0xffffffffffffffff }; // degenerate: zero bits, the value is the range (SPEC §4.6)
    var narrow3: u32 = 0;
    guard schema_rt::wire_bits(s, narrow3, 8) else { return false; }
    let raw2: u64 = narrow3;
    value.Tail = raw2 as! u8;
    return true;
}

// FixedVecMaxBits is the longest wire path in bits, alignment padding at its worst case.
let FixedVecMaxBits: i64 = 102;
// FixedVecMaxBytes is FixedVecMaxBits in bytes, rounded up to the 8-byte write-buffer granularity:
// size write buffers from it.
let FixedVecMaxBytes: i64 = 16;

// ZeroFixedVec sets value to its zero form (SPEC §5): every field zero, a
// nested type at ITS zero form — not the specified defaults, which NewFixedVec
// builds. A read zeroes the untaken side of a branch with it.
fn ZeroFixedVec(value: FixedVec&) {
    value.X = 0;
    value.Y = 0;
    value.Z = 0;
}

// WriteFixedVec writes value in wire order. It returns SERIALIZE_ERROR_NONE, or the
// refusal kind of the first value the wire cannot carry; the size written is
// serialize_bits_processed(s).
fn WriteFixedVec(s: WriteStream&, value: FixedVec&) -> i32 {
    if s.num_bits - s.bits_written < FixedVecMaxBits {
        // a stream too small for the value refuses before the runtime sees the
        // write; serialize.goose aborts on a write past the buffer (U9)
        let need = _MeasureFixedVec(value, s.bits_written) - s.bits_written;
        if need > s.num_bits - s.bits_written { return SERIALIZE_ERROR_PAST_END; }
    }
    var l = schema_rt::wire_open(s);
    let refusal = _WriteFixedVec(s, l, value);
    schema_rt::wire_close(s, l);
    return refusal;
}

inline fn _WriteFixedVec(s: WriteStream&, l: schema_rt::WireW&, value: FixedVec&) -> i32 {
    if value.X < (-6553600000) || value.X > 6553600000 { return SERIALIZE_ERROR_VALUE_OUT_OF_RANGE; }
    schema_rt::wire_close(s, l);
    serialize_fixed64(s, value.X, 48, 16, (-100000), 100000);
    schema_rt::wire_reopen(s, l);
    if value.Y < (-6553600000) || value.Y > 6553600000 { return SERIALIZE_ERROR_VALUE_OUT_OF_RANGE; }
    schema_rt::wire_close(s, l);
    serialize_fixed64(s, value.Y, 48, 16, (-100000), 100000);
    schema_rt::wire_reopen(s, l);
    if value.Z < (-6553600000) || value.Z > 6553600000 { return SERIALIZE_ERROR_VALUE_OUT_OF_RANGE; }
    schema_rt::wire_close(s, l);
    serialize_fixed64(s, value.Z, 48, 16, (-100000), 100000);
    schema_rt::wire_reopen(s, l);
    return SERIALIZE_ERROR_NONE;
}

fn _MeasureFixedVec(value: FixedVec&, bits: i64) -> i64 {
    var total = bits;
    total += 34;
    total += 34;
    total += 34;
    return total;
}

// ReadFixedVec reads value, validating every field, then ends the packet (SPEC §5).
// It returns false with the reason latched on the stream (serialize_error(s)).
fn ReadFixedVec(s: ReadStream&, value: FixedVec&) -> bool {
    guard _ReadFixedVec(s, value) else { return false; }
    guard serialize_end(s) else { return false; } // one packet's end: no trailing byte, no set padding (SPEC §5)
    return true;
}

inline fn _ReadFixedVec(s: ReadStream&, value: FixedVec&) -> bool {
    guard serialize_fixed64(s, value.X, 48, 16, (-100000), 100000) else { return false; }
    guard serialize_fixed64(s, value.Y, 48, 16, (-100000), 100000) else { return false; }
    guard serialize_fixed64(s, value.Z, 48, 16, (-100000), 100000) else { return false; }
    return true;
}

// FixedQuatMaxBits is the longest wire path in bits, alignment padding at its worst case.
let FixedQuatMaxBits: i64 = 128;
// FixedQuatMaxBytes is FixedQuatMaxBits in bytes, rounded up to the 8-byte write-buffer granularity:
// size write buffers from it.
let FixedQuatMaxBytes: i64 = 16;

// ZeroFixedQuat sets value to its zero form (SPEC §5): every field zero, a
// nested type at ITS zero form — not the specified defaults, which NewFixedQuat
// builds. A read zeroes the untaken side of a branch with it.
fn ZeroFixedQuat(value: FixedQuat&) {
    value.X = 0;
    value.Y = 0;
    value.Z = 0;
    value.W = 0;
}

// WriteFixedQuat writes value in wire order. It returns SERIALIZE_ERROR_NONE, or the
// refusal kind of the first value the wire cannot carry; the size written is
// serialize_bits_processed(s).
fn WriteFixedQuat(s: WriteStream&, value: FixedQuat&) -> i32 {
    if s.num_bits - s.bits_written < FixedQuatMaxBits {
        // a stream too small for the value refuses before the runtime sees the
        // write; serialize.goose aborts on a write past the buffer (U9)
        let need = _MeasureFixedQuat(value, s.bits_written) - s.bits_written;
        if need > s.num_bits - s.bits_written { return SERIALIZE_ERROR_PAST_END; }
    }
    var l = schema_rt::wire_open(s);
    let refusal = _WriteFixedQuat(s, l, value);
    schema_rt::wire_close(s, l);
    return refusal;
}

inline fn _WriteFixedQuat(s: WriteStream&, l: schema_rt::WireW&, value: FixedQuat&) -> i32 {
    if value.X < (-1073741824) || value.X > 1073741824 { return SERIALIZE_ERROR_VALUE_OUT_OF_RANGE; }
    schema_rt::wire_close(s, l);
    serialize_fixed32(s, value.X, 2, 30, (-1), 1);
    schema_rt::wire_reopen(s, l);
    if value.Y < (-1073741824) || value.Y > 1073741824 { return SERIALIZE_ERROR_VALUE_OUT_OF_RANGE; }
    schema_rt::wire_close(s, l);
    serialize_fixed32(s, value.Y, 2, 30, (-1), 1);
    schema_rt::wire_reopen(s, l);
    if value.Z < (-1073741824) || value.Z > 1073741824 { return SERIALIZE_ERROR_VALUE_OUT_OF_RANGE; }
    schema_rt::wire_close(s, l);
    serialize_fixed32(s, value.Z, 2, 30, (-1), 1);
    schema_rt::wire_reopen(s, l);
    if value.W < (-1073741824) || value.W > 1073741824 { return SERIALIZE_ERROR_VALUE_OUT_OF_RANGE; }
    schema_rt::wire_close(s, l);
    serialize_fixed32(s, value.W, 2, 30, (-1), 1);
    schema_rt::wire_reopen(s, l);
    return SERIALIZE_ERROR_NONE;
}

fn _MeasureFixedQuat(value: FixedQuat&, bits: i64) -> i64 {
    var total = bits;
    total += 32;
    total += 32;
    total += 32;
    total += 32;
    return total;
}

// ReadFixedQuat reads value, validating every field, then ends the packet (SPEC §5).
// It returns false with the reason latched on the stream (serialize_error(s)).
fn ReadFixedQuat(s: ReadStream&, value: FixedQuat&) -> bool {
    guard _ReadFixedQuat(s, value) else { return false; }
    guard serialize_end(s) else { return false; } // one packet's end: no trailing byte, no set padding (SPEC §5)
    return true;
}

inline fn _ReadFixedQuat(s: ReadStream&, value: FixedQuat&) -> bool {
    guard serialize_fixed32(s, value.X, 2, 30, (-1), 1) else { return false; }
    guard serialize_fixed32(s, value.Y, 2, 30, (-1), 1) else { return false; }
    guard serialize_fixed32(s, value.Z, 2, 30, (-1), 1) else { return false; }
    guard serialize_fixed32(s, value.W, 2, 30, (-1), 1) else { return false; }
    return true;
}

