		return false
	end
	value.HasTarget = BOOL.value
	if value.HasTarget then
		if not stream:serializeUint128(WIDE) then
			return false
		end
		value.TargetId = WIDE.value
	else
		value.TargetId = K9
	end
	return true
end

-- ReadLudicrousState is the one-packet read: ReadLudicrousStateBody, then the end check once after
-- the top-level object (SPEC §5); it reports the object's bits consumed.
function M.ReadLudicrousState(stream: any, value: LudicrousState): boolean
	if not M.ReadLudicrousStateBody(stream, value) then
		return false
	end
	local bits = stream:bitsProcessed()
	local reader = stream._reader
	local bitsRead = reader._bitsRead
	if not stream:serializeEnd() then
		return false
	end
	stream._bits = bits
	reader._bitsRead = bitsRead
	return true
end

-- type DegenerateProbe
export type DegenerateProbe = {
	LockedFixed: number,
	LockedInt: number,
	LockedWide: any,
	Tail: number,
}

-- DegenerateProbeMaxBits is the longest wire path; align pads at worst case (SPEC §6.1).
-- DegenerateProbeMaxBytes is rounded up to the 8-byte write-buffer granularity.
M.DegenerateProbeMaxBits = 8
M.DegenerateProbeMaxBytes = 8

-- NewDegenerateProbe builds the value at its defaults (SPEC §5).
function M.NewDegenerateProbe(): DegenerateProbe
	local value: DegenerateProbe = {
		LockedFixed = -3, -- specified default (SPEC §5)
		LockedInt = 7, -- specified default (SPEC §5)
		LockedWide = K22, -- specified default (SPEC §5)
		Tail = 0,
	}
	return value
end

-- InitDegenerateProbe restores fresh construction values in place, preserving storage.
function M.InitDegenerateProbe(value: DegenerateProbe)
	value.LockedFixed = -3
	value.LockedInt = 7
	value.LockedWide = K22
	value.Tail = 0
end

-- ZeroDegenerateProbe resets the §5 zero form: all-zero storage, without declared defaults.
function M.ZeroDegenerateProbe(value: DegenerateProbe)
	value.LockedFixed = 0
	value.LockedInt = 0
	value.LockedWide = K2
	value.Tail = 0
end

-- WriteDegenerateProbe writes the type wire (SPEC §4.3, §6.1: the declared order).
function M.WriteDegenerateProbe(stream: any, value: DegenerateProbe): boolean
	if type(value.LockedFixed) ~= "number" or value.LockedFixed < -3 or value.LockedFixed > -3 then -- whole units, moo's own Q48.16
		return false
	end
	NUM.value = value.LockedFixed
	if not stream:serializeFixedNumber(NUM, -3, -3) then -- the Q format's raw offset (SPEC §4.3)
		return false
	end
	if not isInt(value.LockedInt, 7, 7) then
		return false
	end
	NUM.value = value.LockedInt
	if not stream:serializeInt(NUM, 7, 7) then -- int, offset from min (SPEC §4.3)
		return false
	end
	if not isWide(serialize.Int128, value.LockedWide, K22, K22) then
		return false
	end
	WIDE.value = value.LockedWide
	if not stream:serializeInt128(WIDE, K22, K22) then -- int128, offset from min (SPEC §4.3)
		return false
	end
	if not isInt(value.Tail, 0, 255) then
		return false
	end
	NUM.value = value.Tail
	if not stream:serializeBits(NUM, 8) then
		return false
	end
	return true
end

-- ReadDegenerateProbeBody reads the type wire; false refuses (stream:error() names a runtime
-- refusal; a schema rule's refusal returns false unlatched). A nested read
-- stops here; the end check belongs to the public one-packet read (SPEC §5).
function M.ReadDegenerateProbeBody(stream: any, value: DegenerateProbe): boolean
	if not stream:serializeFixedNumber(NUM, -3, -3) then -- rejects above the raw range (SPEC §4.3)
		return false
	end
	value.LockedFixed = NUM.value
	if not stream:serializeInt(NUM, 7, 7) then -- rejects out of range (SPEC §4.3)
		return false
	end
	value.LockedInt = NUM.value
	if not stream:serializeInt128(WIDE, K22, K22) then -- rejects above max (SPEC §4.3)
		return false
	end
	value.LockedWide = WIDE.value
	if not stream:serializeBits(NUM, 8) then
		return false
	end
	value.Tail = NUM.value
	return true
end

-- ReadDegenerateProbe is the one-packet read: ReadDegenerateProbeBody, then the end check once after
-- the top-level object (SPEC §5); it reports the object's bits consumed.
function M.ReadDegenerateProbe(stream: any, value: DegenerateProbe): boolean
	if not M.ReadDegenerateProbeBody(stream, value) then
		return false
	end
	local bits = stream:bitsProcessed()
	local reader = stream._reader
	local bitsRead = reader._bitsRead
	if not stream:serializeEnd() then
		return false
	end
	stream._bits = bits
	reader._bitsRead = bitsRead
	return true
end

-- type FixedVec
export type FixedVec = {
	X: number,
	Y: number,
	Z: number,
}

-- FixedVecMaxBits is the longest wire path; align pads at worst case (SPEC §6.1).
-- FixedVecMaxBytes is rounded up to the 8-byte write-buffer granularity.
M.FixedVecMaxBits = 102
M.FixedVecMaxBytes = 16

-- NewFixedVec builds the value at its defaults (SPEC §5).
function M.NewFixedVec(): FixedVec
	local value: FixedVec = {
		X = 0,
		Y = 0,
		Z = 0,
	}
	return value
end

-- InitFixedVec restores fresh construction values in place, preserving storage.
function M.InitFixedVec(value: FixedVec)
	value.X = 0
	value.Y = 0
	value.Z = 0
end

-- ZeroFixedVec resets the §5 zero form: all-zero storage, without declared defaults.
function M.ZeroFixedVec(value: FixedVec)
	value.X = 0
	value.Y = 0
	value.Z = 0
end

-- WriteFixedVec writes the type wire (SPEC §4.3, §6.1: the declared order).
function M.WriteFixedVec(stream: any, value: FixedVec): boolean
	if type(value.X) ~= "number" or value.X < -100000 or value.X > 100000 then -- whole units, moo's own Q48.16
		return false
	end
	NUM.value = value.X
	if not stream:serializeFixedNumber(NUM, -100000, 100000) then -- the Q format's raw offset (SPEC §4.3)
		return false
	end
	if type(value.Y) ~= "number" or value.Y < -100000 or value.Y > 100000 then -- whole units, moo's own Q48.16
		return false
	end
	NUM.value = value.Y
	if not stream:serializeFixedNumber(NUM, -100000, 100000) then -- the Q format's raw offset (SPEC §4.3)
		return false
	end
	if type(value.Z) ~= "number" or value.Z < -100000 or value.Z > 100000 then -- whole units, moo's own Q48.16
		return false
	end
	NUM.value = value.Z
	if not stream:serializeFixedNumber(NUM, -100000, 100000) then -- the Q format's raw offset (SPEC §4.3)
		return false
	end
	return true
end

-- ReadFixedVecBody reads the type wire; false refuses (stream:error() names a runtime
-- refusal; a schema rule's refusal returns false unlatched). A nested read
-- stops here; the end check belongs to the public one-packet read (SPEC §5).
function M.ReadFixedVecBody(stream: any, value: FixedVec): boolean
	if not stream:serializeFixedNumber(NUM, -100000, 100000) then -- rejects above the raw range (SPEC §4.3)
		return false
	end
	value.X = NUM.value
	if not stream:serializeFixedNumber(NUM, -100000, 100000) then -- rejects above the raw range (SPEC §4.3)
		return false
	end
	value.Y = NUM.value
	if not stream:serializeFixedNumber(NUM, -100000, 100000) then -- rejects above the raw range (SPEC §4.3)
		return false
	end
	value.Z = NUM.value
	return true
end

-- ReadFixedVec is the one-packet read: ReadFixedVecBody, then the end check once after
-- the top-level object (SPEC §5); it reports the object's bits consumed.
function M.ReadFixedVec(stream: any, value: FixedVec): boolean
	if not M.ReadFixedVecBody(stream, value) then
		return false
	end
	local bits = stream:bitsProcessed()
	local reader = stream._reader
	local bitsRead = reader._bitsRead
	if not stream:serializeEnd() then
		return false
	end
	stream._bits = bits
	reader._bitsRead = bitsRead
	return true
end

-- type FixedQuat
export type FixedQuat = {
	X: number,
	Y: number,
	Z: number,
	W: number,
}

-- FixedQuatMaxBits is the longest wire path; align pads at worst case (SPEC §6.1).
-- FixedQuatMaxBytes is rounded up to the 8-byte write-buffer granularity.
M.FixedQuatMaxBits = 128
M.FixedQuatMaxBytes = 16

-- NewFixedQuat builds the value at its defaults (SPEC §5).
function M.NewFixedQuat(): FixedQuat
	local value: FixedQuat = {
		X = 0,
		Y = 0,
		Z = 0,
		W = 1073741824, -- specified default (SPEC §5)
	}
	return value
end

-- InitFixedQuat restores fresh construction values in place, preserving storage.
function M.InitFixedQuat(value: FixedQuat)
	value.X = 0
	value.Y = 0
	value.Z = 0
	value.W = 1073741824
end

-- ZeroFixedQuat resets the §5 zero form: all-zero storage, without declared defaults.
function M.ZeroFixedQuat(value: FixedQuat)
	value.X = 0
	value.Y = 0
	value.Z = 0
	value.W = 0
end

-- WriteFixedQuat writes the type wire (SPEC §4.3, §6.1: the declared order).
function M.WriteFixedQuat(stream: any, value: FixedQuat): boolean
	if not isInt(value.X, -1073741824, 1073741824) then -- the raw value at its storage width
		return false
	end
	WIDE.value = value.X
	if not stream:serializeFixed64(WIDE, 2, 30, K23, K24) then -- the Q format's raw offset (SPEC §4.3)
		return false
	end
	if not isInt(value.Y, -1073741824, 1073741824) then -- the raw value at its storage width
		return false
	end
	WIDE.value = value.Y
	if not stream:serializeFixed64(WIDE, 2, 30, K23, K24) then -- the Q format's raw offset (SPEC §4.3)
		return false
	end
	if not isInt(value.Z, -1073741824, 1073741824) then -- the raw value at its storage width
		return false
	end
	WIDE.value = value.Z
	if not stream:serializeFixed64(WIDE, 2, 30, K23, K24) then -- the Q format's raw offset (SPEC §4.3)
		return false
	end
	if not isInt(value.W, -1073741824, 1073741824) then -- the raw value at its storage width
		return false
	end
	WIDE.value = value.W
	if not stream:serializeFixed64(WIDE, 2, 30, K23, K24) then -- the Q format's raw offset (SPEC §4.3)
		return false
	end
	return true
end

-- ReadFixedQuatBody reads the type wire; false refuses (stream:error() names a runtime
-- refusal; a schema rule's refusal returns false unlatched). A nested read
-- stops here; the end check belongs to the public one-packet read (SPEC §5).
function M.ReadFixedQuatBody(stream: any, value: FixedQuat): boolean
	if not stream:serializeFixed64(WIDE, 2, 30, K23, K24) then -- rejects above the raw range (SPEC §4.3)
		return false
	end
	value.X = serialize.Int64.toNumber(WIDE.value)
	if not stream:serializeFixed64(WIDE, 2, 30, K23, K24) then -- rejects above the raw range (SPEC §4.3)
		return false
	end
	value.Y = serialize.Int64.toNumber(WIDE.value)
	if not stream:serializeFixed64(WIDE, 2, 30, K23, K24) then -- rejects above the raw range (SPEC §4.3)
		return false
	end
	value.Z = serialize.Int64.toNumber(WIDE.value)
	if not stream:serializeFixed64(WIDE, 2, 30, K23, K24) then -- rejects above the raw range (SPEC §4.3)
		return false
	end
	value.W = serialize.Int64.toNumber(WIDE.value)
	return true
end

-- ReadFixedQuat is the one-packet read: ReadFixedQuatBody, then the end check once after
-- the top-level object (SPEC §5); it reports the object's bits consumed.
function M.ReadFixedQuat(stream: any, value: FixedQuat): boolean
	if not M.ReadFixedQuatBody(stream, value) then
		return false
	end
	local bits = stream:bitsProcessed()
	local reader = stream._reader
	local bitsRead = reader._bitsRead
	if not stream:serializeEnd() then
		return false
	end
	stream._bits = bits
	reader._bitsRead = bitsRead
	return true
end

return M
