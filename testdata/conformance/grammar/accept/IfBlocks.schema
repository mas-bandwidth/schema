// AN `if` WITH NO `else` ENDS AT ITS `}`, AND THE NEXT LINE IS AN ITEM (SPEC.md
// §4.2, the If production; docs/SPEC-CONFORMANCE.md §8, gap 14). `else` may
// stand on the line after the `}` (Allman) or on the same line. Every block
// below parses.
package grammarif

table Guarded
{
    at_rest bool
    if at_rest
    {
        resting int32
    }
    after int32
    if !at_rest
    {
        moving int32
    }
    else
    {
        parked int32
    }
    tail int32
    if at_rest {
        inline int32
    } else {
        other int32
    }
    last int32
}
