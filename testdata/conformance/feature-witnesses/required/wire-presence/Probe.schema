package probe
table RequiredValue { a int32 | required
 b int32 | required }
table Inner { id int32 | required }
table Outer { inner Inner }
table Sequence { children []Inner }
table Mapping { items map[uint8]Inner }
table Graph { child *Inner }
table Guarded {
 outer bool
 if outer {
  inner bool
  if inner { req int32 | required }
 }
}

table Root { a int32
 b int32 | required
 c int32 | required }
table RequiredArray { values [..4]int32 | required }
table RequiredMap { values map[uint8]int32 | required }
enum Key { A, B }
table RequiredKeyed { values [Key]int32 | required }
union Choice { n int32 }
table RequiredUnion { value Choice | required }


table R {
    outer bool
    if outer {
        inner bool
        if inner { yes int32 | required }
        else { no int32 | required }
    }
}

table N {
    outer bool
    if !outer {
        inner bool
        if !inner { yes int32 | required }
        else { no int32 | required }
    }
}

table Leaf { x int32 }
table P {
    outer bool
    if outer {
        inner bool
        if inner { child *Leaf | required }
    }
}

