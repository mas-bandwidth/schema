// Ludicrous.schema — fixed-point numbers and 128-bit integers (SPEC §4.3).
// Use fixed(I, F) when a value needs exact, deterministic fractions across
// machines (positions in a lockstep simulation, money), and int128/uint128
// when 64 bits are not enough (large ids, wide accumulators). Every target
// supports both. The name comes from the game feature that first needed
// 128-bit integers, its "ludicrous mode".

package ludicrous

// a fixed field's whole-unit bounds compose from constants like any range
const MaxWorldUnits = 30000

// sentinel-zero (SPEC §4.2): None = 0 implicit — a zero-initialized mode IS
// the null, no has-flag pair
enum DriveMode { Cruise, Warp, Ludicrous }

// fixed(I, F) is a signed Q I.F number: I integer bits and F fraction bits.
// The bounds are in whole units and size the wire, like an integer range.
// Shown: Q16.16, Q48.16, Q112.16 (128-bit storage), Q32.0 (no fraction, so
// it is a ranged integer on the wire), and a fixed array, which encodes each
// element with the shared bounds
type FixedProbe
{
    angle    fixed(16, 16)    | min = -180, max = 180
    position fixed(48, 16)    | min = -MaxWorldUnits, max = MaxWorldUnits
    reach    fixed(112, 16)   | min = -1000000, max = 1000000
    ticks    fixed(32, 0)     | min = 0, max = 1000000
    samples  [2]fixed(16, 16) | min = -8, max = 8
}

// ufixed(I, F) is the unsigned sibling (SPEC §4.3): no sign bit, whole-unit
// domain [0, 2^I), the same F, and storage an unsigned integer of exactly
// I+F bits. The shapes mirror FixedProbe's. span's raw values reach above
// 2^63, the top half of uint64 storage. locked has min == max, so it costs
// zero bits on the wire and always reads back as 3.
type UnsignedProbe
{
    angle   ufixed(16, 16)     | min = 0, max = 360
    span    ufixed(48, 16)     | min = 0, max = 281474976710655
    reach   ufixed(112, 16)    | min = 0, max = 2000000
    ticks   ufixed(32, 0)      | min = 0, max = 1000000
    samples [2]ufixed(16, 16)  | min = 0, max = 16
    locked  ufixed(16, 16) = 3 | min = 3, max = 3
    tail    uint8
}

// the 128-bit integers: the raw field (always 128 bits, low qword first), a
// ranged field whose range fits 64 bits (the same wire bytes as an int64
// over the same bounds), a ranged field only 128 bits can hold (±2^100:
// 102 wire bits), and specified defaults on both kinds, including one
// beyond the int64 range
type WideProbe
{
    entity_id uint128
    energy    int128                         | min = -5000000000, max = 5000000000
    flux      int128                         | min = -1267650600228229401496703205376, max = 1267650600228229401496703205376
    bias      int128 = -250                  | min = -1000, max = 1000
    seed      uint128 = 36893488147419103232
}

// composition, a counted array of the raw field, and branch zeroing over a
// 128-bit field (SPEC §5: the untaken side reads back as zero)
type LudicrousState
{
    mode       DriveMode
    probe      FixedProbe
    wide       WideProbe
    keys       [..4]uint128
    has_target bool
    if has_target
    {
        target_id uint128
    }
}

// A range with min == max is legal and costs ZERO bits (SPEC §4.6): the
// reader recovers the value from the range alone. The tail byte after them
// starts at bit 0, because the three locked fields write nothing.
type DegenerateProbe
{
    locked_fixed fixed(16, 16) = -3       | min = -3, max = -3
    locked_int   int32 = 7                | min = 7, max = 7
    locked_wide  int128 = -12345678901234 | min = -12345678901234, max = -12345678901234
    tail         uint8
}

// fixed-component composites — the vector and quaternion shapes at fixed
// precision, plain types whose wire is the ranged fixed encoding from the
// component bounds
type FixedVec
{
    x fixed(48, 16) | min = -100000, max = 100000
    y fixed(48, 16) | min = -100000, max = 100000
    z fixed(48, 16) | min = -100000, max = 100000
}

type FixedQuat
{
    x fixed(2, 30) | min = -1, max = 1
    y fixed(2, 30) | min = -1, max = 1
    z fixed(2, 30) | min = -1, max = 1
    // defaults to the identity rotation: 1.0 is exact in Q2.30
    // (1.0 * 2^30 is an integer), so a fixed default is legal (SPEC §4.6)
    w fixed(2, 30) = 1.0 | min = -1, max = 1
}
