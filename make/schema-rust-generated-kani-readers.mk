# non-port-make-file
# KANI ON THE GENERATED RUST READERS (the schema-per-language-lenses group).
#
# The corpus is the tables-generated-rust corpus make/rust.mk already builds:
# every schema under the corpus directories its generate targets read, not a
# second corpus. For each unit this target writes a Kani harness crate beside
# the generated crate and proves every public variable-form reader it finds
# (`pub fn <root>_load(wire: &[u8], ...)` and `<root>_load_measure(wire)`)
# with an arbitrary byte string up to KANI_READERS_BOUND bytes. The property is
# the one the card names: no panic, no overflow, no out-of-bounds for any input
# up to that bound. The generated runtime rides in the same crate, so its
# bounds arithmetic is checked too.
#
# KANI IS HEAVY (nightly, CBMC under the hood), so this target never runs on a
# push: .github/workflows/schema-rust-generated-kani-readers.yml carries it on
# a schedule and workflow_dispatch only.
#
# INSTALL: kani-verifier from its official source, fleet-wide through the
# rowan-tools/fleet ansible play (Glenn's standing grant), never by hand on one
# machine and never from an unofficial mirror. The target probes for it and
# refuses by name when it is absent; a missing tool is not a pass.

KANI          ?= kani
KANI_RUN      ?= cargo kani
KANI_VERSION  ?= 0.63.0
KANI_READERS_BOUND  ?= 64
KANI_READERS_UNWIND ?= $(shell expr $(KANI_READERS_BOUND) + 4)
KANI_READERS_DIR    ?= build/kani-readers

.PHONY: tables-rust-generated-kani-readers
tables-rust-generated-kani-readers:
	@if ! command -v $(KANI) >/dev/null 2>&1; then \
		echo "tool missing: kani (pin $(KANI_VERSION))"; \
		echo "  install kani-verifier fleet-wide through rowan-tools/fleet, not by hand"; \
		exit 1; \
	fi
	@$(KANI) --version 2>&1 | grep -Fq '$(KANI_VERSION)' || { \
		echo "tool version mismatch: kani is not the pinned $(KANI_VERSION)"; \
		$(KANI) --version 2>&1 | head -3; exit 1; }
	@$(MAKE) --no-print-directory build/tables-generated-rust/.stamp
	@rm -rf $(KANI_READERS_DIR)
	@mkdir -p $(KANI_READERS_DIR)
	@set -eu; \
	for crate in build/tables-generated-rust/*/; do \
		[ -f "$$crate/Cargo.toml" ] || continue; \
		[ -f "$$crate/src/lib.rs" ] || continue; \
		pkg=$$(sed -n 's/^name = "\(.*\)"/\1/p' "$$crate/Cargo.toml" | head -1); \
		[ -n "$$pkg" ] || continue; \
		unit=$$(basename "$$crate"); \
		loads=$$(grep -rhoE 'pub fn [a-z0-9_]+_load\(wire: &\[u8\]' "$$crate/src" | sed 's/pub fn //; s/(wire.*//' | sort -u); \
		measures=$$(grep -rhoE 'pub fn [a-z0-9_]+_load_measure\(wire: &\[u8\]\)' "$$crate/src" | sed 's/pub fn //; s/(wire.*//' | sort -u); \
		[ -n "$$loads" ] || continue; \
		ident=$$(printf '%s' "$$pkg" | tr '-' '_'); \
		out="$(KANI_READERS_DIR)/$$unit"; \
		mkdir -p "$$out"; \
		printf '[package]\nname = "kani-%s"\nversion = "0.0.0"\nedition = "2024"\n\n[lib]\npath = "lib.rs"\n\n[dependencies]\n%s = { package = "%s", path = "../../tables-generated-rust/%s" }\n\n[workspace]\n' \
			"$$unit" "$$ident" "$$pkg" "$$unit" > "$$out/Cargo.toml"; \
		{ \
		  echo '#![cfg(kani)]'; \
		  echo '// Generated by make/schema-rust-generated-kani-readers.mk. DO NOT EDIT.'; \
		  echo "const BOUND: usize = $(KANI_READERS_BOUND);"; \
		  echo ''; \
		  for fn in $$loads; do \
		    echo '#[kani::proof]'; \
		    echo "#[kani::unwind($(KANI_READERS_UNWIND))]"; \
		    echo "fn load_$${fn}_bounded() {"; \
		    echo '    let bytes: [u8; BOUND] = kani::any();'; \
		    echo '    let len: usize = kani::any();'; \
		    echo '    kani::assume(len <= BOUND);'; \
		    echo "    let mut report = $$ident::TableReport::default();"; \
		    echo "    let _ = $$ident::$$fn(&bytes[..len], &mut report);"; \
		    echo '}'; \
		    echo ''; \
		  done; \
		  for fn in $$measures; do \
		    echo '#[kani::proof]'; \
		    echo "#[kani::unwind($(KANI_READERS_UNWIND))]"; \
		    echo "fn measure_$${fn}_bounded() {"; \
		    echo '    let bytes: [u8; BOUND] = kani::any();'; \
		    echo '    let len: usize = kani::any();'; \
		    echo '    kani::assume(len <= BOUND);'; \
		    echo "    let _ = $$ident::$$fn(&bytes[..len]);"; \
		    echo '}'; \
		    echo ''; \
		  done; \
		  if [ "$${KANI_READERS_PLANT:-0}" = 1 ]; then \
		    echo '#[kani::proof]'; \
		    echo 'fn planted_out_of_bounds() {'; \
		    echo '    // KANI-READERS-PLANT: the negative control reads past a one-byte buffer.'; \
		    echo '    let bytes = [0u8; 1];'; \
		    echo '    let index: usize = kani::any();'; \
		    echo '    kani::assume(index < 4);'; \
		    echo '    let _ = core::hint::black_box(bytes[index]);'; \
		    echo '}'; \
		  fi; \
		} > "$$out/lib.rs"; \
		echo "kani-readers: $$unit ($$(printf '%s\n' $$loads | wc -l) load, $$(printf '%s\n' $$measures | wc -l) measure)"; \
	done; \
	[ -n "$$(ls -A $(KANI_READERS_DIR) 2>/dev/null)" ] || { echo 'kani-readers: the corpus carries no generated reader'; exit 1; }
	@set -eu; \
	for dir in $(KANI_READERS_DIR)/*/; do \
		echo "kani-readers: checking $$dir"; \
		(cd "$$dir" && $(KANI_RUN)); \
	done
	@echo 'kani readers: every generated variable-form reader checked up to $(KANI_READERS_BOUND) bytes'

# THE NEGATIVE CONTROL: the same target with the planted out-of-bounds read in
# every harness. Kani must exit non-zero and name the plant; a checker that
# never went red on a plant is a checker nobody has watched work.
.PHONY: tables-rust-generated-kani-readers-negative-control
tables-rust-generated-kani-readers-negative-control:
	@mkdir -p $(KANI_READERS_DIR)-negative
	@if KANI_READERS_PLANT=1 $(MAKE) --no-print-directory tables-rust-generated-kani-readers \
			KANI_READERS_DIR=$(KANI_READERS_DIR)-negative > $(KANI_READERS_DIR)-negative/log 2>&1; then \
		echo 'NEGATIVE CONTROL FAILED: Kani stayed green with an out-of-bounds read planted'; \
		cat $(KANI_READERS_DIR)-negative/log; exit 1; \
	fi
	@grep -q 'planted_out_of_bounds' $(KANI_READERS_DIR)-negative/log || { \
		echo 'NEGATIVE CONTROL FAILED: Kani went red, but did not name the plant'; \
		cat $(KANI_READERS_DIR)-negative/log; exit 1; }
	@grep -qiE 'out.of.bounds|index out of|FAILED' $(KANI_READERS_DIR)-negative/log || { \
		echo 'NEGATIVE CONTROL FAILED: Kani went red, but not on the bounds check'; \
		cat $(KANI_READERS_DIR)-negative/log; exit 1; }
	@grep -m1 'planted_out_of_bounds' $(KANI_READERS_DIR)-negative/log
	@echo 'kani readers negative control: the planted out-of-bounds read turns the target RED and is named'
