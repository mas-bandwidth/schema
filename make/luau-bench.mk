# make/luau-bench.mk — the Luau BENCH legs' gate and its negative control
# (bench/README.md, "Runner contract"; bench/tables/README.md, "Registering a
# port"; docs/PORT-LUAU.md, THE HARNESS). The units the legs measure are
# generated by make/luau.mk (generated/bench/luau, generated/bench/tables/luau,
# the latter registered in BENCH_TABLES_LEGS).
#
# bench-luau-gate runs both legs' gates, no clock: each loads its committed
# corpus (as source: the interpreter has no io), byte-compares variant 0
# against the C++-pinned golden and round-trips all 64 variants under the pinned
# interpreter, and reports nothing. A timed pass is `bench/run.sh --only luau`
# and `bench/tables/run.sh --only luau`, on the fleet only; the interpreter's
# native codegen is OFF in both, and no codegen row is measured.
.PHONY: bench-luau-gate bench-luau-gate-negative-control
bench-luau-gate: toolchain-luau generated/bench/luau/.stamp generated/bench/tables/luau/.stamp
	bench/luau/run --gate
	bench/tables/luau/leg build
	bench/tables/luau/leg run --gate

# The control plants a flipped golden under each leg, a stray untagged line
# under the packet runner, and an os.clock() clock and a corpus name in .luau
# files under a copy of bench/ for the shape gate, and requires each refused by
# name beside clean baselines (bench/luau/negative-control.sh).
bench-luau-gate-negative-control: toolchain-luau generated/bench/luau/.stamp generated/bench/tables/luau/.stamp
	bench/luau/negative-control.sh
