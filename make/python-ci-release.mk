# make/python-ci-release.mk — the Python leg's CI and release tier
# (docs/port-python/table-ci-release.md). Included by the Makefile's wildcard
# include; a dashed stem, so the port registry never probes it as a --lang.
# Every recipe runs Python through the pins make/python-toolchain.mk names
# ($(PYTHON), $(PYTHON_FLOOR)), never an interpreter looked up on PATH.

# THE TIER'S OWN GATE: TestPythonReadiness holds the release target, the bench
# leg and the workflow steps that install the pins, then runs the bench leg's
# gate under both pins; its control plants one fault per rule in a copy of the
# artifact the rule reads, and a flipped golden byte and a flipped variant byte
# in copies of the bench corpus, and requires each red by name.
.PHONY: python-readiness python-readiness-negative-control
PYTHON_CI_SUPPORT_GROUPS += python-readiness python-readiness-negative-control
python-readiness: python-toolchain-check
	SCHEMA_SLOW=1 go test -count=1 -timeout 600s -run '^TestPythonReadiness$$' ./internal/codegen/pythontable/
python-readiness-negative-control: python-toolchain-check
	SCHEMA_SLOW=1 go test -count=1 -timeout 600s -run '^TestPythonReadinessNegativeControl$$' ./internal/codegen/pythontable/
test-python: python-readiness python-readiness-negative-control

# THE TABLES BENCH LEG (bench/tables/python/leg): the corpus generated by
# bin/schema, then the runner's gate under each pin. No clock runs here.
.PHONY: tables-python-bench-gate tables-python-bench-gate-negative-control
tables-python-bench-gate: bin/schema python-toolchain-check
	PYTHON=$(PYTHON) bench/tables/python/leg build
	PYTHON=$(PYTHON) bench/tables/python/leg run --gate
	PYTHON=$(PYTHON_FLOOR) bench/tables/python/leg run --gate

# ITS REVERSED WITNESSES, through the real leg over a unit of its own: a copy
# of the corpus whose golden differs from variant 0, and one whose variant 3
# does not round-trip, must each fail the gate by its own message.
tables-python-bench-gate-negative-control: bin/schema python-toolchain-check
	@rm -rf build/python-bench-negative && mkdir -p build/python-bench-negative/golden build/python-bench-negative/roundtrip
	@cp testdata/wire/bench_table.bin bench/corpus/variants/bench_table.variants.bin build/python-bench-negative/golden/
	@cp testdata/wire/bench_table.bin bench/corpus/variants/bench_table.variants.bin build/python-bench-negative/roundtrip/
	@printf '\377' | dd of=build/python-bench-negative/golden/bench_table.bin bs=1 seek=100 conv=notrunc 2>/dev/null
	@size=$$(wc -c < bench/corpus/variants/bench_table.variants.bin); \
	printf '\377' | dd of=build/python-bench-negative/roundtrip/bench_table.variants.bin bs=1 seek=$$((size / 64 * 3 + 100)) conv=notrunc 2>/dev/null
	@PYTHON=$(PYTHON) PYTHON_BENCH_GEN=build/python-bench-negative/gen bench/tables/python/leg build
	@for c in golden:WIRE\ GOLDEN\ MISMATCH roundtrip:FAILED:\ bench_table; do \
		name=$${c%%:*}; want=$${c#*:}; \
		if PYTHON=$(PYTHON) PYTHON_BENCH_GEN=build/python-bench-negative/gen bench/tables/python/leg run --gate \
			--wire-dir build/python-bench-negative/$$name --variant-dir build/python-bench-negative/$$name \
			> build/python-bench-negative/$$name.log 2>&1; then \
			echo "NEGATIVE CONTROL FAILED: the $$name corpus passed the Python bench gate"; exit 1; fi; \
		grep -q "$$want" build/python-bench-negative/$$name.log || \
			{ echo "NEGATIVE CONTROL FAILED: the $$name corpus went red, but not on $$want"; cat build/python-bench-negative/$$name.log; exit 1; }; \
	done
	@echo "tables-python-bench-gate negative control: a flipped golden byte and a flipped variant byte each fail the gate by name"

# THE HARNESS FOR THE LEG'S acceptance run
# (test/conformance/nightly-readiness python): every build admits
# `implementation --lang python`, a built-in target
# (test/conformance/harness/implementation_tagged.go).
build/conformance-harness-python: $(wildcard test/conformance/harness/*.go) $(GO_SOURCES)
	@mkdir -p build
	go build -o $@ ./test/conformance/harness

# THE RELEASE TIER (docs/PORTING.md J3). certify.yml's release-targets job
# derives tables-python-release from this file by name, and its release-gates
# job installs the pins every recipe here needs. Every instrument is the PR
# tier's scaled, none is new: the release wire fuzz (make/wire-fuzz-release.mk:
# both arms, seeds 1-3, at the release count) with the verdict pipe's control
# beside it, the bench leg's gate and its witnesses, then one MEASURED pass of
# the tables bench, the rows only (--bare), so the certification log carries
# the leg's write and round-trip rates beside the other ports'. A bench on a
# shared runner is a pairing check: it shows the leg runs and roughly where it
# stands, and certifies nothing.
.PHONY: tables-python-release
tables-python-release: bin/schema python-toolchain-check build/conformance-harness build/conformance-python
	$(MAKE) tables-wire-fuzz-release-python
	$(MAKE) tables-python-wire-fuzz-negative-control
	$(MAKE) tables-python-bench-gate
	$(MAKE) tables-python-bench-gate-negative-control
	PYTHON=$(PYTHON) bench/tables/run.sh --only python --bare
	@echo "tables python release gate: the wire fuzz at release depth with its control, and the bench leg's gate, witnesses and measured pass"
