# make/lobster-bench.mk — the Lobster BENCH legs' gate and its negative control
# (bench/README.md, "Runner contract"; bench/tables/README.md, "Registering a
# port"; docs/PORT-LOBSTER.md, THE HARNESS). The units the legs measure are
# generated by make/lobster.mk (generated/bench/lobster,
# generated/bench/tables/lobster, the latter registered in BENCH_TABLES_LEGS).
#
# bench-lobster-gate runs both legs' gates, no clock: each loads its committed
# corpus, byte-compares variant 0 against the C++-pinned golden and round-trips
# all 64 variants under the pinned toolchain, and reports nothing. A timed pass
# is `bench/run.sh --only lobster` and `bench/tables/run.sh --only lobster`, on
# the fleet only. The --cpp ahead-of-time row is owed (schema-lobster-bench-cpp,
# docs/roadmap.sexp).
.PHONY: bench-lobster-gate bench-lobster-gate-negative-control
bench-lobster-gate: toolchain-lobster generated/bench/lobster/.stamp generated/bench/tables/lobster/.stamp
	bench/lobster/run --gate
	bench/tables/lobster/leg build
	bench/tables/lobster/leg run --gate

# The control plants a flipped golden under each leg, a compiler warning under
# the packet runner, and a seconds_elapsed() clock and a corpus name in .lobster
# files under a copy of bench/, and requires each refused by name beside clean
# baselines (bench/lobster/negative-control.sh). About 3 s on the studio.
bench-lobster-gate-negative-control: toolchain-lobster generated/bench/lobster/.stamp generated/bench/tables/lobster/.stamp
	bench/lobster/negative-control.sh
