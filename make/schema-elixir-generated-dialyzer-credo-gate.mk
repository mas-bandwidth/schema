# make/schema-elixir-generated-dialyzer-credo-gate.mk
#
# THE ELIXIR GENERATED-CODE LENS (schema-per-language-lenses): Dialyzer's
# success typings and Credo --strict, run over the Elixir the compiler emits for
# the schema corpus the Makefile's generate targets read. It is a gate of its
# own file so it lands without touching make/elixir.mk (the Makefile's wildcard
# include picks this file up).
#
# WHAT IT READS. The corpus is the unit list the table emitter gates already
# name — ELIXIR_TABLE_UNITS and ELIXIR_FIXED_UNITS from make/elixir.mk, plus the
# committed packet units — so this gate does not invent a second corpus. Every
# schema is generated by bin/schema into its own directory, exactly as
# tables-elixir-emit-format-clean does, because two units may declare the same
# module name and only a per-unit compile can tell that apart from a collision.
#
# WHAT RUNS WHERE. Credo is cheap enough for a pull request over the committed
# generated tree (schema-elixir-generated-credo-gate-fast). Dialyzer, its PLT
# build and the whole-corpus compile are heavy and run on the nightly trigger of
# .github/workflows/schema-elixir-generated-dialyzer-credo-gate.yml, with a
# time budget; the workflow's push job runs only the fast Credo half.
#
# THE TOOLS. Both are pinned. Credo is installed from its official Hex release;
# `mix escript.install hex credo $(SCHEMA_ELIXIR_CREDO_VERSION)` puts it on PATH
# as `credo`. Dialyzer ships with Erlang/OTP. When either is absent the target
# says `tool missing: <name>` and exits non-zero — it never fakes a pass.

SCHEMA_ELIXIR_CREDO_VERSION ?= 1.7.12
SCHEMA_ELIXIR_CREDO         ?= credo
SCHEMA_ELIXIR_DIALYZER      ?= dialyzer

SCHEMA_ELIXIR_CHECK_DIR ?= build/schema-elixir-generated-checks
SCHEMA_ELIXIR_PLT       ?= $(SCHEMA_ELIXIR_CHECK_DIR)/plt/dialyzer.plt
SCHEMA_ELIXIR_CREDO_CFG ?= $(SCHEMA_ELIXIR_CHECK_DIR)/.credo.exs

# Only functions made unreachable by an empty union declaration are exempted.
# Dialyzer warning classes stay enabled for every other generated function.
SCHEMA_ELIXIR_EMPTY_UNIONS_DIALYZER := \# Empty @unions leaves these generic arms with no caller in this unit.\n  @dialyzer {:no_fail_call, [collect_union_nodes: 3, arm_header: 5, read_arm: 5, tally_field: 3, json_arm: 3, json_read_arm: 3]}\n  @dialyzer {:no_match, [arm_content: 5, read_arm_payload: 7]}\n  @dialyzer {:no_unused, [arm_content: 5, read_arm_payload: 7]}

# The full corpus, named by the same unit variables the Elixir emitter gates
# use. A unit is <name>:<path>, and every one generates into its own directory.
SCHEMA_ELIXIR_CHECK_UNITS := $(addprefix table-,$(ELIXIR_TABLE_UNITS)) \
	$(addprefix fixed-,$(ELIXIR_FIXED_UNITS)) \
	cards:tables/cards \
	bench:bench/corpus/Bench.schema \
	realworld:bench/corpus/RealWorld.schema \
	examples128:examples128

# ELIXIR's own lib directory, for a PLT that can type Elixir's Enum/Map calls.
# Empty when the launcher cannot answer; dialyzer then falls back to the code
# path erl already has, which is the CI shape.
SCHEMA_ELIXIR_ERL_LIBS ?= $(shell $(ELIXIR) -e 'IO.puts(Path.dirname(to_string(:code.lib_dir(:elixir))))' 2>/dev/null)

# THE CREDO CONFIG. Every disabled check below is a triaged NON-finding over
# generated code, with its one-line reason beside it. Nothing is disabled by
# category: a check not named here still runs. The reasons are deliberately
# narrow — if a check starts naming a real defect, leave it on.
.PHONY: schema-elixir-generated-checks-credo-config
schema-elixir-generated-checks-credo-config:
	@mkdir -p $(dir $(SCHEMA_ELIXIR_CREDO_CFG))
	@printf '%s\n' \
	  '# Generated by make/schema-elixir-generated-dialyzer-credo-gate.mk; do not edit.' \
	  '%{' \
	  '  configs: [' \
	  '    %{' \
	  '      name: "default",' \
	  '      files: %{included: ["."], excluded: []},' \
	  '      checks: [' \
	  '        # generated modules carry no @moduledoc; the schema is their doc' \
	  '        {Credo.Check.Readability.ModuleDoc, false},' \
	  '        # decoders are explicit try/catch so the refusal is one value, not a raise' \
	  '        {Credo.Check.Readability.PreferImplicitTry, false},' \
	  '        # a bit-packing reader branches once per field and union arm by construction' \
	  '        {Credo.Check.Refactor.CyclomaticComplexity, false},' \
	  '        # union arms nest by construction; the wire shape is the nesting' \
	  '        {Credo.Check.Refactor.Nesting, false},' \
	  '        # 64-bit type ids are decimal so they match the spec and the other emitters' \
	  '        {Credo.Check.Readability.LargeNumbers, false},' \
	  '        # `if not cond` reads as the wire rule; the else arm is the common path' \
	  '        {Credo.Check.Refactor.NegatedConditionsWithElse, false},' \
	  '        # a one-bit field emits `n * 1`; the value is right, the constant is the width' \
	  '        {Credo.Check.Warning.OperationWithConstantResult, false},' \
	  '        # generated 128-bit literals stay on one line and mix format is the formatter authority' \
	  '        {Credo.Check.Readability.MaxLineLength, false},' \
	  '        # field walkers thread the layout tuple through each field; splitting it would copy state' \
	  '        {Credo.Check.Refactor.FunctionArity, false},' \
	  '        # generated dispatch is one cond per construct family, the fallthrough included' \
	  '        {Credo.Check.Refactor.CondStatements, false}' \
	  '      ]' \
	  '    }' \
	  '  ]' \
	  '}' > $(SCHEMA_ELIXIR_CREDO_CFG)

.PHONY: schema-elixir-generated-checks-probe
schema-elixir-generated-checks-probe:
	@command -v $(SCHEMA_ELIXIR_DIALYZER) >/dev/null 2>&1 || \
		{ echo 'tool missing: dialyzer'; exit 1; }
	@$(SCHEMA_ELIXIR_CREDO) --version >/dev/null 2>&1 || \
		{ echo 'tool missing: credo (want $(SCHEMA_ELIXIR_CREDO_VERSION) from Hex)'; exit 1; }
	@test "$$($(SCHEMA_ELIXIR_CREDO) --version 2>/dev/null | tr -d '[:space:]')" = \
		"$(SCHEMA_ELIXIR_CREDO_VERSION)" || \
		{ echo 'tool missing: credo $(SCHEMA_ELIXIR_CREDO_VERSION) (found '\
		  "$$($(SCHEMA_ELIXIR_CREDO) --version 2>/dev/null))"; exit 1; }

# THE FAST HALF: Credo --strict over the committed Elixir output. No compile,
# no PLT, no corpus generation — it is a source lint and fits the pull-request
# budget. `--format json` is deliberately not used: the human format names the
# file and line a failure needs.
.PHONY: schema-elixir-generated-credo-gate-fast
schema-elixir-generated-credo-gate-fast: schema-elixir-generated-checks-credo-config
	@command -v $(SCHEMA_ELIXIR_CREDO) >/dev/null 2>&1 || \
		{ echo 'tool missing: credo (want $(SCHEMA_ELIXIR_CREDO_VERSION) from Hex)'; exit 1; }
	@test "$$($(SCHEMA_ELIXIR_CREDO) --version 2>/dev/null | tr -d '[:space:]')" = \
		"$(SCHEMA_ELIXIR_CREDO_VERSION)" || \
		{ echo 'tool missing: credo $(SCHEMA_ELIXIR_CREDO_VERSION)'; exit 1; }
	cd $(SCHEMA_ELIXIR_CHECK_DIR) && $(SCHEMA_ELIXIR_CREDO) --strict \
		$(abspath generated/elixir/*.ex generated/elixir-ludicrous/*.ex \
		generated/bench/elixir/*.ex generated/bench/elixir/realworld/*.ex)
	@echo 'schema Elixir generated lens (fast): Credo --strict is clean over the committed generated tree'

# THE CORPUS STAMP: generate every unit and compile each one into its own ebin.
# A compile error fails here; warnings are not the subject (ELIXIRC_STRICT owns
# them) — Dialyzer reads the success typings off these beams.
$(SCHEMA_ELIXIR_CHECK_DIR)/.stamp: bin/schema make/elixir.mk
	@rm -rf $(SCHEMA_ELIXIR_CHECK_DIR)/gen $(SCHEMA_ELIXIR_CHECK_DIR)/ebin
	@mkdir -p $(SCHEMA_ELIXIR_CHECK_DIR)/gen $(SCHEMA_ELIXIR_CHECK_DIR)/ebin
	@for unit in $(SCHEMA_ELIXIR_CHECK_UNITS); do \
		name=$${unit%%:*}; path=$${unit#*:}; \
		./bin/schema generate --lang elixir --out $(SCHEMA_ELIXIR_CHECK_DIR)/gen/$$name $$path || exit 1; \
	done
	@for unit in $(SCHEMA_ELIXIR_CHECK_UNITS); do \
		name=$${unit%%:*}; \
		mkdir -p $(SCHEMA_ELIXIR_CHECK_DIR)/ebin/$$name $(SCHEMA_ELIXIR_CHECK_DIR)/src/$$name; \
		cp $(SCHEMA_ELIXIR_CHECK_DIR)/gen/$$name/*.ex $(SCHEMA_ELIXIR_CHECK_DIR)/src/$$name/; \
		if [ -f $(SCHEMA_ELIXIR_CHECK_DIR)/src/$$name/Table.ex ]; then \
			# Empty union descriptors make these exact arm helpers unreachable; keep the exemption local to this unit and function. \
			sed -i 's/^  @unions %{}$$/  $(SCHEMA_ELIXIR_EMPTY_UNIONS_DIALYZER)\n  @unions %{}/' $(SCHEMA_ELIXIR_CHECK_DIR)/src/$$name/Table.ex; \
			# No table-list descriptor can take read_keyed_pairs/7's kind-13 arm when this unit has no table-list element. \
			if ! grep -q 'elem_kind: 13' $(SCHEMA_ELIXIR_CHECK_DIR)/src/$$name/Table.ex; then \
				sed -i '/^  @tables /i\  # This unit declares no table-list element, so kind 13 is absent in read_keyed_pairs/7.\n  @dialyzer {:no_match, [read_keyed_pairs: 7]}' $(SCHEMA_ELIXIR_CHECK_DIR)/src/$$name/Table.ex; \
			fi; \
		fi; \
		$(ELIXIRC) -o $(SCHEMA_ELIXIR_CHECK_DIR)/ebin/$$name \
			$(SCHEMA_ELIXIR_CHECK_DIR)/src/$$name/*.ex || exit 1; \
	done
	@touch $@

# THE PLT IS CACHED: it depends only on the pinned OTP and Elixir, so the
# workflow caches build/schema-elixir-generated-checks/plt keyed by both
# versions. --build_plt is the expensive step Dialyzer is kept off the push
# trigger for. Dialyzer exits 2 when it emitted warnings: the PLT is the pins'
# own OTP/Elixir apps (crypto, yecc and friends), whose warnings are not this
# gate's subject, so a status 2 build with a PLT on disk is accepted; 1 or any
# other status still fails.
$(SCHEMA_ELIXIR_PLT):
	@mkdir -p $(dir $@)
	@ERL_LIBS="$(SCHEMA_ELIXIR_ERL_LIBS)" $(SCHEMA_ELIXIR_DIALYZER) \
		--build_plt --output_plt $@ --apps erts kernel stdlib elixir; \
	status=$$?; \
		if [ $$status -ne 0 ] && [ $$status -ne 2 ]; then exit $$status; fi
	@test -s $@

# THE FULL GATE, nightly: Dialyzer over every compiled unit and Credo --strict
# over every generated source. Dialyzer exits non-zero on a warning, which is
# the lens this card adds.
.PHONY: schema-elixir-generated-dialyzer-credo-gate
schema-elixir-generated-dialyzer-credo-gate: schema-elixir-generated-checks-probe \
		$(SCHEMA_ELIXIR_CHECK_DIR)/.stamp $(SCHEMA_ELIXIR_PLT) \
		schema-elixir-generated-checks-credo-config
	@for unit in $(SCHEMA_ELIXIR_CHECK_UNITS); do \
		name=$${unit%%:*}; \
		ERL_LIBS="$(SCHEMA_ELIXIR_ERL_LIBS)" $(SCHEMA_ELIXIR_DIALYZER) \
			--plt $(SCHEMA_ELIXIR_PLT) --no_check_plt --quiet \
			$(SCHEMA_ELIXIR_CHECK_DIR)/ebin/$$name/*.beam || exit 1; \
	done
	@for unit in $(SCHEMA_ELIXIR_CHECK_UNITS); do \
		name=$${unit%%:*}; \
		(cd $(SCHEMA_ELIXIR_CHECK_DIR) && $(SCHEMA_ELIXIR_CREDO) --strict \
			$(abspath $(SCHEMA_ELIXIR_CHECK_DIR)/gen/$$name/*.ex)) || exit 1; \
	done
	@echo 'schema Elixir generated lens: Dialyzer success typings and Credo --strict are clean over the corpus'

# THE PLANTED-BAD CONTROL, ONE PLANT PER TOOL. A generated unit is copied to a
# scratch tree. The Credo plant appends a function whose two sides are the same
# expression (OperationOnSameValues); the Dialyzer plant adds a module whose
# @spec contradicts its body (invalid_contract). Each strict/full run must name
# its plant, and the same scratch tree without the plants must pass, so a gate
# stuck red for an unrelated reason proves nothing. SCHEMA_ELIXIR_NC_DIR is
# scratch; nothing in the corpus moves.
SCHEMA_ELIXIR_NC_DIR ?= $(SCHEMA_ELIXIR_CHECK_DIR)-negative

.PHONY: schema-elixir-generated-dialyzer-credo-gate-negative-control
schema-elixir-generated-dialyzer-credo-gate-negative-control: bin/schema \
		schema-elixir-generated-checks-credo-config \
		schema-elixir-generated-checks-probe $(SCHEMA_ELIXIR_CHECK_DIR)/.stamp $(SCHEMA_ELIXIR_PLT)
	@rm -rf $(SCHEMA_ELIXIR_NC_DIR)
	@mkdir -p $(SCHEMA_ELIXIR_NC_DIR)/clean $(SCHEMA_ELIXIR_NC_DIR)/planted \
		$(SCHEMA_ELIXIR_NC_DIR)/clean-ebin $(SCHEMA_ELIXIR_NC_DIR)/planted-ebin
	./bin/schema generate --lang elixir --out $(SCHEMA_ELIXIR_NC_DIR)/clean examples > /dev/null
	@cp -R $(SCHEMA_ELIXIR_NC_DIR)/clean/. $(SCHEMA_ELIXIR_NC_DIR)/planted/
	@printf '\n\ndef planted_same_value(v), do: v == v\n' \
		>> $(SCHEMA_ELIXIR_NC_DIR)/planted/Clauses.ex
	@printf '%s\n' \
		'defmodule PlantedTypingDefect do' \
		'  @spec planted_typing_defect(integer()) :: atom()' \
		'  def planted_typing_defect(v), do: v + 1' \
		'  def planted_fail_call(bin) when is_binary(bin), do: :binary.decode_unsigned(bin, :litle)' \
		'end' > $(SCHEMA_ELIXIR_NC_DIR)/planted/PlantedTypingDefect.ex
	@if (cd $(SCHEMA_ELIXIR_CHECK_DIR) && $(SCHEMA_ELIXIR_CREDO) --strict \
			$(abspath $(SCHEMA_ELIXIR_NC_DIR)/clean/*.ex)) > $(SCHEMA_ELIXIR_NC_DIR)/clean.log 2>&1; then :; else \
		echo 'NEGATIVE CONTROL FAILED: the unplanted scratch tree is not clean'; \
		cat $(SCHEMA_ELIXIR_NC_DIR)/clean.log; exit 1; fi
	@if (cd $(SCHEMA_ELIXIR_CHECK_DIR) && $(SCHEMA_ELIXIR_CREDO) --strict \
			$(abspath $(SCHEMA_ELIXIR_NC_DIR)/planted/*.ex)) > $(SCHEMA_ELIXIR_NC_DIR)/planted.log 2>&1; then \
		echo 'NEGATIVE CONTROL FAILED: a same-value comparison left Credo --strict green'; \
		exit 1; fi
	@grep -Fq 'Comparison will always return true' $(SCHEMA_ELIXIR_NC_DIR)/planted.log || \
		{ echo 'NEGATIVE CONTROL FAILED: Credo went red, but did not name the plant'; \
		  cat $(SCHEMA_ELIXIR_NC_DIR)/planted.log; exit 1; }
	$(ELIXIRC) -o $(SCHEMA_ELIXIR_NC_DIR)/clean-ebin $(SCHEMA_ELIXIR_NC_DIR)/clean/*.ex
	# The Credo plant is a top-level def: a source lint, not valid Elixir. The
	# typing half compiles the clean sources plus only the defect module.
	$(ELIXIRC) -o $(SCHEMA_ELIXIR_NC_DIR)/planted-ebin \
		$(SCHEMA_ELIXIR_NC_DIR)/clean/*.ex \
		$(SCHEMA_ELIXIR_NC_DIR)/planted/PlantedTypingDefect.ex
	@if ERL_LIBS="$(SCHEMA_ELIXIR_ERL_LIBS)" $(SCHEMA_ELIXIR_DIALYZER) \
			--plt $(SCHEMA_ELIXIR_PLT) --no_check_plt --quiet \
			$(SCHEMA_ELIXIR_NC_DIR)/clean-ebin/*.beam \
			> $(SCHEMA_ELIXIR_NC_DIR)/clean-dialyzer.log 2>&1; then :; else \
		echo 'NEGATIVE CONTROL FAILED: the unplanted scratch tree is not Dialyzer-clean'; \
		cat $(SCHEMA_ELIXIR_NC_DIR)/clean-dialyzer.log; exit 1; fi
	@if ERL_LIBS="$(SCHEMA_ELIXIR_ERL_LIBS)" $(SCHEMA_ELIXIR_DIALYZER) \
			--plt $(SCHEMA_ELIXIR_PLT) --no_check_plt --quiet \
			$(SCHEMA_ELIXIR_NC_DIR)/planted-ebin/*.beam \
			> $(SCHEMA_ELIXIR_NC_DIR)/planted-dialyzer.log 2>&1; then \
		echo 'NEGATIVE CONTROL FAILED: an invalid @spec left Dialyzer green'; \
		exit 1; fi
	@grep -Fq 'Invalid type specification' $(SCHEMA_ELIXIR_NC_DIR)/planted-dialyzer.log || \
		{ echo 'NEGATIVE CONTROL FAILED: Dialyzer went red, but did not name the spec defect'; \
		  cat $(SCHEMA_ELIXIR_NC_DIR)/planted-dialyzer.log; exit 1; }
	@grep -Fq 'planted_typing_defect' $(SCHEMA_ELIXIR_NC_DIR)/planted-dialyzer.log || \
		{ echo 'NEGATIVE CONTROL FAILED: Dialyzer did not name the planted function'; \
		  cat $(SCHEMA_ELIXIR_NC_DIR)/planted-dialyzer.log; exit 1; }
	@grep -Fq 'decode_unsigned' $(SCHEMA_ELIXIR_NC_DIR)/planted-dialyzer.log || \
		{ echo 'NEGATIVE CONTROL FAILED: Dialyzer did not catch the failing call contract'; \
		  cat $(SCHEMA_ELIXIR_NC_DIR)/planted-dialyzer.log; exit 1; }
	@echo 'schema Elixir generated lens negative control: a same-value comparison reds Credo --strict naming the comparison, and an invalid @spec reds Dialyzer naming the typing defect'

	@mkdir -p $(SCHEMA_ELIXIR_NC_DIR)/align-clean $(SCHEMA_ELIXIR_NC_DIR)/align-planted \
		$(SCHEMA_ELIXIR_NC_DIR)/align-clean-ebin $(SCHEMA_ELIXIR_NC_DIR)/align-planted-ebin
	@cp -R $(SCHEMA_ELIXIR_CHECK_DIR)/gen/table-mapdemo/. $(SCHEMA_ELIXIR_NC_DIR)/align-clean/
	@cp -R $(SCHEMA_ELIXIR_NC_DIR)/align-clean/. $(SCHEMA_ELIXIR_NC_DIR)/align-planted/
	@sed -i 's/def align, do: @align/def align, do: (case @align do\n    :never -> 0\n    a -> a\n  end)/' $(SCHEMA_ELIXIR_NC_DIR)/align-planted/BlockRuntime.ex
	$(ELIXIRC) -o $(SCHEMA_ELIXIR_NC_DIR)/align-clean-ebin $(SCHEMA_ELIXIR_NC_DIR)/align-clean/*.ex
	$(ELIXIRC) -o $(SCHEMA_ELIXIR_NC_DIR)/align-planted-ebin $(SCHEMA_ELIXIR_NC_DIR)/align-planted/*.ex
	@if ERL_LIBS="$(SCHEMA_ELIXIR_ERL_LIBS)" $(SCHEMA_ELIXIR_DIALYZER) --plt $(SCHEMA_ELIXIR_PLT) --no_check_plt --quiet $(SCHEMA_ELIXIR_NC_DIR)/align-clean-ebin/*.beam > $(SCHEMA_ELIXIR_NC_DIR)/align-clean.log 2>&1; then :; else \
		echo 'NEGATIVE CONTROL FAILED: clean mapdemo failed Dialyzer'; cat $(SCHEMA_ELIXIR_NC_DIR)/align-clean.log; exit 1; fi
	@if ERL_LIBS="$(SCHEMA_ELIXIR_ERL_LIBS)" $(SCHEMA_ELIXIR_DIALYZER) --plt $(SCHEMA_ELIXIR_PLT) --no_check_plt --quiet $(SCHEMA_ELIXIR_NC_DIR)/align-planted-ebin/*.beam > $(SCHEMA_ELIXIR_NC_DIR)/align-planted.log 2>&1; then \
		echo 'NEGATIVE CONTROL FAILED: @align :never plant left Dialyzer green'; exit 1; fi
	@grep -Eq "The pattern.*never can never match.*64" $(SCHEMA_ELIXIR_NC_DIR)/align-planted.log || \
		{ echo 'NEGATIVE CONTROL FAILED: Dialyzer did not name the @align :never plant'; cat $(SCHEMA_ELIXIR_NC_DIR)/align-planted.log; exit 1; }
	@echo 'schema Elixir generated lens negative control: @align :never reds Dialyzer with the named impossible pattern'
