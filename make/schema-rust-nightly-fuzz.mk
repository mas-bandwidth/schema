# make/schema-rust-nightly-fuzz.mk — NIGHTLY COVERAGE-GUIDED FUZZING of the
# Rust port's generated table readers (Glenn, 2026-10-18).
#
# The target set is the Rust table corpus this repo already generates, not a
# second corpus: RUST_TABLE_UNITS (make/rust.mk) is the same list the port's
# conformance driver and fuzz legs read, so a corpus shape added there is
# fuzzed here without an edit.  One fuzz_target per READER KIND:
#
#   load    — <table>_load(data, &mut report)      the tolerant whole-file read
#   strict  — <table>_load_retain(data, &mut retain, &mut report)
#                                                    the retaining (strict) read
#   json    — <table>_from_json(text, &mut report)  the text/JSON parse
#
# The oracle is the card's: no crash, no hang, no sanitizer/assert finding, and
# a refusal is a clean typed error (None + report), never a panic and never a
# silent success on malformed input.
#
# THE TOOL IS PROBED, NEVER FAKED.  cargo-fuzz and the nightly toolchain are
# installed fleet-wide from their official source through rowan-tools/fleet's
# ansible play; this target refuses by name when either is missing, exactly as
# the repo's toolchain gate does.  Never hand-install on one machine.
#
# FUZZ_SECONDS is the per-reader-kind budget (default 10 minutes, the card's
# default), and it is an argument so a replay costs no clock: the replay target
# passes -runs=<exact file count>, never -max_total_time.
FUZZ_CARGO_FUZZ_VERSION ?= 0.13.1
FUZZ_LIBFUZZER_VERSION ?= 0.4.9
FUZZ_SECONDS ?= 600
FUZZ_DIR ?= build/schema-rust-nightly-fuzz
# the port's committed regression corpus: minimised crashers, replayed by the
# fast gate on every push.  (PATHS-PROPOSED: test/rust-nightly-fuzz-corpus.)
FUZZ_CRASHES ?= test/rust-nightly-fuzz-corpus
FUZZ_PATH ?= $(RUSTUP_BIN):$(HOME)/.cargo/bin:$$PATH

# the corpus list the harness reads: one schema path per line, rendered from
# RUST_TABLE_UNITS so there is exactly one corpus in this tree
FUZZ_CORPUS_FILE := $(FUZZ_DIR)/corpus.txt

.PHONY: schema-rust-nightly-fuzz-probe
schema-rust-nightly-fuzz-probe:
	@if ! PATH="$(FUZZ_PATH)" cargo fuzz --version 2>/dev/null | grep -q 'cargo-fuzz $(FUZZ_CARGO_FUZZ_VERSION)'; then \
		echo "tool missing: cargo-fuzz $(FUZZ_CARGO_FUZZ_VERSION) (host $$(hostname))"; \
		echo "  install it through the fleet play in rowan-tools/fleet; never by hand"; \
		exit 1; \
	fi
	@if ! PATH="$(FUZZ_PATH)" cargo +nightly --version >/dev/null 2>&1; then \
		echo "tool missing: rust nightly toolchain (host $$(hostname))"; \
		echo "  rustup toolchain install nightly; install it through the fleet play"; \
		exit 1; \
	fi
	@if [ ! -d "$(SERIALIZE_RS)" ]; then \
		echo "tool missing: serialize.rs at $(SERIALIZE_RS) (host $$(hostname))"; \
		exit 1; \
	fi

# THE HARNESS IS GENERATED, not checked in: the emitter own the reader names,
# so the Makefile greps the generated units for the three reader entry points
# and writes one fuzz_target per kind.  The same recipe writes the corpus list.
$(FUZZ_DIR)/fuzz/Cargo.toml: bin/schema build/tables-generated-rust/.stamp make/schema-rust-nightly-fuzz.mk
	@rm -rf $(FUZZ_DIR)
	@mkdir -p $(FUZZ_DIR)/fuzz/fuzz_targets $(FUZZ_DIR)/corpus
	@{ \
		echo '[package]'; \
		echo 'name = "schema-rust-nightly-fuzz"'; \
		echo 'version = "0.0.0"'; \
		echo 'edition = "2024"'; \
		echo '[package.metadata]'; \
		echo 'cargo-fuzz = true'; \
		echo '[dependencies]'; \
		echo 'libfuzzer-sys = "=$(FUZZ_LIBFUZZER_VERSION)"'; \
		for unit in $(RUST_TABLE_UNITS); do \
			name=$${unit%%:*}; \
			printf '%s = { path = "../../tables-generated-rust/%s" }\n' "$$name" "$$name"; \
		done; \
		echo '[profile.release]'; \
		echo 'debug = 1'; \
	} > $@
	@for unit in $(RUST_TABLE_UNITS); do echo "$${unit#*:}"; done > $(FUZZ_CORPUS_FILE)
	@for kind in load strict json; do \
		case $$kind in \
			load)   argexpr='data'; pat='_load(';; \
			strict) argexpr='data'; pat='_load_retain(';; \
			json)   argexpr='std::str::from_utf8(data).unwrap_or("")'; pat='_from_json(';; \
		esac; \
		{ \
			echo '// GENERATED by make/schema-rust-nightly-fuzz.mk — one fuzz_target per reader kind.'; \
			echo '#![no_main]'; \
			echo 'use libfuzzer_sys::fuzz_target;'; \
			echo 'fuzz_target!(|data: &[u8]| {'; \
			for unit in $(RUST_TABLE_UNITS); do \
				name=$${unit%%:*}; src=build/tables-generated-rust/$$name/src; \
				for fn in $$(grep -rho "pub fn [a-z0-9_]*$$pat" $$src/*.rs 2>/dev/null | sed 's/pub fn //;s/(//' | sort -u); do \
					case $$kind in \
						strict) echo "    { let mut r = $${name}::TableReport::default(); let mut t = $${name}::TableRetain::default(); let _ = $${name}::$$fn($$argexpr, &mut t, &mut r); }";; \
						*)      echo "    { let mut r = $${name}::TableReport::default(); let _ = $${name}::$$fn($$argexpr, &mut r); }";; \
					esac; \
				done; \
			done; \
			echo '});'; \
		} > $(FUZZ_DIR)/fuzz/fuzz_targets/$$kind.rs; \
	done
	@test -s $(FUZZ_DIR)/fuzz/fuzz_targets/load.rs
	@test -s $(FUZZ_DIR)/fuzz/fuzz_targets/strict.rs
	@test -s $(FUZZ_DIR)/fuzz/fuzz_targets/json.rs
	@echo "schema-rust-nightly-fuzz harness: $$(wc -l < $(FUZZ_CORPUS_FILE)) schema paths, three reader-kind fuzz targets"

# THE NIGHTLY.  One cargo-fuzz run per reader kind for FUZZ_SECONDS.  The seed
# corpus is the Go fuzzer's testdata (internal/fuzz/testdata) and the Go seed
# files it carries, copied once into cargo-fuzz's corpus directories; run with
# SEED=0 to skip the copy.
.PHONY: schema-rust-nightly-fuzz
schema-rust-nightly-fuzz: schema-rust-nightly-fuzz-probe $(FUZZ_DIR)/fuzz/Cargo.toml
	@for kind in load strict json; do \
		mkdir -p $(FUZZ_DIR)/fuzz/corpus/$$kind; \
		if [ "$(SEED)" != "0" ] && [ -d internal/fuzz/testdata/fuzz ]; then \
			find internal/fuzz/testdata/fuzz -type f -exec cp -n {} $(FUZZ_DIR)/fuzz/corpus/$$kind/ \; ; \
		fi; \
		if [ -d $(FUZZ_CRASHES)/$$kind ]; then \
			cp -n $(FUZZ_CRASHES)/$$kind/* $(FUZZ_DIR)/fuzz/corpus/$$kind/ 2>/dev/null || true; \
		fi; \
		( cd $(FUZZ_DIR) && PATH="$(FUZZ_PATH)" cargo +nightly fuzz run $$kind -- -max_total_time=$(FUZZ_SECONDS) ) || exit 1; \
	done

# THE FAST REPLAY.  Every saved input, exactly once, no clock: -runs is the
# number of files, so a push pays replay only.  A green line here is the gate
# that a landed crasher cannot silently return.
.PHONY: schema-rust-nightly-fuzz-replay
schema-rust-nightly-fuzz-replay: schema-rust-nightly-fuzz-probe $(FUZZ_DIR)/fuzz/Cargo.toml
	@for kind in load strict json; do \
		dir=$(FUZZ_CRASHES)/$$kind; \
		n=$$(ls -1 $$dir 2>/dev/null | wc -l | tr -d ' '); \
		[ "$$n" -gt 0 ] || { echo "schema-rust-nightly-fuzz replay: no saved inputs for $$kind"; continue; }; \
		(cd $(FUZZ_DIR) && PATH="$(FUZZ_PATH)" cargo +nightly fuzz run $$kind $$(cd "$(CURDIR)" && pwd)/$$dir -runs=$$n) || exit 1; \
	done
	@echo "schema-rust-nightly-fuzz replay: every saved input refused or read cleanly, no panic"

# THE PLANT (STEP 5).  A scratch copy of the generated reader with the
# short-file bound removed from the tolerant load; the fuzzer must find the
# out-of-bounds panic inside the nightly budget, and the saved input must then
# fail the replay.  Nothing tracked is edited: the plant lives under build/.
.PHONY: schema-rust-nightly-fuzz-negative-control
schema-rust-nightly-fuzz-negative-control: schema-rust-nightly-fuzz-probe $(FUZZ_DIR)/fuzz/Cargo.toml
	@rm -rf build/schema-rust-nightly-fuzz-planted
	@cp -r build/tables-generated-rust build/schema-rust-nightly-fuzz-planted
	@planted=$$(grep -rl 'wire.len() < 9' build/schema-rust-nightly-fuzz-planted/*/src/*.rs 2>/dev/null | head -1); \
	 test -n "$$planted" || { echo "NEGATIVE CONTROL FAILED: no short-file bound to remove"; exit 1; }; \
	 sed -i.bak '/if wire.len() < 9 { report.malformed = true; return None; }/d' $$planted; \
	 grep -q 'wire.len() < 9' $$planted && { echo "NEGATIVE CONTROL FAILED: the plant did not remove the bound"; exit 1; }; \
	 echo "planted: removed the short-file bound from $$planted"
	@rm -rf build/schema-rust-nightly-fuzz-planted-fuzz
	@cp -r $(FUZZ_DIR) build/schema-rust-nightly-fuzz-planted-fuzz
	@sed -i.bak 's#../../tables-generated-rust/#../../schema-rust-nightly-fuzz-planted/#g' build/schema-rust-nightly-fuzz-planted-fuzz/fuzz/Cargo.toml
	@mkdir -p $(FUZZ_CRASHES)/load
	@set +e; ( cd build/schema-rust-nightly-fuzz-planted-fuzz && PATH="$(FUZZ_PATH)" cargo +nightly fuzz run load -- -max_total_time=60 ) >build/schema-rust-nightly-fuzz-planted.log 2>&1; rc=$$?; set -e; \
	 if [ $$rc -eq 0 ]; then echo "NEGATIVE CONTROL FAILED: the fuzzer did not find the removed bound"; exit 1; fi; \
	 crash=$$(find build/schema-rust-nightly-fuzz-planted-fuzz/fuzz/artifacts -type f 2>/dev/null | head -1); \
	 test -n "$$crash" || { echo "NEGATIVE CONTROL FAILED: a crash with no saved input"; exit 1; }; \
	 cp "$$crash" $(FUZZ_CRASHES)/load/planted-short-file; \
	 if ( cd build/schema-rust-nightly-fuzz-planted-fuzz && PATH="$(FUZZ_PATH)" cargo +nightly fuzz run load $(CURDIR)/$(FUZZ_CRASHES)/load -runs=1 ) >/dev/null 2>&1; then \
		echo "NEGATIVE CONTROL FAILED: the saved planted input passed the replay"; exit 1; \
	 fi
	 echo "schema-rust-nightly-fuzz negative control: the fuzzer found the removed bound and the saved input fails the replay (red kept)"
