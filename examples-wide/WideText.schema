// WideText.schema — wide text, wstring(N) (SPEC §4.12, §7.3).
//
// wstring(N) holds up to N UTF-16 code units: use it when your strings are
// UTF-16 at rest (a Windows or console text API, a UI toolkit) and you want
// them on the wire without a conversion. string(N) is the UTF-8 form.
// Every target supports both on the packet wire.
//
// Every type here holds ONE text field and nothing else, so the type's whole
// wire IS that field's wire.

package wide

// wstring(7): the length field is the 3 bits that hold [0, 7], and the
// first code unit follows at bit 3 with no alignment (SPEC §4.12).
type WideSeven
{
    text wstring(7)
}

// wstring(4): a 3-bit length field over [0, 4], so a damaged length of 5, 6
// or 7 is expressible on the wire and refused on read.
type WideFour
{
    text wstring(4)
}

// string(15), the UTF-8 form for comparison: a 4-bit length field, padding
// to the next byte, then the payload from byte 1. A read refuses malformed
// UTF-8 (SPEC §4.7).
type NarrowFifteen
{
    text string(15)
}

// A wstring(7) field for mixed content: basic-plane code units, the top of
// the basic plane (0xE000, 0xFFFF), and astral characters, each of which
// takes two code units as a surrogate pair (SPEC §4.12).
type WideInterop
{
    caption wstring(7)
}
