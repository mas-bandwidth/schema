// Caption.schema — wide text in TABLES (docs/SPEC-TABLES.md §3, kind 33).
//
// WideText.schema shows wstring(N) on the packet wire (SPEC.md §4.12); this
// file shows it on the table wire. Wide text in a table is C++ only today:
// the other eight targets refuse this file, and accept WideText.schema.
//
// Each place wide text can appear in a table is declared once: a TABLE's own
// field, a field of a `type` the table reaches, a UNION ARM, and an array
// ELEMENT. `wstring(N)` cannot be a MAP KEY: a map's entries are sorted by
// `memcmp`, and little-endian code units do not sort that way (§2.8).

package wide

// The bounds match WideText.schema's, 7 and 4. With a bound of 4, five code
// units on the wire are clamped to the four kept, and the cut can fall
// between the two halves of a surrogate pair.

// A `type` a table reaches: its wide text is stored exactly as on the
// packet wire, and the table wire reads and writes that storage.
type Line
{
    text wstring(4)
}

// An arm is a field line (§2.6), so wide text is an admissible arm payload and
// rides under kind 33 with the arm's `L` as its BYTE length. The narrow arm
// beside it is what makes a respelling between the two an ordinary kind
// mismatch rather than UTF-8 bytes read as code units.
union Body
{
    wide   wstring(4)
    narrow string(4)
    tally  int32      | was = "count"
}

// The root: every site at once, so one instance exercises them all.
fixed table Caption
{
    title wstring(7)
    line  Line
    lines [..3]Line
    body  Body
}

// A FIXED table (§2.2): no pointer in its by-value closure, so it takes the
// block form and its cook is one region of one node. Wide text's cooked
// storage is char16_t[N + 1] and an int32 used length in CODE UNITS (§7.2),
// and a fixed root is where that layout is asserted rather than derived.
fixed table Stamp
{
    label wstring(4)
    seq   uint32
}
