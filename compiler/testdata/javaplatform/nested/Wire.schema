// Wire.schema: a type named for every platform type the Java emitters name,
// each a nested class of Wire that shadows that simple name in the file, beside
// fields of every kind and the table forms (compiler/javaplatform_test.go).
// A name schema check refuses (a Ruby or Python builtin, SPEC §4.6) is no
// legal type name, so it has no declaration here.
package javaplatform

type ArrayDeque { v uint8 }
type ArrayList { v uint8 }
type Arrays { v uint8 }
type Base64 { v uint8 }
type BigDecimal { v uint8 }
type BigInteger { v uint8 }
type Boolean { v uint8 }
type ByteBuffer { v uint8 }
type ByteOrder { v uint8 }
type Character { v uint8 }
type CharacterCodingException { v uint8 }
type CodingErrorAction { v uint8 }
type Consumer { v uint8 }
type Double { v uint8 }
type Formatter { v uint8 }
type HashMap { v uint8 }
type HashSet { v uint8 }
type IdentityHashMap { v uint8 }
type IllegalArgumentException { v uint8 }
type IllegalStateException { v uint8 }
type IndexOutOfBoundsException { v uint8 }
type IntConsumer { v uint8 }
type Long { v uint8 }
type Map { v uint8 }
type MathContext { v uint8 }
type MethodHandles { v uint8 }
type NoSuchFieldException { v uint8 }
type Number { v uint8 }
type NumberFormatException { v uint8 }
type Override { v uint8 }
type ReflectiveOperationException { v uint8 }
type RoundingMode { v uint8 }
type RuntimeException { v uint8 }
type StandardCharsets { v uint8 }
type StringBuilder { v uint8 }
type Supplier { v uint8 }
type SuppressWarnings { v uint8 }
type System { v uint8 }
type ThreadLocal { v uint8 }
type TreeMap { v uint8 }
type VarHandle { v uint8 }

enum Team { Red, Blue }

flags Mode { Fast, Quiet, Loud }

type Holder
{
    flag    bool
    small   uint8
    half    int16
    word    uint32
    big     int64
    huge    uint64
    wide    uint128
    vast    int128 | min = -1267650600228229401496703205376, max = 1267650600228229401496703205376
    ratio   float32
    precise float64
    unit    float32 | min = 0, max = 1, resolution = 0.01
    name    string(16)
    blob    bytes(8)
    side    Team
    mode    Mode
    raw     [4]uint8
    words   [3]uint32
    many    [0..4]uint16
    s1 ArrayDeque
    s2 ArrayList
    s3 Arrays
    s5 Base64
    s6 BigDecimal
    s7 BigInteger
    s8 Boolean
    s9 ByteBuffer
    s10 ByteOrder
    s11 Character
    s12 CharacterCodingException
    s13 CodingErrorAction
    s14 Consumer
    s15 Double
    s17 Formatter
    s18 HashMap
    s19 HashSet
    s20 IdentityHashMap
    s21 IllegalArgumentException
    s22 IllegalStateException
    s23 IndexOutOfBoundsException
    s24 IntConsumer
    s26 Long
    s27 Map
    s29 MathContext
    s30 MethodHandles
    s31 NoSuchFieldException
    s32 Number
    s33 NumberFormatException
    s34 Override
    s35 ReflectiveOperationException
    s36 RoundingMode
    s37 RuntimeException
    s39 StandardCharsets
    s40 StringBuilder
    s41 Supplier
    s42 SuppressWarnings
    s43 System
    s44 ThreadLocal
    s45 TreeMap
    s46 VarHandle
}

table Shelf
{
    a     float32
    b     float64
    n     int64
    u     uint64
    side  Team
    mode  Mode
    title string(32)
    items []uint32
}

fixed table Slot
{
    a    float32
    b    float64
    n    int64
    wide uint128
    side Team
    name string(16)
}
