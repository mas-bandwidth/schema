package starlight

fixed table RenderShip
{
    x     float32
    y     float32
    angle float32
    hull  float32 = 1.0
}

fixed table RenderLaser
{
    x0 float32
    y0 float32
    x1 float32
    y1 float32
}

fixed table RenderFrame
{
    frame  uint64
    ships  [..MaxShips]RenderShip
    lasers [..MaxLasers]RenderLaser
}
