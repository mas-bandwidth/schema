// FG3.schema — dart/R28, THE GUARD CHAIN (docs/FIXED-FORM-ALGORITHM.md §4.1,
// §5.8 row 6), modelled on test/tables/FG1.schema.
//
//   R28  THREE NESTED UNIONS. A union inside a type that is an arm of a union
//        that is inside a type that is an arm of a union: the innermost arm's
//        entries answer to THREE tags, and two inline guard lanes cannot carry
//        the third. The plan entry carries an offset and a count into a pool
//        of (guard, arg, argW) links, outermost first, and the entry runs only
//        when EVERY tag holds its ordinal.
//
// The record body, at this build's own widths (every tag one byte):
//
//    0..4   head
//    4      Outer's tag
//    5      Mid's tag             (OuterA.mid)
//    6      Inner's tag           (MidA.inner)
//    7..11  Leaf.n                (Inner.leaf; Other.k is byte 7 alone)
//   11..15  MidA.edge
//   15..19  OuterA.rim
//
// The other arm of every union is narrower than the arm it shares bytes with,
// so byte 10 is written by the innermost leaf arm and by NOTHING ELSE: a probe
// forges each tag in turn and watches byte 10 stay as the caller stained it.
package tblfg3

type Leaf
{
    n int32 = 0
}

type Other
{
    k int8 = 0
}

union Inner
{
    leaf  Leaf
    other Other
}

type MidA
{
    inner Inner
    edge  int32 = 0
}

type MidB
{
    p int16 = 0
}

union Mid
{
    a MidA
    b MidB
}

type OuterA
{
    mid Mid
    rim int32 = 0
}

type OuterB
{
    m int16 = 0
}

union Outer
{
    a OuterA
    b OuterB
}

fixed table FkRoot
{
    head int32 = 1
    pick Outer
}
