// SpaceMessages.schema — the tracer bullet: space game's Messages.h expressed in
// schema language, messages only. The gate is byte-identity of each message BODY
// against the hand-written encoders (WriteMessage in game/Source/Messages.h).
//
// Known seams, named up front:
//   - the dispatch tag: space's packet layer writes messageId as its own uint8
//     outside the body; schema's WriteMessage writes a sorted-by-name tag in
//     minimal bits. Bodies are compared; the tag is the packet layer's seam.
//   - UpdateConfig: space writes a RAW 32-bit size, then uint64 hash, then
//     align+bytes[size]. schema's bytes(N) fuses length+align+bytes with a
//     BOUNDED length. Not expressible byte-identically in v1 — the schema form
//     below is the idiomatic translation, expected to differ on the wire.

package space

const MaxBlockSize       = 2000
const MaxConfigDataBytes = 256000

message Test {
    sequence uint16
    a        int32  [min = 0, max = 1000]
    b        int32  [min = 0, max = 1000]
    c        int32  [min = 0, max = 1000]
}

message Block {
    data bytes(MaxBlockSize)
}

message Synchronize {
    client_frame         uint64
    synchronize_sequence uint16
}

message Timescale {
    time_scale float64
    rtt        bits(32)
    jitter     bits(32)
}

message Heartbeat {
    // empty body — presence is the payload; space's packet layer pads to 1 byte
}

message UpdateConfig {
    // space's wire: size bits(32), hash uint64, align, data[size]
    // schema's wire: hash uint64, length [0,MaxConfigDataBytes], align, data
    // — deliberately idiomatic, byte-identity NOT expected (tracer finding 2)
    hash uint64
    data bytes(MaxConfigDataBytes)
}

message PlayerObject {
    handle uint64
}
